// `xl lc`: the xlang compiler, installed per user under `$XLANG_HOME/xlc` (see `toolchain.xl`); no root rights, and several
// versions side by side (xlang-docs/compiler/install.md "Toolchain"). The stdlib has its own command, `xl std`.
//
//   install [tag]   install a compiler release and make it active
//   update          install the newest compiler and make it active
//   list            the installed compilers; `*` marks the active one
//   use <tag>       make an installed compiler active
//   remove <tag>... remove installed compilers, never the active one
//   clean           remove every installed compiler but the active one, and the failed-install leftovers
//
// Without a tag the newest stable release is taken, or the newest pre-release when the repository has no stable one yet. A tag may
// be partial (`v1.2` is the newest v1.2.x). Releases come from `hasirciogluhq/xlc` (`xlc_<ver>_<os>_<arch>.tar.gz`, `.zip` on
// Windows, the binary at the archive root); the asset is checked against the release's `checksums.txt` before it is unpacked.
from "std" import String, Vec, Result, println, format, trim, files
from "../core/problem" import Problem, Done, done, fail, finish
from "../core/tag" import bare
from "../core/host" import osName, archName, join, joinS, exe
from "../core/release" import fetchAsset, pickRelease, unpack, ARCHIVE
from "../core/proc" import Line, capture
from "toolchain" import activeTags, activateXlc, cleanReleases, releaseDir, removeRelease, xlcBinary, installed

define XLC_REPO = "hasirciogluhq/xlc"
define MODE_EXECUTABLE = 493        // 0755: tar.extract does not carry file modes

export fn lcUsage() {
    println("usage: xl lc <command> [arguments]")
    println("")
    println("  install [tag]   install a compiler release and make it active")
    println("  update          install the newest compiler and make it active")
    println("  list            show the installed compilers (* = active)")
    println("  use <tag>       make an installed compiler active")
    println("  remove <tag>..  remove installed compilers, never the active one")
    println("  clean           remove every installed compiler but the active one")
}

/// Unpacks into `<dir>.partial`, lets `finish` arrange the tree, then renames the result to `dir`: a failed install leaves nothing
/// that looks installed.
fn installXlc(tag: *String) -> Done {
    local dir = releaseDir("xlc", tag)
    if files.isDir(&dir) {
        println("xlc {} is already installed", tag)
        return done()
    }
    local version = bare(tag)
    local os = osName()
    local arch = archName()
    local asset = format("xlc_{}_{}_{}.{}", &version, &os, &arch, ARCHIVE)
    println("downloading {} {}", &asset, tag)
    local data = fetchAsset(XLC_REPO, tag, asset.asStr())?
    local partial = format("{}.partial", &dir)
    files.removeAll(&partial)
    unpack(&data, &partial)?
    local name = exe("xlc")
    local binary = joinS(&partial, &name)
    if !files.exists(&binary) || !files.chmod(&binary, MODE_EXECUTABLE) {
        files.removeAll(&partial)
        return fail<bool>("E0793", format("{} has no xlc binary at its root", &asset), String("the release is broken; pick another version"))
    }
    // A binary for another system or a corrupt one fails here, before it is installed.
    local check = Line(&binary)
    check.add("--version")
    switch capture(&check, "E0793") {
        case Result.Ok(out) {
            local said = trim(out.asStr())
            println("  {}", &said)
        }
        case Result.Err(e) {
            files.removeAll(&partial)
            return Result.Err(e)
        }
    }
    if !files.rename(&partial, &dir) {
        files.removeAll(&partial)
        return fail<bool>("E0793", format("could not move the compiler into {}", &dir), String("check that XLANG_HOME is writable"))
    }
    return done()
}

/// The one optional tag argument (empty = the newest release).
fn specOf(args: *Vec<String>, needTag: bool) -> Result<String, Problem> {
    if args.length() > 1 || (args.isEmpty() && needTag) {
        local what = needTag ? String("`xl lc use` needs a compiler tag") : String("unexpected arguments")
        return fail<String>("E0740", what, String("see `xl lc help`"))
    }
    if !args.isEmpty() && args.get(0).startsWith("-") {
        return fail<String>("E0740", format("unexpected argument `{}`", args.get(0)), String("see `xl lc help`"))
    }
    return Result.Ok(args.isEmpty() ? String() : args.get(0).clone())
}

fn install(args: *Vec<String>) -> Done {
    local spec = specOf(args, false)?
    local xlcTag = pickRelease(XLC_REPO, &spec)?
    installXlc(&xlcTag)?
    activateXlc(&xlcTag)?
    println("active: xlc {}", &xlcTag)
    return done()
}

fn update() -> Done {
    local before = activeTags()
    local none: Vec<String> = Vec<String>()
    install(&none)?
    local after = activeTags()
    if before.xlcTag.equals(&after.xlcTag) { println("already up to date") }
    return done()
}

fn list() -> Done {
    local active = activeTags()
    println("xlc:")
    local tags = installed("xlc")
    if tags.isEmpty() { println("  (none)") }
    for t in tags {
        local mark = String(t.equals(&active.xlcTag) ? "*" : " ")
        println("  {} {}", &mark, t)
    }
    return done()
}

fn use(args: *Vec<String>) -> Done {
    local tag = specOf(args, true)?
    local binary = xlcBinary(&tag)
    if !files.exists(&binary) { return fail<bool>("E0790", format("xlc {} is not installed", &tag), format("run `xl lc install {}`", &tag)) }
    activateXlc(&tag)?
    println("active: xlc {}", &tag)
    return done()
}

/// The tags named on the command line, each an installed release as `xl lc list` shows it.
fn remove(args: *Vec<String>) -> Done {
    if args.isEmpty() {
        return fail<bool>("E0740", String("`xl lc remove` needs at least one compiler tag"), String("see the tags with `xl lc list`"))
    }
    local active = activeTags()
    for a in args {
        removeRelease("xlc", a, &active.xlcTag)?
        println("removed xlc {}", a)
    }
    return done()
}

fn clean() -> Done {
    local active = activeTags()
    local gone = cleanReleases("xlc", &active.xlcTag)
    if gone.isEmpty() {
        println("nothing to remove")
    } else {
        for t in gone { println("removed xlc {}", t) }
    }
    return done()
}

/// `xl lc <command> ...`; `args` starts after `lc`.
export fn lcMain(args: *Vec<String>) -> i32 {
    if args.isEmpty() || args.get(0).equals("help") || args.get(0).equals("--help") || args.get(0).equals("-h") {
        lcUsage()
        return args.isEmpty() ? 2 : 0
    }
    local rest: Vec<String> = Vec<String>()
    for a, i in args { if i > 0 { rest.push(a.clone()) } }
    local cmd = args.get(0)
    if cmd.equals("install") || cmd.equals("i") { return finish(install(&rest)) }
    if cmd.equals("update") || cmd.equals("up") { return finish(update()) }
    if cmd.equals("list") || cmd.equals("ls") { return finish(list()) }
    if cmd.equals("use") { return finish(use(&rest)) }
    if cmd.equals("remove") || cmd.equals("rm") { return finish(remove(&rest)) }
    if cmd.equals("clean") { return finish(clean()) }
    return finish(fail<bool>("E0740", format("unknown command `xl lc {}`", cmd), String("see `xl lc help`")))
}
