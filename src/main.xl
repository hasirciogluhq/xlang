// xl: the xlang tool. It installs the compiler (`xl lc`) and the standard library (`xl std`), manages packages (`xl pkg`), builds
// and runs programs through `xlc` (`xl check`, `xl build`, `xl run`) and updates itself (`xl self-update`). Layout: src/README.md.
from "std" import String, Vec, println, eprintln, format
from "std/os/args" import fromArgv
from "core/problem" import fail, finish
from "core/version" import VERSION
from "pkg/command" import pkgMain
from "lc/command" import lcMain
from "stdlib/command" import stdMain
from "build/command" import checkMain, buildMain, runMain, envMain
from "build/test" import testMain
from "self/command" import selfUpdateMain

define BUILD_NOTES = "Flags are xlc's own (`xlc --help`: -O2, -o out, --emit=obj, -D NAME=VALUE, --target, ...) and pass through\nunchanged; --std=<dir> replaces the stdlib. Without a file, main.xl of the project root (the directory of the nearest\nxlang.toml) or of the current directory is used. Builds never touch the network. XL_VERBOSE=1 prints the xlc command line."
define CHECK_HELP = "usage: xl check [flags] [file.xl] [flags]\n\nType-checks a program with the project's stdlib and packages; writes nothing.\n"
define BUILD_HELP = "usage: xl build [flags] [file.xl] [flags]\n\nBuilds an executable next to the file (or what --emit asks for) with the project's stdlib and packages.\n"
define RUN_HELP = "usage: xl run [flags] [file.xl] [program arguments...]\n       xl run [flags] -- [program arguments...]\n\nBuilds the program into a temporary directory and runs it; everything after the file or `--` goes to the\nprogram, and its exit status becomes xl's.\n"
define TEST_HELP = "usage: xl test [flags] [patterns...] [-- program arguments...]\n\nBuilds and runs test files (*.test.xl) with the project's stdlib and packages, several at a time, and reports each in file\norder. A pattern is a file, a directory, a glob (`*` and `?` within a path segment, `**` across segments; without `/` it\nmatches a name at any depth) or a part of a path. Without one, every test file under the current directory runs.\n\n  -x, --exclude <pattern>   skip the files the pattern selects (repeatable)\n  -j, --jobs <n>            build and run n files at once (default: one per CPU)\n  -q, --quiet               print a file's output only when it fails\n      --fail-fast           stop at the first failure and end the files still running\n      --list                print the selected files and run nothing\n      --no-color            plain output (also when NO_COLOR is set or stdout is not a terminal)\n      --std=<dir>           replace the stdlib\n\nOther flags go to xlc for every file (-O2, -D NAME=VALUE, --safety=checked, ...); arguments after `--` go to every test\nprogram. The exit status is 0 when every file built and passed."
define ENV_HELP = "usage: xl env [--json] [--std=<dir>] [file.xl]\n\nPrints the compiler, stdlib, package roots and flags a build of the file uses, and why a build could not start.\n--json prints one object for editors and scripts (xlang-docs: compiler/cli)."
define SELF_UPDATE_HELP = "usage: xl self-update [tag] [--check] [--force]\n\nReplaces this xl with the newest release (or the given tag) of hasirciogluhq/xlang after checking its checksum.\nA pre-release xl follows pre-releases. --check only reports; --force reinstalls or downgrades."

/// `xl <command> --help` of the commands that have no subcommands (`pkg`, `lc` and `std` print their own); false for any other command.
fn commandHelp(cmd: *String) -> bool {
    local pages = [("check", CHECK_HELP), ("build", BUILD_HELP), ("run", RUN_HELP), ("test", TEST_HELP), ("env", ENV_HELP), ("self-update", SELF_UPDATE_HELP)]
    for p in pages {
        local (name, text) = *p
        if !cmd.equals(name) { continue }
        println(text)
        if cmd.equals("check") || cmd.equals("build") || cmd.equals("run") { println(BUILD_NOTES) }
        return true
    }
    return false
}

fn usage() {
    println("xl {}: the xlang tool", VERSION)
    println("")
    println("usage: xl <command> [arguments]")
    println("")
    println("  run [flags] [file.xl] [args...]   build and run a program; arguments after the file go to it")
    println("  build [flags] [file.xl]           build an executable (or what --emit asks for)")
    println("  check [flags] [file.xl]           type-check without writing anything")
    println("  test [flags] [patterns...]        build and run the *.test.xl files, several at a time")
    println("  env [--json] [file.xl]            the compiler, stdlib and module roots a build of the file uses")
    println("  pkg <command>                     packages: add, install, update, remove, list, clean")
    println("  lc <command>                      the compiler: install, update, list, use")
    println("  std <command>                     the standard library: install, update, list, use")
    println("  self-update [--check] [--force]   replace this xl with the newest release")
    println("  version                           print the version")
    println("")
    println("`xl <command> --help` describes a command. Flags of build, check and run go to the compiler (xlc --help).")
}

@entry fn main(argc: i32, argv: **u8) -> i32 {
    local all = fromArgv(argc, argv)
    if all.length() < 2 {
        usage()
        return 2
    }
    local cmd = all.get(1).clone()
    local rest: Vec<String> = Vec<String>()
    for a, i in all { if i > 1 { rest.push(a.clone()) } }
    if !rest.isEmpty() && (rest.get(0).equals("--help") || rest.get(0).equals("-h")) && commandHelp(&cmd) { return 0 }
    if cmd.equals("help") || cmd.equals("--help") || cmd.equals("-h") {
        usage()
        return 0
    }
    if cmd.equals("version") || cmd.equals("--version") || cmd.equals("-V") {
        println(VERSION)
        return 0
    }
    if cmd.equals("pkg") { return pkgMain(&rest) }
    if cmd.equals("lc") { return lcMain(&rest) }
    if cmd.equals("std") { return stdMain(&rest) }
    if cmd.equals("check") { return checkMain(&rest) }
    if cmd.equals("build") { return buildMain(&rest) }
    if cmd.equals("run") { return runMain(&rest) }
    if cmd.equals("test") { return testMain(&rest) }
    if cmd.equals("env") { return envMain(&rest) }
    if cmd.equals("self-update") { return selfUpdateMain(&rest) }
    eprintln("error: unknown command `{}`", &cmd)
    eprintln("  fix: see `xl help`")
    return 2
}
