// filesystem — low + convenience FS API over the filesystem bridge.
//   import * as filesystem from filesystem
//   local body = filesystem.ReadAll("path.txt")
// Bridge never panics; check Errno() / negative handles / non-zero status.

declare xl_filesystem_errno(): int32
declare xl_filesystem_open(path: string, mode: int32): int64
declare xl_filesystem_close(handle: int64): int32
declare xl_filesystem_read(handle: int64, max: int32): string
declare xl_filesystem_write(handle: int64, data: string): int32
declare xl_filesystem_seek(handle: int64, offset: int64, whence: int32): int64
declare xl_filesystem_tell(handle: int64): int64
declare xl_filesystem_flush(handle: int64): int32
declare xl_filesystem_truncate(handle: int64, size: int64): int32
declare xl_filesystem_read_all(path: string): string
declare xl_filesystem_write_all(path: string, data: string): int32
declare xl_filesystem_append_all(path: string, data: string): int32
declare xl_filesystem_exists(path: string): int32
declare xl_filesystem_is_file(path: string): int32
declare xl_filesystem_is_dir(path: string): int32
declare xl_filesystem_is_symlink(path: string): int32
declare xl_filesystem_size(path: string): int64
declare xl_filesystem_mtime(path: string): int64
declare xl_filesystem_mkdir(path: string): int32
declare xl_filesystem_mkdir_all(path: string): int32
declare xl_filesystem_remove(path: string): int32
declare xl_filesystem_rmdir(path: string): int32
declare xl_filesystem_rename(from: string, to: string): int32
declare xl_filesystem_copy(from: string, to: string): int32
declare xl_filesystem_chmod(path: string, mode: int32): int32
declare xl_filesystem_cwd(): string
declare xl_filesystem_chdir(path: string): int32
declare xl_filesystem_realpath(path: string): string
declare xl_filesystem_read_dir(path: string): string
declare xl_filesystem_read_handle(handle: int64): string
declare xl_filesystem_write_handle(handle: int64, data: string): int32

export struct File {
    handle: int64
    path: string
}

export fn ModeRead(): int32 {
    return 1
}

export fn ModeWrite(): int32 {
    return 2
}

export fn ModeAppend(): int32 {
    return 3
}

export fn ModeReadWrite(): int32 {
    return 4
}

export fn ModeReadWriteExisting(): int32 {
    return 5
}

export fn SeekSet(): int32 {
    return 0
}

export fn SeekCur(): int32 {
    return 1
}

export fn SeekEnd(): int32 {
    return 2
}

export fn Errno(): int32 {
    return xl_filesystem_errno()
}

export fn Open(path: string, mode: int32): File {
    local h = xl_filesystem_open(path, mode)
    return new File { handle = h, path = path }
}

export fn OpenRead(path: string): File {
    return Open(path, ModeRead())
}

export fn OpenWrite(path: string): File {
    return Open(path, ModeWrite())
}

export fn OpenAppend(path: string): File {
    return Open(path, ModeAppend())
}

export fn Close(f: File): int32 {
    if f.handle < 0 {
        return 1
    }
    return xl_filesystem_close(f.handle)
}

export fn Read(f: File, max: int32): string {
    if f.handle < 0 {
        return ""
    }
    return xl_filesystem_read(f.handle, max)
}

export fn ReadAll(path: string): string {
    return xl_filesystem_read_all(path)
}

export fn ReadStream(f: File): string {
    if f.handle < 0 {
        return ""
    }
    return xl_filesystem_read_handle(f.handle)
}

export fn Write(path: string, data: string): int32 {
    return xl_filesystem_write_all(path, data)
}

export fn Append(path: string, data: string): int32 {
    return xl_filesystem_append_all(path, data)
}

export fn WriteStream(f: File, data: string): int32 {
    if f.handle < 0 {
        return 1
    }
    return xl_filesystem_write_handle(f.handle, data)
}

export fn Seek(f: File, offset: int64, whence: int32): int64 {
    if f.handle < 0 {
        return 0 - 1
    }
    return xl_filesystem_seek(f.handle, offset, whence)
}

export fn Tell(f: File): int64 {
    if f.handle < 0 {
        return 0 - 1
    }
    return xl_filesystem_tell(f.handle)
}

export fn Flush(f: File): int32 {
    if f.handle < 0 {
        return 1
    }
    return xl_filesystem_flush(f.handle)
}

export fn Truncate(f: File, size: int64): int32 {
    if f.handle < 0 {
        return 1
    }
    return xl_filesystem_truncate(f.handle, size)
}

export fn Exists(path: string): int32 {
    return xl_filesystem_exists(path)
}

export fn IsFile(path: string): int32 {
    return xl_filesystem_is_file(path)
}

export fn IsDir(path: string): int32 {
    return xl_filesystem_is_dir(path)
}

export fn IsSymlink(path: string): int32 {
    return xl_filesystem_is_symlink(path)
}

export fn Size(path: string): int64 {
    return xl_filesystem_size(path)
}

export fn Mtime(path: string): int64 {
    return xl_filesystem_mtime(path)
}

export fn Mkdir(path: string): int32 {
    return xl_filesystem_mkdir(path)
}

export fn MkdirAll(path: string): int32 {
    return xl_filesystem_mkdir_all(path)
}

export fn Remove(path: string): int32 {
    return xl_filesystem_remove(path)
}

export fn Rmdir(path: string): int32 {
    return xl_filesystem_rmdir(path)
}

export fn Rename(from: string, to: string): int32 {
    return xl_filesystem_rename(from, to)
}

export fn Copy(from: string, to: string): int32 {
    return xl_filesystem_copy(from, to)
}

export fn Chmod(path: string, mode: int32): int32 {
    return xl_filesystem_chmod(path, mode)
}

export fn Cwd(): string {
    return xl_filesystem_cwd()
}

export fn Chdir(path: string): int32 {
    return xl_filesystem_chdir(path)
}

export fn Realpath(path: string): string {
    return xl_filesystem_realpath(path)
}

export fn ReadDir(path: string): string {
    return xl_filesystem_read_dir(path)
}

export fn IsOpen(f: File): int32 {
    if f.handle < 0 {
        return 0
    }
    return 1
}
