// Mutex, RWLock ve atomik tipler — tüm mantık xlang içinde.
// OS köprüsü: plain declare → bridge / C ABI (mutex_*, cond_*, atomic_*, xl_sleep_ms, xl_now_ms).

declare xl_mutex_init(): int64
declare xl_mutex_lock(m: int64): int32
declare xl_mutex_trylock(m: int64): int32
declare xl_mutex_unlock(m: int64): int32
declare xl_cond_init(): int64
declare xl_cond_wait(c: int64, m: int64): int32
declare xl_cond_signal(c: int64): int32
declare xl_cond_broadcast(c: int64): int32
declare xl_sleep_ms(ms: int32): int32
declare xl_now_ms(): int64
declare xl_atomic_alloc(): int64
declare xl_atomic_load(p: int64): int64
declare xl_atomic_store(p: int64, val: int64): int32
declare xl_atomic_fetch_add(p: int64, delta: int64): int64
declare xl_atomic_compare_exchange(p: int64, expected: int64, desired: int64): int32

export struct Lock {
    gate: int64
    held: int64
    generation: int64
    timeout: int64
    slot: int32
}

export struct RWLock {
    mu: int64
    cv_read: int64
    cv_write: int64
    readers: int64
    writer: int64
    write_held: int64
    write_gen: int64
    read_timeout: int64
    write_timeout: int64
    slot: int32
}

export struct AtomicInt {
    cell: int64
}

export struct AtomicBool {
    cell: int64
}

lock_gates: array int64
lock_held_cells: array int64
lock_gen_cells: array int64
rw_mu_cells: array int64
rw_cv_read_cells: array int64
rw_cv_write_cells: array int64
rw_writer_cells: array int64
rw_write_held_cells: array int64
rw_write_gen_cells: array int64
lock_registry_mu: int64
lock_registry_inited: int32

fn init_lock_registry() {
    if lock_registry_inited != 0 {
        return 0
    }
    lock_registry_mu = xl_mutex_init()
    lock_gates = new array int64
    lock_held_cells = new array int64
    lock_gen_cells = new array int64
    rw_mu_cells = new array int64
    rw_cv_read_cells = new array int64
    rw_cv_write_cells = new array int64
    rw_writer_cells = new array int64
    rw_write_held_cells = new array int64
    rw_write_gen_cells = new array int64
    lock_registry_inited = 1
    return 0
}

fn alloc_lock_slot(gate: int64, held: int64, generation: int64): int32 {
    init_lock_registry()
    xl_mutex_lock(lock_registry_mu)
    local slot = array_len(lock_gates)
    array_push(lock_gates, gate)
    array_push(lock_held_cells, held)
    array_push(lock_gen_cells, generation)
    xl_mutex_unlock(lock_registry_mu)
    return slot
}

fn alloc_rw_slot(mu: int64, cv_read: int64, cv_write: int64, writer: int64, write_held: int64, write_gen: int64): int32 {
    init_lock_registry()
    xl_mutex_lock(lock_registry_mu)
    local slot = array_len(rw_mu_cells)
    array_push(rw_mu_cells, mu)
    array_push(rw_cv_read_cells, cv_read)
    array_push(rw_cv_write_cells, cv_write)
    array_push(rw_writer_cells, writer)
    array_push(rw_write_held_cells, write_held)
    array_push(rw_write_gen_cells, write_gen)
    xl_mutex_unlock(lock_registry_mu)
    return slot
}

pending_lock_slot: int32
pending_lock_ms: int32
pending_rw_slot: int32
pending_rw_ms: int32

fn lock_auto_release_global() {
    lock_auto_release_by_slot(pending_lock_slot, pending_lock_ms)
    return 0
}

fn rw_write_auto_release_global() {
    rw_write_auto_release_by_slot(pending_rw_slot, pending_rw_ms)
    return 0
}

fn lock_auto_release_by_slot(slot: int32, timeout_ms: int32) {
    xl_sleep_ms(timeout_ms)
    local gate = array_get(lock_gates, slot)
    local held_ptr = array_get(lock_held_cells, slot)
    if xl_atomic_compare_exchange(held_ptr, 1, 0) == 0 {
        return 0
    }
    xl_mutex_unlock(gate)
    return 0
}

fn rw_write_auto_release_by_slot(slot: int32, timeout_ms: int32) {
    xl_sleep_ms(timeout_ms)
    local rw_mu = array_get(rw_mu_cells, slot)
    local cv_read = array_get(rw_cv_read_cells, slot)
    local writer_ptr = array_get(rw_writer_cells, slot)
    local held_ptr = array_get(rw_write_held_cells, slot)
    if xl_atomic_compare_exchange(held_ptr, 1, 0) == 0 {
        return 0
    }
    xl_mutex_lock(rw_mu)
    xl_atomic_store(writer_ptr, 0)
    xl_cond_broadcast(cv_read)
    xl_mutex_unlock(rw_mu)
    return 0
}

export fn NewLock(): Lock {
    local gate = xl_mutex_init()
    local held = xl_atomic_alloc()
    local generation = xl_atomic_alloc()
    local timeout = xl_atomic_alloc()
    xl_atomic_store(held, 0)
    xl_atomic_store(generation, 0)
    xl_atomic_store(timeout, 0)
    local slot = alloc_lock_slot(gate, held, generation)
    return new Lock {
        gate = gate,
        held = held,
        generation = generation,
        timeout = timeout,
        slot = slot
    }
}

export fn Lock(l: Lock): int32 {
    xl_mutex_lock(l.gate)
    xl_atomic_store(l.held, 1)
    return 1
}

export fn Unlock(l: Lock): int32 {
    if xl_atomic_load(l.held) == 0 {
        return 0
    }
    if xl_atomic_compare_exchange(l.held, 1, 0) == 0 {
        return 0
    }
    xl_atomic_store(l.timeout, 0)
    xl_mutex_unlock(l.gate)
    return 1
}

export fn SetTimeout(l: Lock, ms: int32): int32 {
    if xl_atomic_load(l.held) == 0 {
        return 0
    }
    if ms <= 0 {
        xl_atomic_store(l.timeout, 0)
        return 0
    }
    xl_atomic_store(l.timeout, ms)
    pending_lock_slot = l.slot
    pending_lock_ms = ms
    spawn(lock_auto_release_global())
    return 1
}

export fn IsHeld(l: Lock): int32 {
    if xl_atomic_load(l.held) != 0 {
        return 1
    }
    return 0
}

export fn TryLock(l: Lock): int32 {
    if xl_mutex_trylock(l.gate) == 0 {
        return 0
    }
    xl_atomic_store(l.held, 1)
    return 1
}

export fn NewRWLock(): RWLock {
    local readers = xl_atomic_alloc()
    local writer = xl_atomic_alloc()
    local write_held = xl_atomic_alloc()
    local write_gen = xl_atomic_alloc()
    local read_timeout = xl_atomic_alloc()
    local write_timeout = xl_atomic_alloc()
    xl_atomic_store(readers, 0)
    xl_atomic_store(writer, 0)
    xl_atomic_store(write_held, 0)
    xl_atomic_store(write_gen, 0)
    xl_atomic_store(read_timeout, 0)
    xl_atomic_store(write_timeout, 0)
    local mu = xl_mutex_init()
    local cv_read = xl_cond_init()
    local cv_write = xl_cond_init()
    local slot = alloc_rw_slot(mu, cv_read, cv_write, writer, write_held, write_gen)
    return new RWLock {
        mu = mu,
        cv_read = cv_read,
        cv_write = cv_write,
        readers = readers,
        writer = writer,
        write_held = write_held,
        write_gen = write_gen,
        read_timeout = read_timeout,
        write_timeout = write_timeout,
        slot = slot
    }
}

export fn ReadLock(rw: RWLock): int32 {
    xl_mutex_lock(rw.mu)
    while xl_atomic_load(rw.writer) != 0 {
        xl_cond_wait(rw.cv_read, rw.mu)
    }
    xl_atomic_fetch_add(rw.readers, 1)
    xl_mutex_unlock(rw.mu)
    return 1
}

export fn ReadUnlock(rw: RWLock): int32 {
    xl_mutex_lock(rw.mu)
    local prev = xl_atomic_fetch_add(rw.readers, 0 - 1)
    if prev == 1 {
        xl_cond_signal(rw.cv_write)
    }
    xl_mutex_unlock(rw.mu)
    return 0
}

export fn WriteLock(rw: RWLock): int32 {
    xl_mutex_lock(rw.mu)
    while xl_atomic_load(rw.readers) != 0 || xl_atomic_load(rw.writer) != 0 {
        xl_cond_wait(rw.cv_write, rw.mu)
    }
    xl_atomic_store(rw.writer, 1)
    xl_atomic_store(rw.write_held, 1)
    xl_mutex_unlock(rw.mu)
    return 1
}

export fn WriteUnlock(rw: RWLock): int32 {
    xl_mutex_lock(rw.mu)
    if xl_atomic_load(rw.write_held) == 0 {
        xl_mutex_unlock(rw.mu)
        return 0
    }
    xl_atomic_store(rw.write_held, 0)
    xl_atomic_store(rw.writer, 0)
    xl_atomic_store(rw.write_timeout, 0)
    xl_cond_broadcast(rw.cv_read)
    xl_mutex_unlock(rw.mu)
    return 1
}

export fn WriteIsHeld(rw: RWLock): int32 {
    if xl_atomic_load(rw.write_held) != 0 {
        return 1
    }
    return 0
}

export fn SetWriteTimeout(rw: RWLock, ms: int32): int32 {
    if xl_atomic_load(rw.write_held) == 0 {
        return 0
    }
    if ms <= 0 {
        xl_atomic_store(rw.write_timeout, 0)
        return 0
    }
    xl_atomic_store(rw.write_timeout, ms)
    pending_rw_slot = rw.slot
    pending_rw_ms = ms
    spawn(rw_write_auto_release_global())
    return 1
}

export fn NewAtomicInt(initial: int64): AtomicInt {
    local cell = xl_atomic_alloc()
    xl_atomic_store(cell, initial)
    return new AtomicInt { cell = cell }
}

export fn Load(a: AtomicInt): int64 {
    return xl_atomic_load(a.cell)
}

export fn Store(a: AtomicInt, val: int64): int32 {
    return xl_atomic_store(a.cell, val)
}

export fn FetchAdd(a: AtomicInt, delta: int64): int64 {
    return xl_atomic_fetch_add(a.cell, delta)
}

export fn CompareExchange(a: AtomicInt, expected: int64, desired: int64): int32 {
    return xl_atomic_compare_exchange(a.cell, expected, desired)
}

export fn NewAtomicBool(initial: int32): AtomicBool {
    local cell = xl_atomic_alloc()
    if initial != 0 {
        xl_atomic_store(cell, 1)
    } else {
        xl_atomic_store(cell, 0)
    }
    return new AtomicBool { cell = cell }
}

export fn Load(a: AtomicBool): int32 {
    if xl_atomic_load(a.cell) != 0 {
        return 1
    }
    return 0
}

export fn Store(a: AtomicBool, val: int32): int32 {
    if val != 0 {
        return xl_atomic_store(a.cell, 1)
    }
    return xl_atomic_store(a.cell, 0)
}
