// Go-routine benzeri scheduler — tüm mantık xlang içinde.
// Bridge declares: xl_cpu_count, mutex_*, cond_*, xl_thread_start.

struct SpawnTask {
    entry: int64
}

declare xl_cpu_count(): int32
declare xl_mutex_init(): int64
declare xl_mutex_lock(m: int64): int32
declare xl_mutex_unlock(m: int64): int32
declare xl_cond_init(): int64
declare xl_cond_wait(c: int64, m: int64): int32
declare xl_cond_signal(c: int64): int32
declare xl_cond_broadcast(c: int64): int32
declare xl_thread_start(entry: int64, arg: int32): int64

spawn_queue: array SpawnTask
queue_mu: int64
queue_cv_work: int64
queue_cv_done: int64
inflight: int32 = 0
initialized: int32 = 0
worker_total: int32 = 0

fn init_scheduler() {
    if initialized != 0 {
        return 0
    }
    queue_mu = xl_mutex_init()
    queue_cv_work = xl_cond_init()
    queue_cv_done = xl_cond_init()
    spawn_queue = new array SpawnTask
    local cpus = xl_cpu_count()
    local workers = cpus - 1
    if workers < 1 {
        workers = 1
    }
    local i = 0
    while i < workers {
        xl_thread_start(worker_loop, i)
        worker_total = worker_total + 1
        i = i + 1
    }
    initialized = 1
    return 0
}

fn worker_loop(worker_id: int32) {
    while true {
        xl_mutex_lock(queue_mu)
        while array_len(spawn_queue) == 0 {
            xl_cond_wait(queue_cv_work, queue_mu)
        }
        local task = array_pop_front(spawn_queue)
        inflight = inflight + 1
        xl_mutex_unlock(queue_mu)
        invoke0(task.entry)
        xl_mutex_lock(queue_mu)
        inflight = inflight - 1
        if array_len(spawn_queue) == 0 {
            if inflight == 0 {
                xl_cond_broadcast(queue_cv_done)
            }
        }
        xl_mutex_unlock(queue_mu)
    }
    return 0
}

export fn spawn(entry: int64) {
    init_scheduler()
    local task: SpawnTask = new SpawnTask { entry = entry }
    xl_mutex_lock(queue_mu)
    array_push(spawn_queue, task)
    xl_cond_signal(queue_cv_work)
    xl_mutex_unlock(queue_mu)
    return 0
}

export fn wait_all() {
    init_scheduler()
    xl_mutex_lock(queue_mu)
    while array_len(spawn_queue) != 0 || inflight != 0 {
        xl_cond_wait(queue_cv_done, queue_mu)
    }
    xl_mutex_unlock(queue_mu)
    return 0
}

export fn add_worker() {
    init_scheduler()
    xl_thread_start(worker_loop, worker_total)
    worker_total = worker_total + 1
    return 0
}

export fn cpu() {
    return xl_cpu_count()
}
