// Low-level process / IO bridges (Go os/exec + Node child_process benzeri).
//   import process from process
//   local pid = process.fork()
//
// Bridge ABI: xl_<object>_<action> — linked from OS process bridge.

declare xl_env_get(key: string): string
declare xl_env_set(key: string, value: string): int32
declare xl_cwd_get(): string
declare xl_chdir(path: string): int32

declare xl_proc_fork(): int32
declare xl_proc_exec(path: string, args: string): int32
declare xl_proc_wait(pid: int32): int32
declare xl_proc_exit(code: int32): int32
declare xl_proc_kill(pid: int32, signal: int32): int32

declare xl_pipe_create(): int64
declare xl_pipe_read_fd(h: int64): int32
declare xl_pipe_write_fd(h: int64): int32
declare xl_fd_close(fd: int32): int32
declare xl_fd_read(fd: int32, max: int32): string
declare xl_fd_write(fd: int32, data: string): int32
declare xl_fd_dup2(old_fd: int32, new_fd: int32): int32

declare xl_run_capture(path: string, args: string): int32
declare xl_capture_stdout(): string
