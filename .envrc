# direnv (macOS only): inside this repo `xl` is this project's outputs/xlang, ahead of any global `xl`.
# The symlink follows rebuilds, so `xmake build` is enough to update it.
if [ "$(uname -s)" = "Darwin" ]; then
    mkdir -p .direnv/bin
    ln -sfn "$PWD/outputs/xlang" .direnv/bin/xl
    PATH_add .direnv/bin
fi
