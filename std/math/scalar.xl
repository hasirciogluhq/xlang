// std/math/scalar: scalar helpers shared by the vector, rectangle and matrix types. Nothing here knows about a
// vector or a matrix, so `vec2`/`vec3`/`vec4`/`rect` import this module and this module imports none of them
// (one-way edge, no import cycle).
//   lerp, smoothstep: the standard graphics/UI interpolations. smoothstep is the Hermite basis
//   3t^2 - 2t^3 (https://registry.khronos.org/OpenGL-Refpages/gl4/html/smoothstep.xhtml), whose first
//   derivative is zero at both ends, so a value that is stitched in with it leaves the piecewise function C1.
//   mapRange: one linear map; degToRad/radToDeg are the 180/pi factors (SI: one turn is 2*pi rad).

/// Pi to double precision: the double nearest to the exact value (3.141592653589793, FDLIBM's `pi`).
export define MATH_PI = 3.141592653589793

/// Pi/2, one quarter turn.
export define MATH_PI_2 = 1.5707963267948966

/// 2*pi, one turn in radians.
export define MATH_TAU = 6.283185307179586

/// The linear interpolation a + (b - a) t. `t` is not clamped, so an extrapolation (t outside [0, 1]) works, and
/// t = 0 gives exactly `a` and t = 1 exactly `b` because the second term is zero at both ends.
export fn lerp(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}

/// Hermite smoothstep between the edges e0 and e1: 0 at or below e0, 1 at or above e1, and 3t^2 - 2t^3 in
/// between, which is monotone and flat at both ends. e0 == e1 is a step at that edge (t is 0 or 1).
export fn smoothstep(e0: f64, e1: f64, x: f64) -> f64 {
    local t: f64 = (x - e0) / (e1 - e0)
    if t < 0.0 { t = 0.0 }
    if t > 1.0 { t = 1.0 }
    return t * t * (3.0 - 2.0 * t)
}

/// Maps x from [inLo, inHi] linearly onto [outLo, outHi]. The map is affine, so x outside the input range is
/// extrapolated rather than clamped. Panics when inLo equals inHi: that range holds no direction.
export fn mapRange(x: f64, inLo: f64, inHi: f64, outLo: f64, outHi: f64) -> f64 {
    if inLo == inHi { panic("mapRange: the input range is empty") }
    return outLo + (x - inLo) * (outHi - outLo) / (inHi - inLo)
}

/// `x` limited to [lo, hi]. Panics on a NaN bound or when lo > hi, which has no answer.
export fn clamp(x: f64, lo: f64, hi: f64) -> f64 {
    if !(lo <= hi) { panic("clamp: lo is above hi") }
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

/// Degrees to radians: deg * pi / 180.
export fn degToRad(deg: f64) -> f64 {
    return deg * MATH_PI / 180.0
}

/// Radians to degrees: rad * 180 / pi.
export fn radToDeg(rad: f64) -> f64 {
    return rad * 180.0 / MATH_PI
}
