// std/math/transform: the rigid-plus-scale placement `Transform` (position, rotation, scale) as a value class whose
//   fields are themselves value classes (`Vec3`, `Quat`): no pointer, no heap, no allocation.
//   A class may hold another class by value as long as neither needs a drop, and Vec3/Quat are plain f64 bags, so the
//   three fields are stored, copied and returned directly instead of being unpacked into twelve loose f64 fields.
//   The order of the operations is the one of every scene graph (three.js `Object3D`, OpenGL's TRS): a point is first
//   scaled, then rotated, then translated, so the matrix is M = T * R * S and the local axes are the columns of R.
//   `compose(parent, out)` gives the same placement as parent * self, so a child transform is applied first and a
//   parent's afterwards (self is the local placement, `parent` the world placement of its parent).
//   `toMat4` is the standard affine matrix of that TRS product
//   (https://en.wikipedia.org/wiki/Transformation_matrix#Affine_transformations).
//   No static fn in the language, so `transformIdentity()` is a free function.
from "scalar" import approxEqual
from "vec3" import Vec3
from "quaternion" import Quat, quatIdentity
from "matrix3" import Mat3
from "matrix4" import Mat4

define TRANSFORM_EPS = 0.000000001

/// A placement: scale, then rotation, then position. `Transform()` is the identity placement.
export class Transform {
    position: Vec3
    rotation: Quat
    scale: Vec3

    /// The identity placement: origin, no rotation, scale 1.
    fn init(self) {
        self.position = Vec3(0.0, 0.0, 0.0)
        self.rotation = Quat()
        self.scale = Vec3(1.0, 1.0, 1.0)
    }

    /// The placement at `p` with no rotation and scale 1.
    fn init(self, p: *Vec3) {
        self.position = Vec3(p.x, p.y, p.z)
        self.rotation = Quat()
        self.scale = Vec3(1.0, 1.0, 1.0)
    }

    /// The placement of the three parts, in the order they are applied to a point.
    fn init(self, p: *Vec3, q: *Quat, s: *Vec3) {
        self.position = Vec3(p.x, p.y, p.z)
        self.rotation = Quat(q.w, q.x, q.y, q.z)
        self.scale = Vec3(s.x, s.y, s.z)
    }

    /// The affine matrix M = T * R * S: the 3x3 block is R with each column multiplied by the matching scale, the
    /// last column is the position and the last row is (0, 0, 0, 1).
    fn toMat4(self) -> Mat4 {
        local r: Mat3 = self.rotation.toMat3()
        local sx: f64 = self.scale.x
        local sy: f64 = self.scale.y
        local sz: f64 = self.scale.z
        return Mat4(r.m[0] * sx, r.m[1] * sy, r.m[2] * sz, self.position.x,
                    r.m[3] * sx, r.m[4] * sy, r.m[5] * sz, self.position.y,
                    r.m[6] * sx, r.m[7] * sy, r.m[8] * sz, self.position.z,
                    0.0, 0.0, 0.0, 1.0)
    }

    /// Writes the placed point into `out`: rotation of (p * scale), then plus position. The scale is componentwise,
    /// so a non-uniform scale is not a similarity and is applied before the rotation, as in a TRS matrix.
    fn applyPoint(self, p: *Vec3, out: *Vec3) {
        local scaled: Vec3 = Vec3(p.x * self.scale.x, p.y * self.scale.y, p.z * self.scale.z)
        local rotated: Vec3 = Vec3(0.0, 0.0, 0.0)
        self.rotation.rotateVec(&scaled, &rotated)
        out.x = rotated.x + self.position.x
        out.y = rotated.y + self.position.y
        out.z = rotated.z + self.position.z
    }

    /// Writes the placed direction into `out`: the rotation of (v * scale) with no translation. A direction is not a
    /// point, so the position does not apply; the scale does, because a direction is stretched by the same linear map.
    fn applyVector(self, v: *Vec3, out: *Vec3) {
        local scaled: Vec3 = Vec3(v.x * self.scale.x, v.y * self.scale.y, v.z * self.scale.z)
        self.rotation.rotateVec(&scaled, out)
    }

    /// Writes the inverse placement into `out` and returns true; returns false and leaves `out` untouched when a scale
    /// component is zero. The inverse of T * R * S is S^-1 * R^-1 * T^-1, so the position is the un-rotated,
    /// un-scaled negative translation and the scale is the reciprocal of each component.
    fn inverse(self, out: *Transform) -> bool {
        if self.scale.x == 0.0 || self.scale.y == 0.0 || self.scale.z == 0.0 {
            return false
        }
        local neg: Vec3 = Vec3(0.0 - self.position.x, 0.0 - self.position.y, 0.0 - self.position.z)
        local invPos: Vec3 = Vec3(0.0, 0.0, 0.0)
        self.rotation.rotateVec(&neg, &invPos)
        // Every field of `out` is assigned a whole value computed in a local first: a field assignment that reads
        // another field of the same object (`out.position = ..(.. out.scale.x ..)`) or writes two fields in one
        // statement computes the wrong value in the current code generator, and whole-value locals are correct on
        // every backend. `out` may also be `self`, which the locals make safe.
        local sx: f64 = self.scale.x
        local sy: f64 = self.scale.y
        local sz: f64 = self.scale.z
        local newPos: Vec3 = Vec3(invPos.x / sx, invPos.y / sy, invPos.z / sz)
        local iw: f64 = self.rotation.w
        local ix: f64 = self.rotation.x
        local iy: f64 = self.rotation.y
        local iz: f64 = self.rotation.z
        local newRot: Quat = Quat(iw, 0.0 - ix, 0.0 - iy, 0.0 - iz)
        local newScale: Vec3 = Vec3(1.0 / sx, 1.0 / sy, 1.0 / sz)
        out.position = newPos
        out.rotation = newRot
        out.scale = newScale
        return true
    }

    /// Writes the combination parent * self into `out`: `self` is applied first, then `parent`. The position composes
    /// as parent.applyPoint(self.position), the rotations multiply as q_parent * q_self and the scales multiply
    /// componentwise. This is exact only when the parent has a uniform scale or the child carries no rotation: a
    /// non-uniform parent scale shears a rotated child, which a TRS triple cannot represent, and the componentwise
    /// product is then the approximation every TRS-based engine makes. `out` may alias `parent`.
    fn compose(self, parent: *Transform, out: *Transform) {
        local worldPos: Vec3 = Vec3(0.0, 0.0, 0.0)
        parent.applyPoint(&self.position, &worldPos)
        local worldRot: Quat = parent.rotation.mul(&self.rotation)
        local worldScale: Vec3 = Vec3(parent.scale.x * self.scale.x,
                                      parent.scale.y * self.scale.y,
                                      parent.scale.z * self.scale.z)
        out.position = worldPos
        out.rotation = worldRot
        out.scale = worldScale
    }

    /// Moves the position by (dx, dy, dz), in the parent frame (not the local, rotated frame).
    fn translate(self, dx: f64, dy: f64, dz: f64) {
        self.position = Vec3(self.position.x + dx, self.position.y + dy, self.position.z + dz)
    }

    /// Rotates the placement by `q`: the rotation is applied in the world (parent) frame, so the new rotation is
    /// q * self.rotation and the position does not move. Left-multiplying is the choice an "orbit around a pivot"
    /// or a "turn the whole object" operation makes; a rotation about its own local axis is
    /// `self.rotation * q`, which a caller does by assigning `self.rotation` directly.
    fn rotate(self, q: *Quat) {
        self.rotation = q.mul(&self.rotation)
    }

    /// Componentwise equality within `eps` in absolute value: position and scale componentwise, the rotation as a
    /// quaternion (so q and -q, the same rotation, compare unequal here; see `Quat.near`).
    fn near(self, o: *Transform, eps: f64) -> bool {
        return self.position.near(&o.position, eps) && self.rotation.near(&o.rotation, eps) &&
               self.scale.near(&o.scale, eps)
    }

    /// `near` with the module default of 1e-9.
    fn nearDefault(self, o: *Transform) -> bool {
        return self.near(o, TRANSFORM_EPS)
    }
}

// ---- free constructor (no static fn in the language) ---------------------------------------

/// The identity placement: origin, no rotation, scale 1.
export fn transformIdentity() -> Transform {
    return Transform()
}
