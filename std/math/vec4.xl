// std/math/vec4: the homogeneous 4D vector `Vec4` as a value class: four f64 fields and methods, no pointer, no heap.
//   A Vec4 is (x, y, z, w), the homogeneous form of a 3D point or direction: with w = 1 it transforms as a point
//   under an affine 4x4 matrix, with w = 0 as a direction (the translation column is then ignored), which is the
//   convention of OpenGL's matrix stack (https://registry.khronos.org/OpenGL-Refpages/gl2.1/xhtml/glMultMatrix.xml).
//   Only the operations that are meaningful in 4D are here: the fourth component has no cross product.
from "math" import sqrt
from "scalar" import lerp
from "vec3" import Vec3

define VEC4_EPS = 0.000000001

/// An (x, y, z, w) vector. `Vec4(a, b, c, d)` builds it.
export class Vec4 {
    x: f64
    y: f64
    z: f64
    w: f64

    fn init(self, x: f64, y: f64, z: f64, w: f64) {
        self.x = x
        self.y = y
        self.z = z
        self.w = w
    }

    fn add(self, o: *Vec4) -> Vec4 {
        return Vec4(self.x + o.x, self.y + o.y, self.z + o.z, self.w + o.w)
    }

    fn sub(self, o: *Vec4) -> Vec4 {
        return Vec4(self.x - o.x, self.y - o.y, self.z - o.z, self.w - o.w)
    }

    fn scale(self, k: f64) -> Vec4 {
        return Vec4(self.x * k, self.y * k, self.z * k, self.w * k)
    }

    fn negate(self) -> Vec4 {
        return Vec4(0.0 - self.x, 0.0 - self.y, 0.0 - self.z, 0.0 - self.w)
    }

    fn dot(self, o: *Vec4) -> f64 {
        return self.x * o.x + self.y * o.y + self.z * o.z + self.w * o.w
    }

    fn lengthSquared(self) -> f64 {
        return self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w
    }

    fn length(self) -> f64 {
        return sqrt(self.lengthSquared())
    }

    /// The unit vector in the direction of self; the zero vector for the zero vector.
    fn normalized(self) -> Vec4 {
        local l: f64 = self.length()
        if l == 0.0 {
            return Vec4(0.0, 0.0, 0.0, 0.0)
        }
        return Vec4(self.x / l, self.y / l, self.z / l, self.w / l)
    }

    fn distance(self, o: *Vec4) -> f64 {
        local dx: f64 = self.x - o.x
        local dy: f64 = self.y - o.y
        local dz: f64 = self.z - o.z
        local dw: f64 = self.w - o.w
        return sqrt(dx * dx + dy * dy + dz * dz + dw * dw)
    }

    fn lerp(self, o: *Vec4, t: f64) -> Vec4 {
        return Vec4(lerp(self.x, o.x, t), lerp(self.y, o.y, t), lerp(self.z, o.z, t), lerp(self.w, o.w, t))
    }

    /// The first three components as a direction; the w component is dropped.
    fn xyz(self) -> Vec3 {
        return Vec3(self.x, self.y, self.z)
    }

    fn equals(self, o: *Vec4) -> bool {
        return self.x == o.x && self.y == o.y && self.z == o.z && self.w == o.w
    }

    fn near(self, o: *Vec4, eps: f64) -> bool {
        local dx: f64 = self.x - o.x
        if dx < 0.0 { dx = 0.0 - dx }
        local dy: f64 = self.y - o.y
        if dy < 0.0 { dy = 0.0 - dy }
        local dz: f64 = self.z - o.z
        if dz < 0.0 { dz = 0.0 - dz }
        local dw: f64 = self.w - o.w
        if dw < 0.0 { dw = 0.0 - dw }
        return dx <= eps && dy <= eps && dz <= eps && dw <= eps
    }

    fn nearDefault(self, o: *Vec4) -> bool {
        return self.near(o, VEC4_EPS)
    }
}
