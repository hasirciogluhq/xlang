// std/math/quaternion: the unit-quaternion rotation class `Quat` (w, x, y, z) as a value class: four f64 fields,
//   no pointer, no heap. No angle is ever stored, so composing rotations is one Hamilton product (16 multiply-adds)
//   instead of a matrix product, and slerp is well defined between any two orientations.
//   Field order is (w, x, y, z), the scalar part first, the convention of Hamilton
//   (https://en.wikipedia.org/wiki/Quaternion#Hamilton_product) and of the quaternion-to-matrix formula used here.
//   The product is Hamilton's: (w1 w2 - v1.v2, w1 v2 + w2 v1 + v1 x v2), where v is the vector part (x, y, z); `mul`
//   therefore applies `o` after self, the same order as a matrix product self * o.
//   The rotation formula is q v q*, the conjugation of a pure quaternion (0, v) by q, given in closed form in
//   `rotateVec` (https://en.wikipedia.org/wiki/Quaternions_and_spatial_rotation, section "Using quaternions as
//   rotations"). Both give the same matrix as `quatToMat3`.
//   slerp is Shoemake's spherical interpolation
//   (Shoemake, "Animating rotation with quaternion curves", SIGGRAPH 1985, https://doi.org/10.1145/325165.325242):
//   linear in the angle, on the shortest of the two arcs.
//   No static fn in the language, so the named constructors are free functions (`quatIdentity`,
//   `quatFromAxisAngle`, `quatFromEuler`, ...).
from "scalar" import approxEqual
from "math" import sqrt
from "trig" import sin, cos, atan2, acos, asin
from "float" import fabs
from "vec3" import Vec3
from "matrix3" import Mat3

define QUAT_EPS = 0.000000001

/// A quaternion w + xi + yj + zk. A unit quaternion is a rotation; `Quat()` is the identity rotation.
export class Quat {
    w: f64
    x: f64
    y: f64
    z: f64

    /// The identity quaternion (1, 0, 0, 0): no rotation.
    fn init(self) {
        self.w = 1.0
        self.x = 0.0
        self.y = 0.0
        self.z = 0.0
    }

    /// The quaternion (w, x, y, z) as is. A rotation needs a unit quaternion, so `quatFromAxisAngle` or
    /// `normalized()` is the usual way to build one.
    fn init(self, w: f64, x: f64, y: f64, z: f64) {
        self.w = w
        self.x = x
        self.y = y
        self.z = z
    }

    /// self + o, componentwise (the quaternions form a vector space over the reals).
    fn add(self, o: *Quat) -> Quat {
        return Quat(self.w + o.w, self.x + o.x, self.y + o.y, self.z + o.z)
    }

    /// self - o, componentwise.
    fn sub(self, o: *Quat) -> Quat {
        return Quat(self.w - o.w, self.x - o.x, self.y - o.y, self.z - o.z)
    }

    /// Every component times the scalar k.
    fn scale(self, k: f64) -> Quat {
        return Quat(self.w * k, self.x * k, self.y * k, self.z * k)
    }

    /// The Hamilton product self * o: the rotation self followed by o. Non-commutative, so the order matters.
    fn mul(self, o: *Quat) -> Quat {
        local out: Quat = Quat()
        self.mulTo(o, &out)
        return out
    }

    /// Writes the Hamilton product self * o into `out`. `out` may alias an argument: every component is read into a
    /// local before the write.
    fn mulTo(self, o: *Quat, out: *Quat) {
        local w1: f64 = self.w
        local x1: f64 = self.x
        local y1: f64 = self.y
        local z1: f64 = self.z
        local w2: f64 = o.w
        local x2: f64 = o.x
        local y2: f64 = o.y
        local z2: f64 = o.z
        out.w = w1 * w2 - x1 * x2 - y1 * y2 - z1 * z2
        out.x = w1 * x2 + x1 * w2 + y1 * z2 - z1 * y2
        out.y = w1 * y2 - x1 * z2 + y1 * w2 + z1 * x2
        out.z = w1 * z2 + x1 * y2 - y1 * x2 + z1 * w2
    }

    /// The conjugate (w, -x, -y, -z). For a unit quaternion it is the inverse rotation.
    fn conjugate(self) -> Quat {
        return Quat(self.w, 0.0 - self.x, 0.0 - self.y, 0.0 - self.z)
    }

    /// The multiplicative inverse conjugate / |q|^2. The zero quaternion has none, so it returns the zero quaternion
    /// rather than an infinity (the same choice `Vec3.normalized` makes for the zero vector).
    fn inverse(self) -> Quat {
        local n: f64 = self.lengthSquared()
        if n == 0.0 {
            return Quat(0.0, 0.0, 0.0, 0.0)
        }
        local k: f64 = 1.0 / n
        return Quat(self.w * k, (0.0 - self.x) * k, (0.0 - self.y) * k, (0.0 - self.z) * k)
    }

    /// The squared norm w^2 + x^2 + y^2 + z^2 (the quaternion conjugate times itself); no square root.
    fn lengthSquared(self) -> f64 {
        return self.w * self.w + self.x * self.x + self.y * self.y + self.z * self.z
    }

    /// The norm |q| = sqrt(w^2 + x^2 + y^2 + z^2). A rotation quaternion has norm 1.
    fn length(self) -> f64 {
        return sqrt(self.lengthSquared())
    }

    /// The unit quaternion in the same direction. The zero quaternion has no direction; it returns the identity
    /// rather than a NaN, so a caller that normalizes a degenerate value still gets a usable rotation.
    fn normalized(self) -> Quat {
        local l: f64 = self.length()
        if l == 0.0 {
            return Quat()
        }
        return Quat(self.w / l, self.x / l, self.y / l, self.z / l)
    }

    /// The inner product w1 w2 + x1 x2 + y1 y2 + z1 z2, the cosine of the angle between the two rotations when both
    /// are unit quaternions (the scalar part of self * conjugate(o)).
    fn dot(self, o: *Quat) -> f64 {
        return self.w * o.w + self.x * o.x + self.y * o.y + self.z * o.z
    }

    /// Writes the rotation of the vector `v` by this (unit) quaternion into `out`: the vector part of q (0, v) q*.
    /// The expanded form 2 (dot(u, v) u + (w^2 - dot(u, u)) v + 2 w (u x v)) with u = (x, y, z) needs no temporary
    /// quaternion (https://en.wikipedia.org/wiki/Quaternions_and_spatial_rotation).
    fn rotateVec(self, v: *Vec3, out: *Vec3) {
        local w: f64 = self.w
        local ux: f64 = self.x
        local uy: f64 = self.y
        local uz: f64 = self.z
        local dotUV: f64 = ux * v.x + uy * v.y + uz * v.z
        local dotUU: f64 = ux * ux + uy * uy + uz * uz
        local k: f64 = 2.0 * dotUV
        local k2: f64 = 2.0 * w
        // u x v, the vector part of the cross term.
        local cx: f64 = uy * v.z - uz * v.y
        local cy: f64 = uz * v.x - ux * v.z
        local cz: f64 = ux * v.y - uy * v.x
        local s: f64 = w * w - dotUU
        out.x = k * ux + s * v.x + k2 * cx
        out.y = k * uy + s * v.y + k2 * cy
        out.z = k * uz + s * v.z + k2 * cz
    }

    /// Spherical linear interpolation from self (t = 0) to `b` (t = 1) along the arc of length |angle|. When the two
    /// quaternions lie in opposite hemispheres (dot < 0) `b` is negated first: q and -q are the same rotation, so
    /// taking the shorter arc is what the caller means
    /// (Shoemake 1985, https://doi.org/10.1145/325165.325242). A dot close to 1 (within 1e-9 of the parallel case)
    /// falls back to the linear interpolation, because sin(theta) goes to zero and the formula divides by it.
    fn slerp(self, b: *Quat, t: f64) -> Quat {
        local a: Quat = self.normalized()
        local c: Quat = b.normalized()
        local d: f64 = a.dot(&c)
        if d < 0.0 {
            // The components are read into locals before the constructor call: an inlined nested constructor that
            // reads a field of the value being replaced computes the wrong value in the current code generator
            // (`Quat(0.0 - c.w, ...)` assigned to `c`), and this form is correct on every backend.
            local nw: f64 = 0.0 - c.w
            local nx: f64 = 0.0 - c.x
            local ny: f64 = 0.0 - c.y
            local nz: f64 = 0.0 - c.z
            c = Quat(nw, nx, ny, nz)
            d = 0.0 - d
        }
        if d > 0.999999999 {
            local lin: Quat = Quat(a.w + (c.w - a.w) * t, a.x + (c.x - a.x) * t,
                                   a.y + (c.y - a.y) * t, a.z + (c.z - a.z) * t)
            return lin.normalized()
        }
        local theta: f64 = acos(d)
        local st: f64 = sin(theta)
        local ka: f64 = sin((1.0 - t) * theta) / st
        local kb: f64 = sin(t * theta) / st
        return Quat(a.w * ka + c.w * kb, a.x * ka + c.x * kb, a.y * ka + c.y * kb, a.z * ka + c.z * kb)
    }

    /// The rotation matrix of this unit quaternion. The closed form with 1 - 2(y^2 + z^2) on the diagonal is used
    /// because it needs no scalar multiplication per entry and stays orthogonal for a unit q
    /// (https://en.wikipedia.org/wiki/Rotation_matrix#Quaternion, "Quaternion to rotation matrix").
    fn toMat3(self) -> Mat3 {
        local w: f64 = self.w
        local x: f64 = self.x
        local y: f64 = self.y
        local z: f64 = self.z
        local xx: f64 = x * x
        local yy: f64 = y * y
        local zz: f64 = z * z
        local xy: f64 = x * y
        local xz: f64 = x * z
        local yz: f64 = y * z
        local wx: f64 = w * x
        local wy: f64 = w * y
        local wz: f64 = w * z
        return Mat3(1.0 - 2.0 * (yy + zz), 2.0 * (xy - wz), 2.0 * (xz + wy),
                    2.0 * (xy + wz), 1.0 - 2.0 * (xx + zz), 2.0 * (yz - wx),
                    2.0 * (xz - wy), 2.0 * (yz + wx), 1.0 - 2.0 * (xx + yy))
    }

    /// Componentwise equality within `eps` in absolute value. A quaternion and its negation are the same rotation,
    /// so a rotation comparison checks both (`near` of q and `near` of -q).
    fn near(self, o: *Quat, eps: f64) -> bool {
        return approxEqual(self.w, o.w, eps) && approxEqual(self.x, o.x, eps) &&
               approxEqual(self.y, o.y, eps) && approxEqual(self.z, o.z, eps)
    }

    /// `near` with the module default of 1e-9.
    fn nearDefault(self, o: *Quat) -> bool {
        return self.near(o, QUAT_EPS)
    }

    /// True when this quaternion is the identity rotation (within `eps`).
    fn isIdentity(self, eps: f64) -> bool {
        return approxEqual(self.w, 1.0, eps) && approxEqual(self.x, 0.0, eps) &&
               approxEqual(self.y, 0.0, eps) && approxEqual(self.z, 0.0, eps)
    }
}

// ---- free constructors (no static fn in the language) --------------------------------------

/// The identity rotation (1, 0, 0, 0).
export fn quatIdentity() -> Quat {
    return Quat()
}

/// The rotation by `rad` about `axis`: (cos(rad/2), sin(rad/2) * u) for the unit axis u. The half angle comes from
/// the fact that q v q* turns v by 2 * the angle in the (cos, sin) pair
/// (https://en.wikipedia.org/wiki/Quaternions_and_spatial_rotation). A non-unit axis is normalized; the zero axis
/// has no direction and gives the identity.
export fn quatFromAxisAngle(axis: *Vec3, rad: f64) -> Quat {
    local u: Vec3 = axis.normalized()
    if u.x == 0.0 && u.y == 0.0 && u.z == 0.0 {
        return Quat()
    }
    local h: f64 = rad * 0.5
    local s: f64 = sin(h)
    return Quat(cos(h), u.x * s, u.y * s, u.z * s)
}

/// The quaternion of the intrinsic ZYX Euler angles: R = Rz(z) * Ry(y) * Rx(x), that is x about the x axis first,
/// then y about the new y axis, then z about the new z axis. This is the aerospace "yaw-pitch-roll" order used by
/// three.js `Euler` with order 'XYZ' and by `glm::eulerAngleZYX`, and the half-angle products are the standard ones
/// of https://en.wikipedia.org/wiki/Conversion_between_quaternions_and_Euler_angles (section "Euler angles (or
/// Tait-Bryan angles)", the last table row, yaw-pitch-roll). `quatToEuler` inverts exactly this order.
export fn quatFromEuler(x: f64, y: f64, z: f64) -> Quat {
    local hx: f64 = x * 0.5
    local hy: f64 = y * 0.5
    local hz: f64 = z * 0.5
    local cx: f64 = cos(hx)
    local sx: f64 = sin(hx)
    local cy: f64 = cos(hy)
    local sy: f64 = sin(hy)
    local cz: f64 = cos(hz)
    local sz: f64 = sin(hz)
    return Quat(cz * cy * cx + sz * sy * sx,
                cz * cy * sx - sz * sy * cx,
                cz * sy * cx + sz * cy * sx,
                sz * cy * cx - cz * sy * sx)
}

/// The intrinsic ZYX Euler angles (x, y, z) of this rotation, the inverse of `quatFromEuler`. With
/// sy = 2(w y - z x) clamped to [-1, 1]:
///   y = asin(2(w y - z x)), x = atan2(2(w x + y z), 1 - 2(x^2 + y^2)),
///   z = atan2(2(w z + x y), 1 - 2(y^2 + z^2))
/// (https://en.wikipedia.org/wiki/Conversion_between_quaternions_and_Euler_angles). At gimbal lock (y = +-90
/// degrees) x and z are not separable; this returns z = 0 and puts the whole turn into x, which is one of the valid
/// answers.
export fn quatToEuler(q: *Quat) -> Vec3 {
    local w: f64 = q.w
    local x: f64 = q.x
    local y: f64 = q.y
    local z: f64 = q.z
    local sy: f64 = 2.0 * (w * y - z * x)
    if sy > 1.0 { sy = 1.0 }
    if sy < 0.0 - 1.0 { sy = 0.0 - 1.0 }
    local ey: f64 = asin(sy)
    local ex: f64 = atan2(2.0 * (w * x + y * z), 1.0 - 2.0 * (x * x + y * y))
    local ez: f64 = atan2(2.0 * (w * z + x * y), 1.0 - 2.0 * (y * y + z * z))
    if fabs(sy) > 0.999999999 {
        // Gimbal lock: only x -+ z is defined; the shepperd form below keeps the sum (or difference) in x.
        ex = 2.0 * atan2(x, w)
        ez = 0.0
    }
    return Vec3(ex, ey, ez)
}

/// The unit quaternion of a pure rotation matrix, by Shepperd's method: the largest of (w, x, y, z) is computed from
/// the square root of the corresponding diagonal combination and the other three follow from the off-diagonal sums,
/// which is numerically stable for every rotation, including a 180 degree turn where the trace is -1
/// (https://en.wikipedia.org/wiki/Rotation_matrix#Quaternion; Shepperd, "Quaternion from rotation matrix", J.
/// Guidance and Control 1978). `m` must be a rotation (orthonormal, det 1); a scaled matrix is not rejected.
export fn quatFromMat3(m: *Mat3) -> Quat {
    local m00: f64 = m.m[0]
    local m01: f64 = m.m[1]
    local m02: f64 = m.m[2]
    local m10: f64 = m.m[3]
    local m11: f64 = m.m[4]
    local m12: f64 = m.m[5]
    local m20: f64 = m.m[6]
    local m21: f64 = m.m[7]
    local m22: f64 = m.m[8]
    local tr: f64 = m00 + m11 + m22
    if tr > 0.0 {
        local s: f64 = sqrt(tr + 1.0) * 2.0
        return Quat(0.25 * s, (m21 - m12) / s, (m02 - m20) / s, (m10 - m01) / s)
    }
    if m00 > m11 && m00 > m22 {
        local s: f64 = sqrt(1.0 + m00 - m11 - m22) * 2.0
        return Quat((m21 - m12) / s, 0.25 * s, (m01 + m10) / s, (m02 + m20) / s)
    }
    if m11 > m22 {
        local s: f64 = sqrt(1.0 + m11 - m00 - m22) * 2.0
        return Quat((m02 - m20) / s, (m01 + m10) / s, 0.25 * s, (m12 + m21) / s)
    }
    local s: f64 = sqrt(1.0 + m22 - m00 - m11) * 2.0
    return Quat((m10 - m01) / s, (m02 + m20) / s, (m12 + m21) / s, 0.25 * s)
}

/// The rotation that looks along `forward` with `up` as the up reference, as a quaternion: the same orientation
/// `mat4LookAt` builds, with the camera's -z along `forward` and its +y as close to `up` as possible. Panics when
/// `forward` is zero or `up` is parallel to it, since no orientation exists then.
export fn quatLookRotation(forward: *Vec3, up: *Vec3) -> Quat {
    local f: Vec3 = forward.normalized()
    if f.x == 0.0 && f.y == 0.0 && f.z == 0.0 {
        panic("quatLookRotation: forward is the zero vector")
    }
    local right: Vec3 = f.cross(up)
    right = right.normalized()
    if right.x == 0.0 && right.y == 0.0 && right.z == 0.0 {
        panic("quatLookRotation: up is parallel to forward")
    }
    local u: Vec3 = right.cross(&f)
    // Columns of the rotation: (right, u, -forward), the camera axes expressed in world space.
    local m: Mat3 = Mat3(right.x, u.x, 0.0 - f.x,
                         right.y, u.y, 0.0 - f.y,
                         right.z, u.z, 0.0 - f.z)
    return quatFromMat3(&m)
}
