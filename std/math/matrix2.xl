// std/math/matrix2: the fixed 2x2 matrix `Mat2` as a value class: four f64 entries, no pointer, no heap.
//   Storage is one fixed array `m: [f64; 4]` in row-major order, entry (i, j) at `m[i * 2 + j]`. Row-major is chosen
//   so that `m[0], m[1], m[2], m[3]` read like the written matrix, the same layout as the dynamic `Mat`
//   (std/math/matrix) and as the C and GLSL conventions where the matrix is written as rows
//   (https://registry.khronos.org/OpenGL/specs/gl/GLSLangSpec.4.60.pdf, section 5.4.2: `mat2` is column-major in
//   memory, so the literal is written rows-first; we store rows-first and keep the arithmetic identical).
//   One array field rather than `m00, m01, m02, m03` because every algorithm here is an index expression over the
//   entries (cofactor expansion, transpose, product): an array lets one loop body serve all entries and keeps the
//   file short, while 16 separate fields would need 16 names in the 4x4 inverse's cofactors.
//   This type is independent of the dynamic, heap-backed `Mat`: no allocation, no capacity, no drop.
//   No static (associated) function exists in the language, so the named constructors are free functions
//   (`mat2Identity`, `mat2Rotation`, ...). No method chaining either (`a.mul(&b).transposed()` is `E0709`, a method
//   needs an addressable receiver, and `&temporary` does not exist), so every product also has a form that writes
//   into a caller's matrix (`mulTo`).
from "scalar" import approxEqual
from "trig" import sin, cos
from "vec2" import Vec2

define MAT2_EPS = 0.000000001

/// A row-major 2x2 matrix of f64, `m[0] m[1] / m[2] m[3]`.
export class Mat2 {
    m: [f64; 4]

    /// The zero matrix.
    fn init(self) {
        local i: i32 = 0
        while i < 4 {
            self.set2(i as usize, 0.0)
            i = i + 1
        }
    }

    /// The matrix of the eight (actually four) arguments in row-major order: `Mat2(a, b, c, d)` is `[a b; c d]`.
    fn init(self, m00: f64, m01: f64, m10: f64, m11: f64) {
        self.m[0] = m00
        self.m[1] = m01
        self.m[2] = m10
        self.m[3] = m11
    }

    fn set2(self, i: usize, v: f64) {
        self.m[i] = v
    }

    /// Entry (i, j), i and j in 0..1.
    fn at(self, i: i32, j: i32) -> f64 {
        return self.m[((i * 2 + j) as usize)]
    }

    /// Sets entry (i, j).
    fn set(self, i: i32, j: i32, v: f64) {
        self.m[((i * 2 + j) as usize)] = v
    }

    /// self + o.
    fn add(self, o: *Mat2) -> Mat2 {
        return Mat2(self.m[0] + o.m[0], self.m[1] + o.m[1], self.m[2] + o.m[2], self.m[3] + o.m[3])
    }

    /// self - o.
    fn sub(self, o: *Mat2) -> Mat2 {
        return Mat2(self.m[0] - o.m[0], self.m[1] - o.m[1], self.m[2] - o.m[2], self.m[3] - o.m[3])
    }

    /// Every entry times the scalar k.
    fn scale(self, k: f64) -> Mat2 {
        return Mat2(self.m[0] * k, self.m[1] * k, self.m[2] * k, self.m[3] * k)
    }

    /// The product self * o, as a new matrix.
    fn mul(self, o: *Mat2) -> Mat2 {
        local out: Mat2 = Mat2()
        self.mulTo(o, &out)
        return out
    }

    /// Writes the product self * o into `out`. `out` may alias self or o: every entry is read from the arguments
    /// into a temporary before `out` is written, so `a.mulTo(&b, &a)` is well-defined.
    fn mulTo(self, o: *Mat2, out: *Mat2) {
        local a: Mat2 = self.shallowCopy()
        local r0: f64 = a.m[0] * o.m[0] + a.m[1] * o.m[2]
        local r1: f64 = a.m[0] * o.m[1] + a.m[1] * o.m[3]
        local r2: f64 = a.m[2] * o.m[0] + a.m[3] * o.m[2]
        local r3: f64 = a.m[2] * o.m[1] + a.m[3] * o.m[3]
        out.m[0] = r0
        out.m[1] = r1
        out.m[2] = r2
        out.m[3] = r3
    }

    /// A copy of this matrix (the entry array is copied, not shared).
    fn shallowCopy(self) -> Mat2 {
        return Mat2(self.m[0], self.m[1], self.m[2], self.m[3])
    }

    /// Writes the linear image self * v into `out`. No translation: a 2x2 matrix maps a direction.
    fn mulVec(self, v: *Vec2, out: *Vec2) {
        local x: f64 = v.x
        local y: f64 = v.y
        out.x = self.m[0] * x + self.m[1] * y
        out.y = self.m[2] * x + self.m[3] * y
    }

    /// The transpose, as a new matrix.
    fn transposed(self) -> Mat2 {
        return Mat2(self.m[0], self.m[2], self.m[1], self.m[3])
    }

    /// The determinant m00 m11 - m01 m10 (https://en.wikipedia.org/wiki/Determinant, section 2x2).
    fn det(self) -> f64 {
        return self.m[0] * self.m[3] - self.m[1] * self.m[2]
    }

    /// Writes the inverse into `out` and returns true; returns false and leaves `out` untouched when the matrix is
    /// singular. The inverse of `[a b; c d]` is `1/det [d -b; -c a]`; with det = 0 it does not exist. "Singular" is
    /// the exact test det == 0: a matrix whose det is merely tiny inverts to large finite entries, which is the
    /// honest answer (no conditioning estimate is made here).
    fn inverse(self, out: *Mat2) -> bool {
        local d: f64 = self.det()
        if d == 0.0 { return false }
        local k: f64 = 1.0 / d
        out.m[0] = self.m[3] * k
        out.m[1] = (0.0 - self.m[1]) * k
        out.m[2] = (0.0 - self.m[2]) * k
        out.m[3] = self.m[0] * k
        return true
    }

    /// The trace m00 + m11, the sum of the diagonal entries.
    fn trace(self) -> f64 {
        return self.m[0] + self.m[3]
    }

    /// True when every entry equals the entry of the identity exactly.
    fn isIdentity(self) -> bool {
        return self.m[0] == 1.0 && self.m[1] == 0.0 && self.m[2] == 0.0 && self.m[3] == 1.0
    }

    /// Entrywise equality within `eps` in absolute value.
    fn near(self, o: *Mat2, eps: f64) -> bool {
        local i: i32 = 0
        while i < 4 {
            if !approxEqual(self.m[i as usize], o.m[i as usize], eps) { return false }
            i = i + 1
        }
        return true
    }

    /// `near` with the module default of 1e-9.
    fn nearDefault(self, o: *Mat2) -> bool {
        return self.near(o, MAT2_EPS)
    }

    /// True when every entry agrees exactly (not within an epsilon; `near` is the approximate form).
    fn equals(self, o: *Mat2) -> bool {
        local i: i32 = 0
        while i < 4 {
            if self.m[i as usize] != o.m[i as usize] { return false }
            i = i + 1
        }
        return true
    }
}

// ---- free constructors (no static fn in the language) --------------------------------------

/// The 2x2 identity.
export fn mat2Identity() -> Mat2 {
    return Mat2(1.0, 0.0, 0.0, 1.0)
}

/// The counter-clockwise rotation by `rad` radians (a positive angle turns +x toward +y):
/// [cos -sin; sin cos]. This is the standard right-handed 2D rotation matrix, the same one GLSL builds with
/// `mat2(cos, sin, -sin, cos)` in column order
/// (https://en.wikipedia.org/wiki/Rotation_matrix#In_two_dimensions).
export fn mat2Rotation(rad: f64) -> Mat2 {
    local c: f64 = cos(rad)
    local s: f64 = sin(rad)
    return Mat2(c, 0.0 - s, s, c)
}

/// The diagonal scale [sx 0; 0 sy].
export fn mat2Scale(sx: f64, sy: f64) -> Mat2 {
    return Mat2(sx, 0.0, 0.0, sy)
}

/// The matrix whose first column is `a` and second column is `b`: [a.x b.x; a.y b.y]. Building a matrix from the
/// images of the basis vectors is how a linear map is described, so the columns, not the rows, are the arguments.
export fn mat2FromColumns(a: *Vec2, b: *Vec2) -> Mat2 {
    return Mat2(a.x, b.x, a.y, b.y)
}

/// The entrywise linear interpolation a + (b - a) t; `t` is not clamped. Every entry is linearly independent under
/// interpolation, so the entrywise form is the unique matrix that moves each entry linearly.
export fn mat2Lerp(a: *Mat2, b: *Mat2, t: f64) -> Mat2 {
    local out: Mat2 = Mat2()
    local i: i32 = 0
    while i < 4 {
        local p: usize = i as usize
        out.m[p] = a.m[p] + (b.m[p] - a.m[p]) * t
        i = i + 1
    }
    return out
}
