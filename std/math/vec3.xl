// std/math/vec3: the 3D vector `Vec3` as a value class: three f64 fields and methods, no pointer, no heap.
//   3D data (positions, directions, normals) is the type the graphics, physics and ray code passes around, so the
//   type is small (24 bytes) and copied by value; a method that builds a new vector costs one struct copy.
//   The cross product follows the right-handed convention of OpenGL and of the usual x/time, y/up, z/forward
//   frame: cross(x, y) = z (https://registry.khronos.org/OpenGL-Refpages/gl2.1/xhtml/gluLookAt.xml uses it).
//   `normalized` divides by the Euclidean norm and returns the zero vector for the zero vector, so a caller never
//   receives a NaN and never needs the boolean that the old out-parameter form returned.
from "math" import sqrt
from "scalar" import lerp
from "matrix" import Mat

define VEC3_EPS = 0.000000001

/// An (x, y, z) vector. `Vec3(a, b, c)` builds it.
export class Vec3 {
    x: f64
    y: f64
    z: f64

    fn init(self, x: f64, y: f64, z: f64) {
        self.x = x
        self.y = y
        self.z = z
    }

    fn add(self, o: *Vec3) -> Vec3 {
        return Vec3(self.x + o.x, self.y + o.y, self.z + o.z)
    }

    fn sub(self, o: *Vec3) -> Vec3 {
        return Vec3(self.x - o.x, self.y - o.y, self.z - o.z)
    }

    /// Componentwise product (Hadamard product); `dot` is the inner product.
    fn mul(self, o: *Vec3) -> Vec3 {
        return Vec3(self.x * o.x, self.y * o.y, self.z * o.z)
    }

    fn scale(self, k: f64) -> Vec3 {
        return Vec3(self.x * k, self.y * k, self.z * k)
    }

    fn negate(self) -> Vec3 {
        return Vec3(0.0 - self.x, 0.0 - self.y, 0.0 - self.z)
    }

    fn dot(self, o: *Vec3) -> f64 {
        return self.x * o.x + self.y * o.y + self.z * o.z
    }

    /// The right-handed cross product self x o, normal to both; zero when they are parallel.
    fn cross(self, o: *Vec3) -> Vec3 {
        return Vec3(self.y * o.z - self.z * o.y, self.z * o.x - self.x * o.z, self.x * o.y - self.y * o.x)
    }

    /// The squared length x^2 + y^2 + z^2; use it for comparisons and for a distance test without a square root.
    fn lengthSquared(self) -> f64 {
        return self.x * self.x + self.y * self.y + self.z * self.z
    }

    fn length(self) -> f64 {
        return sqrt(self.x * self.x + self.y * self.y + self.z * self.z)
    }

    /// The unit vector in the direction of self; the zero vector for the zero vector (its direction is undefined).
    fn normalized(self) -> Vec3 {
        local l: f64 = self.length()
        if l == 0.0 {
            return Vec3(0.0, 0.0, 0.0)
        }
        return Vec3(self.x / l, self.y / l, self.z / l)
    }

    fn distance(self, o: *Vec3) -> f64 {
        local dx: f64 = self.x - o.x
        local dy: f64 = self.y - o.y
        local dz: f64 = self.z - o.z
        return sqrt(dx * dx + dy * dy + dz * dz)
    }

    fn distanceSquared(self, o: *Vec3) -> f64 {
        local dx: f64 = self.x - o.x
        local dy: f64 = self.y - o.y
        local dz: f64 = self.z - o.z
        return dx * dx + dy * dy + dz * dz
    }

    /// The linear interpolation self + (o - self) t; `t` is not clamped.
    fn lerp(self, o: *Vec3, t: f64) -> Vec3 {
        return Vec3(lerp(self.x, o.x, t), lerp(self.y, o.y, t), lerp(self.z, o.z, t))
    }

    /// The componentwise smaller of the two.
    fn min(self, o: *Vec3) -> Vec3 {
        local x: f64 = self.x
        if o.x < x { x = o.x }
        local y: f64 = self.y
        if o.y < y { y = o.y }
        local z: f64 = self.z
        if o.z < z { z = o.z }
        return Vec3(x, y, z)
    }

    /// The componentwise larger of the two.
    fn max(self, o: *Vec3) -> Vec3 {
        local x: f64 = self.x
        if o.x > x { x = o.x }
        local y: f64 = self.y
        if o.y > y { y = o.y }
        local z: f64 = self.z
        if o.z > z { z = o.z }
        return Vec3(x, y, z)
    }

    /// Exact componentwise equality; compare floating point results with `near` instead.
    fn equals(self, o: *Vec3) -> bool {
        return self.x == o.x && self.y == o.y && self.z == o.z
    }

    /// Componentwise equality within `eps` in absolute value.
    fn near(self, o: *Vec3, eps: f64) -> bool {
        local dx: f64 = self.x - o.x
        if dx < 0.0 { dx = 0.0 - dx }
        local dy: f64 = self.y - o.y
        if dy < 0.0 { dy = 0.0 - dy }
        local dz: f64 = self.z - o.z
        if dz < 0.0 { dz = 0.0 - dz }
        return dx <= eps && dy <= eps && dz <= eps
    }

    /// `near` with the module default of 1e-9.
    fn nearDefault(self, o: *Vec3) -> bool {
        return self.near(o, VEC3_EPS)
    }

    /// The transformed direction of a 3x3 matrix (a linear map: no translation).
    fn transform(self, m: *Mat) -> Vec3 {
        if m.rows != 3 || m.cols != 3 {
            panic("Vec3.transform: the matrix must be 3x3")
        }
        return Vec3(m.at(0, 0) * self.x + m.at(0, 1) * self.y + m.at(0, 2) * self.z,
                    m.at(1, 0) * self.x + m.at(1, 1) * self.y + m.at(1, 2) * self.z,
                    m.at(2, 0) * self.x + m.at(2, 1) * self.y + m.at(2, 2) * self.z)
    }
}
