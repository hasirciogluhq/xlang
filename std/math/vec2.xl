// std/math/vec2: the 2D vector `Vec2` as a value class: two f64 fields and methods, no pointer, no heap.
//   A class (not a struct) because the methods live with the fields and because a struct cannot carry a method.
//   The weight of the type is two doubles, so it is copied by value everywhere; the only cost of a method that
//   returns `Vec2` is the 16-byte copy.
//   Methods take `self` (the receiver is a pointer to it) and a `*Vec3`-style pointer for the other operand, so
//   no argument is ever boxed or copied behind the caller's back.
from "math" import sqrt
from "scalar" import lerp, clamp
from "matrix" import Mat

define VEC2_EPS = 0.000000001

/// An (x, y) vector. `Vec2(a, b)` builds it; `Vec2.zero()` is the origin.
export class Vec2 {
    x: f64
    y: f64

    fn init(self, x: f64, y: f64) {
        self.x = x
        self.y = y
    }

    fn add(self, o: *Vec2) -> Vec2 {
        return Vec2(self.x + o.x, self.y + o.y)
    }

    fn sub(self, o: *Vec2) -> Vec2 {
        return Vec2(self.x - o.x, self.y - o.y)
    }

    /// Componentwise product (a Hadamard product, not the dot product).
    fn mul(self, o: *Vec2) -> Vec2 {
        return Vec2(self.x * o.x, self.y * o.y)
    }

    fn scale(self, k: f64) -> Vec2 {
        return Vec2(self.x * k, self.y * k)
    }

    fn negate(self) -> Vec2 {
        return Vec2(0.0 - self.x, 0.0 - self.y)
    }

    fn dot(self, o: *Vec2) -> f64 {
        return self.x * o.x + self.y * o.y
    }

    /// The z component of the 3D cross product (a1 b2 - a2 b1): the signed area of the parallelogram, positive
    /// when `o` is counter-clockwise from `self`.
    fn cross(self, o: *Vec2) -> f64 {
        return self.x * o.y - self.y * o.x
    }

    /// The squared length x^2 + y^2. Use it for comparisons; it needs no square root.
    fn lengthSquared(self) -> f64 {
        return self.x * self.x + self.y * self.y
    }

    /// Euclidean length sqrt(x^2 + y^2). `sqrt` is std/math's Newton iteration, exact to a few ulp.
    fn length(self) -> f64 {
        return sqrt(self.x * self.x + self.y * self.y)
    }

    /// The unit vector in the same direction. The zero vector has no direction, so this returns the zero vector
    /// instead of dividing by zero (no NaN reaches the caller).
    fn normalized(self) -> Vec2 {
        local l: f64 = self.length()
        if l == 0.0 {
            return Vec2(0.0, 0.0)
        }
        return Vec2(self.x / l, self.y / l)
    }

    /// Euclidean distance to `o`.
    fn distance(self, o: *Vec2) -> f64 {
        local dx: f64 = self.x - o.x
        local dy: f64 = self.y - o.y
        return sqrt(dx * dx + dy * dy)
    }

    /// The squared distance to `o` (no square root).
    fn distanceSquared(self, o: *Vec2) -> f64 {
        local dx: f64 = self.x - o.x
        local dy: f64 = self.y - o.y
        return dx * dx + dy * dy
    }

    /// The linear interpolation self + (o - self) t; `t` is not clamped.
    fn lerp(self, o: *Vec2, t: f64) -> Vec2 {
        return Vec2(lerp(self.x, o.x, t), lerp(self.y, o.y, t))
    }

    /// The componentwise smaller of the two.
    fn min(self, o: *Vec2) -> Vec2 {
        local x: f64 = self.x
        if o.x < x { x = o.x }
        local y: f64 = self.y
        if o.y < y { y = o.y }
        return Vec2(x, y)
    }

    /// The componentwise larger of the two.
    fn max(self, o: *Vec2) -> Vec2 {
        local x: f64 = self.x
        if o.x > x { x = o.x }
        local y: f64 = self.y
        if o.y > y { y = o.y }
        return Vec2(x, y)
    }

    /// Exact componentwise equality. Floating point results should be compared with `near` instead.
    fn equals(self, o: *Vec2) -> bool {
        return self.x == o.x && self.y == o.y
    }

    /// Componentwise equality within `eps` in absolute value.
    fn near(self, o: *Vec2, eps: f64) -> bool {
        local dx: f64 = self.x - o.x
        if dx < 0.0 { dx = 0.0 - dx }
        local dy: f64 = self.y - o.y
        if dy < 0.0 { dy = 0.0 - dy }
        return dx <= eps && dy <= eps
    }

    /// Same as `near` with the module default of 1e-9.
    fn nearDefault(self, o: *Vec2) -> bool {
        return self.near(o, VEC2_EPS)
    }

    /// Both components limited to [lo, hi].
    fn clamped(self, lo: f64, hi: f64) -> Vec2 {
        return Vec2(clamp(self.x, lo, hi), clamp(self.y, lo, hi))
    }

    /// The transformed point of a 2x2 matrix (linear map: no translation).
    fn transform(self, m: *Mat) -> Vec2 {
        if m.rows != 2 || m.cols != 2 {
            panic("Vec2.transform: the matrix must be 2x2")
        }
        return Vec2(m.at(0, 0) * self.x + m.at(0, 1) * self.y, m.at(1, 0) * self.x + m.at(1, 1) * self.y)
    }

    /// The transformed point of a 3x3 affine matrix (x, y, 1), the 2D form of OpenGL's 4x4 with a bottom row of
    /// (0, 0, 1) (https://registry.khronos.org/OpenGL-Refpages/gl2.1/xhtml/glMultMatrix.xml).
    fn transformAffine(self, m: *Mat) -> Vec2 {
        if m.rows != 3 || m.cols != 3 {
            panic("Vec2.transformAffine: the matrix must be 3x3")
        }
        return Vec2(m.at(0, 0) * self.x + m.at(0, 1) * self.y + m.at(0, 2),
                    m.at(1, 0) * self.x + m.at(1, 1) * self.y + m.at(1, 2))
    }
}
