// std/crypto/cipher/aes: the AES block cipher for 128-, 192- and 256-bit keys (FIPS 197,
// https://csrc.nist.gov/pubs/fs/197/final). Key expansion is section 5.2, encryption is section 5.1, the inverse
// cipher is section 5.3. The S-box is built on first use from its definition (multiplicative inverse in GF(2^8)
// followed by the affine map of section 5.1.1), so no table is typed in by hand.
// The state is 16 bytes in column-major order (byte index = 4 * column + row).
// Round count: 10, 12 or 14 for 16-, 24- and 32-byte keys. The round keys are 16 * (rounds + 1) bytes.
// Table lookups depend on the data, so this implementation is not constant-time.

global aesSbox: [ui8; 256]
global aesInvSbox: [ui8; 256]
global aesSboxReady: bool

fn rotl8(x: ui8, n: ui8) -> ui8 {
    return (x << n) | (x >> (8 - n))
}

/// Multiplication by x (xtime) in GF(2^8) modulo x^8 + x^4 + x^3 + x + 1 (0x11b), FIPS 197 section 4.2.1.
fn xtime(x: ui8) -> ui8 {
    local hi: ui8 = 0
    if (x & 0x80) != 0 { hi = 0x1b }
    return (x << 1) ^ hi
}

/// General multiplication in GF(2^8) (FIPS 197 section 4.2): the shift-and-add product modulo 0x11b.
fn gmul(a: ui8, b: ui8) -> ui8 {
    local p: ui8 = 0
    local x: ui8 = a
    local y: ui8 = b
    while y != 0 {
        if (y & 1) != 0 { p = p ^ x }
        x = xtime(x)
        y = y >> 1
    }
    return p
}

fn buildSbox() {
    // Walks the multiplicative group of GF(2^8) with generator 3, keeping q = p^-1 (FIPS 197 section 5.1.1).
    local p: ui8 = 1
    local q: ui8 = 1
    local first: bool = true
    while first || p != 1 {
        first = false
        p = p ^ xtime(p)
        q = q ^ (q << 1)
        q = q ^ (q << 2)
        q = q ^ (q << 4)
        if (q & 0x80) != 0 { q = q ^ 0x09 }
        aesSbox[p] = q ^ rotl8(q, 1) ^ rotl8(q, 2) ^ rotl8(q, 3) ^ rotl8(q, 4) ^ 0x63
    }
    aesSbox[0] = 0x63
    local i: usize = 0
    while i < 256 {
        aesInvSbox[aesSbox[i]] = i as ui8
        i = i + 1
    }
    aesSboxReady = true
}

fn ensureTables() {
    if !aesSboxReady { buildSbox() }
}

/// The number of rounds for a key of `keyLen` bytes (16, 24 or 32); 0 for any other length.
export fn aesRounds(keyLen: usize) -> usize {
    if keyLen == 16 { return 10 }
    if keyLen == 24 { return 12 }
    if keyLen == 32 { return 14 }
    return 0
}

/// Expands the `keyLen`-byte key (16, 24 or 32) into `16 * (rounds + 1)` bytes of round keys at `rk` (FIPS 197
/// section 5.2). The caller checks the key length with `aesRounds`.
export fn aesKeyExpand(key: *ui8, keyLen: usize, rk: *ui8) {
    ensureTables()
    local nk: usize = keyLen / 4
    local words: usize = 4 * (aesRounds(keyLen) + 1)
    local i: usize = 0
    while i < keyLen {
        rk[i] = key[i]
        i = i + 1
    }
    local rcon: ui8 = 1
    i = nk
    while i < words {
        local t0: ui8 = rk[(i - 1) * 4]
        local t1: ui8 = rk[(i - 1) * 4 + 1]
        local t2: ui8 = rk[(i - 1) * 4 + 2]
        local t3: ui8 = rk[(i - 1) * 4 + 3]
        if i % nk == 0 {
            // RotWord, SubWord, then xor with Rcon (section 5.2, line 3 of the algorithm)
            local r: ui8 = t0
            t0 = aesSbox[t1] ^ rcon
            t1 = aesSbox[t2]
            t2 = aesSbox[t3]
            t3 = aesSbox[r]
            rcon = xtime(rcon)
        } else if nk > 6 && i % nk == 4 {
            // the extra SubWord of the 256-bit schedule
            t0 = aesSbox[t0]
            t1 = aesSbox[t1]
            t2 = aesSbox[t2]
            t3 = aesSbox[t3]
        }
        rk[i * 4] = rk[(i - nk) * 4] ^ t0
        rk[i * 4 + 1] = rk[(i - nk) * 4 + 1] ^ t1
        rk[i * 4 + 2] = rk[(i - nk) * 4 + 2] ^ t2
        rk[i * 4 + 3] = rk[(i - nk) * 4 + 3] ^ t3
        i = i + 1
    }
}

/// Encrypts one 16-byte block: `out[0..16) = AES(rk, rounds, in[0..16))`. `in` and `out` may be the same buffer.
export fn aesEncrypt(rk: *ui8, rounds: usize, in: *ui8, out: *ui8) {
    ensureTables()
    local s: [ui8; 16]
    local t: [ui8; 16]
    local i: usize = 0
    while i < 16 {
        s[i] = in[i] ^ rk[i]
        i = i + 1
    }
    local round: usize = 1
    while round <= rounds {
        // SubBytes and ShiftRows: row r of column c takes row r of column (c + r) mod 4.
        i = 0
        while i < 16 {
            local col: usize = i / 4
            local row: usize = i % 4
            t[i] = aesSbox[s[((col + row) % 4) * 4 + row]]
            i = i + 1
        }
        if round < rounds {
            // MixColumns (section 5.1.3)
            local c: usize = 0
            while c < 4 {
                local a0: ui8 = t[c * 4]
                local a1: ui8 = t[c * 4 + 1]
                local a2: ui8 = t[c * 4 + 2]
                local a3: ui8 = t[c * 4 + 3]
                local all: ui8 = a0 ^ a1 ^ a2 ^ a3
                s[c * 4] = a0 ^ all ^ xtime(a0 ^ a1)
                s[c * 4 + 1] = a1 ^ all ^ xtime(a1 ^ a2)
                s[c * 4 + 2] = a2 ^ all ^ xtime(a2 ^ a3)
                s[c * 4 + 3] = a3 ^ all ^ xtime(a3 ^ a0)
                c = c + 1
            }
        } else {
            i = 0
            while i < 16 {
                s[i] = t[i]
                i = i + 1
            }
        }
        i = 0
        while i < 16 {
            s[i] = s[i] ^ rk[round * 16 + i]
            i = i + 1
        }
        round = round + 1
    }
    i = 0
    while i < 16 {
        out[i] = s[i]
        i = i + 1
    }
}

/// Decrypts one 16-byte block with the inverse cipher (FIPS 197 section 5.3): `out = AESInv(rk, rounds, in)`.
export fn aesDecrypt(rk: *ui8, rounds: usize, in: *ui8, out: *ui8) {
    ensureTables()
    local s: [ui8; 16]
    local t: [ui8; 16]
    local i: usize = 0
    while i < 16 {
        s[i] = in[i] ^ rk[rounds * 16 + i]
        i = i + 1
    }
    local round: usize = rounds
    while round >= 1 {
        // InvShiftRows then InvSubBytes: row r of column c takes row r of column (c - r) mod 4.
        i = 0
        while i < 16 {
            local col: usize = i / 4
            local row: usize = i % 4
            t[i] = aesInvSbox[s[((col + 4 - row) % 4) * 4 + row]]
            i = i + 1
        }
        i = 0
        while i < 16 {
            t[i] = t[i] ^ rk[(round - 1) * 16 + i]
            i = i + 1
        }
        if round > 1 {
            // InvMixColumns (section 5.3.3)
            local c: usize = 0
            while c < 4 {
                local a0: ui8 = t[c * 4]
                local a1: ui8 = t[c * 4 + 1]
                local a2: ui8 = t[c * 4 + 2]
                local a3: ui8 = t[c * 4 + 3]
                s[c * 4] = gmul(a0, 14) ^ gmul(a1, 11) ^ gmul(a2, 13) ^ gmul(a3, 9)
                s[c * 4 + 1] = gmul(a0, 9) ^ gmul(a1, 14) ^ gmul(a2, 11) ^ gmul(a3, 13)
                s[c * 4 + 2] = gmul(a0, 13) ^ gmul(a1, 9) ^ gmul(a2, 14) ^ gmul(a3, 11)
                s[c * 4 + 3] = gmul(a0, 11) ^ gmul(a1, 13) ^ gmul(a2, 9) ^ gmul(a3, 14)
                c = c + 1
            }
        } else {
            i = 0
            while i < 16 {
                s[i] = t[i]
                i = i + 1
            }
        }
        round = round - 1
    }
    i = 0
    while i < 16 {
        out[i] = s[i]
        i = i + 1
    }
}
