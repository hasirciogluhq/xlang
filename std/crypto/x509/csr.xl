// std/crypto/x509/csr: PKCS #10 certification requests (RFC 2986, https://www.rfc-editor.org/rfc/rfc2986, section 4). A request is
//   CertificationRequest ::= SEQUENCE { certificationRequestInfo, signatureAlgorithm, signature BIT STRING }
//   CertificationRequestInfo ::= SEQUENCE { version INTEGER (0), subject Name, subjectPKInfo, attributes [0] IMPLICIT SET }
// The signature covers the whole certificationRequestInfo TLV (section 4.2). This parser reads the subject, the public key
// (through the same SubjectPublicKeyInfo reader as certificates, so RSA and EC P-256/P-384 keys) and the self-signature check.
// Attributes (for example extensionRequest) are skipped; they are not parsed. The views point into `der`, which must outlive
// the Csr.
from "x509" import Cert, Tlv, derRead, parseSpki, sigAlgOf, x509VerifySignature, KEY_NONE

/// A parsed certification request. `ok` is false when the DER is not a valid request.
export struct Csr {
    info: *ui8                // the certificationRequestInfo TLV: the signed bytes
    infoLen: usize
    subject: *ui8             // the subject Name TLV
    subjectLen: usize
    key: Cert                 // the public key (only the key fields are set)
    sigAlg: i32
    sig: *ui8                 // signature bytes, without the unused-bits byte
    sigLen: usize
    ok: bool
}

/// Parses a DER certification request.
export fn csrParse(der: *ui8, len: usize) -> Csr {
    local c: Csr
    c.key.keyType = KEY_NONE
    local outer: Tlv
    if !derRead(der, len, &outer) || outer.tag != 0x30 { return c }
    local body: *ui8 = outer.body
    local avail: usize = outer.len
    local info: Tlv
    if !derRead(body, avail, &info) || info.tag != 0x30 { return c }
    local off: usize = info.total
    if off > avail { return c }
    local alg: Tlv
    if !derRead(&body[off], avail - off, &alg) || alg.tag != 0x30 { return c }
    local oid: Tlv
    if !derRead(alg.body, alg.len, &oid) || oid.tag != 0x06 { return c }
    c.sigAlg = sigAlgOf(&oid)
    off = off + alg.total
    local sigTlv: Tlv
    if off > avail || !derRead(&body[off], avail - off, &sigTlv) || sigTlv.tag != 0x03 { return c }
    if sigTlv.len < 1 || sigTlv.body[0] != 0 { return c }
    c.sig = &sigTlv.body[1]
    c.sigLen = sigTlv.len - 1
    // inside the info: version, subject, subjectPKInfo
    c.info = body
    c.infoLen = info.total
    local iBody: *ui8 = info.body
    local iLen: usize = info.len
    local v: Tlv
    if !derRead(iBody, iLen, &v) || v.tag != 0x02 || v.len != 1 || v.body[0] != 0 { return c }
    local io: usize = v.total
    local subj: Tlv
    if io > iLen || !derRead(&iBody[io], iLen - io, &subj) || subj.tag != 0x30 { return c }
    c.subject = &iBody[io]
    c.subjectLen = subj.total
    io = io + subj.total
    local spki: Tlv
    if io > iLen || !derRead(&iBody[io], iLen - io, &spki) || spki.tag != 0x30 { return c }
    if !parseSpki(&c.key, &spki) { return c }
    c.ok = true
    return c
}

/// True when the signature over the request's info is valid under the request's own public key (proof of possession, RFC 2986
/// section 3 step 4: the requester signs the request with the private key that matches the key it submits).
export fn csrVerifySelf(c: *Csr) -> bool {
    if !c.ok { return false }
    return x509VerifySignature(&c.key, c.sigAlg, c.info, c.infoLen, c.sig, c.sigLen)
}
