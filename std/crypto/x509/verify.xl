// std/crypto/x509/verify: certification path validation (RFC 5280 section 6.1, the basic path processing that a relying
// party needs; https://www.rfc-editor.org/rfc/rfc5280). The chain is given leaf first: chain[0] is the end entity, and each
// next certificate is the issuer of the one before it. Checks, per certificate:
//   - its validity period contains `now` (section 6.1.3 a.2);
//   - each certificate after the leaf is a CA: basicConstraints cA is set, and keyCertSign is set when keyUsage is present
//     (section 6.1.4 k and section 4.2.1.9);
//   - the pathLenConstraint of a CA is not exceeded by the number of intermediate certificates below it (section 6.1.4 l);
//   - the issuer name matches (byte-wise DER, section 6.1.3 a.4) and the signature verifies under the issuer's key (a.3).
// The last certificate must be issued by a trust anchor in `roots`, or be one itself (byte-equal DER). A root is only used
// when it is valid at `now` and is a CA. Not checked: name constraints, policies, critical extensions this parser does not
// know, and revocation (use crl.xl for that). The certificates' DER must outlive the call.
from "x509" import Cert, x509ValidAt, x509IssuedBy, x509CheckSignedBy

/// True when the DER of `a` and `b` is the same byte string.
fn sameDer(a: *Cert, b: *Cert) -> bool {
    if a.derLen != b.derLen { return false }
    local i: usize = 0
    while i < a.derLen {
        if a.der[i] != b.der[i] { return false }
        i = i + 1
    }
    return true
}

/// True when `c` may sign certificates (an intermediate or a root).
fn mayIssue(c: *Cert) -> bool {
    if !c.hasBasic || !c.isCa { return false }
    if c.hasKeyUsage && !c.keyCertSign { return false }
    return true
}

/// Validates `chain[0..n)` (leaf first) against the trust anchors `roots[0..nRoots)` at time `now` (seconds since 1970-01-01 UTC).
export fn x509ChainVerify(chain: *Cert, n: usize, roots: *Cert, nRoots: usize, now: i64) -> bool {
    if n == 0 { return false }
    local i: usize = 0
    while i < n {
        if !x509ValidAt(&chain[i], now) { return false }
        i = i + 1
    }
    // each certificate after the leaf is a CA that issued the one before it
    i = 1
    while i < n {
        local child: *Cert = &chain[i - 1]
        local parent: *Cert = &chain[i]
        if !mayIssue(parent) { return false }
        if parent.pathLen >= 0 && (i - 1) > (parent.pathLen as usize) { return false }
        if !x509IssuedBy(child, parent) || !x509CheckSignedBy(child, parent) { return false }
        i = i + 1
    }
    // the top of the chain: a trust anchor itself, or issued by one
    local top: *Cert = &chain[n - 1]
    local r: usize = 0
    while r < nRoots {
        local root: *Cert = &roots[r]
        if sameDer(top, root) && x509ValidAt(root, now) { return true }
        if x509ValidAt(root, now) && mayIssue(root) && x509IssuedBy(top, root) && x509CheckSignedBy(top, root) { return true }
        r = r + 1
    }
    return false
}
