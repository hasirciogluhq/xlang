// std/crypto/hash/mac: generic HMAC (RFC 2104, https://www.rfc-editor.org/rfc/rfc2104) over any digest id of digest.xl.
//   HMAC(K, m) = H((K' XOR opad) || H((K' XOR ipad) || m)), ipad = 0x36 repeated, opad = 0x5c repeated,
//   K' = K padded with zeros to the block size, or H(K) when K is longer than the block size (section 2).
// The message is not limited: the inner input is built in a buffer from the registered allocator (std/mem), so
// `hmac` may allocate. Streaming HMAC over a long message is a separate item (plan Q2).
from "digest" import digest, digestLen, digestBlockLen
from "../../mem/mem" import currentAllocator

/// The largest digest block (SHA-384 and SHA-512 family) in bytes.
define HMAC_MAX_BLOCK = 128

fn copyBytes(dst: *ui8, src: *ui8, n: usize) {
    local i: usize = 0
    while i < n {
        dst[i] = src[i]
        i = i + 1
    }
}

/// `out[0..digestLen(alg))` = HMAC-alg(key[0..klen), msg[0..mlen)). False when `alg` is unknown.
/// Keys of any length are accepted (RFC 2104 section 3 allows any length; longer keys are hashed first).
export fn hmac(alg: i32, key: *ui8, klen: usize, msg: *ui8, mlen: usize, out: *ui8) -> bool {
    local bs: usize = digestBlockLen(alg)
    if bs == 0 { return false }
    local ol: usize = digestLen(alg)
    local k: [ui8; 128]
    local i: usize = 0
    while i < HMAC_MAX_BLOCK {
        k[i] = 0
        i = i + 1
    }
    if klen > bs {
        digest(alg, key, klen, &k[0])
    } else {
        copyBytes(&k[0], key, klen)
    }
    local inner: *ui8 = currentAllocator.alloc(bs + mlen, 1) as *ui8
    if inner == nil {
        panic("hmac: out of memory")
    }
    i = 0
    while i < bs {
        inner[i] = k[i] ^ 0x36
        i = i + 1
    }
    copyBytes(&inner[bs], msg, mlen)
    local ih: [ui8; 64]
    digest(alg, inner, bs + mlen, &ih[0])
    currentAllocator.free(inner as *void)
    local outer: [ui8; 192]
    i = 0
    while i < bs {
        outer[i] = k[i] ^ 0x5c
        i = i + 1
    }
    copyBytes(&outer[bs], &ih[0], ol)
    digest(alg, &outer[0], bs + ol, out)
    return true
}
