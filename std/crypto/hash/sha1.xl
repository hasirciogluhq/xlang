// std/crypto/hash/sha1: SHA-1 (RFC 3174, https://www.rfc-editor.org/rfc/rfc3174). One-shot `sha1(data, n, out)` with a
// 20-byte digest and a streaming `Sha1` state (init / update / final; copy the struct to snapshot a running hash).
// SHA-1 has practical collisions (SHAttered, 2017): it is kept for protocols that still require it (UUID version 5,
// legacy fingerprints), never for new signatures or integrity against an attacker.
// Layout: the message is big-endian. Padding appends 0x80, zero bytes up to 56 mod 64, then the 64-bit big-endian
// bit length (RFC 3174 section 4). Round constants K and the round functions are in RFC 3174 section 5.

fn rotl(x: ui32, n: ui32) -> ui32 {
    return (x << n) | (x >> (32 - n))
}

/// Compresses one 64-byte block into `h[0..5]`.
fn block(h: *ui32, p: *ui8) {
    local w: [ui32; 80]
    local i: usize = 0
    while i < 16 {
        w[i] = ((p[i * 4] as ui32) << 24) | ((p[i * 4 + 1] as ui32) << 16) |
               ((p[i * 4 + 2] as ui32) << 8) | (p[i * 4 + 3] as ui32)
        i = i + 1
    }
    while i < 80 {
        w[i] = rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1)
        i = i + 1
    }
    local a: ui32 = h[0]
    local b: ui32 = h[1]
    local c: ui32 = h[2]
    local d: ui32 = h[3]
    local e: ui32 = h[4]
    i = 0
    while i < 80 {
        local f: ui32 = 0
        local k: ui32 = 0
        if i < 20 {
            f = (b & c) | (~b & d)
            k = 0x5a827999
        } else if i < 40 {
            f = b ^ c ^ d
            k = 0x6ed9eba1
        } else if i < 60 {
            f = (b & c) | (b & d) | (c & d)
            k = 0x8f1bbcdc
        } else {
            f = b ^ c ^ d
            k = 0xca62c1d6
        }
        local temp: ui32 = rotl(a, 5) + f + e + k + w[i]
        e = d
        d = c
        c = rotl(b, 30)
        b = a
        a = temp
        i = i + 1
    }
    h[0] = h[0] + a
    h[1] = h[1] + b
    h[2] = h[2] + c
    h[3] = h[3] + d
    h[4] = h[4] + e
}

/// Streaming SHA-1 state. A plain struct copy (`*a = *b`) snapshots a running hash.
export struct Sha1 {
    h: [ui32; 5]
    buf: [ui8; 64]
    used: usize
    total: ui64
}

export fn sha1Init(s: *Sha1) {
    s.h[0] = 0x67452301
    s.h[1] = 0xefcdab89
    s.h[2] = 0x98badcfe
    s.h[3] = 0x10325476
    s.h[4] = 0xc3d2e1f0
    s.used = 0
    s.total = 0
}

export fn sha1Update(s: *Sha1, data: *ui8, n: usize) {
    s.total = s.total + (n as ui64)
    local i: usize = 0
    while i < n {
        s.buf[s.used] = data[i]
        s.used = s.used + 1
        i = i + 1
        if s.used == 64 {
            block(&s.h[0], &s.buf[0])
            s.used = 0
        }
    }
}

/// Finishes a copy of the state: `s` itself keeps absorbing afterwards. Writes the 20 digest bytes to `out`.
export fn sha1Final(s: *Sha1, out: *ui8) {
    local c: Sha1 = *s
    local bits: ui64 = c.total << 3
    c.buf[c.used] = 0x80
    c.used = c.used + 1
    if c.used > 56 {
        while c.used < 64 {
            c.buf[c.used] = 0
            c.used = c.used + 1
        }
        block(&c.h[0], &c.buf[0])
        c.used = 0
    }
    while c.used < 56 {
        c.buf[c.used] = 0
        c.used = c.used + 1
    }
    local i: usize = 0
    while i < 8 {
        c.buf[63 - i] = ((bits >> ((i as ui64) * 8)) & 0xff) as ui8
        i = i + 1
    }
    block(&c.h[0], &c.buf[0])
    i = 0
    while i < 5 {
        out[i * 4] = (c.h[i] >> 24) as ui8
        out[i * 4 + 1] = ((c.h[i] >> 16) & 0xff) as ui8
        out[i * 4 + 2] = ((c.h[i] >> 8) & 0xff) as ui8
        out[i * 4 + 3] = (c.h[i] & 0xff) as ui8
        i = i + 1
    }
}

/// SHA-1 of `data[0..n]` into the 20 bytes at `out`.
export fn sha1(data: *ui8, n: usize, out: *ui8) {
    local s: Sha1
    sha1Init(&s)
    sha1Update(&s, data, n)
    sha1Final(&s, out)
}
