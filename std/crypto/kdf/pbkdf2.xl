// std/crypto/kdf/pbkdf2: PBKDF2 (RFC 8018 section 5.2, https://www.rfc-editor.org/rfc/rfc8018#section-5.2) over any
// HMAC of std/crypto/hash/mac. The derived key is the concatenation of blocks T_i = U_1 xor ... xor U_c, where
// U_1 = PRF(P, S || INT(i)) and U_j = PRF(P, U_{j-1}), with INT(i) the 32-bit big-endian block index.
// Test vectors: RFC 6070 (PBKDF2-HMAC-SHA1, "password", "salt", c = 1, 20 bytes = 0c60c80f961f0e71f3a9b524af6012062fe037a6).
// The iteration count is the cost parameter: the caller picks it, and this function runs it exactly.
from "../hash/digest" import digestLen
from "../hash/mac" import hmac
from "../../mem/mem" import currentAllocator

/// Derives `outLen` bytes into `out` from the password `pass` and the salt `salt` with `iterations` rounds (at least 1)
/// using the HMAC of digest `alg`. False for an unknown digest, zero iterations, or a key longer than the digest output
/// count allows (outLen must be below 2^32 blocks of the digest size).
export fn pbkdf2(alg: i32, pass: *ui8, plen: usize, salt: *ui8, slen: usize, iterations: ui32, out: *ui8, outLen: usize) -> bool {
    local hl: usize = digestLen(alg)
    if hl == 0 || iterations == 0 { return false }
    local buf: *ui8 = currentAllocator.alloc(slen + 4, 1) as *ui8
    if buf == nil { panic("pbkdf2: out of memory") }
    local i: usize = 0
    while i < slen {
        buf[i] = salt[i]
        i = i + 1
    }
    local u: [ui8; 64]
    local t: [ui8; 64]
    local done: usize = 0
    local block: ui32 = 1
    while done < outLen {
        buf[slen] = ((block >> 24) & 0xff) as ui8
        buf[slen + 1] = ((block >> 16) & 0xff) as ui8
        buf[slen + 2] = ((block >> 8) & 0xff) as ui8
        buf[slen + 3] = (block & 0xff) as ui8
        hmac(alg, pass, plen, buf, slen + 4, &u[0])
        i = 0
        while i < hl {
            t[i] = u[i]
            i = i + 1
        }
        local j: ui32 = 1
        while j < iterations {
            hmac(alg, pass, plen, &u[0], hl, &u[0])
            i = 0
            while i < hl {
                t[i] = t[i] ^ u[i]
                i = i + 1
            }
            j = j + 1
        }
        local take: usize = outLen - done
        if take > hl { take = hl }
        i = 0
        while i < take {
            out[done + i] = t[i]
            i = i + 1
        }
        done = done + take
        block = block + 1
    }
    currentAllocator.free(buf as *void)
    return true
}
