// std/crypto/kdf/onestep: the one-step hash KDFs.
//   concat_kdf (NIST SP 800-56C rev. 2, section 4.1, https://csrc.nist.gov/pubs/sp/800/56/c/r2/final): counter from 1,
//   Hash(counter || Z || FixedInfo) for each block, the counter as a 32-bit big-endian integer.
//   x963_kdf (ANSI X9.63 section 5.6.3, the SEC 1 version 2 section 3.6.1 key derivation): counter from 1, Hash(Z ||
//   counter || SharedInfo), the counter as a 32-bit big-endian integer after Z.
// Both take the shared secret Z (for example an ECDH x coordinate from std/crypto/sig/ecdsa) and produce `outLen` bytes.
// No published test vector is checked here yet (see KNOWN-LIMITATIONS, "Std cryptography"); the construction is
// the one-step form of each specification, with the counter at the start (concat) or after Z (X9.63).
from "../hash/digest" import digest, digestLen
from "../../mem/mem" import currentAllocator

/// The concatenation KDF (SP 800-56C one-step, hash `alg`): `out` gets `outLen` bytes. False for an unknown digest.
export fn concatKdf(alg: i32, z: *ui8, zlen: usize, info: *ui8, ilen: usize, out: *ui8, outLen: usize) -> bool {
    local hl: usize = digestLen(alg)
    if hl == 0 { return false }
    local buf: *ui8 = currentAllocator.alloc(4 + zlen + ilen, 1) as *ui8
    if buf == nil { panic("concatKdf: out of memory") }
    local h: [ui8; 64]
    local done: usize = 0
    local counter: ui32 = 1
    while done < outLen {
        buf[0] = ((counter >> 24) & 0xff) as ui8
        buf[1] = ((counter >> 16) & 0xff) as ui8
        buf[2] = ((counter >> 8) & 0xff) as ui8
        buf[3] = (counter & 0xff) as ui8
        local i: usize = 0
        while i < zlen {
            buf[4 + i] = z[i]
            i = i + 1
        }
        i = 0
        while i < ilen {
            buf[4 + zlen + i] = info[i]
            i = i + 1
        }
        digest(alg, buf, 4 + zlen + ilen, &h[0])
        local take: usize = outLen - done
        if take > hl { take = hl }
        local j: usize = 0
        while j < take {
            out[done + j] = h[j]
            j = j + 1
        }
        done = done + take
        counter = counter + 1
    }
    currentAllocator.free(buf as *void)
    return true
}

/// The ANSI X9.63 KDF with hash `alg`: `out` gets `outLen` bytes. False for an unknown digest.
export fn x963Kdf(alg: i32, z: *ui8, zlen: usize, info: *ui8, ilen: usize, out: *ui8, outLen: usize) -> bool {
    local hl: usize = digestLen(alg)
    if hl == 0 { return false }
    local buf: *ui8 = currentAllocator.alloc(zlen + 4 + ilen, 1) as *ui8
    if buf == nil { panic("x963Kdf: out of memory") }
    local h: [ui8; 64]
    local done: usize = 0
    local counter: ui32 = 1
    while done < outLen {
        local i: usize = 0
        while i < zlen {
            buf[i] = z[i]
            i = i + 1
        }
        buf[zlen] = ((counter >> 24) & 0xff) as ui8
        buf[zlen + 1] = ((counter >> 16) & 0xff) as ui8
        buf[zlen + 2] = ((counter >> 8) & 0xff) as ui8
        buf[zlen + 3] = (counter & 0xff) as ui8
        i = 0
        while i < ilen {
            buf[zlen + 4 + i] = info[i]
            i = i + 1
        }
        digest(alg, buf, zlen + 4 + ilen, &h[0])
        local take: usize = outLen - done
        if take > hl { take = hl }
        local j: usize = 0
        while j < take {
            out[done + j] = h[j]
            j = j + 1
        }
        done = done + take
        counter = counter + 1
    }
    currentAllocator.free(buf as *void)
    return true
}
