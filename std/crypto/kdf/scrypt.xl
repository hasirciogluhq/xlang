// std/crypto/kdf/scrypt: scrypt (RFC 7914, https://www.rfc-editor.org/rfc/rfc7914), a memory-hard password KDF.
//   B = PBKDF2-HMAC-SHA256(P, S, 1, p * 128 r); each 128r-byte chunk of B goes through ROMix; the result is
//   PBKDF2-HMAC-SHA256(P, B', 1, dkLen). ROMix (section 4) uses N blocks of 128r bytes of memory; BlockMix uses
//   Salsa20/8 (the Salsa core with 4 double rounds, section 3). All words are little-endian.
// Test vectors (RFC 7914 section 12): scrypt("", "", 16, 1, 1, 64) = 77d65762...906 (full value in the test program);
// scrypt("password", "NaCl", 1024, 8, 16, 64) = fdbabe1c...0640.
// Memory is N * 128 * r bytes from the registered allocator; the cost parameters are the caller's.
from "../hash/digest" import DIGEST_SHA256
from "../cipher/salsa20" import salsaCore
from "pbkdf2" import pbkdf2
from "../../mem/mem" import currentAllocator

fn le32(p: *ui8) -> ui32 {
    return (p[0] as ui32) | ((p[1] as ui32) << 8) | ((p[2] as ui32) << 16) | ((p[3] as ui32) << 24)
}

fn put32(p: *ui8, v: ui32) {
    p[0] = (v & 0xff) as ui8
    p[1] = ((v >> 8) & 0xff) as ui8
    p[2] = ((v >> 16) & 0xff) as ui8
    p[3] = ((v >> 24) & 0xff) as ui8
}

/// Salsa20/8 core on the 64-byte block `b`, in place (RFC 7914 section 3, with feed-forward).
fn salsa8(b: *ui8) {
    local input: [ui32; 16]
    local output: [ui32; 16]
    local i: usize = 0
    while i < 16 {
        input[i] = le32(&b[i * 4])
        i = i + 1
    }
    salsaCore(&input[0], &output[0], 4)
    i = 0
    while i < 16 {
        put32(&b[i * 4], output[i])
        i = i + 1
    }
}

/// BlockMix (RFC 7914 section 4): `b` holds 2r blocks of 64 bytes; `y` receives the mixed blocks in the order
/// even blocks first, then odd blocks.
fn blockMix(b: *ui8, r: usize, y: *ui8) {
    local x: [ui8; 64]
    local i: usize = 0
    while i < 64 {
        x[i] = b[(2 * r - 1) * 64 + i]
        i = i + 1
    }
    local blk: usize = 0
    while blk < 2 * r {
        local k: usize = 0
        while k < 64 {
            x[k] = x[k] ^ b[blk * 64 + k]
            k = k + 1
        }
        salsa8(&x[0])
        local dst: usize = r + (blk - 1) / 2
        if blk % 2 == 0 { dst = blk / 2 }
        k = 0
        while k < 64 {
            y[dst * 64 + k] = x[k]
            k = k + 1
        }
        blk = blk + 1
    }
}

/// Integerify (section 4): the first 8 bytes of the last 64-byte block as a little-endian integer.
fn integerify(b: *ui8, r: usize) -> ui64 {
    local base: usize = (2 * r - 1) * 64
    local v: ui64 = 0
    local i: usize = 0
    while i < 8 {
        v = v | ((b[base + i] as ui64) << ((8 * i) as ui64))
        i = i + 1
    }
    return v
}

/// ROMix (section 4) on the 128r-byte chunk `b`, using `v` (N * 128r bytes) and the scratch buffers `x` and `y`.
fn roMix(b: *ui8, r: usize, n: usize, v: *ui8, x: *ui8, y: *ui8) {
    local len: usize = 128 * r
    local i: usize = 0
    while i < len {
        x[i] = b[i]
        i = i + 1
    }
    local k: usize = 0
    while k < n {
        i = 0
        while i < len {
            v[k * len + i] = x[i]
            i = i + 1
        }
        blockMix(x, r, y)
        i = 0
        while i < len {
            x[i] = y[i]
            i = i + 1
        }
        k = k + 1
    }
    k = 0
    while k < n {
        local j: usize = (integerify(x, r) % (n as ui64)) as usize
        i = 0
        while i < len {
            x[i] = x[i] ^ v[j * len + i]
            i = i + 1
        }
        blockMix(x, r, y)
        i = 0
        while i < len {
            x[i] = y[i]
            i = i + 1
        }
        k = k + 1
    }
    i = 0
    while i < len {
        b[i] = x[i]
        i = i + 1
    }
}

/// scrypt(P, S, N, r, p) into `out` (`outLen` bytes). N must be a power of two above 1; r and p are at least 1. False
/// for invalid parameters.
export fn scrypt(pass: *ui8, plen: usize, salt: *ui8, slen: usize, n: usize, r: usize, p: usize, out: *ui8, outLen: usize) -> bool {
    if n < 2 || (n & (n - 1)) != 0 || r == 0 || p == 0 { return false }
    local chunk: usize = 128 * r
    local bl: usize = p * chunk
    local b: *ui8 = currentAllocator.alloc(bl, 1) as *ui8
    local v: *ui8 = currentAllocator.alloc(n * chunk, 1) as *ui8
    local x: *ui8 = currentAllocator.alloc(chunk, 1) as *ui8
    local y: *ui8 = currentAllocator.alloc(chunk, 1) as *ui8
    if b == nil || v == nil || x == nil || y == nil { panic("scrypt: out of memory") }
    pbkdf2(DIGEST_SHA256, pass, plen, salt, slen, 1, b, bl)
    local i: usize = 0
    while i < p {
        roMix(&b[i * chunk], r, n, v, x, y)
        i = i + 1
    }
    pbkdf2(DIGEST_SHA256, pass, plen, b, bl, 1, out, outLen)
    currentAllocator.free(y as *void)
    currentAllocator.free(x as *void)
    currentAllocator.free(v as *void)
    currentAllocator.free(b as *void)
    return true
}
