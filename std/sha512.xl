// std/sha512: SHA-512 and SHA-384 (FIPS 180-4), one-shot. Pure xl, no allocation.

global K: [ui64; 80] = [
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
]

fn rotr(x: ui64, n: ui64) -> ui64 {
    return (x >> n) | (x << (64 - n))
}

fn block(h: *ui64, p: *ui8) {
    local w: [ui64; 80]
    local i: usize = 0
    while i < 16 {
        local v: ui64 = 0
        local j: usize = 0
        while j < 8 {
            v = (v << 8) | (p[i * 8 + j] as ui64)
            j = j + 1
        }
        w[i] = v
        i = i + 1
    }
    while i < 80 {
        local s0: ui64 = rotr(w[i - 15], 1) ^ rotr(w[i - 15], 8) ^ (w[i - 15] >> 7)
        local s1: ui64 = rotr(w[i - 2], 19) ^ rotr(w[i - 2], 61) ^ (w[i - 2] >> 6)
        w[i] = w[i - 16] + s0 + w[i - 7] + s1
        i = i + 1
    }
    local a: ui64 = h[0]
    local b: ui64 = h[1]
    local c: ui64 = h[2]
    local d: ui64 = h[3]
    local e: ui64 = h[4]
    local f: ui64 = h[5]
    local g: ui64 = h[6]
    local hh: ui64 = h[7]
    i = 0
    while i < 80 {
        local S1: ui64 = rotr(e, 14) ^ rotr(e, 18) ^ rotr(e, 41)
        local ch: ui64 = (e & f) ^ (~e & g)
        local t1: ui64 = hh + S1 + ch + K[i] + w[i]
        local S0: ui64 = rotr(a, 28) ^ rotr(a, 34) ^ rotr(a, 39)
        local maj: ui64 = (a & b) ^ (a & c) ^ (b & c)
        local t2: ui64 = S0 + maj
        hh = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
        i = i + 1
    }
    h[0] = h[0] + a
    h[1] = h[1] + b
    h[2] = h[2] + c
    h[3] = h[3] + d
    h[4] = h[4] + e
    h[5] = h[5] + f
    h[6] = h[6] + g
    h[7] = h[7] + hh
}

fn run(h: *ui64, data: *ui8, n: usize, out: *ui8, outLen: usize) {
    local done: usize = 0
    while n - done >= 128 {
        block(h, &data[done])
        done = done + 128
    }
    local tail: [ui8; 256]
    local rest: usize = n - done
    local i: usize = 0
    while i < 256 {
        tail[i] = 0
        i = i + 1
    }
    i = 0
    while i < rest {
        tail[i] = data[done + i]
        i = i + 1
    }
    tail[rest] = 0x80
    local total: usize = 128
    if rest >= 112 { total = 256 }
    local bits: ui64 = (n as ui64) << 3
    i = 0
    while i < 8 {
        tail[total - 1 - i] = ((bits >> ((i as ui64) * 8)) & 0xff) as ui8
        i = i + 1
    }
    block(h, &tail[0])
    if total == 256 { block(h, &tail[128]) }
    i = 0
    while i < outLen {
        out[i] = ((h[i / 8] >> ((7 - (i % 8) as ui64) * 8)) & 0xff) as ui8
        i = i + 1
    }
}

/// SHA-512 of `data[0..n]` into the 64 bytes at `out`.
export fn sha512(data: *ui8, n: usize, out: *ui8) {
    local h: [ui64; 8]
    h[0] = 0x6a09e667f3bcc908
    h[1] = 0xbb67ae8584caa73b
    h[2] = 0x3c6ef372fe94f82b
    h[3] = 0xa54ff53a5f1d36f1
    h[4] = 0x510e527fade682d1
    h[5] = 0x9b05688c2b3e6c1f
    h[6] = 0x1f83d9abfb41bd6b
    h[7] = 0x5be0cd19137e2179
    run(&h[0], data, n, out, 64)
}

/// SHA-384 of `data[0..n]` into the 48 bytes at `out`.
export fn sha384(data: *ui8, n: usize, out: *ui8) {
    local h: [ui64; 8]
    h[0] = 0xcbbb9d5dc1059ed8
    h[1] = 0x629a292a367cd507
    h[2] = 0x9159015a3070dd17
    h[3] = 0x152fecd8f70e5939
    h[4] = 0x67332667ffc00b31
    h[5] = 0x8eb44a8768581511
    h[6] = 0xdb0c2e0d64f98fa7
    h[7] = 0x47b5481dbefa4fa4
    run(&h[0], data, n, out, 48)
}
