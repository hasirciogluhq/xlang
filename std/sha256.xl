// std/sha256: SHA-256 (FIPS 180-4). One-shot `sha256(data, n, out)` with a 32-byte digest, and a
// streaming `Sha256` state (init / update / final; copy the struct to snapshot a running hash).
// Pure xl, no tables outside `K`, no allocation.

global K: [ui32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

fn rotr(x: ui32, n: ui32) -> ui32 {
    return (x >> n) | (x << (32 - n))
}

/// Compresses one 64-byte block into `h[0..8]`.
fn block(h: *ui32, p: *ui8) {
    local w: [ui32; 64]
    local i: usize = 0
    while i < 16 {
        w[i] = ((p[i * 4] as ui32) << 24) | ((p[i * 4 + 1] as ui32) << 16) |
               ((p[i * 4 + 2] as ui32) << 8) | (p[i * 4 + 3] as ui32)
        i = i + 1
    }
    while i < 64 {
        local s0: ui32 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3)
        local s1: ui32 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10)
        w[i] = w[i - 16] + s0 + w[i - 7] + s1
        i = i + 1
    }
    local a: ui32 = h[0]
    local b: ui32 = h[1]
    local c: ui32 = h[2]
    local d: ui32 = h[3]
    local e: ui32 = h[4]
    local f: ui32 = h[5]
    local g: ui32 = h[6]
    local hh: ui32 = h[7]
    i = 0
    while i < 64 {
        local S1: ui32 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
        local ch: ui32 = (e & f) ^ (~e & g)
        local t1: ui32 = hh + S1 + ch + K[i] + w[i]
        local S0: ui32 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
        local maj: ui32 = (a & b) ^ (a & c) ^ (b & c)
        local t2: ui32 = S0 + maj
        hh = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
        i = i + 1
    }
    h[0] = h[0] + a
    h[1] = h[1] + b
    h[2] = h[2] + c
    h[3] = h[3] + d
    h[4] = h[4] + e
    h[5] = h[5] + f
    h[6] = h[6] + g
    h[7] = h[7] + hh
}

/// Streaming SHA-256 state. A plain struct copy (`*a = *b`) snapshots a running hash.
export struct Sha256 {
    h: [ui32; 8]
    buf: [ui8; 64]
    used: usize
    total: ui64
}

export fn sha256Init(s: *Sha256) {
    s.h[0] = 0x6a09e667
    s.h[1] = 0xbb67ae85
    s.h[2] = 0x3c6ef372
    s.h[3] = 0xa54ff53a
    s.h[4] = 0x510e527f
    s.h[5] = 0x9b05688c
    s.h[6] = 0x1f83d9ab
    s.h[7] = 0x5be0cd19
    s.used = 0
    s.total = 0
}

export fn sha256Update(s: *Sha256, data: *ui8, n: usize) {
    s.total = s.total + (n as ui64)
    local i: usize = 0
    while i < n {
        s.buf[s.used] = data[i]
        s.used = s.used + 1
        i = i + 1
        if s.used == 64 {
            block(&s.h[0], &s.buf[0])
            s.used = 0
        }
    }
}

/// Finishes a copy of the state: `s` itself keeps absorbing afterwards.
export fn sha256Final(s: *Sha256, out: *ui8) {
    local c: Sha256 = *s
    local bits: ui64 = c.total << 3
    c.buf[c.used] = 0x80
    c.used = c.used + 1
    if c.used > 56 {
        while c.used < 64 {
            c.buf[c.used] = 0
            c.used = c.used + 1
        }
        block(&c.h[0], &c.buf[0])
        c.used = 0
    }
    while c.used < 56 {
        c.buf[c.used] = 0
        c.used = c.used + 1
    }
    local i: usize = 0
    while i < 8 {
        c.buf[63 - i] = ((bits >> ((i as ui64) * 8)) & 0xff) as ui8
        i = i + 1
    }
    block(&c.h[0], &c.buf[0])
    i = 0
    while i < 8 {
        out[i * 4] = (c.h[i] >> 24) as ui8
        out[i * 4 + 1] = ((c.h[i] >> 16) & 0xff) as ui8
        out[i * 4 + 2] = ((c.h[i] >> 8) & 0xff) as ui8
        out[i * 4 + 3] = (c.h[i] & 0xff) as ui8
        i = i + 1
    }
}

/// SHA-256 of `data[0..n]` into the 32 bytes at `out`.
export fn sha256(data: *ui8, n: usize, out: *ui8) {
    local s: Sha256
    sha256Init(&s)
    sha256Update(&s, data, n)
    sha256Final(&s, out)
}
