// std/sha256: SHA-256 (FIPS 180-4). One-shot `sha256(data, n, out)` with a 32-byte digest; the
// streaming state is not exposed yet. Pure xl, no tables outside `K`, no allocation.

global K: [ui32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

fn rotr(x: ui32, n: ui32) -> ui32 {
    return (x >> n) | (x << (32 - n))
}

/// Compresses one 64-byte block into `h[0..8]`.
fn block(h: *ui32, p: *ui8) {
    local w: [ui32; 64]
    local i: usize = 0
    while i < 16 {
        w[i] = ((p[i * 4] as ui32) << 24) | ((p[i * 4 + 1] as ui32) << 16) |
               ((p[i * 4 + 2] as ui32) << 8) | (p[i * 4 + 3] as ui32)
        i = i + 1
    }
    while i < 64 {
        local s0: ui32 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3)
        local s1: ui32 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10)
        w[i] = w[i - 16] + s0 + w[i - 7] + s1
        i = i + 1
    }
    local a: ui32 = h[0]
    local b: ui32 = h[1]
    local c: ui32 = h[2]
    local d: ui32 = h[3]
    local e: ui32 = h[4]
    local f: ui32 = h[5]
    local g: ui32 = h[6]
    local hh: ui32 = h[7]
    i = 0
    while i < 64 {
        local S1: ui32 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
        local ch: ui32 = (e & f) ^ (~e & g)
        local t1: ui32 = hh + S1 + ch + K[i] + w[i]
        local S0: ui32 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
        local maj: ui32 = (a & b) ^ (a & c) ^ (b & c)
        local t2: ui32 = S0 + maj
        hh = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
        i = i + 1
    }
    h[0] = h[0] + a
    h[1] = h[1] + b
    h[2] = h[2] + c
    h[3] = h[3] + d
    h[4] = h[4] + e
    h[5] = h[5] + f
    h[6] = h[6] + g
    h[7] = h[7] + hh
}

/// SHA-256 of `data[0..n]` into the 32 bytes at `out`.
export fn sha256(data: *ui8, n: usize, out: *ui8) {
    local h: [ui32; 8]
    h[0] = 0x6a09e667
    h[1] = 0xbb67ae85
    h[2] = 0x3c6ef372
    h[3] = 0xa54ff53a
    h[4] = 0x510e527f
    h[5] = 0x9b05688c
    h[6] = 0x1f83d9ab
    h[7] = 0x5be0cd19

    local done: usize = 0
    while n - done >= 64 {
        block(&h[0], &data[done])
        done = done + 64
    }
    // Final one or two blocks: remaining bytes, 0x80, zero padding, 64-bit bit length.
    local tail: [ui8; 128]
    local rest: usize = n - done
    local i: usize = 0
    while i < 128 {
        tail[i] = 0
        i = i + 1
    }
    i = 0
    while i < rest {
        tail[i] = data[done + i]
        i = i + 1
    }
    tail[rest] = 0x80
    local total: usize = 64
    if rest >= 56 { total = 128 }
    local bits: ui64 = (n as ui64) << 3
    i = 0
    while i < 8 {
        tail[total - 1 - i] = ((bits >> ((i as ui64) * 8)) & 0xff) as ui8
        i = i + 1
    }
    block(&h[0], &tail[0])
    if total == 128 { block(&h[0], &tail[64]) }

    i = 0
    while i < 8 {
        out[i * 4] = (h[i] >> 24) as ui8
        out[i * 4 + 1] = ((h[i] >> 16) & 0xff) as ui8
        out[i * 4 + 2] = ((h[i] >> 8) & 0xff) as ui8
        out[i * 4 + 3] = (h[i] & 0xff) as ui8
        i = i + 1
    }
}
