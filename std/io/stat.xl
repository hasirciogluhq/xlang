// std/io/stat: file metadata. The kernel's buffer is read as little-endian words (every supported CPU is little-endian).
// Linux: statx (x86-64 332, arm64 291; include/uapi/linux/stat.h): stx_mode ui16 at 28, stx_size ui64 at 40, stx_mtime.tv_sec i64 at
// 112; the call follows symbolic links (AT_SYMLINK_NOFOLLOW is not set). macOS: stat from libSystem, 64-bit layout (sys/stat.h):
// st_mode ui16 at 4, st_mtimespec.tv_sec i64 at 48, st_size i64 at 96. Windows: NtQueryInformationFile through `sysFileInfo`
// (std/sys/windows.xl; layouts in docs/std/system.md); the mode is synthesized from the file attributes.

/// The file kind bits of st_mode (S_IFMT, mode 0170000) and the directory value (S_IFDIR, 0040000).
export define FILE_MODE_TYPE = 61440
export define FILE_MODE_DIR = 16384

export struct FileStat {
    mode: ui32
    size: i64
    mtimeSec: i64
    ok: bool
}

#if os == "linux"

#if arch == "x86_64"
define STAT_STATX = 332
#elif arch == "aarch64"
define STAT_STATX = 291
#endif
define STAT_AT_FDCWD = -100
define STAT_MASK_BASIC = 2047

export fn fsStat(path: *ui8) -> FileStat {
    local b: [ui64; 32]
    if syscall(STAT_STATX, STAT_AT_FDCWD, path, 0, STAT_MASK_BASIC, &b[0]) < 0 { return FileStat { ok: false } }
    return FileStat { mode: ((b[3] >> 32) & 0xffff) as ui32, size: b[5] as i64, mtimeSec: b[14] as i64, ok: true }
}

#elif os == "macos"

@library("System") declare fn stat(path: *ui8, buf: *void) -> i32

export fn fsStat(path: *ui8) -> FileStat {
    local b: [ui64; 32]
    if stat(path, &b[0] as *void) != 0 { return FileStat { ok: false } }
    return FileStat { mode: ((b[0] >> 32) & 0xffff) as ui32, size: b[12] as i64, mtimeSec: b[6] as i64, ok: true }
}

#else

from "../sys/windows" import sysFileInfo

define STAT_ATTR_READONLY = 1
define STAT_ATTR_DIRECTORY = 16
define STAT_REGULAR = 33188                             // S_IFREG | 0644
define STAT_DIRECTORY = 16877                           // S_IFDIR | 0755
define STAT_TICKS_PER_SECOND = 10000000                 // FILETIME units (100 ns)
define STAT_EPOCH_DELTA = 11644473600                   // seconds from 1601-01-01 to 1970-01-01

export fn fsStat(path: *ui8) -> FileStat {
    local info: [i64; 3]
    if !sysFileInfo(path, &info[0]) { return FileStat { ok: false } }
    local mode: ui32 = (info[0] & STAT_ATTR_DIRECTORY) != 0 ? STAT_DIRECTORY : STAT_REGULAR
    return FileStat {
        mode: (info[0] & STAT_ATTR_READONLY) != 0 ? mode & 0xfffffedb : mode,        // clear the write bits 0222
        size: info[1], mtimeSec: info[2] / STAT_TICKS_PER_SECOND - STAT_EPOCH_DELTA, ok: true,
    }
}

#endif
