// std/auth/jws: asymmetric JSON Web Signatures for compact tokens (RFC 7515, https://www.rfc-editor.org/rfc/rfc7515) with keys in
// JSON Web Key form (RFC 7517, https://www.rfc-editor.org/rfc/rfc7517) and the JWK thumbprint of RFC 7638
// (https://www.rfc-editor.org/rfc/rfc7638). The algorithms are those of RFC 7518 (https://www.rfc-editor.org/rfc/rfc7518) and
// RFC 8037 (https://www.rfc-editor.org/rfc/rfc8037):
//   RS256  RSASSA-PKCS1-v1_5 with SHA-256 (RFC 7518 section 3.3); RSA key with n and e
//   ES256  ECDSA with P-256 and SHA-256 (RFC 7518 section 3.4); EC key with crv "P-256", x and y; the signature is R || S (64 bytes)
//   EdDSA  Ed25519 (RFC 8037 section 3.2); OKP key with crv "Ed25519" and x; the signature is 64 bytes
// The header's alg must equal the algorithm the caller names, so a token cannot choose another one, and "none" is refused.
// Member values are the base64url strings of the key (RFC 7518 section 6). Keys are limited to 4096-bit RSA moduli.
// Not done: x5c and x5t certificate members, key selection by kid, JWK sets, and the other JWS algorithms (ES384, RS384,
// RS512, PS256).
from "../encoding/base64" import base64UrlDecodeRaw, base64UrlEncodeRaw
from "../encoding/jsonfull" import jsonPointerGet
from "../crypto/hash/digest" import digest, DIGEST_SHA256
from "../crypto/sig/rsa" import rsaVerifyPkcs1
from "../crypto/sig/ecdsa" import ecdsaVerify, ECDSA_P256
from "../crypto/sig/ed25519" import ed25519Verify
from "../str/str" import fromParts, eq
from "../str/string" import String

define JWS_MAX_BYTES = 512

/// The raw JSON value (quotes included) of the member at `pointer` (an RFC 6901 pointer such as "/kty"); empty when absent.
fn rawMember(jwk: str, pointer: str) -> str {
    return jsonPointerGet(jwk.ptr, jwk.len, pointer.ptr, pointer.len)
}

/// True when the member at `pointer` is the JSON string `value`.
fn memberIs(jwk: str, pointer: str, value: str) -> bool {
    local raw: str = rawMember(jwk, pointer)
    if raw.len != value.len + 2 || raw[0] != 34 { return false }
    return eq(fromParts(&raw.ptr[1], value.len), value)
}

/// Decodes the base64url string member at `pointer` into `out` (capacity `cap`) and returns the byte count, or -1 when the
/// member is missing, is not a string, is not valid base64url, or decodes to more than `cap` bytes.
fn memberBytes(jwk: str, pointer: str, out: *ui8, cap: usize) -> isize {
    local raw: str = rawMember(jwk, pointer)
    if raw.len < 2 || raw[0] != 34 { return -1 }
    local body: str = fromParts(&raw.ptr[1], raw.len - 2)
    local tmp: [ui8; 1024]
    if body.len > 1024 { return -1 }
    local n: isize = base64UrlDecodeRaw(body.ptr, body.len, &tmp[0])
    if n < 0 || (n as usize) > cap { return -1 }
    local i: usize = 0
    while i < (n as usize) {
        out[i] = tmp[i]
        i = i + 1
    }
    return n
}

/// RS256: the signature over `input` under the RSA key `jwk`.
fn verifyRs256(jwk: str, input: str, sig: *ui8, slen: usize) -> bool {
    if !memberIs(jwk, "/kty", "RSA") { return false }
    local n: [ui8; JWS_MAX_BYTES]
    local e: [ui8; JWS_MAX_BYTES]
    local nl: isize = memberBytes(jwk, "/n", &n[0], JWS_MAX_BYTES)
    local el: isize = memberBytes(jwk, "/e", &e[0], JWS_MAX_BYTES)
    if nl <= 0 || el <= 0 { return false }
    local h: [ui8; 64]
    if !digest(DIGEST_SHA256, input.ptr, input.len, &h[0]) { return false }
    return rsaVerifyPkcs1(&n[0], nl as usize, &e[0], el as usize, sig, slen, DIGEST_SHA256, &h[0], 32)
}

/// ES256: R || S over the SHA-256 digest of `input` under the P-256 key `jwk`.
fn verifyEs256(jwk: str, input: str, sig: *ui8, slen: usize) -> bool {
    if !memberIs(jwk, "/kty", "EC") || !memberIs(jwk, "/crv", "P-256") { return false }
    if slen != 64 { return false }
    local x: [ui8; 32]
    local y: [ui8; 32]
    if memberBytes(jwk, "/x", &x[0], 32) != 32 { return false }
    if memberBytes(jwk, "/y", &y[0], 32) != 32 { return false }
    local h: [ui8; 64]
    if !digest(DIGEST_SHA256, input.ptr, input.len, &h[0]) { return false }
    return ecdsaVerify(ECDSA_P256, &x[0], &y[0], &h[0], 32, sig, &sig[32])
}

/// EdDSA (Ed25519): the signature over the signing input under the OKP key `jwk`.
fn verifyEdDsa(jwk: str, input: str, sig: *ui8, slen: usize) -> bool {
    if !memberIs(jwk, "/kty", "OKP") || !memberIs(jwk, "/crv", "Ed25519") { return false }
    if slen != 64 { return false }
    local x: [ui8; 32]
    if memberBytes(jwk, "/x", &x[0], 32) != 32 { return false }
    return ed25519Verify(&x[0], input.ptr, input.len, sig)
}

/// Verifies the compact token `token` (RFC 7515 section 5.2) with the JWK `jwk` and the algorithm `alg` ("RS256", "ES256" or
/// "EdDSA"). Returns true only when the header's alg is `alg` and the signature verifies over the signing input.
export fn jwtVerifyWithJwk(token: str, jwk: str, alg: str) -> bool {
    local first: i64 = -1
    local last: i64 = -1
    local i: usize = 0
    while i < token.len {
        if token[i] == 46 {
            if first < 0 { first = i as i64 }
            last = i as i64
        }
        i = i + 1
    }
    if first <= 0 || last <= first { return false }
    local header: str = fromParts(token.ptr, first as usize)
    local input: str = fromParts(token.ptr, last as usize)
    local sigText: str = fromParts(&token.ptr[(last as usize) + 1], token.len - (last as usize) - 1)
    local hbuf: [ui8; 512]
    if header.len > 680 { return false }
    local hl: isize = base64UrlDecodeRaw(header.ptr, header.len, &hbuf[0])
    if hl <= 0 { return false }
    local headerJson: str = fromParts(&hbuf[0], hl as usize)
    local headerAlg: str = rawMember(headerJson, "/alg")
    if headerAlg.len != alg.len + 2 || headerAlg[0] != 34 { return false }
    if !eq(fromParts(&headerAlg.ptr[1], alg.len), alg) { return false }
    local sig: [ui8; 1024]
    if sigText.len > 1024 { return false }
    local sl: isize = base64UrlDecodeRaw(sigText.ptr, sigText.len, &sig[0])
    if sl <= 0 { return false }
    if eq(alg, "RS256") { return verifyRs256(jwk, input, &sig[0], sl as usize) }
    if eq(alg, "ES256") { return verifyEs256(jwk, input, &sig[0], sl as usize) }
    if eq(alg, "EdDSA") { return verifyEdDsa(jwk, input, &sig[0], sl as usize) }
    return false
}

/// The JWK thumbprint (RFC 7638 section 3): SHA-256 over the canonical JSON of the required members (lexicographic order, no
/// white space), encoded in base64url without padding. Returns the encoded text; empty for a key type it does not know.
export fn jwkThumbprintSha256(jwk: str) -> String {
    local canon: String = String()
    if memberIs(jwk, "/kty", "RSA") {
        canon.append("{\"e\":")
        canon.append(rawMember(jwk, "/e"))
        canon.append(",\"kty\":\"RSA\",\"n\":")
        canon.append(rawMember(jwk, "/n"))
        canon.append("}")
    } else if memberIs(jwk, "/kty", "EC") {
        canon.append("{\"crv\":")
        canon.append(rawMember(jwk, "/crv"))
        canon.append(",\"kty\":\"EC\",\"x\":")
        canon.append(rawMember(jwk, "/x"))
        canon.append(",\"y\":")
        canon.append(rawMember(jwk, "/y"))
        canon.append("}")
    } else if memberIs(jwk, "/kty", "OKP") {
        canon.append("{\"crv\":")
        canon.append(rawMember(jwk, "/crv"))
        canon.append(",\"kty\":\"OKP\",\"x\":")
        canon.append(rawMember(jwk, "/x"))
        canon.append("}")
    } else {
        return String()
    }
    local h: [ui8; 32]
    local text: str = canon.asStr()
    if !digest(DIGEST_SHA256, text.ptr, text.len, &h[0]) { return String() }
    local enc: [ui8; 64]
    local el: usize = base64UrlEncodeRaw(&h[0], 32, &enc[0])
    local out: String = String()
    out.append(fromParts(&enc[0], el))
    return out
}
