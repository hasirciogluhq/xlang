// std/auth/sigv4: AWS Signature Version 4 (AWS General Reference, "Signature Version 4 signing process",
// https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_aws-signing.html). The caller builds the canonical request
// (method, canonical URI and query, canonical headers, signed header names, hashed payload) and the credential scope;
// these functions do the keyed steps:
//   kDate    = HMAC-SHA256("AWS4" + secret, YYYYMMDD)
//   kRegion  = HMAC-SHA256(kDate, region)
//   kService = HMAC-SHA256(kRegion, service)
//   kSigning = HMAC-SHA256(kService, "aws4_request")
//   signature = hex(HMAC-SHA256(kSigning, stringToSign))
// stringToSign = "AWS4-HMAC-SHA256" LF amzDate LF scope LF hex(SHA256(canonicalRequest)).
// Test vector (AWS documentation, IAM ListUsers example): secret wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY, date 20150830,
// region us-east-1, service iam, amzDate 20150830T123600Z -> signature 5d672d79c15b13162d9279b0855cfba6789a8edb4c82c400e06b5924a6f2b5d7.
from "../crypto/hash/mac" import hmac
from "../crypto/hash/digest" import DIGEST_SHA256
from "../encoding/hex" import hexEncode
from "../str/string" import String
from "../str/str" import fromParts
from "../mem/mem" import currentAllocator

/// HMAC-SHA256 of `msg` under the byte key `key` into 32 bytes at `out`.
fn mac256(key: str, msg: str, out: *ui8) {
    hmac(DIGEST_SHA256, key.ptr, key.len, msg.ptr, msg.len, out)
}

/// The 32-byte signing key for the date (YYYYMMDD), region, and service (SigV4 derivation steps above).
export fn sigv4SigningKey(secret: str, dateStamp: str, region: str, service: str, out: *ui8) {
    local prefix: String = String()
    prefix.append("AWS4")
    prefix.append(secret)
    local kDate: [ui8; 32]
    mac256(prefix.asStr(), dateStamp, &kDate[0])
    local kRegion: [ui8; 32]
    mac256(fromParts(&kDate[0], 32), region, &kRegion[0])
    local kService: [ui8; 32]
    mac256(fromParts(&kRegion[0], 32), service, &kService[0])
    mac256(fromParts(&kService[0], 32), "aws4_request", out)
}

/// The signature of `stringToSign` as 64 lowercase hex characters, using the signing key derived from the secret, date,
/// region and service.
export fn sigv4Signature(secret: str, dateStamp: str, region: str, service: str, stringToSign: str) -> String {
    local key: [ui8; 32]
    sigv4SigningKey(secret, dateStamp, region, service, &key[0])
    local mac: [ui8; 32]
    mac256(fromParts(&key[0], 32), stringToSign, &mac[0])
    local hx: [ui8; 64]
    hexEncode(&mac[0], 32, &hx[0])
    local out: String = String()
    out.append(fromParts(&hx[0], 64))
    return out
}

/// The string to sign: the algorithm name, the request time (YYYYMMDDTHHMMSSZ), the credential scope and the hex SHA-256 of
/// the canonical request (which the caller computes with std/crypto/hash/sha256, hex encoded).
export fn sigv4StringToSign(amzDate: str, scope: str, canonicalRequestHashHex: str) -> String {
    local out: String = String()
    out.append("AWS4-HMAC-SHA256\n")
    out.append(amzDate)
    out.append("\n")
    out.append(scope)
    out.append("\n")
    out.append(canonicalRequestHashHex)
    return out
}
