// std/auth/jwt: JSON Web Signature with HMAC-SHA-256 (RFC 7515 section 3 and appendix A.1, JWS compact serialization) and
// the JWT claims convention (RFC 7519, https://www.rfc-editor.org/rfc/rfc7519). A compact token is
//   BASE64URL(header) "." BASE64URL(payload) "." BASE64URL(HMAC-SHA-256(key, header "." payload))
// with base64url without padding (RFC 4648 section 5). Only HS256 is implemented here; asymmetric algorithms (RS256,
// ES256, EdDSA) need the signature modules and are planned with JWK (RFC 7517). The verifier never accepts "none"
// (RFC 7515 section 10.5 warns against it) and compares the signature in constant time.
from "../encoding/base64" import base64UrlEncodeRaw, base64UrlDecodeRaw
from "../crypto/hash/mac" import hmac
from "../crypto/hash/digest" import DIGEST_SHA256
from "../crypto/ct" import constantTimeEq
from "../str/string" import String
from "../str/str" import fromParts, eq
from "../encoding/jsonfull" import jsonPointerGet
from "../mem/mem" import currentAllocator

/// The length of the unpadded base64url text of `n` bytes (RFC 4648 section 5: 4n/3 rounded up).
fn b64urlLen(n: usize) -> usize {
    return (4 * n + 2) / 3
}

/// Signs `header` and `payload` (both JSON text) with `key` and returns the compact token (RFC 7515 section 5.1).
export fn jwtSignHs256(header: str, payload: str, key: *ui8, klen: usize) -> String {
    local hb: *ui8 = currentAllocator.alloc(b64urlLen(header.len) + 1, 1) as *ui8
    local pb: *ui8 = currentAllocator.alloc(b64urlLen(payload.len) + 1, 1) as *ui8
    if hb == nil || pb == nil { panic("jwtSignHs256: out of memory") }
    local hl: usize = base64UrlEncodeRaw(header.ptr, header.len, hb)
    local pl: usize = base64UrlEncodeRaw(payload.ptr, payload.len, pb)
    local signingInput: String = String()
    signingInput.append(fromParts(hb, hl))
    signingInput.append(".")
    signingInput.append(fromParts(pb, pl))
    local mac: [ui8; 32]
    hmac(DIGEST_SHA256, key, klen, signingInput.cstr(), signingInput.length(), &mac[0])
    local sb: *ui8 = currentAllocator.alloc(b64urlLen(32) + 1, 1) as *ui8
    if sb == nil { panic("jwtSignHs256: out of memory") }
    local sl: usize = base64UrlEncodeRaw(&mac[0], 32, sb)
    local token: String = String()
    token.append(signingInput.asStr())
    token.append(".")
    token.append(fromParts(sb, sl))
    currentAllocator.free(hb as *void)
    currentAllocator.free(pb as *void)
    currentAllocator.free(sb as *void)
    return token
}

/// Verifies an HS256 compact token against `key`. Returns true only when the header names alg HS256 and the signature
/// matches (compared in constant time). The header and payload are not parsed here: use jsonPointerGet on the decoded parts.
export fn jwtVerifyHs256(token: str, key: *ui8, klen: usize) -> bool {
    // the signing input is everything before the last dot; the signature is after it
    local last: i64 = -1
    local i: usize = 0
    while i < token.len {
        if token[i] == 46 { last = i as i64 }
        i = i + 1
    }
    if last < 0 { return false }
    local signingInput: str = fromParts(token.ptr, last as usize)
    local sigText: str = fromParts(&token.ptr[last as usize + 1], token.len - last as usize - 1)
    // the header must declare HS256 (checked on the raw base64url text of the known header value)
    local first: i64 = -1
    i = 0
    while i < token.len {
        if token[i] == 46 {
            first = i as i64
            break
        }
        i = i + 1
    }
    if first < 0 { return false }
    local headerText: str = fromParts(token.ptr, first as usize)
    local decoded: *ui8 = currentAllocator.alloc(headerText.len + 4, 1) as *ui8
    if decoded == nil { panic("jwtVerifyHs256: out of memory") }
    local dl: isize = base64UrlDecodeRaw(headerText.ptr, headerText.len, decoded)
    if dl <= 0 {
        currentAllocator.free(decoded as *void)
        return false
    }
    // the header's "alg" member, as raw JSON text, must be "HS256" with its quotes
    local alg: str = jsonPointerGet(decoded, dl as usize, "/alg", 4)
    local isHs256: bool = eq(alg, "\"HS256\"")
    currentAllocator.free(decoded as *void)
    if !isHs256 { return false }
    local mac: [ui8; 32]
    hmac(DIGEST_SHA256, key, klen, signingInput.ptr, signingInput.len, &mac[0])
    local want: *ui8 = currentAllocator.alloc(b64urlLen(32) + 1, 1) as *ui8
    if want == nil { panic("jwtVerifyHs256: out of memory") }
    local wl: usize = base64UrlEncodeRaw(&mac[0], 32, want)
    local ok: bool = wl == sigText.len && constantTimeEq(want, sigText.ptr, wl)
    currentAllocator.free(want as *void)
    return ok
}
