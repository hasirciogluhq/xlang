// std/cloud/s3: an S3 client (the Amazon S3 REST API, https://docs.aws.amazon.com/AmazonS3/latest/API/Welcome.html) that works with
// any S3-compatible provider. Requests are signed with AWS Signature Version 4 (https://docs.aws.amazon.com/IAM/latest/UserGuide/
// reference_aws-signing.html), the canonical request and the string to sign follow that document; the keyed steps are in std/auth.
//
// A provider is an S3Profile: its endpoint, its region, the addressing style it accepts (path style, bucket/key in the path; or
// virtual-hosted style, bucket in the host name; RFC-free but described in the S3 documentation), and its header rules. Some providers
// do not use every header that AWS uses, so the profile says which headers are required (a missing one is an error, the request is not
// sent) and which are optional (sent when the provider understands them, otherwise they are left out and a warning is recorded).
// Built-in profiles: AWS, a generic path-style endpoint (MinIO, Ceph RGW, SeaweedFS), Cloudflare R2, Google Cloud Storage (interop).
//
// Operations: PutObject, GetObject, HeadObject, DeleteObject, ListObjectsV2 (with continuation), multipart upload (create, upload part,
// complete, abort) and presigned GET URLs (query-string signing with UNSIGNED-PAYLOAD). Bodies are in memory; streaming request bodies
// use the multipart calls for large objects.
from "../http/client" import Client, Request, Response, Headers, CLIENT_OK, clientErrorText
from "../crypto/hash/sha256" import sha256
from "../encoding/hex" import hexEncode
from "../auth/sigv4" import sigv4Signature, sigv4StringToSign
from "../auth/oauth" import pctEncode
from "../str/str" import fromParts, eq, fromC
from "../str/string" import String
from "../collections/vec" import Vec
from "../sys" import sysClockSeconds
from "../time/date" import civilFromDays, DateTime

export define S3_ADDR_PATH = 1
export define S3_ADDR_VIRTUAL = 2

/// A provider: where it is, how it addresses buckets, and which request headers it needs.
export class S3Profile {
    name: String
    endpoint: String           // host name, with ":port" when not the default (no scheme, no path)
    region: String
    https: bool
    addressing: i32            // S3_ADDR_PATH or S3_ADDR_VIRTUAL
    requiresContentSha256: bool   // x-amz-content-sha256 must be sent (a missing one is an error)
    acceptsSessionToken: bool     // x-amz-security-token is understood

    fn init(self) {
        self.name = String()
        self.endpoint = String()
        self.region = String()
        self.https = true
        self.addressing = S3_ADDR_VIRTUAL
        self.requiresContentSha256 = false
        self.acceptsSessionToken = true
    }
}

/// AWS S3 in a region: virtual-hosted style, the full header set.
export fn s3ProfileAws(region: str) -> S3Profile {
    local p: S3Profile = S3Profile()
    p.name.append("aws")
    if eq(region, "us-east-1") {
        p.endpoint.append("s3.amazonaws.com")
    } else {
        p.endpoint.append("s3.")
        p.endpoint.append(region)
        p.endpoint.append(".amazonaws.com")
    }
    p.region.append(region)
    p.addressing = S3_ADDR_VIRTUAL
    p.requiresContentSha256 = true
    return p
}

/// A path-style endpoint at `host` (MinIO, Ceph RGW, SeaweedFS and other S3-compatible servers): the bucket is in the path. The
/// region is used for the signature scope and defaults to us-east-1 in most of them.
export fn s3ProfileGeneric(host: str, region: str, https: bool) -> S3Profile {
    local p: S3Profile = S3Profile()
    p.name.append("generic")
    p.endpoint.append(host)
    p.region.append(region)
    p.https = https
    p.addressing = S3_ADDR_PATH
    p.requiresContentSha256 = false
    p.acceptsSessionToken = false
    return p
}

/// Cloudflare R2: the account endpoint, region "auto", virtual-hosted style.
export fn s3ProfileR2(accountId: str) -> S3Profile {
    local p: S3Profile = S3Profile()
    p.name.append("r2")
    p.endpoint.append(accountId)
    p.endpoint.append(".r2.cloudflarestorage.com")
    p.region.append("auto")
    p.addressing = S3_ADDR_PATH
    p.requiresContentSha256 = false
    p.acceptsSessionToken = false
    return p
}

/// Google Cloud Storage in its S3 interoperability mode (HMAC keys): the storage.googleapis.com endpoint, region "auto".
export fn s3ProfileGcs() -> S3Profile {
    local p: S3Profile = S3Profile()
    p.name.append("gcs")
    p.endpoint.append("storage.googleapis.com")
    p.region.append("auto")
    p.addressing = S3_ADDR_VIRTUAL
    p.requiresContentSha256 = false
    p.acceptsSessionToken = false
    return p
}

/// The result of an operation: the HTTP status, the body text (or the error text), the response header wanted (ETag), and any
/// error code the provider reported ("NoSuchKey", "AccessDenied", ...).
export class S3Result {
    ok: bool
    status: i32
    code: String
    message: String
    body: String
    etag: String
    contentType: String
    clientError: i32

    fn init(self) {
        self.ok = false
        self.status = 0
        self.code = String()
        self.message = String()
        self.body = String()
        self.etag = String()
        self.contentType = String()
        self.clientError = 0
    }
}

/// One object of a listing.
export class S3Object {
    key: String
    size: i64
    etag: String
    lastModified: String

    fn init(self) {
        self.key = String()
        self.size = 0
        self.etag = String()
        self.lastModified = String()
    }
}

/// A listing page: the objects, whether more follow, and the token that fetches the next page.
export class S3List {
    objects: Vec<S3Object>
    truncated: bool
    nextToken: String
    result: S3Result

    fn init(self) {
        self.objects = Vec<S3Object>()
        self.truncated = false
        self.nextToken = String()
        self.result = S3Result()
    }
}

/// The client: a profile, credentials, the warnings recorded while sending (optional headers a provider ignores), and the HTTP client.
export class S3Client {
    profile: S3Profile
    accessKey: String
    secretKey: String
    sessionToken: String
    warnings: Vec<String>
    http: Client

    fn init(self, profile: S3Profile, accessKey: str, secretKey: str) {
        self.profile = profile
        self.accessKey = String()
        self.accessKey.append(accessKey)
        self.secretKey = String()
        self.secretKey.append(secretKey)
        self.sessionToken = String()
        self.warnings = Vec<String>()
        self.http = Client()
    }

    /// Sets the temporary credential token (AWS STS); ignored with a warning by providers that do not understand it.
    fn UseSessionToken(self, token: str) {
        self.sessionToken = String()
        self.sessionToken.append(token)
    }

    /// Number of warnings recorded so far. Each is text such as "x-amz-security-token not sent: provider does not accept it".
    fn Warnings(self) -> usize {
        return self.warnings.length()
    }

    fn PutObject(self, bucket: str, key: str, contentType: str, body: str) -> S3Result {
        return self.send("PUT", bucket, key, "", "", contentType, body)
    }

    /// Creates a bucket (PUT /bucket). Regions other than us-east-1 need a LocationConstraint body on AWS; providers that take none ignore it.
    fn CreateBucket(self, bucket: str) -> S3Result {
        return self.send("PUT", bucket, "", "", "", "", "")
    }

    fn GetObject(self, bucket: str, key: str) -> S3Result {
        return self.send("GET", bucket, key, "", "", "", "")
    }

    fn HeadObject(self, bucket: str, key: str) -> S3Result {
        return self.send("HEAD", bucket, key, "", "", "", "")
    }

    fn DeleteObject(self, bucket: str, key: str) -> S3Result {
        return self.send("DELETE", bucket, key, "", "", "", "")
    }

    /// One page of ListObjectsV2. `token` is the continuation token of the previous page, or "" for the first.
    fn ListObjectsV2(self, bucket: str, prefix: str, token: str, maxKeys: i32) -> S3List {
        local query: String = String()
        query.append("list-type=2")
        if prefix.len > 0 {
            query.append("&prefix=")
            query.append(pctEncode(prefix).asStr())
        }
        if token.len > 0 {
            query.append("&continuation-token=")
            query.append(pctEncode(token).asStr())
        }
        if maxKeys > 0 {
            query.append("&max-keys=")
            query.append(numberText(maxKeys as i64).asStr())
        }
        local out: S3List = S3List()
        out.result = self.send("GET", bucket, "", query.asStr(), "", "", "")
        if !out.result.ok { return out }
        local body: str = out.result.body.asStr()
        out.truncated = eq(xmlTag(body, "IsTruncated"), "true")
        out.nextToken.append(xmlTag(body, "NextContinuationToken"))
        local pos: usize = 0
        while true {
            local item: str = xmlBetween(body, "<Contents>", "</Contents>", pos)
            if item.len == 0 { break }
            local o: S3Object = S3Object()
            o.key.append(xmlTag(item, "Key"))
            o.size = parseI64(xmlTag(item, "Size"))
            o.etag.append(xmlTag(item, "ETag"))
            o.lastModified.append(xmlTag(item, "LastModified"))
            out.objects.push(o)
            pos = (ptrOffset(body, item) + item.len)
        }
        return out
    }

    /// Starts a multipart upload; the UploadId is in the result body (xmlTag "UploadId").
    fn CreateMultipartUpload(self, bucket: str, key: str, contentType: str) -> S3Result {
        return self.send("POST", bucket, key, "uploads=", "", contentType, "")
    }

    /// Uploads one part (1 to 10000; every part but the last is at least 5 MiB). The part's ETag is in the result.
    fn UploadPart(self, bucket: str, key: str, uploadId: str, partNumber: i32, body: str) -> S3Result {
        local q: String = String()
        q.append("partNumber=")
        q.append(numberText(partNumber as i64).asStr())
        q.append("&uploadId=")
        q.append(pctEncode(uploadId).asStr())
        local out: S3Result = self.send("PUT", bucket, key, q.asStr(), "", "", body)
        return out
    }

    /// Completes a multipart upload. `partsXml` is the list of "<Part><PartNumber>n</PartNumber><ETag>...</ETag></Part>" elements.
    fn CompleteMultipartUpload(self, bucket: str, key: str, uploadId: str, partsXml: str) -> S3Result {
        local q: String = String()
        q.append("uploadId=")
        q.append(pctEncode(uploadId).asStr())
        local doc: String = String()
        doc.append("<CompleteMultipartUpload>")
        doc.append(partsXml)
        doc.append("</CompleteMultipartUpload>")
        local out: S3Result = self.send("POST", bucket, key, q.asStr(), "", "application/xml", doc.asStr())
        return out
    }

    fn AbortMultipartUpload(self, bucket: str, key: str, uploadId: str) -> S3Result {
        local q: String = String()
        q.append("uploadId=")
        q.append(pctEncode(uploadId).asStr())
        local out: S3Result = self.send("DELETE", bucket, key, q.asStr(), "", "", "")
        return out
    }

    /// A presigned GET URL valid for `expires` seconds (query-string authentication, SigV4 with UNSIGNED-PAYLOAD).
    fn PresignGet(self, bucket: str, key: str, expires: i32) -> String {
        return self.PresignGetAt(bucket, key, expires, sysClockSeconds())
    }

    /// The presigned GET URL for the time `now` (Unix seconds). PresignGet uses the clock; this form gives reproducible URLs.
    fn PresignGetAt(self, bucket: str, key: str, expires: i32, now: i64) -> String {
        local amzDate: String = amzTimestamp(now)
        local dateStamp: String = dateOnly(amzDate.asStr())
        local host: String = self.hostFor(bucket)
        local path: String = self.pathFor(bucket, key)
        local scope: String = scopeOf(self, dateStamp.asStr())
        local credential: String = String()
        credential.append(self.accessKey.asStr())
        credential.append("/")
        credential.append(scope.asStr())
        local canonicalQuery: String = String()
        canonicalQuery.append("X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=")
        canonicalQuery.append(pctEncode(credential.asStr()).asStr())
        canonicalQuery.append("&X-Amz-Date=")
        canonicalQuery.append(amzDate.asStr())
        canonicalQuery.append("&X-Amz-Expires=")
        canonicalQuery.append(numberText(expires as i64).asStr())
        canonicalQuery.append("&X-Amz-SignedHeaders=host")
        local canonicalHeaders: String = String()
        canonicalHeaders.append("host:")
        canonicalHeaders.append(host.asStr())
        canonicalHeaders.append("\n")
        local signature: String = self.signWith("GET", path.asStr(), canonicalQuery.asStr(), canonicalHeaders.asStr(), "host", "UNSIGNED-PAYLOAD", amzDate.asStr(), dateStamp.asStr(), scope.asStr())
        local url: String = String()
        url.append(self.schemeText())
        url.append(host.asStr())
        url.append(path.asStr())
        url.append("?")
        url.append(canonicalQuery.asStr())
        url.append("&X-Amz-Signature=")
        url.append(signature.asStr())
        return url
    }

    fn schemeText(self) -> str {
        if self.profile.https { return "https://" }
        return "http://"
    }

    fn hostFor(self, bucket: str) -> String {
        local h: String = String()
        if self.profile.addressing == S3_ADDR_VIRTUAL && bucket.len > 0 {
            h.append(bucket)
            h.append(".")
        }
        h.append(self.profile.endpoint.asStr())
        return h
    }

    fn pathFor(self, bucket: str, key: str) -> String {
        local p: String = String()
        if self.profile.addressing == S3_ADDR_PATH && bucket.len > 0 {
            p.append("/")
            p.append(bucket)
        }
        p.append("/")
        p.append(encodeKey(key).asStr())
        return p
    }

    /// Signs and sends one request, and reads the answer into an S3Result.
    fn send(self, method: str, bucket: str, key: str, query: str, extra: str, contentType: str, body: str) -> S3Result {
        local out: S3Result = S3Result()
        local host: String = self.hostFor(bucket)
        local path: String = self.pathFor(bucket, key)
        local now: i64 = sysClockSeconds()
        local amzDate: String = amzTimestamp(now)
        local dateStamp: String = dateOnly(amzDate.asStr())
        local scope: String = scopeOf(self, dateStamp.asStr())
        local payloadHash: String = hashHex(body)
        local canonicalQuery: String = canonicalQueryOf(query)
        // the headers that are signed: host, x-amz-content-sha256, x-amz-date, content-type, and the session token when it is sent
        local signed: String = String()
        local canonicalHeaders: String = String()
        if contentType.len > 0 {
            canonicalHeaders.append("content-type:")
            canonicalHeaders.append(contentType)
            canonicalHeaders.append("\n")
            signed.append("content-type;")
        }
        canonicalHeaders.append("host:")
        canonicalHeaders.append(host.asStr())
        canonicalHeaders.append("\n")
        signed.append("host;")
        if self.profile.requiresContentSha256 || true {
            canonicalHeaders.append("x-amz-content-sha256:")
            canonicalHeaders.append(payloadHash.asStr())
            canonicalHeaders.append("\n")
            signed.append("x-amz-content-sha256;")
        }
        canonicalHeaders.append("x-amz-date:")
        canonicalHeaders.append(amzDate.asStr())
        canonicalHeaders.append("\n")
        signed.append("x-amz-date")
        local sendToken: bool = self.sessionToken.length() > 0
        if sendToken && !self.profile.acceptsSessionToken {
            self.warnings.push(warningText("x-amz-security-token not sent: the provider does not accept it"))
            sendToken = false
        }
        if sendToken {
            canonicalHeaders.append("x-amz-security-token:")
            canonicalHeaders.append(self.sessionToken.asStr())
            canonicalHeaders.append("\n")
            signed.append(";x-amz-security-token")
        }
        local signature: String = self.signWith(method, path.asStr(), canonicalQuery.asStr(), canonicalHeaders.asStr(), signed.asStr(), payloadHash.asStr(), amzDate.asStr(), dateStamp.asStr(), scope.asStr())
        local authorization: String = String()
        authorization.append("AWS4-HMAC-SHA256 Credential=")
        authorization.append(self.accessKey.asStr())
        authorization.append("/")
        authorization.append(scope.asStr())
        authorization.append(", SignedHeaders=")
        authorization.append(signed.asStr())
        authorization.append(", Signature=")
        authorization.append(signature.asStr())
        // the request
        local url: String = String()
        url.append(self.schemeText())
        url.append(host.asStr())
        url.append(path.asStr())
        if canonicalQuery.length() > 0 {
            url.append("?")
            url.append(canonicalQuery.asStr())
        }
        local req: Request = Request(method, url.asStr())
        req.headers.Set("Authorization", authorization.asStr())
        req.headers.Set("x-amz-date", amzDate.asStr())
        req.headers.Set("x-amz-content-sha256", payloadHash.asStr())
        if contentType.len > 0 { req.headers.Set("Content-Type", contentType) }
        if sendToken { req.headers.Set("x-amz-security-token", self.sessionToken.asStr()) }
        req.SetBody(body)
        local resp: Response = self.http.Do(&req)
        out.clientError = resp.error
        out.status = resp.status
        out.ok = resp.error == CLIENT_OK && resp.status >= 200 && resp.status < 300
        out.body.append(resp.body.asStr())
        out.etag.append(resp.Header("ETag"))
        out.contentType.append(resp.Header("Content-Type"))
        if !out.ok && resp.error == CLIENT_OK {
            out.code.append(xmlTag(resp.body.asStr(), "Code"))
            out.message.append(xmlTag(resp.body.asStr(), "Message"))
        }
        if resp.error != CLIENT_OK {
            out.message.append(clientErrorText(resp.error))
        }
        return out
    }

    /// The SigV4 signature of a canonical request (AWS documentation, "Create a signature for AWS Signature Version 4").
    fn signWith(self, method: str, path: str, canonicalQuery: str, canonicalHeaders: str, signedHeaders: str, payloadHash: str, amzDate: str, dateStamp: str, scope: str) -> String {
        local canonical: String = String()
        canonical.append(method)
        canonical.append("\n")
        canonical.append(path)
        canonical.append("\n")
        canonical.append(canonicalQuery)
        canonical.append("\n")
        canonical.append(canonicalHeaders)
        canonical.append("\n")
        canonical.append(signedHeaders)
        canonical.append("\n")
        canonical.append(payloadHash)
        local canonicalHash: String = hashHex(canonical.asStr())
        local toSign: String = sigv4StringToSign(amzDate, scope, canonicalHash.asStr())
        local sig: String = sigv4Signature(self.secretKey.asStr(), dateStamp, self.profile.region.asStr(), "s3", toSign.asStr())
        return sig
    }
}

fn warningText(s: str) -> String {
    local w: String = String()
    w.append(s)
    return w
}

fn scopeOf(c: *S3Client, dateStamp: str) -> String {
    local s: String = String()
    s.append(dateStamp)
    s.append("/")
    s.append(c.profile.region.asStr())
    s.append("/s3/aws4_request")
    return s
}

/// Hex of the SHA-256 of `data`.
fn hashHex(data: str) -> String {
    local digest: [ui8; 32]
    sha256(data.ptr, data.len, &digest[0])
    local hex: [ui8; 64]
    hexEncode(&digest[0], 32, &hex[0])
    local s: String = String()
    s.append(fromParts(&hex[0], 64))
    return s
}

/// RFC 3986 encoding of an object key, keeping the '/' separators (S3 signs the encoded path, RFC 3986 section 2.1).
fn encodeKey(key: str) -> String {
    local out: String = String()
    local i: usize = 0
    local start: usize = 0
    while i <= key.len {
        if i == key.len || key[i] == 47 {
            out.append(pctEncode(fromParts(&key.ptr[start], i - start)).asStr())
            if i < key.len { out.append("/") }
            start = i + 1
        }
        i = i + 1
    }
    return out
}

/// The canonical query string of a raw query ("k=v&k2=v2" with values already encoded): pairs sorted by name (SigV4 step 3).
fn canonicalQueryOf(query: str) -> String {
    local out: String = String()
    if query.len == 0 { return out }
    local count: usize = 1
    local i: usize = 0
    while i < query.len {
        if query[i] == 38 { count = count + 1 }
        i = i + 1
    }
    local names: Vec<String> = Vec<String>()
    local vals: Vec<String> = Vec<String>()
    local start: usize = 0
    i = 0
    while i <= query.len {
        if i == query.len || query[i] == 38 {
            local pair: str = fromParts(&query.ptr[start], i - start)
            local eqAt: usize = 0
            while eqAt < pair.len && pair[eqAt] != 61 { eqAt = eqAt + 1 }
            local n: String = String()
            n.append(fromParts(pair.ptr, eqAt))
            local v: String = String()
            if eqAt < pair.len { v.append(fromParts(&pair.ptr[eqAt + 1], pair.len - eqAt - 1)) }
            names.push(n)
            vals.push(v)
            start = i + 1
        }
        i = i + 1
    }
    if names.length() > 64 {
        return out
    }
    // insertion sort of the indices by name (SigV4 canonical query: sorted by the encoded name, then value)
    local order: [usize; 64]
    local n: usize = names.length()
    local k: usize = 0
    while k < n {
        order[k] = k
        k = k + 1
    }
    k = 1
    while k < n {
        local m: usize = k
        while m > 0 {
            local a: *String = names.get(order[m - 1])
            local b: *String = names.get(order[m])
            if compareStr(b.asStr(), a.asStr()) >= 0 { break }
            local tmp: usize = order[m - 1]
            order[m - 1] = order[m]
            order[m] = tmp
            m = m - 1
        }
        k = k + 1
    }
    local j: usize = 0
    while j < names.length() {
        if j > 0 { out.append("&") }
        local nm: *String = names.get(order[j])
        local vv: *String = vals.get(order[j])
        out.append(nm.asStr())
        out.append("=")
        out.append(vv.asStr())
        j = j + 1
    }
    return out
}

fn compareStr(a: str, b: str) -> i32 {
    local n: usize = a.len
    if b.len < n { n = b.len }
    local i: usize = 0
    while i < n {
        if a[i] < b[i] { return -1 }
        if a[i] > b[i] { return 1 }
        i = i + 1
    }
    if a.len < b.len { return -1 }
    if a.len > b.len { return 1 }
    return 0
}

/// "YYYYMMDDTHHMMSSZ" for the Unix time `t`.
fn amzTimestamp(t: i64) -> String {
    local days: i64 = t / 86400
    local rem: i64 = t % 86400
    if rem < 0 {
        rem = rem + 86400
        days = days - 1
    }
    local d: DateTime = civilFromDays(days)
    local s: String = String()
    s.append(paddedNumber(d.year, 4).asStr())
    s.append(paddedNumber(d.month as i64, 2).asStr())
    s.append(paddedNumber(d.day as i64, 2).asStr())
    s.append("T")
    s.append(paddedNumber(rem / 3600, 2).asStr())
    s.append(paddedNumber((rem % 3600) / 60, 2).asStr())
    s.append(paddedNumber(rem % 60, 2).asStr())
    s.append("Z")
    return s
}

fn dateOnly(stamp: str) -> String {
    local s: String = String()
    s.append(fromParts(stamp.ptr, 8))
    return s
}

fn paddedNumber(v: i64, width: usize) -> String {
    local digits: [ui8; 20]
    local x: i64 = v
    if x < 0 { x = 0 }
    local n: usize = 0
    while true {
        digits[n] = (48 + (x % 10)) as ui8
        n = n + 1
        x = x / 10
        if x == 0 { break }
    }
    local s: String = String()
    local pad: usize = 0
    if n < width { pad = width - n }
    while pad > 0 {
        s.append("0")
        pad = pad - 1
    }
    while n > 0 {
        n = n - 1
        s.append(fromParts(&digits[n], 1))
    }
    return s
}

fn numberText(v: i64) -> String {
    return paddedNumber(v, 1)
}

fn parseI64(v: str) -> i64 {
    local n: i64 = 0
    local i: usize = 0
    while i < v.len && v[i] >= 48 && v[i] <= 57 {
        n = n * 10 + ((v[i] - 48) as i64)
        i = i + 1
    }
    return n
}

/// The text between the first "<tag>" and "</tag>" of `xml`, or "".
fn xmlTag(xml: str, tag: str) -> str {
    local open: String = String()
    open.append("<")
    open.append(tag)
    open.append(">")
    local close: String = String()
    close.append("</")
    close.append(tag)
    close.append(">")
    return xmlBetween(xml, open.asStr(), close.asStr(), 0)
}

/// The text between `open` and `close` found at or after `begin` (open and close are not part of it), or "".
fn xmlBetween(xml: str, open: str, close: str, begin: usize) -> str {
    local i: usize = begin
    while i + open.len <= xml.len {
        if eq(fromParts(&xml.ptr[i], open.len), open) {
            local s: usize = i + open.len
            local j: usize = s
            while j + close.len <= xml.len {
                if eq(fromParts(&xml.ptr[j], close.len), close) {
                    return fromParts(&xml.ptr[s], j - s)
                }
                j = j + 1
            }
            return ""
        }
        i = i + 1
    }
    return ""
}

fn ptrOffset(base: str, part: str) -> usize {
    return (part.ptr as usize) - (base.ptr as usize)
}
