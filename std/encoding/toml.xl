// std/encoding/toml: TOML 1.0 (https://toml.io/en/v1.0.0, the grammar of the specification). The module checks a document
// (tomlValid) and looks up values by their dotted key (tomlGet), returning the raw text of the value as a view into the input,
// in the same style as the JSON reader of std/encoding/jsonfull. It builds no tree.
// Checked: comments; bare, quoted and dotted keys; standard and array-of-tables headers; basic, literal and multi-line strings
// with escapes (\uXXXX and \UXXXXXXXX must be Unicode scalar values, section 2.1.2 and section 2.2); integers in decimal, hex, octal
// and binary with underscores; floats (fractions, exponents, inf and nan); booleans; the four datetime forms (RFC 3339 for offset
// datetimes, section 3 of the spec); arrays and inline tables, nested to 64 levels.
// Not checked: duplicate keys and table redefinitions (they need a tree; the caller must detect them), and the calendar limits of
// leap seconds. Keys are compared as written, with the quotes of a quoted key removed and no escape processing.
// A failure returns false (tomlValid) or an empty view (tomlGet); a position is 0 when the parse fails.

define TOML_MAX_DEPTH = 64

from "../str/str" import fromParts, eq
from "../str/string" import String

fn isDigit(c: ui8) -> bool {
    return c >= 48 && c <= 57
}

fn isHex(c: ui8) -> bool {
    return isDigit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
}

fn isBare(c: ui8) -> bool {
    return isDigit(c) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 95
}

/// Skips spaces and tabs.
fn skipWs(t: *ui8, n: usize, p: usize) -> usize {
    local q: usize = p
    while q < n && (t[q] == 32 || t[q] == 9) {
        q = q + 1
    }
    return q
}

/// Skips a comment starting at `p` (which is '#') up to the line end; returns the position of the line end or n.
fn skipComment(t: *ui8, n: usize, p: usize) -> usize {
    local q: usize = p
    while q < n && t[q] != 10 && t[q] != 13 {
        if t[q] < 32 && t[q] != 9 { return 0 }
        q = q + 1
    }
    return q
}

/// Skips whitespace, newlines and comments (allowed between array items).
fn skipBlank(t: *ui8, n: usize, p: usize) -> usize {
    local q: usize = p
    while q < n {
        if t[q] == 32 || t[q] == 9 || t[q] == 10 {
            q = q + 1
        } else if t[q] == 13 && q + 1 < n && t[q + 1] == 10 {
            q = q + 2
        } else if t[q] == 35 {
            q = skipComment(t, n, q)
            if q == 0 { return 0 }
        } else {
            break
        }
    }
    return q
}

/// The number of hex digits `count` at `p` as a Unicode scalar value check (section 2.1.2 and section 2.2: not a surrogate, at most
/// U+10FFFF). Returns the position after the digits, or 0.
fn unicodeEscape(t: *ui8, n: usize, p: usize, count: usize) -> usize {
    if p + count > n { return 0 }
    local v: ui64 = 0
    local i: usize = 0
    while i < count {
        if !isHex(t[p + i]) { return 0 }
        local c: ui8 = t[p + i]
        local d: ui64 = 0
        if isDigit(c) {
            d = (c - 48) as ui64
        } else if c >= 97 {
            d = (c - 87) as ui64
        } else {
            d = (c - 55) as ui64
        }
        v = v * 16 + d
        i = i + 1
    }
    if v > 0x10ffff || (v >= 0xd800 && v <= 0xdfff) { return 0 }
    return p + count
}

/// Scans the body of a basic or multi-line basic string after the opening quote(s). `multi` allows newlines and the line-ending
/// backslash. Returns the position after the closing quote(s), or 0.
fn basicBody(t: *ui8, n: usize, p: usize, multi: bool) -> usize {
    local q: usize = p
    while q < n {
        local c: ui8 = t[q]
        if c == 34 {
            if !multi { return q + 1 }
            if q + 2 < n && t[q + 1] == 34 && t[q + 2] == 34 {
                // up to two quotes may precede the closing delimiter
                local e: usize = q + 3
                while e < n && t[e] == 34 && e < q + 5 { e = e + 1 }
                return e
            }
            q = q + 1
        } else if c == 92 {
            if q + 1 >= n { return 0 }
            local e: ui8 = t[q + 1]
            if e == 117 {
                q = unicodeEscape(t, n, q + 2, 4)
            } else if e == 85 {
                q = unicodeEscape(t, n, q + 2, 8)
            } else if e == 98 || e == 116 || e == 110 || e == 102 || e == 114 || e == 34 || e == 92 {
                q = q + 2
            } else if multi && (e == 32 || e == 9 || e == 10 || e == 13) {
                // line-ending backslash: only whitespace up to the newline, then blank lines
                local r: usize = q + 1
                while r < n && (t[r] == 32 || t[r] == 9) { r = r + 1 }
                if r >= n || (t[r] != 10 && t[r] != 13) { return 0 }
                q = skipBlank(t, n, r)
                if q == 0 { return 0 }
            } else {
                return 0
            }
            if q == 0 { return 0 }
        } else if c == 10 || c == 13 {
            if !multi { return 0 }
            q = q + 1
        } else if c < 32 && c != 9 {
            return 0
        } else {
            q = q + 1
        }
    }
    return 0
}

/// Scans a literal or multi-line literal string body (no escapes).
fn literalBody(t: *ui8, n: usize, p: usize, multi: bool) -> usize {
    local q: usize = p
    while q < n {
        local c: ui8 = t[q]
        if c == 39 {
            if !multi { return q + 1 }
            if q + 2 < n && t[q + 1] == 39 && t[q + 2] == 39 {
                local e: usize = q + 3
                while e < n && t[e] == 39 && e < q + 5 { e = e + 1 }
                return e
            }
            q = q + 1
        } else if c == 10 || c == 13 {
            if !multi { return 0 }
            q = q + 1
        } else if c < 32 && c != 9 {
            return 0
        } else {
            q = q + 1
        }
    }
    return 0
}

/// A string value at `p` (basic, literal, multi-line basic or multi-line literal). Returns the position after it, or 0.
fn stringValue(t: *ui8, n: usize, p: usize) -> usize {
    if p >= n { return 0 }
    if t[p] == 34 {
        if p + 2 < n && t[p + 1] == 34 && t[p + 2] == 34 {
            // a newline right after the opening delimiter is trimmed (section 2.1.6)
            local s: usize = p + 3
            if s < n && t[s] == 10 { s = s + 1 } else if s + 1 < n && t[s] == 13 && t[s + 1] == 10 { s = s + 2 }
            return basicBody(t, n, s, true)
        }
        return basicBody(t, n, p + 1, false)
    }
    if t[p] == 39 {
        if p + 2 < n && t[p + 1] == 39 && t[p + 2] == 39 {
            local s: usize = p + 3
            if s < n && t[s] == 10 { s = s + 1 } else if s + 1 < n && t[s] == 13 && t[s + 1] == 10 { s = s + 2 }
            return literalBody(t, n, s, true)
        }
        return literalBody(t, n, p + 1, false)
    }
    return 0
}

/// A simple key segment at `p`: a bare key or a basic or literal quoted key. Returns the position after it, or 0.
fn simpleKey(t: *ui8, n: usize, p: usize) -> usize {
    if p >= n { return 0 }
    if t[p] == 34 { return basicBody(t, n, p + 1, false) }
    if t[p] == 39 { return literalBody(t, n, p + 1, false) }
    local q: usize = p
    while q < n && isBare(t[q]) { q = q + 1 }
    if q == p { return 0 }
    return q
}

/// A dotted key at `p` (segments separated by '.' with optional blanks). Returns the position after the key, or 0.
fn dottedKey(t: *ui8, n: usize, p: usize) -> usize {
    local q: usize = simpleKey(t, n, p)
    if q == 0 { return 0 }
    while true {
        local r: usize = skipWs(t, n, q)
        if r < n && t[r] == 46 {
            r = skipWs(t, n, r + 1)
            local e: usize = simpleKey(t, n, r)
            if e == 0 { return 0 }
            q = e
        } else {
            break
        }
    }
    return q
}

fn digitsAt(t: *ui8, n: usize, p: usize, count: usize) -> bool {
    if p + count > n { return false }
    local i: usize = 0
    while i < count {
        if !isDigit(t[p + i]) { return false }
        i = i + 1
    }
    return true
}

/// Digits with single underscores between them (`1_000`), starting at `p`. Returns the position after them, or 0.
fn underscoredDigits(t: *ui8, n: usize, p: usize, allowHex: bool) -> usize {
    local q: usize = p
    local last_us: bool = true
    while q < n {
        local c: ui8 = t[q]
        if c == 95 {
            if last_us { return 0 }
            last_us = true
            q = q + 1
        } else if isDigit(c) || (allowHex && isHex(c)) {
            last_us = false
            q = q + 1
        } else {
            break
        }
    }
    if q == p || last_us { return 0 }
    return q
}

/// A date at `p`: YYYY-MM-DD with a valid month and day. Returns the position after it, or 0.
fn dateAt(t: *ui8, n: usize, p: usize) -> usize {
    if !digitsAt(t, n, p, 4) || p + 4 >= n || t[p + 4] != 45 { return 0 }
    if !digitsAt(t, n, p + 5, 2) || p + 7 >= n || t[p + 7] != 45 || !digitsAt(t, n, p + 8, 2) { return 0 }
    local y: i64 = ((t[p] - 48) as i64) * 1000 + ((t[p + 1] - 48) as i64) * 100 + ((t[p + 2] - 48) as i64) * 10 + ((t[p + 3] - 48) as i64)
    local m: i64 = ((t[p + 5] - 48) as i64) * 10 + ((t[p + 6] - 48) as i64)
    local d: i64 = ((t[p + 8] - 48) as i64) * 10 + ((t[p + 9] - 48) as i64)
    if m < 1 || m > 12 || d < 1 { return 0 }
    local dim: i64 = 31
    if m == 4 || m == 6 || m == 9 || m == 11 {
        dim = 30
    } else if m == 2 {
        dim = 28
        if (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 { dim = 29 }
    }
    if d > dim { return 0 }
    return p + 10
}

/// A time at `p`: HH:MM[:SS[.fraction]]. Returns the position after it, or 0.
fn timeAt(t: *ui8, n: usize, p: usize) -> usize {
    if !digitsAt(t, n, p, 2) || p + 2 >= n || t[p + 2] != 58 || !digitsAt(t, n, p + 3, 2) { return 0 }
    if t[p] > 50 || (t[p] == 50 && t[p + 1] > 51) || t[p + 3] > 53 { return 0 }
    local q: usize = p + 5
    if q < n && t[q] == 58 {
        if !digitsAt(t, n, q + 1, 2) { return 0 }
        if t[q + 1] > 54 { return 0 }
        q = q + 3
        if q < n && t[q] == 46 {
            local f: usize = q + 1
            while f < n && isDigit(t[f]) { f = f + 1 }
            if f == q + 1 { return 0 }
            q = f
        }
    }
    return q
}

/// An offset at `p`: Z, z, or [+-]HH:MM. Returns the position after it, or 0 when there is none.
fn offsetAt(t: *ui8, n: usize, p: usize) -> usize {
    if p < n && (t[p] == 90 || t[p] == 122) { return p + 1 }
    if p < n && (t[p] == 43 || t[p] == 45) {
        if !digitsAt(t, n, p + 1, 2) || p + 3 >= n || t[p + 3] != 58 || !digitsAt(t, n, p + 4, 2) { return 0 }
        return p + 6
    }
    return 0
}

/// A datetime or local date or time at `p`, returns the end or 0 when `p` does not start one.
fn dateTimeAt(t: *ui8, n: usize, p: usize) -> usize {
    local d: usize = dateAt(t, n, p)
    if d != 0 {
        if d < n && (t[d] == 84 || t[d] == 116 || t[d] == 32) && d + 1 < n && isDigit(t[d + 1]) {
            local tm: usize = timeAt(t, n, d + 1)
            if tm == 0 { return 0 }
            local o: usize = offsetAt(t, n, tm)
            if o != 0 { return o }
            return tm
        }
        return d
    }
    return timeAt(t, n, p)
}

/// The unsigned digits of a decimal integer part: 0 or a non-zero leading digit, with underscores. Returns the end or 0.
fn decimalDigits(t: *ui8, n: usize, p: usize) -> usize {
    if p < n && t[p] == 48 {
        if p + 1 < n && isDigit(t[p + 1]) { return 0 }
        return p + 1
    }
    return underscoredDigits(t, n, p, false)
}

/// A number token at `p` (integer, float, hex, octal, binary, inf or nan). Returns the end or 0.
fn numberAt(t: *ui8, n: usize, p: usize) -> usize {
    local q: usize = p
    if q < n && (t[q] == 43 || t[q] == 45) { q = q + 1 }
    // inf and nan (signed or not)
    if n - q >= 3 && ((t[q] == 105 && t[q + 1] == 110 && t[q + 2] == 102) || (t[q] == 110 && t[q + 1] == 97 && t[q + 2] == 110)) {
        return q + 3
    }
    // prefixed integers take no sign
    if q == p && q + 1 < n && t[q] == 48 && (t[q + 1] == 120 || t[q + 1] == 111 || t[q + 1] == 98) {
        local kind: ui8 = t[q + 1]
        if kind == 120 {
            return underscoredDigits(t, n, q + 2, true)
        }
        local e: usize = underscoredDigits(t, n, q + 2, false)
        if e == 0 { return 0 }
        local i: usize = q + 2
        while i < e {
            if kind == 111 && t[i] != 95 && (t[i] < 48 || t[i] > 55) { return 0 }
            if kind == 98 && t[i] != 95 && t[i] != 48 && t[i] != 49 { return 0 }
            i = i + 1
        }
        return e
    }
    local ip: usize = decimalDigits(t, n, q)
    if ip == 0 { return 0 }
    local isFloat: bool = false
    local r: usize = ip
    if r < n && t[r] == 46 {
        local fe: usize = underscoredDigits(t, n, r + 1, false)
        if fe == 0 { return 0 }
        r = fe
        isFloat = true
    }
    if r < n && (t[r] == 101 || t[r] == 69) {
        local s: usize = r + 1
        if s < n && (t[s] == 43 || t[s] == 45) { s = s + 1 }
        local ee: usize = underscoredDigits(t, n, s, false)
        if ee == 0 { return 0 }
        r = ee
        isFloat = true
    }
    return r
}

/// A value at `p` (with nesting level `depth`). Returns the position after it, or 0.
fn valueAt(t: *ui8, n: usize, p: usize, depth: usize) -> usize {
    if depth > TOML_MAX_DEPTH || p >= n { return 0 }
    local c: ui8 = t[p]
    if c == 34 || c == 39 { return stringValue(t, n, p) }
    if c == 91 { return arrayAt(t, n, p, depth + 1) }
    if c == 123 { return inlineTableAt(t, n, p, depth + 1) }
    if n - p >= 4 && t[p] == 116 && t[p + 1] == 114 && t[p + 2] == 117 && t[p + 3] == 101 { return p + 4 }
    if n - p >= 5 && t[p] == 102 && t[p + 1] == 97 && t[p + 2] == 108 && t[p + 3] == 115 && t[p + 4] == 101 { return p + 5 }
    // a datetime starts with a date or a time: try it before the number, since both start with digits
    local dt: usize = dateTimeAt(t, n, p)
    if dt != 0 { return dt }
    return numberAt(t, n, p)
}

/// An array at `p` ('['), trailing comma allowed, newlines and comments allowed between items.
fn arrayAt(t: *ui8, n: usize, p: usize, depth: usize) -> usize {
    local q: usize = skipBlank(t, n, p + 1)
    if q == 0 || q >= n { return 0 }
    if t[q] == 93 { return q + 1 }
    while true {
        q = valueAt(t, n, q, depth)
        if q == 0 { return 0 }
        q = skipBlank(t, n, q)
        if q == 0 || q >= n { return 0 }
        if t[q] == 93 { return q + 1 }
        if t[q] != 44 { return 0 }
        q = skipBlank(t, n, q + 1)
        if q == 0 || q >= n { return 0 }
        if t[q] == 93 { return q + 1 }
    }
    return 0
}

/// An inline table at `p` ('{'): key-value pairs on one line, separated by commas.
fn inlineTableAt(t: *ui8, n: usize, p: usize, depth: usize) -> usize {
    local q: usize = skipWs(t, n, p + 1)
    if q >= n { return 0 }
    if t[q] == 125 { return q + 1 }
    while true {
        q = dottedKey(t, n, q)
        if q == 0 { return 0 }
        q = skipWs(t, n, q)
        if q >= n || t[q] != 61 { return 0 }
        q = skipWs(t, n, q + 1)
        q = valueAt(t, n, q, depth)
        if q == 0 { return 0 }
        q = skipWs(t, n, q)
        if q >= n { return 0 }
        if t[q] == 125 { return q + 1 }
        if t[q] != 44 { return 0 }
        q = skipWs(t, n, q + 1)
    }
    return 0
}

/// True when the rest of the line after `p` is blanks and an optional comment, ending at a newline or the end of the input.
fn lineEnd(t: *ui8, n: usize, p: usize) -> usize {
    local q: usize = skipWs(t, n, p)
    if q < n && t[q] == 35 {
        q = skipComment(t, n, q)
        if q == 0 { return 0 }
    }
    if q >= n { return n }
    if t[q] == 10 { return q + 1 }
    if t[q] == 13 && q + 1 < n && t[q + 1] == 10 { return q + 2 }
    return 0
}

/// Checks a whole document (TOML 1.0). Duplicate keys are not detected (see the comment at the top of this file).
export fn tomlValid(text: *ui8, n: usize) -> bool {
    local p: usize = 0
    while p < n {
        local q: usize = skipWs(text, n, p)
        if q >= n { break }
        if text[q] == 10 || (text[q] == 13 && q + 1 < n && text[q + 1] == 10) {
            p = lineEnd(text, n, q)
            if p == 0 { return false }
            continue
        }
        if text[q] == 35 {
            p = lineEnd(text, n, q)
            if p == 0 { return false }
            continue
        }
        if text[q] == 91 {
            // table header or array-of-tables header
            local r: usize = q + 1
            local isArr: bool = false
            if r < n && text[r] == 91 {
                isArr = true
                r = r + 1
            }
            r = skipWs(text, n, r)
            r = dottedKey(text, n, r)
            if r == 0 { return false }
            r = skipWs(text, n, r)
            if r >= n || text[r] != 93 { return false }
            if isArr {
                if r + 1 >= n || text[r + 1] != 93 { return false }
                r = r + 2
            } else {
                r = r + 1
            }
            p = lineEnd(text, n, r)
            if p == 0 { return false }
            continue
        }
        // key = value
        local k: usize = dottedKey(text, n, q)
        if k == 0 { return false }
        k = skipWs(text, n, k)
        if k >= n || text[k] != 61 { return false }
        k = skipWs(text, n, k + 1)
        k = valueAt(text, n, k, 0)
        if k == 0 { return false }
        p = lineEnd(text, n, k)
        if p == 0 { return false }
    }
    return true
}

/// The normalized text of the key `t[s..e)`: quotes and blanks removed, dots kept (keys are compared as written, see above).
fn normKey(t: *ui8, s: usize, e: usize) -> String {
    local out: String = String()
    local i: usize = s
    while i < e {
        local c: ui8 = t[i]
        if c != 34 && c != 39 && c != 32 && c != 9 {
            out.append(fromParts(&t[i], 1))
        }
        i = i + 1
    }
    return out
}

/// The raw text of the value of `key` (a dotted key such as "server.port" or "owner.name", as written in the document with
/// quotes and blanks removed). Table headers, and the keys under them, are followed in order; for a repeated [[array]] the
/// first occurrence is used. Returns an empty view when the key is absent or the document is malformed.
export fn tomlGet(text: *ui8, n: usize, key: str) -> str {
    local none: str = fromParts(text, 0)
    if !tomlValid(text, n) { return none }
    local prefix: String = String()
    local p: usize = 0
    while p < n {
        local q: usize = skipWs(text, n, p)
        if q >= n { break }
        if text[q] == 10 || text[q] == 13 || text[q] == 35 {
            p = lineEnd(text, n, q)
            continue
        }
        if text[q] == 91 {
            local r: usize = q + 1
            if r < n && text[r] == 91 { r = r + 1 }
            r = skipWs(text, n, r)
            local e: usize = dottedKey(text, n, r)
            prefix = normKey(text, r, e)
            local close: usize = e
            while close < n && text[close] != 93 {
                close = close + 1
            }
            if r > q + 1 && text[q + 1] == 91 {
                close = close + 1
            }
            p = lineEnd(text, n, close + 1)
            if p == 0 { return none }
            continue
        }
        local k: usize = dottedKey(text, n, q)
        local full: String = String()
        if prefix.length() > 0 {
            full.append(prefix.asStr())
            full.append(".")
        }
        full.append(normKey(text, q, k).asStr())
        local eqPos: usize = skipWs(text, n, k)
        local vs: usize = skipWs(text, n, eqPos + 1)
        local ve: usize = valueAt(text, n, vs, 0)
        if eq(full.asStr(), key) { return fromParts(&text[vs], ve - vs) }
        p = lineEnd(text, n, ve)
        if p == 0 { return none }
    }
    return none
}
