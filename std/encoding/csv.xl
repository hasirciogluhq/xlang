// std/encoding/csv: one CSV record at a time (RFC 4180, https://www.rfc-editor.org/rfc/rfc4180). Fields are separated by
// commas; a field may be enclosed in double quotes, and inside quotes a pair of quotes stands for one quote and commas
// and line breaks are data. A record ends at CRLF or LF. This function reads one record from `text[0..n)` starting at
// `pos` and returns its fields as owned Strings; it does not handle a quote opened in one record and closed in another
// beyond the record's own text (the caller joins lines when the quotes do not close).
from "../str/string" import String
from "../collections/vec" import Vec
from "../mem/mem" import currentAllocator

/// Parses the record at `text[pos..n)`. Advances `pos` past the record and its line break. Returns the fields; on a
/// malformed quoted field (a quote followed by a byte other than a comma, a line break, or another quote) the field
/// ends there and the rest of the record is taken as it is.
export fn csvRecord(text: *ui8, n: usize, pos: *usize) -> Vec<String> {
    local fields: Vec<String> = Vec<String>()
    local i: usize = *pos
    local field: String = String()
    local quoted: bool = false
    local done: bool = false
    if i < n && text[i] == 34 {
        // a field that starts with a quote
        quoted = true
        i = i + 1
    }
    while !done {
        if i >= n {
            fields.push(field)
            done = true
        } else if quoted {
            if text[i] == 34 {
                if i + 1 < n && text[i + 1] == 34 {
                    field.push(34)
                    i = i + 2
                } else {
                    quoted = false
                    i = i + 1
                }
            } else {
                field.push(text[i])
                i = i + 1
            }
        } else if text[i] == 44 {
            fields.push(field)
            field = String()
            i = i + 1
            if i < n && text[i] == 34 {
                quoted = true
                i = i + 1
            }
        } else if text[i] == 13 && i + 1 < n && text[i + 1] == 10 {
            fields.push(field)
            i = i + 2
            done = true
        } else if text[i] == 10 {
            fields.push(field)
            i = i + 1
            done = true
        } else {
            field.push(text[i])
            i = i + 1
        }
    }
    *pos = i
    return fields
}
