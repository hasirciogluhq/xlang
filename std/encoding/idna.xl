// std/encoding/idna: the ACE form of one domain label (RFC 3490, https://www.rfc-editor.org/rfc/rfc3490, section 5): a label
// with non-ASCII code points becomes "xn--" followed by its Punycode (RFC 3492). Name preparation (RFC 3491, nameprep) is
// the caller's job; see docs/std/encoding.md.
from "utf8" import utf8Decode
from "punycode" import punyEncode

define ACE_PREFIX = "xn--"

/// Writes the ACE form of the UTF-8 label `text[0..n)` into `out` (capacity `cap`) and returns its length, or -1 when the label
/// is not valid UTF-8 or does not fit. An all-ASCII label is copied unchanged.
export fn idnaLabelToAscii(text: *ui8, n: usize, out: *ui8, cap: usize) -> isize {
    local ascii: bool = true
    local i: usize = 0
    while i < n {
        if text[i] >= 128 { ascii = false }
        i = i + 1
    }
    if ascii {
        if n > cap { return -1 }
        i = 0
        while i < n {
            out[i] = text[i]
            i = i + 1
        }
        return n as isize
    }
    local cps: [i32; 256]
    local count: usize = 0
    i = 0
    while i < n {
        local l: usize = 0
        local cp: i32 = utf8Decode(&text[i], n - i, &l)
        if cp < 0 || count >= 256 { return -1 }
        cps[count] = cp
        count = count + 1
        i = i + l
    }
    if 4 > cap { return -1 }
    out[0] = 120
    out[1] = 110
    out[2] = 45
    out[3] = 45
    local k: isize = punyEncode(&cps[0], count, &out[4], cap - 4)
    if k < 0 { return -1 }
    return (k as usize + 4) as isize
}
