// std/encoding/base32: Base32 (RFC 4648 section 6, https://www.rfc-editor.org/rfc/rfc4648#section-6) and Base32hex
// (RFC 4648 section 7). Five input bytes (40 bits) become eight 5-bit characters. A final group of 1, 2, 3, 4 or 5 bytes
// gives 2, 4, 5, 7 or 8 characters, and the rest of the eight is '=' padding (section 6, Table 2).
// Decoding is canonical (section 3.5): the padding must be exactly what the length requires, the characters before
// it must be in the alphabet, and the unused bits of the last character must be zero; anything else is rejected.
// Alphabets: Base32 "A-Z2-7" (Table 3); Base32hex "0-9A-V" (Table 4). Both are case-sensitive upper case here.

/// The 5-bit value of a Base32 or Base32hex character, or -1 when `c` is outside `alphabet`.
fn valueOf(alphabet: str, c: ui8) -> i32 {
    local i: usize = 0
    while i < 32 {
        if alphabet[i] == c { return i as i32 }
        i = i + 1
    }
    return -1
}

/// Length of the Base32 text for `n` bytes, with padding (section 6).
export fn base32EncodedLen(n: usize) -> usize {
    return ((n + 4) / 5) * 8
}

/// Encodes `data[0..n)` with `alphabet` and '=' padding into `out` (base32EncodedLen(n) bytes); returns the length.
fn encodeWith(alphabet: str, data: *ui8, n: usize, out: *ui8) -> usize {
    local o: usize = 0
    local i: usize = 0
    while i < n {
        local group: usize = n - i
        if group > 5 { group = 5 }
        // the 40-bit group, big-endian, with missing bytes as zero
        local bits: ui64 = 0
        local k: usize = 0
        while k < 5 {
            bits = bits << 8
            if k < group { bits = bits | (data[i + k] as ui64) }
            k = k + 1
        }
        // characters: 8 slots of 5 bits; the slots beyond the data are padding
        local chars: usize = 8
        if group == 1 { chars = 2 }
        if group == 2 { chars = 4 }
        if group == 3 { chars = 5 }
        if group == 4 { chars = 7 }
        k = 0
        while k < 8 {
            if k < chars {
                out[o + k] = alphabet[((bits >> ((35 - 5 * (k as i64)) as ui64)) & 31) as usize]
            } else {
                out[o + k] = 61                 // '='
            }
            k = k + 1
        }
        o = o + 8
        i = i + 5
    }
    return o
}

/// Decodes `text[0..n)` with `alphabet` into `out`. Returns the number of bytes, or -1 when the text is not canonical
/// Base32 (see the file header).
fn decodeWith(alphabet: str, text: *ui8, n: usize, out: *ui8) -> isize {
    if n % 8 != 0 { return -1 }
    local o: usize = 0
    local i: usize = 0
    while i < n {
        local pad: usize = 0
        local data: usize = 8
        // trailing '=' only in the last group
        if i + 8 == n {
            while data > 0 && text[i + data - 1] == 61 {
                data = data - 1
                pad = pad + 1
            }
        }
        // data characters before any padding must not contain '='
        local k: usize = 0
        while k < data {
            if text[i + k] == 61 { return -1 }
            k = k + 1
        }
        // 0, 2, 4, 5, 7 data characters are the only canonical counts (8 with no padding); a group of pure padding is invalid
        if data == 0 { return -1 }
        local rem: usize = data % 8
        if rem == 1 || rem == 3 || rem == 6 { return -1 }
        local bits: ui64 = 0
        k = 0
        while k < 8 {
            local v: i32 = 0
            if k < data {
                v = valueOf(alphabet, text[i + k])
                if v < 0 { return -1 }
            }
            bits = (bits << 5) | (v as ui64)
            k = k + 1
        }
        // number of bytes in this group and the unused bits that must be zero
        local bytes: usize = (data * 5) / 8
        local unused: ui64 = 40 - (bytes as ui64) * 8
        if (bits & (((1 as ui64) << unused) - 1)) != 0 { return -1 }
        k = 0
        while k < bytes {
            out[o + k] = ((bits >> (32 - 8 * (k as ui64))) & 0xff) as ui8
            k = k + 1
        }
        o = o + bytes
        i = i + 8
    }
    return o as isize
}

/// Base32 (RFC 4648 section 6) of `data[0..n)` into `out`; returns the length (base32EncodedLen(n)).
export fn base32Encode(data: *ui8, n: usize, out: *ui8) -> usize {
    return encodeWith("ABCDEFGHIJKLMNOPQRSTUVWXYZ234567", data, n, out)
}

/// Decodes Base32 text of `n` bytes into `out`; returns the byte count, or -1 for text that is not canonical Base32.
export fn base32Decode(text: *ui8, n: usize, out: *ui8) -> isize {
    return decodeWith("ABCDEFGHIJKLMNOPQRSTUVWXYZ234567", text, n, out)
}

/// Base32hex (RFC 4648 section 7) of `data[0..n)` into `out`; returns the length.
export fn base32HexEncode(data: *ui8, n: usize, out: *ui8) -> usize {
    return encodeWith("0123456789ABCDEFGHIJKLMNOPQRSTUV", data, n, out)
}

/// Decodes Base32hex text of `n` bytes into `out`; returns the byte count, or -1.
export fn base32HexDecode(text: *ui8, n: usize, out: *ui8) -> isize {
    return decodeWith("0123456789ABCDEFGHIJKLMNOPQRSTUV", text, n, out)
}
