// std/encoding/utf8: UTF-8 validation, decoding and encoding (RFC 3629, https://www.rfc-editor.org/rfc/rfc3629; the
// Unicode standard 15.0, chapter 3, for the surrogate and range rules). A sequence is valid when its lead byte and
// continuation bytes match the length, the code point is the shortest form (no overlong encodings), it is not a
// surrogate (U+D800 to U+DFFF), and it is at most U+10FFFF. Decoding returns the code point and the byte length.
// Invalid input is reported, never replaced: the caller decides what to do with it.

/// The number of bytes of the UTF-8 sequence that starts with `c`, or 0 when `c` cannot start one (a continuation byte,
/// 0xC0, 0xC1, or 0xF5 and above).
export fn utf8SeqLen(c: ui8) -> usize {
    if c < 0x80 { return 1 }
    if c >= 0xc2 && c <= 0xdf { return 2 }
    if c >= 0xe0 && c <= 0xef { return 3 }
    if c >= 0xf0 && c <= 0xf4 { return 4 }
    return 0
}

/// Decodes the sequence at `s[0..n)`. Returns the code point and writes its byte length to `len`; returns -1 for an
/// invalid or truncated sequence (and sets `len` to 1, so a scanner can skip one byte).
export fn utf8Decode(s: *ui8, n: usize, len: *usize) -> i32 {
    *len = 1
    if n == 0 { return -1 }
    local k: usize = utf8SeqLen(s[0])
    if k == 0 || k > n { return -1 }
    *len = k
    if k == 1 { return s[0] as i32 }
    local cp: i32 = (s[0] as i32) & ((0xff >> (k + 1)) as i32)
    local i: usize = 1
    while i < k {
        if (s[i] & 0xc0) != 0x80 {
            *len = 1
            return -1
        }
        cp = (cp << 6) | ((s[i] & 0x3f) as i32)
        i = i + 1
    }
    // shortest form, surrogates and the range limit
    if k == 3 && cp < 0x800 {
        *len = 1
        return -1
    }
    if k == 4 && cp < 0x10000 {
        *len = 1
        return -1
    }
    if cp >= 0xd800 && cp <= 0xdfff {
        *len = 1
        return -1
    }
    if cp > 0x10ffff {
        *len = 1
        return -1
    }
    return cp
}

/// True when `s[0..n)` is entirely valid UTF-8.
export fn utf8Valid(s: *ui8, n: usize) -> bool {
    local pos: usize = 0
    while pos < n {
        local len: usize = 0
        if utf8Decode(&s[pos], n - pos, &len) < 0 { return false }
        pos = pos + len
    }
    return true
}

/// The number of bytes that encode code point `cp` (1 to 4), or 0 when `cp` is not a valid scalar value.
export fn utf8EncodedLen(cp: i32) -> usize {
    if cp < 0 || cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff) { return 0 }
    if cp < 0x80 { return 1 }
    if cp < 0x800 { return 2 }
    if cp < 0x10000 { return 3 }
    return 4
}

/// Writes the UTF-8 encoding of `cp` to `out` (at least 4 bytes) and returns its length, or 0 for an invalid code point.
export fn utf8Encode(cp: i32, out: *ui8) -> usize {
    local k: usize = utf8EncodedLen(cp)
    if k == 1 {
        out[0] = cp as ui8
    } else if k == 2 {
        out[0] = (0xc0 | (cp >> 6)) as ui8
        out[1] = (0x80 | (cp & 0x3f)) as ui8
    } else if k == 3 {
        out[0] = (0xe0 | (cp >> 12)) as ui8
        out[1] = (0x80 | ((cp >> 6) & 0x3f)) as ui8
        out[2] = (0x80 | (cp & 0x3f)) as ui8
    } else if k == 4 {
        out[0] = (0xf0 | (cp >> 18)) as ui8
        out[1] = (0x80 | ((cp >> 12) & 0x3f)) as ui8
        out[2] = (0x80 | ((cp >> 6) & 0x3f)) as ui8
        out[3] = (0x80 | (cp & 0x3f)) as ui8
    }
    return k
}
