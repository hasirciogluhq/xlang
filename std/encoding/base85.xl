// std/encoding/base85: two 85-radix text encodings of 4-byte groups, both without padding.
//   Base85 (RFC 1924, https://www.rfc-editor.org/rfc/rfc1924): the alphabet of 85 characters in ASCII order of RFC 1924
//   section 2 ("0-9", "A-Z", "a-z", then "!#$%&()*+-;<=>?@^_`{|}~"). A group of 4 bytes is a 32-bit big-endian number;
//   it is written as 5 digits, most significant first. A final group of r bytes (1 to 3) is padded with zero bytes,
//   written as 5 digits, and the first r+1 digits are kept. Decoding pads a final group of s digits with the largest
//   digit (84) and keeps the first s-1 bytes.
//   Ascii85 (Adobe PostScript Language Reference, third edition, section 3.3.2, Level 2 "ASCII base-85 encoding"): the
//   digits are the characters '!' (33) to 'u' (117), so a group is the number plus 33 per digit; four zero bytes are
//   written as 'z'; a final group of r bytes gives r+1 digits, and whitespace in the input is ignored. Decoding stops
//   at the end marker "~>" when it is present.
// RFC 1924 and the Adobe encoding are different formats: they share the 4-byte grouping only.

define BASE85_RFC_ALPHABET = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!#$%&()*+-;<=>?@^_`{|}~"

/// Encodes `data[0..n)` as RFC 1924 base85 into `out`; returns the length. The output holds at most 5 * ceil(n / 4) bytes.
export fn base85Encode(data: *ui8, n: usize, out: *ui8) -> usize {
    local o: usize = 0
    local i: usize = 0
    while i < n {
        local group: usize = n - i
        if group > 4 { group = 4 }
        local v: ui64 = 0
        local k: usize = 0
        while k < 4 {
            v = v << 8
            if k < group { v = v | (data[i + k] as ui64) }
            k = k + 1
        }
        local digits: [ui8; 5]
        k = 5
        while k > 0 {
            k = k - 1
            digits[k] = BASE85_RFC_ALPHABET[(v % 85) as usize]
            v = v / 85
        }
        k = 0
        while k < group + 1 {
            out[o + k] = digits[k]
            k = k + 1
        }
        o = o + group + 1
        i = i + 4
    }
    return o
}

/// The RFC 1924 digit value of `c`, or -1 when `c` is not in the alphabet.
fn base85Value(c: ui8) -> i64 {
    local i: usize = 0
    while i < 85 {
        if BASE85_RFC_ALPHABET[i] == c { return i as i64 }
        i = i + 1
    }
    return -1
}

/// Decodes RFC 1924 base85 text of `n` characters into `out`; returns the byte count or -1 for an invalid character,
/// a final group of a single digit, or a value that does not fit in 32 bits.
export fn base85Decode(text: *ui8, n: usize, out: *ui8) -> isize {
    local o: usize = 0
    local i: usize = 0
    while i < n {
        local group: usize = n - i
        if group > 5 { group = 5 }
        if group == 1 { return -1 }
        local v: ui64 = 0
        local k: usize = 0
        while k < 5 {
            local d: i64 = 84
            if k < group {
                d = base85Value(text[i + k])
                if d < 0 { return -1 }
            }
            v = v * 85 + (d as ui64)
            k = k + 1
        }
        if v > 4294967295 { return -1 }
        k = 0
        while k < group - 1 {
            out[o + k] = ((v >> ((24 - 8 * (k as i64)) as ui64)) & 0xff) as ui8
            k = k + 1
        }
        o = o + group - 1
        i = i + 5
    }
    return o as isize
}

/// Encodes `data[0..n)` as Adobe ascii85 into `out`; returns the length. The output is at most 5 * ceil(n / 4) bytes.
export fn ascii85Encode(data: *ui8, n: usize, out: *ui8) -> usize {
    local o: usize = 0
    local i: usize = 0
    while i < n {
        local group: usize = n - i
        if group > 4 { group = 4 }
        if group == 4 && data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 0 && data[i + 3] == 0 {
            out[o] = 122                       // 'z'
            o = o + 1
            i = i + 4
        } else {
            local v: ui64 = 0
            local k: usize = 0
            while k < 4 {
                v = v << 8
                if k < group { v = v | (data[i + k] as ui64) }
                k = k + 1
            }
            local digits: [ui8; 5]
            k = 5
            while k > 0 {
                k = k - 1
                digits[k] = (33 + (v % 85)) as ui8
                v = v / 85
            }
            k = 0
            while k < group + 1 {
                out[o + k] = digits[k]
                k = k + 1
            }
            o = o + group + 1
            i = i + 4
        }
    }
    return o
}

/// Decodes Adobe ascii85 text of `n` characters into `out`; whitespace is skipped, 'z' is four zero bytes, and
/// "~>" ends the data. Returns the byte count or -1 for an invalid character, 'z' inside a group, a single final digit,
/// or a group that does not fit in 32 bits.
export fn ascii85Decode(text: *ui8, n: usize, out: *ui8) -> isize {
    local o: usize = 0
    local i: usize = 0
    local group: [i64; 5]
    local count: usize = 0
    while i < n {
        local c: ui8 = text[i]
        i = i + 1
        if c == 126 { break }                  // '~' starts the end marker "~>"
        if c == 32 || c == 9 || c == 10 || c == 13 || c == 12 { continue }
        if c == 122 {                          // 'z'
            if count != 0 { return -1 }
            out[o] = 0
            out[o + 1] = 0
            out[o + 2] = 0
            out[o + 3] = 0
            o = o + 4
            continue
        }
        if c < 33 || c > 117 { return -1 }
        group[count] = (c - 33) as i64
        count = count + 1
        if count == 5 {
            local v: ui64 = 0
            local k: usize = 0
            while k < 5 {
                v = v * 85 + (group[k] as ui64)
                k = k + 1
            }
            if v > 4294967295 { return -1 }
            k = 0
            while k < 4 {
                out[o + k] = ((v >> ((24 - 8 * (k as i64)) as ui64)) & 0xff) as ui8
                k = k + 1
            }
            o = o + 4
            count = 0
        }
    }
    if count == 1 { return -1 }
    if count > 1 {
        local v: ui64 = 0
        local k: usize = 0
        while k < 5 {
            local d: i64 = 84
            if k < count { d = group[k] }
            v = v * 85 + (d as ui64)
            k = k + 1
        }
        if v > 4294967295 { return -1 }
        k = 0
        while k < count - 1 {
            out[o + k] = ((v >> ((24 - 8 * (k as i64)) as ui64)) & 0xff) as ui8
            k = k + 1
        }
        o = o + count - 1
    }
    return o as isize
}
