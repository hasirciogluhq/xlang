// std/encoding/punycode: Punycode, the ASCII encoding of Unicode labels for IDNA (RFC 3492, https://www.rfc-editor.org/rfc/rfc3492,
// section 6 for the algorithm and section 5 for the parameters: base 36, tmin 1, tmax 26, skew 38, damp 700, initial bias 72,
// initial n 128). A label whose code points are all ASCII is left as it is; otherwise the basic code points are copied,
// a '-' follows them, and then one variable-length integer per non-basic code point, digits a-z and 0-9.
// The "xn--" ACE prefix (RFC 3490, section 5) is added by punyLabelToAscii. Name preparation (nameprep, RFC 3491) is not done:
// the caller passes labels already in the form it wants (no case folding or normalization here).

define PUNY_BASE = 36
define PUNY_TMIN = 1
define PUNY_TMAX = 26
define PUNY_SKEW = 38
define PUNY_DAMP = 700
define PUNY_INITIAL_BIAS = 72
define PUNY_INITIAL_N = 128

/// The bias adaptation of section 6.1; `first` is true for the first delta of the input.
fn punyAdapt(delta0: i64, points: i64, first: bool) -> i64 {
    local delta: i64 = delta0
    if first {
        delta = delta / PUNY_DAMP
    } else {
        delta = delta / 2
    }
    delta = delta + delta / points
    local k: i64 = 0
    while delta > ((PUNY_BASE - PUNY_TMIN) * PUNY_TMAX) / 2 {
        delta = delta / (PUNY_BASE - PUNY_TMIN)
        k = k + PUNY_BASE
    }
    return k + ((PUNY_BASE - PUNY_TMIN + 1) * delta) / (delta + PUNY_SKEW)
}

/// The threshold t of section 6.2 for position k with the current bias.
fn punyThreshold(k: i64, bias: i64) -> i64 {
    if k <= bias { return PUNY_TMIN }
    if k >= bias + PUNY_TMAX { return PUNY_TMAX }
    return k - bias
}

/// Digit value 0 to 35 as a character: 0-25 are a-z, 26-35 are 0-9.
fn punyDigit(d: i64) -> ui8 {
    if d < 26 { return (97 + d) as ui8 }
    return (22 + d) as ui8
}

/// The value of a digit character (a-z and A-Z are 0-25, 0-9 are 26-35), or -1.
fn punyDigitValue(c: ui8) -> i64 {
    if c >= 48 && c <= 57 { return (c as i64) - 22 }
    if c >= 65 && c <= 90 { return (c as i64) - 65 }
    if c >= 97 && c <= 122 { return (c as i64) - 97 }
    return -1
}

/// Encodes the code points `cps[0..n)` (no label prefix) into `out`; returns the byte count, or -1 when `cap` is too small.
export fn punyEncode(cps: *i32, n: usize, out: *ui8, cap: usize) -> isize {
    local o: usize = 0
    local b: usize = 0
    local i: usize = 0
    while i < n {
        if cps[i] < 128 {
            if o >= cap { return -1 }
            out[o] = cps[i] as ui8
            o = o + 1
            b = b + 1
        }
        i = i + 1
    }
    if b > 0 {
        if o >= cap { return -1 }
        out[o] = 45
        o = o + 1
    }
    local nn: i64 = PUNY_INITIAL_N
    local delta: i64 = 0
    local bias: i64 = PUNY_INITIAL_BIAS
    local h: usize = b
    while h < n {
        // m is the smallest code point not yet handled that is at least nn
        local m: i64 = 0x7fffffff
        i = 0
        while i < n {
            local c: i64 = cps[i] as i64
            if c >= nn && c < m { m = c }
            i = i + 1
        }
        delta = delta + (m - nn) * ((h as i64) + 1)
        nn = m
        i = 0
        while i < n {
            local c: i64 = cps[i] as i64
            if c < nn { delta = delta + 1 }
            if c == nn {
                local q: i64 = delta
                local k: i64 = PUNY_BASE
                while true {
                    local t: i64 = punyThreshold(k, bias)
                    if q < t { break }
                    if o >= cap { return -1 }
                    out[o] = punyDigit(t + (q - t) % (PUNY_BASE - t))
                    o = o + 1
                    q = (q - t) / (PUNY_BASE - t)
                    k = k + PUNY_BASE
                }
                if o >= cap { return -1 }
                out[o] = punyDigit(q)
                o = o + 1
                bias = punyAdapt(delta, (h as i64) + 1, h == b)
                delta = 0
                h = h + 1
            }
            i = i + 1
        }
        delta = delta + 1
        nn = nn + 1
    }
    return o as isize
}

/// Decodes the Punycode text `s[0..n)` (no "xn--" prefix) into code points in `out` (capacity `cap`); returns the number of
/// code points, or -1 for malformed input or overflow.
export fn punyDecode(s: *ui8, n: usize, out: *i32, cap: usize) -> isize {
    local len: usize = 0
    local dash: usize = n
    local i: usize = 0
    while i < n {
        if s[i] == 45 { dash = i }
        i = i + 1
    }
    local inPos: usize = 0
    if dash < n {
        i = 0
        while i < dash {
            if s[i] >= 128 || len >= cap { return -1 }
            out[len] = s[i] as i32
            len = len + 1
            i = i + 1
        }
        inPos = dash + 1
    }
    local nn: i64 = PUNY_INITIAL_N
    local idx: i64 = 0
    local bias: i64 = PUNY_INITIAL_BIAS
    while inPos < n {
        local oldi: i64 = idx
        local w: i64 = 1
        local k: i64 = PUNY_BASE
        while true {
            if inPos >= n { return -1 }
            local digit: i64 = punyDigitValue(s[inPos])
            inPos = inPos + 1
            if digit < 0 { return -1 }
            if digit > (0x7fffffff - idx) / w { return -1 }
            idx = idx + digit * w
            local t: i64 = punyThreshold(k, bias)
            if digit < t { break }
            if w > 0x7fffffff / (PUNY_BASE - t) { return -1 }
            w = w * (PUNY_BASE - t)
            k = k + PUNY_BASE
        }
        local count: i64 = (len as i64) + 1
        bias = punyAdapt(idx - oldi, count, oldi == 0)
        nn = nn + idx / count
        if nn > 0x10ffff { return -1 }
        idx = idx % count
        if len >= cap { return -1 }
        // insert nn at position idx, shifting the later code points up by one
        local at: usize = idx as usize
        local j: usize = len
        while j > at {
            out[j] = out[j - 1]
            j = j - 1
        }
        out[at] = nn as i32
        len = len + 1
        idx = idx + 1
    }
    return len as isize
}
