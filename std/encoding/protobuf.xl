// std/encoding/protobuf: the wire primitives of Protocol Buffers (https://protobuf.dev/programming-guides/encoding/). A field is
// a tag (field number << 3 | wire type) followed by its value. Varints are little-endian base-128 with the high bit as the
// continuation flag, at most 10 bytes for 64 bits (https://protobuf.dev/programming-guides/encoding/#varints). Signed
// integers in sint32/sint64 use zigzag mapping n -> (n << 1) ^ (n >> 63). Wire types: 0 varint, 1 fixed64, 2 length-delimited,
// 5 fixed32 (the groups 3 and 4 are deprecated and rejected here). Fixed values are little-endian.

/// Writes `v` as a varint into `out` (at most 10 bytes); returns the length.
export fn pbVarint(v: ui64, out: *ui8) -> usize {
    local x: ui64 = v
    local n: usize = 0
    while x >= 0x80 {
        out[n] = ((x & 0x7f) | 0x80) as ui8
        x = x >> 7
        n = n + 1
    }
    out[n] = x as ui8
    return n + 1
}

/// Reads a varint at `pos` of `buf[0..n)`. Returns the value and the new position in `pos`; the return is false on truncation
/// or a varint longer than 10 bytes. The value is returned through the struct.
export struct PbVarint {
    value: ui64
    next: usize
    ok: bool
}

export fn pbReadVarint(buf: *ui8, n: usize, pos: usize) -> PbVarint {
    local r: PbVarint
    local shift: ui64 = 0
    local p: usize = pos
    local v: ui64 = 0
    while p < n {
        local b: ui8 = buf[p]
        if shift == 63 && b > 1 { return r }
        v = v | (((b & 0x7f) as ui64) << shift)
        p = p + 1
        if b < 0x80 {
            r.value = v
            r.next = p
            r.ok = true
            return r
        }
        shift = shift + 7
        if p - pos >= 10 { return r }
    }
    return r
}

/// Zigzag encoding of a signed 64-bit integer.
export fn pbZigzag(v: i64) -> ui64 {
    return ((v << 1) ^ (v >> 63)) as ui64
}

/// Zigzag decoding back to a signed 64-bit integer.
export fn pbUnzigzag(u: ui64) -> i64 {
    return ((u >> 1) as i64) ^ (0 - ((u & 1) as i64))
}

/// The tag of a field: field number (1 to 2^29 - 1) and wire type (0, 1, 2 or 5), as a varint.
export fn pbTag(field: ui32, wire: ui8, out: *ui8) -> usize {
    return pbVarint(((field as ui64) << 3) | (wire as ui64), out)
}

/// Writes a little-endian fixed32 (wire type 5) or fixed64 (wire type 1) value; returns 4 or 8.
export fn pbFixed64(v: ui64, out: *ui8) -> usize {
    local i: usize = 0
    while i < 8 {
        out[i] = ((v >> ((i * 8) as ui64)) & 0xff) as ui8
        i = i + 1
    }
    return 8
}

export fn pbFixed32(v: ui32, out: *ui8) -> usize {
    local i: usize = 0
    while i < 4 {
        out[i] = ((v >> ((i * 8) as ui32)) & 0xff) as ui8
        i = i + 1
    }
    return 4
}
