// std/encoding/msgpack: MessagePack (the format specification at https://github.com/msgpack/msgpack/blob/master/spec.md, no RFC).
// Every value starts with one format byte. Small values are inline: positive fixint 0x00-0x7f, fixmap 0x80-0x8f, fixarray
// 0x90-0x9f, fixstr 0xa0-0xbf, negative fixint 0xe0-0xff. The others are c0 nil, c2 false, c3 true, c4-c6 bin8/16/32,
// c7-c9 ext8/16/32, ca float32, cb float64, cc-cf uint8/16/32/64, d0-d3 int8/16/32/64, d4-d8 fixext1/2/4/8/16,
// d9-db str8/16/32, dc-dd array16/32, de-df map16/32. Multi-byte lengths and numbers are big-endian. An ext value is a type
// byte (signed, application defined) followed by the data. A map's length counts pairs, so it has twice as many items.
// The encoders write the smallest form for the value; the reader accepts every form.

define MP_MAX_DEPTH = 64

/// The result of reading an unsigned integer: `value`, the position after it, and `ok`.
export struct MsgpackUint {
    value: ui64
    next: usize
    ok: bool
}

/// Writes an unsigned integer in the smallest form; returns the length (1 to 9).
export fn msgpackUint(v: ui64, out: *ui8) -> usize {
    if v < 128 {
        out[0] = v as ui8
        return 1
    }
    if v <= 0xff {
        out[0] = 0xcc
        out[1] = v as ui8
        return 2
    }
    if v <= 0xffff {
        out[0] = 0xcd
        putBe(out, 1, v, 2)
        return 3
    }
    if v <= 0xffffffff {
        out[0] = 0xce
        putBe(out, 1, v, 4)
        return 5
    }
    out[0] = 0xcf
    putBe(out, 1, v, 8)
    return 9
}

/// Writes a signed integer in the smallest form; returns the length (1 to 9).
export fn msgpackInt(v: i64, out: *ui8) -> usize {
    if v >= 0 { return msgpackUint(v as ui64, out) }
    if v >= -32 {
        out[0] = (v as i8) as ui8
        return 1
    }
    if v >= -128 {
        out[0] = 0xd0
        out[1] = (v as i8) as ui8
        return 2
    }
    if v >= -32768 {
        out[0] = 0xd1
        putBe(out, 1, v as ui64, 2)
        return 3
    }
    if v >= -2147483648 {
        out[0] = 0xd2
        putBe(out, 1, v as ui64, 4)
        return 5
    }
    out[0] = 0xd3
    putBe(out, 1, v as ui64, 8)
    return 9
}

/// The length header of a string (str family), the header of a binary blob, or the header of an array or map with `count`
/// items (`kind` is 115, 98, 97 or 109). The caller writes the payload or the items after it; returns the header length.
export fn msgpackHead(kind: ui8, count: ui64, out: *ui8) -> usize {
    if kind == 97 {
        if count < 16 {
            out[0] = (0x90 | count) as ui8
            return 1
        }
        if count <= 0xffff {
            out[0] = 0xdc
            putBe(out, 1, count, 2)
            return 3
        }
        out[0] = 0xdd
        putBe(out, 1, count, 4)
        return 5
    }
    if kind == 109 {
        if count < 16 {
            out[0] = (0x80 | count) as ui8
            return 1
        }
        if count <= 0xffff {
            out[0] = 0xde
            putBe(out, 1, count, 2)
            return 3
        }
        out[0] = 0xdf
        putBe(out, 1, count, 4)
        return 5
    }
    if kind == 115 {
        if count < 32 {
            out[0] = (0xa0 | count) as ui8
            return 1
        }
        if count <= 0xff {
            out[0] = 0xd9
            out[1] = count as ui8
            return 2
        }
        if count <= 0xffff {
            out[0] = 0xda
            putBe(out, 1, count, 2)
            return 3
        }
        out[0] = 0xdb
        putBe(out, 1, count, 4)
        return 5
    }
    // binary blob
    if count <= 0xff {
        out[0] = 0xc4
        out[1] = count as ui8
        return 2
    }
    if count <= 0xffff {
        out[0] = 0xc5
        putBe(out, 1, count, 2)
        return 3
    }
    out[0] = 0xc6
    putBe(out, 1, count, 4)
    return 5
}

/// A whole string value (UTF-8 bytes); returns the length.
export fn msgpackStr(s: *ui8, n: usize, out: *ui8) -> usize {
    local h: usize = msgpackHead(115, n as ui64, out)
    local i: usize = 0
    while i < n {
        out[h + i] = s[i]
        i = i + 1
    }
    return h + n
}

export fn msgpackBool(b: bool, out: *ui8) -> usize {
    if b {
        out[0] = 0xc3
    } else {
        out[0] = 0xc2
    }
    return 1
}

export fn msgpackNil(out: *ui8) -> usize {
    out[0] = 0xc0
    return 1
}

/// A float64 value (format cb, big-endian IEEE 754 bit pattern); returns 9.
export fn msgpackFloat64(bits: ui64, out: *ui8) -> usize {
    out[0] = 0xcb
    putBe(out, 1, bits, 8)
    return 9
}

fn putBe(out: *ui8, at: usize, v: ui64, width: usize) {
    local i: usize = 0
    while i < width {
        out[at + i] = ((v >> (((width - 1 - i) * 8) as ui64)) & 0xff) as ui8
        i = i + 1
    }
}

fn getBe(buf: *ui8, at: usize, width: usize) -> ui64 {
    local v: ui64 = 0
    local i: usize = 0
    while i < width {
        v = (v << 8) | (buf[at + i] as ui64)
        i = i + 1
    }
    return v
}

/// Reads an unsigned integer value at `pos` (positive fixint or uint 8 to 64). `ok` is false for any other value.
export fn msgpackReadUint(buf: *ui8, n: usize, pos: usize) -> MsgpackUint {
    local r: MsgpackUint
    if pos >= n { return r }
    local f: ui8 = buf[pos]
    if f < 0x80 {
        r.value = f as ui64
        r.next = pos + 1
        r.ok = true
        return r
    }
    local width: usize = 0
    if f == 0xcc {
        width = 1
    } else if f == 0xcd {
        width = 2
    } else if f == 0xce {
        width = 4
    } else if f == 0xcf {
        width = 8
    }
    if width == 0 || n - (pos + 1) < width { return r }
    r.value = getBe(buf, pos + 1, width)
    r.next = pos + 1 + width
    r.ok = true
    return r
}

/// The payload size, after the format byte, of a fixed-size value (numbers, fixext); 0 for the others.
fn fixedPayload(f: ui8) -> usize {
    if f == 0xca || f == 0xce || f == 0xd2 { return 4 }
    if f == 0xcb || f == 0xcf || f == 0xd3 { return 8 }
    if f == 0xcc || f == 0xd0 { return 1 }
    if f == 0xcd || f == 0xd1 { return 2 }
    // fixext: the type byte is part of the payload
    if f == 0xd4 { return 2 }
    if f == 0xd5 { return 3 }
    if f == 0xd6 { return 5 }
    if f == 0xd7 { return 9 }
    if f == 0xd8 { return 17 }
    return 0
}

/// The position after the value at `pos`, or 0 when it is malformed or runs past `n`.
export fn msgpackSkip(buf: *ui8, n: usize, pos: usize) -> usize {
    return skipDepth(buf, n, pos, 0)
}

fn skipDepth(buf: *ui8, n: usize, pos: usize, depth: usize) -> usize {
    if depth > MP_MAX_DEPTH || pos >= n { return 0 }
    local f: ui8 = buf[pos]
    local p: usize = pos + 1
    // inline values: no payload
    if f < 0x80 || f >= 0xe0 || f == 0xc0 || f == 0xc2 || f == 0xc3 { return p }
    if f >= 0x80 && f <= 0x8f { return skipItems(buf, n, p, ((f & 0x0f) as usize) * 2, depth) }
    if f >= 0x90 && f <= 0x9f { return skipItems(buf, n, p, (f & 0x0f) as usize, depth) }
    if f >= 0xa0 && f <= 0xbf { return skipPayload(n, p, (f & 0x1f) as usize) }
    if f == 0xdc { return skipContainer(buf, n, p, 2, 1, depth) }
    if f == 0xdd { return skipContainer(buf, n, p, 4, 1, depth) }
    if f == 0xde { return skipContainer(buf, n, p, 2, 2, depth) }
    if f == 0xdf { return skipContainer(buf, n, p, 4, 2, depth) }
    // strings and binary: a length of 1, 2 or 4 bytes, then the bytes
    if f == 0xc4 || f == 0xd9 { return skipSized(buf, n, p, 1, 0) }
    if f == 0xc5 || f == 0xda { return skipSized(buf, n, p, 2, 0) }
    if f == 0xc6 || f == 0xdb { return skipSized(buf, n, p, 4, 0) }
    // ext: a length of 1, 2 or 4 bytes, then the type byte and the data
    if f == 0xc7 { return skipSized(buf, n, p, 1, 1) }
    if f == 0xc8 { return skipSized(buf, n, p, 2, 1) }
    if f == 0xc9 { return skipSized(buf, n, p, 4, 1) }
    local fixed: usize = fixedPayload(f)
    if fixed > 0 { return skipPayload(n, p, fixed) }
    return 0
}

fn skipPayload(n: usize, at: usize, size: usize) -> usize {
    if n - at < size { return 0 }
    return at + size
}

/// Skips `count` consecutive values at `p`.
fn skipItems(buf: *ui8, n: usize, p: usize, count: usize, depth: usize) -> usize {
    local q: usize = p
    local k: usize = 0
    while k < count {
        q = skipDepth(buf, n, q, depth + 1)
        if q == 0 { return 0 }
        k = k + 1
    }
    return q
}

/// Skips a container whose item count is `width` bytes at `p`. `mult` is 1 for an array and 2 for a map (two values per pair).
fn skipContainer(buf: *ui8, n: usize, p: usize, width: usize, mult: usize, depth: usize) -> usize {
    if n - p < width { return 0 }
    local count: usize = (getBe(buf, p, width) as usize) * mult
    return skipItems(buf, n, p + width, count, depth)
}

/// Skips a sized value: a `width`-byte length at `p`, then `extra` bytes (the ext type byte) and that many bytes of data.
fn skipSized(buf: *ui8, n: usize, p: usize, width: usize, extra: usize) -> usize {
    if n - p < width { return 0 }
    local size: usize = getBe(buf, p, width) as usize
    return skipPayload(n, p + width, size + extra)
}
