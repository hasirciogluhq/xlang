// std/encoding/der: DER writing (ITU-T X.690, https://www.itu.int/rec/T-REC-X.690; the definite-length rules of
// section 8.1 and the minimal INTEGER of section 8.3). The reader is `derRead` in std/crypto/x509.
// A length below 128 is one byte; otherwise one byte 0x80 | k followed by the k big-endian length bytes, with the
// shortest k (section 8.1.3). The writer writes into a caller buffer of `derTlvLen` bytes.

/// The number of bytes of the length field for a body of `n` bytes.
export fn derLengthLen(n: usize) -> usize {
    if n < 128 { return 1 }
    local k: usize = 0
    local v: usize = n
    while v > 0 {
        k = k + 1
        v = v >> 8
    }
    return 1 + k
}

/// The total encoded size of a TLV with a body of `n` bytes: tag, length field and body.
export fn derTlvLen(n: usize) -> usize {
    return 1 + derLengthLen(n) + n
}

/// Writes tag, definite length and body into `out` (derTlvLen(n) bytes); returns the number of bytes written.
export fn derWriteTlv(tag: ui8, body: *ui8, n: usize, out: *ui8) -> usize {
    out[0] = tag
    local lenLen: usize = derLengthLen(n)
    if n < 128 {
        out[1] = n as ui8
    } else {
        local k: usize = lenLen - 1
        out[1] = (0x80 | k) as ui8
        local i: usize = 0
        while i < k {
            out[2 + i] = ((n >> (((k - 1 - i) * 8) as ui64)) & 0xff) as ui8
            i = i + 1
        }
    }
    local i: usize = 0
    while i < n {
        out[1 + lenLen + i] = body[i]
        i = i + 1
    }
    return 1 + lenLen + n
}

/// The minimal two's-complement INTEGER body for the big-endian unsigned magnitude `v[0..n)` (section 8.3.2): leading
/// zero bytes are removed, and one 0x00 is added when the top bit would otherwise make the value negative. Writes the
/// body into `out` (at most n + 1 bytes) and returns its length.
export fn derIntegerBody(v: *ui8, n: usize, out: *ui8) -> usize {
    local start: usize = 0
    while start + 1 < n && v[start] == 0 { start = start + 1 }
    local len: usize = n - start
    local o: usize = 0
    if len == 0 {
        out[0] = 0
        return 1
    }
    if (v[start] & 0x80) != 0 {
        out[0] = 0
        o = 1
    }
    local i: usize = 0
    while i < len {
        out[o + i] = v[start + i]
        i = i + 1
    }
    return o + len
}

/// The DER encodings of the primitive types of X.690 section 8 and the time types of RFC 5280 section 4.1.2.5, written into `out`
/// (capacity derTlvLen of the body). Each returns the length written.
export fn derNull(out: *ui8) -> usize {
    return derWriteTlv(0x05, out, 0, out)
}

export fn derBoolean(v: bool, out: *ui8) -> usize {
    local b: [ui8; 1]
    if v { b[0] = 0xff } else { b[0] = 0 }
    return derWriteTlv(0x01, &b[0], 1, out)
}

export fn derOctetString(body: *ui8, n: usize, out: *ui8) -> usize {
    return derWriteTlv(0x04, body, n, out)
}

/// A BIT STRING with no unused bits (the leading 0x00 of section 8.6.2).
export fn derBitString(body: *ui8, n: usize, out: *ui8) -> usize {
    local b: [ui8; 1]
    b[0] = 0
    local tmp: [ui8; 4096]
    tmp[0] = 0
    local i: usize = 0
    while i < n && i + 1 < 4096 {
        tmp[1 + i] = body[i]
        i = i + 1
    }
    return derWriteTlv(0x03, &tmp[0], n + 1, out)
}

/// An OBJECT IDENTIFIER whose content octets (the base-128 arcs) are given in `body`.
export fn derOid(body: *ui8, n: usize, out: *ui8) -> usize {
    return derWriteTlv(0x06, body, n, out)
}

export fn derUtf8String(body: *ui8, n: usize, out: *ui8) -> usize {
    return derWriteTlv(0x0c, body, n, out)
}

/// UTCTime "YYMMDDHHMMSSZ" (RFC 5280 section 4.1.2.5.1) for the years 1950 to 2049, from seconds since the epoch. Writes 15 bytes of
/// content and returns the TLV length (17).
export fn derUtcTime(unixSeconds: i64, out: *ui8) -> usize {
    local text: [ui8; 13]
    derFormatTime(unixSeconds, &text[0], 2)
    return derWriteTlv(0x17, &text[0], 13, out)
}

/// GeneralizedTime "YYYYMMDDHHMMSSZ" (RFC 5280 section 4.1.2.5.2), for any year.
export fn derGeneralizedTime(unixSeconds: i64, out: *ui8) -> usize {
    local text: [ui8; 15]
    derFormatTime(unixSeconds, &text[0], 4)
    return derWriteTlv(0x18, &text[0], 15, out)
}

/// Writes the UTC time of `t` with a year of `yearDigits` (2 or 4) digits and the terminating 'Z'. The day count uses the civil
/// calendar of std/time (Hinnant's algorithm).
fn derFormatTime(t: i64, text: *ui8, yearDigits: usize) {
    local days: i64 = t / 86400
    local rem: i64 = t % 86400
    if rem < 0 {
        rem = rem + 86400
        days = days - 1
    }
    local y: i64 = 0
    local m: i64 = 0
    local d: i64 = 0
    local z: i64 = days + 719468
    local era: i64 = z / 146097
    if z < 0 && z % 146097 != 0 { era = (z - 146096) / 146097 }
    local doe: i64 = z - era * 146097
    local yoe: i64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    y = yoe + era * 400
    local doy: i64 = doe - (365 * yoe + yoe / 4 - yoe / 100)
    local mp: i64 = (5 * doy + 2) / 153
    d = doy - (153 * mp + 2) / 5 + 1
    if mp < 10 { m = mp + 3 } else { m = mp - 9 }
    if m <= 2 { y = y + 1 }
    local o: usize = 0
    if yearDigits == 4 {
        put2(text, o, y / 100)
        o = o + 2
    }
    put2(text, o, y % 100)
    o = o + 2
    put2(text, o, m)
    o = o + 2
    put2(text, o, d)
    o = o + 2
    put2(text, o, rem / 3600)
    o = o + 2
    put2(text, o, (rem % 3600) / 60)
    o = o + 2
    put2(text, o, rem % 60)
    o = o + 2
    text[o] = 90
}

fn put2(text: *ui8, at: usize, v: i64) {
    text[at] = (48 + (v / 10) % 10) as ui8
    text[at + 1] = (48 + v % 10) as ui8
}
