// std/encoding/cborread: reading CBOR items (RFC 8949, https://www.rfc-editor.org/rfc/rfc8949). Section 3 defines the initial
// byte: major type in the top three bits, additional information in the low five bits. Additional information 0 to 23 is the
// argument itself, 24 to 27 are followed by a 1, 2, 4 or 8 byte big-endian argument, 31 is the indefinite length (majors 2 to 5)
// or the break code 0xff (major 7). Values 28 to 30 are reserved and are an error. This reader checks the structure and skips
// items; it does not build values. The decoder accepts non-shortest argument forms (RFC 8949 section 5.3.1 allows a decoder to
// reject them; it is not required to). Nesting is limited to 64 levels so that a hostile input cannot exhaust the stack.

define CBOR_MAX_DEPTH = 64

/// One item head: `major` (0 to 7), the argument `arg` (the length for strings and containers, the value for integers and
/// tags), `indefinite` for an indefinite length, the position after the head `next`, and `ok`.
export struct CborHead {
    major: ui8
    arg: ui64
    indefinite: bool
    next: usize
    ok: bool
}

/// Reads the head of the item at `pos`. The result is not ok when the input ends or the additional information is reserved.
export fn cborReadHead(buf: *ui8, n: usize, pos: usize) -> CborHead {
    local h: CborHead
    if pos >= n { return h }
    local ib: ui8 = buf[pos]
    h.major = ib >> 5
    local ai: ui8 = ib & 31
    local p: usize = pos + 1
    if ai < 24 {
        h.arg = ai as ui64
    } else if ai == 31 {
        // indefinite length for strings and containers; for major 7 this is the break code, which the caller checks
        if h.major == 0 || h.major == 1 || h.major == 6 { return h }
        h.indefinite = true
    } else if ai >= 28 {
        return h
    } else {
        local width: usize = 1
        if ai == 25 {
            width = 2
        } else if ai == 26 {
            width = 4
        } else if ai == 27 {
            width = 8
        }
        if n - p < width { return h }
        local v: ui64 = 0
        local i: usize = 0
        while i < width {
            v = (v << 8) | (buf[p + i] as ui64)
            i = i + 1
        }
        h.arg = v
        p = p + width
    }
    h.next = p
    h.ok = true
    return h
}

/// The position just after the item that starts at `pos`, or 0 when the item is malformed or runs past `n`.
export fn cborSkip(buf: *ui8, n: usize, pos: usize) -> usize {
    return skipDepth(buf, n, pos, 0)
}

fn skipDepth(buf: *ui8, n: usize, pos: usize, depth: usize) -> usize {
    if depth > CBOR_MAX_DEPTH { return 0 }
    local h: CborHead = cborReadHead(buf, n, pos)
    if !h.ok { return 0 }
    if h.major == 0 || h.major == 1 || h.major == 7 {
        if h.indefinite { return 0 }
        return h.next
    }
    if h.major == 2 || h.major == 3 {
        if h.indefinite {
            // a sequence of definite-length chunks of the same major type, then break
            local p: usize = h.next
            while true {
                if p >= n { return 0 }
                if buf[p] == 255 { return p + 1 }
                local c: CborHead = cborReadHead(buf, n, p)
                if !c.ok || c.major != h.major || c.indefinite { return 0 }
                if n - c.next < c.arg as usize { return 0 }
                p = c.next + (c.arg as usize)
            }
        }
        if n - h.next < h.arg as usize { return 0 }
        return h.next + (h.arg as usize)
    }
    if h.major == 4 || h.major == 5 {
        // a map has two items per pair
        local items: usize = 0
        local p: usize = h.next
        if h.indefinite {
            while true {
                if p >= n { return 0 }
                if buf[p] == 255 { return p + 1 }
                p = skipDepth(buf, n, p, depth + 1)
                if p == 0 { return 0 }
            }
        }
        items = h.arg as usize
        if h.major == 5 { items = items * 2 }
        local k: usize = 0
        while k < items {
            p = skipDepth(buf, n, p, depth + 1)
            if p == 0 { return 0 }
            k = k + 1
        }
        return p
    }
    // major 6: a tag wraps exactly one item
    if h.indefinite { return 0 }
    return skipDepth(buf, n, h.next, depth + 1)
}
