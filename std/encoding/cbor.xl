// std/encoding/cbor: CBOR encoding of the common data items (RFC 8949, https://www.rfc-editor.org/rfc/rfc8949). Each item
// starts with an initial byte: the major type in the top three bits and an argument in the low five bits, with the argument
// in the following 1, 2, 4 or 8 bytes big-endian when it does not fit (section 3). Integers and lengths use the shortest form
// (section 4.2.1). The functions write into a caller buffer and return the length; the buffer must hold the item.
// Major types: 0 unsigned integer, 1 negative integer, 2 byte string, 3 text string, 4 array, 5 map, 7 simple values.

/// Writes the initial byte and argument `arg` of major type `major` (0 to 7) to `out`; returns the length (1 to 9).
export fn cborHead(major: ui8, arg: ui64, out: *ui8) -> usize {
    local mt: ui8 = major << 5
    if arg < 24 {
        out[0] = mt | (arg as ui8)
        return 1
    }
    if arg <= 0xff {
        out[0] = mt | 24
        out[1] = arg as ui8
        return 2
    }
    if arg <= 0xffff {
        out[0] = mt | 25
        out[1] = ((arg >> 8) & 0xff) as ui8
        out[2] = (arg & 0xff) as ui8
        return 3
    }
    if arg <= 0xffffffff {
        out[0] = mt | 26
        local i: usize = 0
        while i < 4 {
            out[1 + i] = ((arg >> (((3 - i) * 8) as ui64)) & 0xff) as ui8
            i = i + 1
        }
        return 5
    }
    out[0] = mt | 27
    local j: usize = 0
    while j < 8 {
        out[1 + j] = ((arg >> (((7 - j) * 8) as ui64)) & 0xff) as ui8
        j = j + 1
    }
    return 9
}

/// An unsigned integer item.
export fn cborUint(v: ui64, out: *ui8) -> usize {
    return cborHead(0, v, out)
}

/// A signed integer item: non-negative values are major type 0, negative ones major type 1 with the argument -1 - v.
export fn cborInt(v: i64, out: *ui8) -> usize {
    if v >= 0 { return cborHead(0, v as ui64, out) }
    return cborHead(1, ((0 - (v + 1)) as ui64), out)
}

/// A byte string (major type 2) or a text string (major type 3) of `n` bytes at `s`; returns the length.
export fn cborString(major: ui8, s: *ui8, n: usize, out: *ui8) -> usize {
    local h: usize = cborHead(major, n as ui64, out)
    local i: usize = 0
    while i < n {
        out[h + i] = s[i]
        i = i + 1
    }
    return h + n
}

/// An array or map header for `count` items (for a map, `count` is the number of pairs; the caller writes the keys and
/// values after it).
export fn cborArrayHead(count: ui64, out: *ui8) -> usize {
    return cborHead(4, count, out)
}

export fn cborMapHead(pairs: ui64, out: *ui8) -> usize {
    return cborHead(5, pairs, out)
}

/// The simple values false (20), true (21) and null (22).
export fn cborBool(b: bool, out: *ui8) -> usize {
    if b {
        out[0] = 0xf5
    } else {
        out[0] = 0xf4
    }
    return 1
}

export fn cborNull(out: *ui8) -> usize {
    out[0] = 0xf6
    return 1
}
