// std/sys: sockets for TCP and UDP over IPv4, one file for every OS. Each public function is written once;
// only its body routes with `#if os`. Linux and macOS call the kernel directly (raw syscalls); Windows calls
// the documented ws2_32 library, because Windows has no stable socket system call numbers.
//
// Users never call OS setup. Every socket creator calls `sockUp` first, which performs the per-OS
// one-time state (WSAStartup on Windows, the process-wide SIGPIPE disposition on Linux). The
// public functions below are the whole socket surface of std/sys.
//
// Specifications:
//   TCP:  RFC 9293 (https://www.rfc-editor.org/rfc/rfc9293), obsoletes RFC 793 (https://www.rfc-editor.org/rfc/rfc793)
//   UDP:  RFC 768  (https://www.rfc-editor.org/rfc/rfc768)
//   IPv4: RFC 791  (https://www.rfc-editor.org/rfc/rfc791)
//   Host requirements: RFC 1122 (https://www.rfc-editor.org/rfc/rfc1122)
//
// Constants shared by all OSes come first, then the OS-specific numbers and imports.
define AF_INET = 2                  // IPv4 address family (https://man7.org/linux/man-pages/man7/ip.7.html)
define SOCK_STREAM = 1              // TCP byte stream (https://man7.org/linux/man-pages/man2/socket.2.html)
define SOCK_DGRAM = 2               // UDP datagrams (same page)

#if os == "linux"
// Linux x86-64 and aarch64 numbers: https://github.com/torvalds/linux/blob/master/arch/x86/entry/syscalls/syscall_64.tbl
// and https://github.com/torvalds/linux/blob/master/include/uapi/asm-generic/unistd.h (aarch64 uses the generic table).
#if arch == "x86_64"
define SYS_SOCKET = 41
define SYS_CONNECT = 42
define SYS_ACCEPT = 43
define SYS_BIND = 49
define SYS_LISTEN = 50
define SYS_SETSOCKOPT = 54
define SYS_RT_SIGACTION = 13
#elif arch == "aarch64"
define SYS_SOCKET = 198
define SYS_CONNECT = 203
define SYS_ACCEPT = 202
define SYS_BIND = 200
define SYS_LISTEN = 201
define SYS_SETSOCKOPT = 208
define SYS_RT_SIGACTION = 134
#endif
// SOL_SOCKET and the SO_* options (https://man7.org/linux/man-pages/man7/socket.7.html)
define SOL_SOCKET = 1
define SO_REUSEADDR = 2
define SO_RCVTIMEO = 20
define SIGPIPE = 13                 // https://man7.org/linux/man-pages/man7/signal.7.html
global sigpipeIgnored: bool
#elif os == "macos"
// XNU syscall numbers (https://github.com/apple-oss-distributions/xnu/blob/main/bsd/kern/syscalls.master)
define SYS_ACCEPT = 30
define SYS_SOCKET = 97
define SYS_CONNECT = 98
define SYS_BIND = 104
define SYS_SETSOCKOPT = 105
define SYS_LISTEN = 106
// SOL_SOCKET and SO_* values (https://github.com/apple-oss-distributions/xnu/blob/main/bsd/sys/socket.h)
define SOL_SOCKET = 65535
define SO_REUSEADDR = 4
define SO_RCVTIMEO = 4102
define SO_NOSIGPIPE = 4130          // per-socket SIGPIPE suppression (BSD-derived)
#elif os == "windows"
// A socket fd is the SOCKET value with bit 30 set, so `sysRead`/`sysWrite`/`sysClose` tell it from a file handle.
// Bit 30 is outside the 32-bit range of kernel handles' low bits used in practice, so the tag is unambiguous here.
define SOCKET_TAG = 1073741824
// Winsock option values (https://learn.microsoft.com/en-us/windows/win32/winsock/socket-options-and-ioctls-with-winsock)
define SOL_SOCKET = 65535
define SO_RCVTIMEO = 4102
// ws2_32 entry points. Every function is documented at
// https://learn.microsoft.com/en-us/windows/win32/api/winsock2/ (WSAStartup, socket, connect, bind, listen,
// accept, recv, send, closesocket) and https://learn.microsoft.com/en-us/windows/win32/api/winsock/nf-winsock-setsockopt
@library("ws2_32") declare fn WSAStartup(version: ui16, data: *ui8) -> i32
@library("ws2_32") declare fn socket(af: i32, kind: i32, proto: i32) -> ui64
@library("ws2_32") declare fn connect(s: ui64, addr: *ui8, len: i32) -> i32
@library("ws2_32") declare fn bind(s: ui64, addr: *ui8, len: i32) -> i32
@library("ws2_32") declare fn listen(s: ui64, backlog: i32) -> i32
@library("ws2_32") declare fn accept(s: ui64, addr: *ui8, len: *i32) -> ui64
@library("ws2_32") declare fn recv(s: ui64, buf: *ui8, len: i32, flags: i32) -> i32
@library("ws2_32") declare fn send(s: ui64, buf: *ui8, len: i32, flags: i32) -> i32
@library("ws2_32") declare fn closesocket(s: ui64) -> i32
@library("ws2_32") declare fn setsockopt(s: ui64, level: i32, name: i32, value: *ui8, len: i32) -> i32
global wsaReady: bool
#endif

// ---- one-time OS state ---------------------------------------------------------------------------

#if os == "windows"
/// Calls WSAStartup for Winsock 2.2 once per process. Every ws2_32 call fails before this succeeds.
/// Specification: https://learn.microsoft.com/en-us/windows/win32/api/winsock2/nf-winsock2-wsastartup
fn wsaInit() -> bool {
    if wsaReady { return true }
    local data: [ui8; 512]          // WSADATA, filled by the call; its fields are not read here
    if WSAStartup(514, &data[0]) != 0 { return false }     // 514 = MAKEWORD(2, 2)
    wsaReady = true
    return true
}
#endif

/// Brings the OS socket layer to the state every socket call needs. Called by each socket creator, so
/// callers never see it.
///   Windows: WSAStartup, once per process.
///   Linux:   SIGPIPE ignored, once per process, so a write to a closed peer returns EPIPE instead of
///            killing the process. Spec: https://man7.org/linux/man-pages/man7/signal.7.html and
///            https://man7.org/linux/man-pages/man2/rt_sigaction.2.html
///   macOS:   nothing process-wide; SIGPIPE is suppressed per socket with SO_NOSIGPIPE (see `noSigpipe`).
/// Returns false when the OS refuses the setup, and then the caller reports a negative result.
fn sockUp() -> bool {
#if os == "windows"
    return wsaInit()
#elif os == "linux"
    if sigpipeIgnored { return true }
    // Kernel `struct sigaction` for SIG_IGN: handler = 1 (SIG_IGN), flags, restorer, mask all zero.
    // Layout: https://man7.org/linux/man-pages/man2/sigaction.2.html (kernel sigaction, 32 bytes on x86-64/aarch64).
    local act: [i64; 4]
    act[0] = 1
    act[1] = 0
    act[2] = 0
    act[3] = 0
    if syscall(SYS_RT_SIGACTION, SIGPIPE, &act[0], 0, 8) < 0 { return false }     // 8 = sigsetsize
    sigpipeIgnored = true
    return true
#else
    return true
#endif
}

/// Makes writes to a gone peer fail with EPIPE on this socket instead of raising SIGPIPE. macOS only:
/// SO_NOSIGPIPE is a per-socket option, so it is set on every new fd. Linux and Windows need nothing here
/// (process-wide in `sockUp`, and Windows has no SIGPIPE).
/// Option reference: SO_NOSIGPIPE in https://github.com/apple-oss-distributions/xnu/blob/main/bsd/sys/socket.h
fn noSigpipe(fd: i32) {
#if os == "macos"
    if fd < 0 { return }
    local one: i32 = 1
    syscall(SYS_SETSOCKOPT, fd, SOL_SOCKET, SO_NOSIGPIPE, &one, 4)
#endif
}

// ---- Windows handle tagging ----------------------------------------------------------------------

#if os == "windows"
/// Creates a ws2_32 socket and returns it as a tagged fd. `sockUp` must have run.
fn newSocket(kind: i32, proto: i32) -> i32 {
    local s: ui64 = socket(AF_INET, kind, proto)
    if s == 18446744073709551615 { return -1 }     // INVALID_SOCKET (~0)
    return (s as i32) | SOCKET_TAG
}

/// True when `fd` came from `newSocket` or `sysTcpAccept` rather than a file handle.
export fn isSocket(fd: i32) -> bool {
    return fd >= 0 && (fd & SOCKET_TAG) != 0
}

/// The raw SOCKET value behind a tagged fd.
export fn socketOf(fd: i32) -> ui64 {
    return (fd & (SOCKET_TAG - 1)) as ui64
}

/// Sends up to `n` bytes. Clamped to the largest length ws2_32 accepts in one call. -1 on failure.
export fn sockSend(fd: i32, buf: *ui8, n: usize) -> isize {
    local len: i32 = n as i32
    if n > 1073741824 { len = 1073741824 }
    local w: i32 = send(socketOf(fd), buf, len, 0)
    if w < 0 { return -1 }
    return w as isize
}

/// Receives up to `n` bytes. 0 at end of stream, -1 on failure.
export fn sockRecv(fd: i32, buf: *ui8, n: usize) -> isize {
    local len: i32 = n as i32
    if n > 1073741824 { len = 1073741824 }
    local r: i32 = recv(socketOf(fd), buf, len, 0)
    if r < 0 { return -1 }
    return r as isize
}

/// Closes a socket fd. 0 on success, -1 on failure.
export fn sockClose(fd: i32) -> i32 {
    return closesocket(socketOf(fd))
}
#endif

// ---- public socket API ---------------------------------------------------------------------------

/// A TCP socket (SOCK_STREAM, IPPROTO_TCP = 6); negative on failure.
/// Spec: https://man7.org/linux/man-pages/man2/socket.2.html and RFC 9293.
export fn sysTcpSocket() -> i32 {
    if !sockUp() { return -1 }
#if os == "windows"
    return newSocket(SOCK_STREAM, 6)
#else
    local fd: i32 = syscall(SYS_SOCKET, AF_INET, SOCK_STREAM, 0) as i32
    noSigpipe(fd)
    return fd
#endif
}

/// A UDP socket (SOCK_DGRAM, IPPROTO_UDP = 17); negative on failure. After `sysTcpConnect` (which fixes the
/// peer for UDP, see https://man7.org/linux/man-pages/man2/connect.2.html) plain `sysWrite`/`sysRead` send
/// and receive datagrams.
export fn sysUdpSocket() -> i32 {
    if !sockUp() { return -1 }
#if os == "windows"
    return newSocket(SOCK_DGRAM, 17)
#else
    return syscall(SYS_SOCKET, AF_INET, SOCK_DGRAM, 0) as i32
#endif
}

/// Receive timeout in milliseconds (0 = none); 0 on success.
/// SO_RCVTIMEO takes a struct timeval on Linux and macOS (https://man7.org/linux/man-pages/man7/socket.7.html)
/// and a 4-byte DWORD of milliseconds on Windows (https://learn.microsoft.com/en-us/windows/win32/api/winsock/nf-winsock-setsockopt).
export fn sysSetRecvTimeout(fd: i32, ms: i32) -> i32 {
#if os == "windows"
    local v: i32 = ms
    return setsockopt(socketOf(fd), SOL_SOCKET, SO_RCVTIMEO, &v as *ui8, 4)
#else
    local tv: [i64; 2]              // struct timeval { tv_sec, tv_usec }, both 64-bit on Linux and macOS
    tv[0] = (ms / 1000) as i64
    tv[1] = ((ms % 1000) * 1000) as i64
    return syscall(SYS_SETSOCKOPT, fd, SOL_SOCKET, SO_RCVTIMEO, &tv[0], 16) as i32
#endif
}

/// Fills a 16-byte sockaddr_in. `ip` is in host order (`127.0.0.1` = 2130706433); the port and address are
/// written in network (big-endian) order, as RFC 791 section 3.2 and https://man7.org/linux/man-pages/man7/ip.7.html require.
/// Layout: Linux and Windows start with a little-endian u16 family; macOS (BSD) starts with a sin_len byte and then the family.
/// Reference: https://github.com/apple-oss-distributions/xnu/blob/main/bsd/netinet/in.h
fn fillAddr(addr: *ui8, ip: ui32, port: ui16) {
    local i: usize = 0
    while i < 16 {
        addr[i] = 0
        i = i + 1
    }
#if os == "macos"
    addr[0] = 16                    // sin_len
    addr[1] = AF_INET
#else
    addr[0] = AF_INET               // little-endian u16 family
#endif
    addr[2] = (port / 256) as ui8
    addr[3] = (port % 256) as ui8
    addr[4] = (ip / 16777216) as ui8
    addr[5] = ((ip / 65536) % 256) as ui8
    addr[6] = ((ip / 256) % 256) as ui8
    addr[7] = (ip % 256) as ui8
}

/// Connects a TCP socket to `ip:port` (or fixes the peer of a UDP socket). 0 on success.
/// Spec: https://man7.org/linux/man-pages/man2/connect.2.html
export fn sysTcpConnect(fd: i32, ip: ui32, port: ui16) -> i32 {
    local addr: [ui8; 16]
    fillAddr(&addr[0], ip, port)
#if os == "windows"
    if connect(socketOf(fd), &addr[0], 16) != 0 { return -1 }
    return 0
#else
    return syscall(SYS_CONNECT, fd, &addr[0], 16) as i32
#endif
}

/// bind + listen. 0 on success. SO_REUSEADDR is set everywhere except Windows, where it would let
/// another process steal the port. Spec: https://man7.org/linux/man-pages/man7/socket.7.html
export fn sysTcpListen(fd: i32, ip: ui32, port: ui16) -> i32 {
    local addr: [ui8; 16]
    fillAddr(&addr[0], ip, port)
#if os == "windows"
    if bind(socketOf(fd), &addr[0], 16) != 0 { return -1 }
    if listen(socketOf(fd), 128) != 0 { return -1 }
    return 0
#else
    local one: i32 = 1
    syscall(SYS_SETSOCKOPT, fd, SOL_SOCKET, SO_REUSEADDR, &one, 4)
    if syscall(SYS_BIND, fd, &addr[0], 16) < 0 { return -1 }
    if syscall(SYS_LISTEN, fd, 128) < 0 { return -1 }
    return 0
#endif
}

/// Blocks until a connection arrives and returns its fd; negative on failure.
/// Spec: https://man7.org/linux/man-pages/man2/accept.2.html and RFC 9293 section 3.5 (connection establishment).
export fn sysTcpAccept(fd: i32) -> i32 {
#if os == "windows"
    local s: ui64 = accept(socketOf(fd), nil, nil)
    if s == 18446744073709551615 { return -1 }
    return (s as i32) | SOCKET_TAG
#else
    local conn: i32 = syscall(SYS_ACCEPT, fd, 0, 0) as i32
    noSigpipe(conn)
    return conn
#endif
}
