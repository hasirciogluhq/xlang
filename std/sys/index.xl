// std/sys: the raw OS layer (plan 7.1). The compiler only translates `syscall`; every number
// and structure below is xl. Native parts are chosen per OS with `#if os`; sockets are one file
// (`sock`) that routes its own bodies, so only the OS-specific pieces differ between modules.
#if os == "linux" export * from "linux"
#if os == "macos" export * from "macos"
#if os == "windows" export * from "windows"
export * from "sock"
export * from "env"
export * from "uring"
