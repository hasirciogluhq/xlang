// std/sys/uring: io_uring on Linux (io_uring_setup 425, io_uring_enter 426; include/uapi/linux/io_uring.h). A ring is set up with
// io_uring_setup, its three regions are mapped (the submission ring at offset IORING_OFF_SQ_RING = 0, the completion ring at
// IORING_OFF_CQ_RING = 0x8000000, the submission entries at IORING_OFF_SQES = 0x10000000), and entries are published by writing
// the tail with release ordering. This module offers the minimal backend the event loop needs: a NOP round trip that proves the
// ring works. Setup refused with ENOSYS (no kernel support) or EPERM (seccomp or container policy) makes uringAvailable return
// false; the caller then uses epoll (std/sys/event). Linux only.
#if os == "linux"

define URING_SETUP = 425
define URING_ENTER = 426
define URING_OFF_SQ_RING = 0
define URING_OFF_CQ_RING = 134217728
define URING_OFF_SQES = 268435456
define URING_ENTER_GETEVENTS = 1
define URING_OP_NOP = 0
define URING_PROT_RW = 3
define URING_MAP_SHARED = 1
#if arch == "x86_64"
define URING_MMAP = 9
define URING_MUNMAP = 11
#elif arch == "aarch64"
define URING_MMAP = 222
define URING_MUNMAP = 215
#endif

/// Offsets of the submission ring fields (io_sqring_offsets, 40 bytes).
@repr(c) struct UringSqOff {
    head: ui32
    tail: ui32
    ringMask: ui32
    ringEntries: ui32
    flags: ui32
    dropped: ui32
    array: ui32
    resv1: ui32
    userAddr: ui64
}

/// Offsets of the completion ring fields (io_cqring_offsets, 40 bytes).
@repr(c) struct UringCqOff {
    head: ui32
    tail: ui32
    ringMask: ui32
    ringEntries: ui32
    overflow: ui32
    cqes: ui32
    flags: ui32
    resv1: ui32
    userAddr: ui64
}

/// io_uring_params (120 bytes): input flags and ring sizes, and the offsets the kernel returns.
@repr(c) struct UringParams {
    sqEntries: ui32
    cqEntries: ui32
    flags: ui32
    sqThreadCpu: ui32
    sqThreadIdle: ui32
    features: ui32
    wqFd: ui32
    resv0: ui32
    resv1: ui32
    resv2: ui32
    sqOff: UringSqOff
    cqOff: UringCqOff
}

/// A set-up ring: the file descriptor, the mapped regions and pointers into them.
export struct Uring {
    fd: i32
    sqRing: usize
    sqRingSize: usize
    cqRing: usize
    cqRingSize: usize
    sqes: usize
    sqesSize: usize
    sqHead: usize
    sqTail: usize
    sqMask: ui32
    sqArray: usize
    cqHead: usize
    cqTail: usize
    cqMask: ui32
    cqes: usize
    entries: ui32
}

/// Maps `size` bytes of the ring file `fd` at `offset`; 0 on failure.
fn uringMap(fd: i32, size: usize, offset: usize) -> usize {
    local r: i64 = syscall(URING_MMAP, 0, size, URING_PROT_RW, URING_MAP_SHARED, fd, offset)
    if r < 0 { return 0 }
    return r as usize
}

/// Sets up a ring with `entries` submission slots. False when the kernel refuses (the error is not kept).
export fn uringSetup(entries: ui32, u: *Uring) -> bool {
    local p: UringParams
    local fd: i64 = syscall(URING_SETUP, entries, &p as *void)
    if fd < 0 { return false }
    u.fd = fd as i32
    u.entries = p.sqEntries
    u.sqRingSize = (p.sqOff.array as usize) + (p.sqEntries as usize) * 4
    u.cqRingSize = (p.cqOff.cqes as usize) + (p.cqEntries as usize) * 16
    u.sqesSize = (p.sqEntries as usize) * 64
    u.sqRing = uringMap(u.fd, u.sqRingSize, URING_OFF_SQ_RING)
    u.cqRing = uringMap(u.fd, u.cqRingSize, URING_OFF_CQ_RING)
    u.sqes = uringMap(u.fd, u.sqesSize, URING_OFF_SQES)
    if u.sqRing == 0 || u.cqRing == 0 || u.sqes == 0 {
        uringClose(u)
        return false
    }
    u.sqHead = u.sqRing + (p.sqOff.head as usize)
    u.sqTail = u.sqRing + (p.sqOff.tail as usize)
    u.sqMask = *((u.sqRing + (p.sqOff.ringMask as usize)) as *ui32)
    u.sqArray = u.sqRing + (p.sqOff.array as usize)
    u.cqHead = u.cqRing + (p.cqOff.head as usize)
    u.cqTail = u.cqRing + (p.cqOff.tail as usize)
    u.cqMask = *((u.cqRing + (p.cqOff.ringMask as usize)) as *ui32)
    u.cqes = u.cqRing + (p.cqOff.cqes as usize)
    // the submission array maps slot i to entry i
    local i: ui32 = 0
    while i < p.sqEntries {
        *((u.sqArray + (i as usize) * 4) as *ui32) = i
        i = i + 1
    }
    return true
}

/// Submits one NOP with `userData`, waits for its completion and returns the completion result (0 for a NOP), or -1 when no
/// completion arrived.
export fn uringNop(u: *Uring, userData: ui64) -> i32 {
    local tail: ui32 = __builtin_atomicLoad(u.sqTail as *ui32, MemoryOrder.acquire)
    local idx: ui32 = tail & u.sqMask
    local sqe: usize = u.sqes + (idx as usize) * 64
    local k: usize = 0
    while k < 64 {
        *((sqe + k) as *ui8) = 0
        k = k + 1
    }
    *(sqe as *ui8) = URING_OP_NOP
    *((sqe + 32) as *ui64) = userData
    __builtin_atomicStore(u.sqTail as *ui32, tail + 1, MemoryOrder.release)
    local r: i64 = syscall(URING_ENTER, u.fd, 1, 1, URING_ENTER_GETEVENTS, 0, 0)
    if r < 0 { return -1 }
    local head: ui32 = __builtin_atomicLoad(u.cqHead as *ui32, MemoryOrder.acquire)
    local ctail: ui32 = __builtin_atomicLoad(u.cqTail as *ui32, MemoryOrder.acquire)
    if head == ctail { return -1 }
    local cqe: usize = u.cqes + ((head & u.cqMask) as usize) * 16
    local res: i32 = *((cqe + 8) as *i32)
    __builtin_atomicStore(u.cqHead as *ui32, head + 1, MemoryOrder.release)
    return res
}

/// Unmaps the rings and closes the descriptor.
export fn uringClose(u: *Uring) {
    if u.sqRing != 0 { syscall(URING_MUNMAP, u.sqRing, u.sqRingSize) }
    if u.cqRing != 0 { syscall(URING_MUNMAP, u.cqRing, u.cqRingSize) }
    if u.sqes != 0 { syscall(URING_MUNMAP, u.sqes, u.sqesSize) }
    if u.fd >= 0 { syscall(3, u.fd) }
    u.sqRing = 0
    u.cqRing = 0
    u.sqes = 0
    u.fd = -1
}

/// True when the kernel and the container policy allow a ring: a ring is set up, used for one NOP and closed.
export fn uringAvailable() -> bool {
    local u: Uring
    u.fd = -1
    if !uringSetup(8, &u) { return false }
    local ok: bool = uringNop(&u, 1) == 0
    uringClose(&u)
    return ok
}

#endif
