// macOS: raw BSD syscalls (the compiler adds the syscall class on x86_64; numbers are the same
// on both architectures). No libSystem is called.
define SYS_EXIT = 1
define SYS_READ = 3
define SYS_WRITE = 4
define SYS_MUNMAP = 73
define SYS_MMAP = 197

define SYS_OPEN = 5
define SYS_CLOSE = 6
define SYS_UNLINK = 10
define SYS_LSEEK = 199
define O_RDONLY = 0
define O_WRONLY_CREAT_TRUNC = 1537     // O_WRONLY | O_CREAT | O_TRUNC
define O_WRONLY_CREAT_APPEND = 521     // O_WRONLY | O_CREAT | O_APPEND

define PROT_READ_WRITE = 3
define MAP_PRIVATE_ANON = 4098      // MAP_PRIVATE | MAP_ANON

export fn sysWrite(fd: i32, buf: *ui8, n: usize) -> isize {
    return syscall(SYS_WRITE, fd, buf, n) as isize
}

/// Writes to a file descriptor; on macOS the same call as `sysWrite` (Windows separates the two).
export fn sysWriteFile(fd: i32, buf: *ui8, n: usize) -> isize {
    return sysWrite(fd, buf, n)
}

export fn sysRead(fd: i32, buf: *ui8, n: usize) -> isize {
    return syscall(SYS_READ, fd, buf, n) as isize
}

export fn sysExit(code: i32) {
    syscall(SYS_EXIT, code)
}

export fn sysMap(size: usize) -> *void {
    local r: i64 = syscall(SYS_MMAP, 0, size, PROT_READ_WRITE, MAP_PRIVATE_ANON, -1, 0)
    if r < 0 && r > -4096 { return nil }
    return r as *void
}

export fn sysUnmap(p: *void, size: usize) {
    syscall(SYS_MUNMAP, p, size)
}

// No yield call yet: the XNU table read for this work has no `sched_yield` entry, and the number once
// used here (331) was not verified against `bsd/kern/syscalls.master`. Callers spin instead (see docs/syscalls/macos-xnu.md).
export fn sysYield() {
}

export fn sysThreadId() -> i64 {
    return 0
}

/// macOS has no futex: waiting spins on the scheduler yield (psynch needs mutex/cond structures).
export fn sysWait(addr: *ui32, expected: ui32) {
    local spins: i32 = 0
    while __builtin_atomicLoad(addr, MemoryOrder.acquire) == expected && spins < 64 {
        spins = spins + 1
    }
}

export fn sysWake(addr: *ui32, count: i32) {
}

// ---- threads: libSystem pthreads (decision D1, option A in docs/known-limitations.md) ------------
//
// pthread_create, pthread_attr_setstack and pthread_detach are the documented interface of libSystem (Apple, pthread(3)). The raw
// bsdthread_* system calls are not used: the kernel refuses bsdthread_register in a process that did not start through libSystem.
// The thread module keeps its own stack (sysMap) and its own exit word (`ctid`, cleared when the entry returns), so the pthread
// attribute only points at that stack; the thread is detached at creation.

@library("System") declare fn pthread_create(th: *ui64, attr: *void, start: fn(*void) -> *void, arg: *void) -> i32
@library("System") declare fn pthread_attr_init(attr: *void) -> i32
@library("System") declare fn pthread_attr_setstack(attr: *void, stack: *void, size: usize) -> i32
@library("System") declare fn pthread_attr_destroy(attr: *void) -> i32
@library("System") declare fn pthread_detach(th: ui64) -> i32

/// Runs on the new pthread: the user entry, then the exit word is cleared (the join protocol of std/thread).
fn threadTrampoline(p: *void) -> *void {
    local words: *usize = p as *usize
    local entry: fn(*void) = words[0] as fn(*void)
    local arg: *void = words[1] as *void
    local ctid: *ui32 = words[2] as *ui32
    entry(arg)
    __builtin_atomicStore(ctid, 0, MemoryOrder.release)
    return nil
}

export fn sysThreadCreate(entry: fn(*void), arg: *void, stack: *void, size: usize, ctid: *ui32) -> i64 {
    // The argument block sits at the bottom of the region: Darwin keeps its own thread structure at the top of a custom stack.
    local block: *usize = stack as *usize
    block[0] = entry as usize
    block[1] = arg as usize
    block[2] = ctid as usize
    // pthread_attr_t is 64 bytes on arm64 and x86-64 macOS; 128 bytes of ui64 leave room for the opaque layout
    local attr: [ui64; 16]
    if pthread_attr_init(&attr[0] as *void) != 0 { return -1 }
    // Darwin takes the TOP (highest address) of a caller-provided stack: stacks grow down from it
    if pthread_attr_setstack(&attr[0] as *void, (stack as usize + size) as *void, size) != 0 {
        pthread_attr_destroy(&attr[0] as *void)
        return -1
    }
    local tid: ui64 = 0
    local r: i32 = pthread_create(&tid, &attr[0] as *void, threadTrampoline, block as *void)
    pthread_attr_destroy(&attr[0] as *void)
    if r != 0 { return -1 }
    pthread_detach(tid)
    return tid as i64
}

/// The stack belongs to the thread module (sysMap / sysUnmap); nothing to release here.
export fn sysThreadRelease(stack: *void, size: usize) {
}

// ---- readiness polling (kqueue) ----------------------------------------------------------

define SYS_KQUEUE = 362
define SYS_KEVENT = 363
define EVFILT_READ = -1
define EVFILT_WRITE = -2
define EV_ADD_ONESHOT = 17          // EV_ADD | EV_ONESHOT

export fn sysPollCreate() -> i32 {
    return syscall(SYS_KQUEUE) as i32
}

export fn sysPollWatch(pfd: i32, fd: i32, write: bool, token: usize) -> i32 {
    // struct kevent: ident ui64, filter i16, flags ui16, fflags ui32, data i64, udata ui64 (32 bytes)
    local ev: [usize; 4]
    ev[0] = fd as usize
    ev[1] = 0
    ev[2] = 0
    ev[3] = token
    local filter: i16 = EVFILT_READ
    if write { filter = EVFILT_WRITE }
    local head: *i16 = &ev[1] as *i16
    head[0] = filter
    local flags: *ui16 = (&ev[1] as usize + 2) as *ui16
    flags[0] = EV_ADD_ONESHOT
    return syscall(SYS_KEVENT, pfd, &ev[0], 1, 0, 0, 0) as i32
}

export fn sysPollWait(pfd: i32, tokens: *usize, max: i32, timeoutMs: i32) -> i32 {
    if max > 16 { max = 16 }
    local buf: [usize; 64]
    local ts: [usize; 2]
    local tsp: *usize = nil
    if timeoutMs >= 0 {
        ts[0] = (timeoutMs / 1000) as usize
        ts[1] = ((timeoutMs % 1000) as usize) * 1000000
        tsp = &ts[0]
    }
    local n: i64 = syscall(SYS_KEVENT, pfd, 0, 0, &buf[0], max, tsp)
    if n <= 0 { return 0 }
    local i: i32 = 0
    while i < n as i32 {
        tokens[i as usize] = buf[(i as usize) * 4 + 3]
        i = i + 1
    }
    return n as i32
}

/// A pipe: `fds[0]` reads, `fds[1]` writes (BSD `pipe` returns both descriptors in registers).
export fn sysPipe(fds: *i32, nonblocking: bool) -> i32 {
    local a: i64 = 0
    local b: i64 = 0
#if arch == "aarch64"
    __builtin_asm("mov x16, #42\nsvc #0x80\nb.cc 1f\nmov x0, #-1\nmov x1, #-1\n1:", out("x0") a, out("x1") b)
#else
    __builtin_asm("mov eax, 0x2000042\nsyscall\njnc 1f\nmov rax, -1\nmov rdx, -1\n1:\nmov {1}, rdx", out("rax") a, out(reg) b,
                  clobber("rcx"), clobber("rdx"), clobber("r11"))
#endif
    if a < 0 { return -1 }
    fds[0] = a as i32
    fds[1] = b as i32
    return 0
}

// ---- files -----------------------------------------------------------------------------------

fn openPath(path: *ui8, flags: i32) -> i32 {
    return syscall(SYS_OPEN, path, flags, 420) as i32
}

/// Opens for reading; negative errno on failure.
export fn sysOpenRead(path: *ui8) -> i32 {
    return openPath(path, O_RDONLY)
}

/// Opens for writing, creating the file; truncates unless `append`.
export fn sysOpenWrite(path: *ui8, append: bool) -> i32 {
    if append { return openPath(path, O_WRONLY_CREAT_APPEND) }
    return openPath(path, O_WRONLY_CREAT_TRUNC)
}

export fn sysClose(fd: i32) -> i32 {
    return syscall(SYS_CLOSE, fd) as i32
}

export fn sysUnlink(path: *ui8) -> i32 {
    return syscall(SYS_UNLINK, path) as i32
}

/// Size of an open file in bytes (the read position is left at the start); negative on failure.
export fn sysFileSize(fd: i32) -> i64 {
    local n: i64 = syscall(SYS_LSEEK, fd, 0, 2)
    syscall(SYS_LSEEK, fd, 0, 0)
    return n
}

// ---- entropy and wall clock --------------------------------------------------------------------

define SYS_GETENTROPY = 500
define SYS_GETTIMEOFDAY = 116

/// Fills `buf[0..n]` with kernel random bytes (getentropy, at most 256 bytes per call).
export fn sysRandom(buf: *ui8, n: usize) -> bool {
    local done: usize = 0
    while done < n {
        local take: usize = n - done
        if take > 256 { take = 256 }
        if syscall(SYS_GETENTROPY, &buf[done], take) < 0 { return false }
        done = done + take
    }
    return true
}

/// Seconds since 1970-01-01 UTC (gettimeofday); negative on failure.
export fn sysClockSeconds() -> i64 {
    local tv: [i64; 2]
    tv[0] = -1
    if syscall(SYS_GETTIMEOFDAY, &tv[0], 0, 0) < 0 { return -1 }
    return tv[0]
}

/// sysctlbyname(3) from libSystem: reads or writes the Apple sysctl `name`. 0 on success, -1 on failure (errno is not kept).
@library("System") declare fn sysctlbyname(name: *ui8, oldp: *void, oldlenp: *usize, newp: *void, newlen: usize) -> i32

export fn sysSysctl(name: *ui8, oldp: *void, oldlen: *usize) -> bool {
    return sysctlbyname(name, oldp, oldlen, nil, 0) == 0
}

/// Maps `size` bytes with a PROT_NONE guard page below them; see the Linux variant. macOS mprotect is BSD number 74.
export fn sysMapGuarded(size: usize) -> *void {
    local base: *void = sysMap(size + 4096)
    if base == nil { return nil }
    if syscall(74, base, 4096, 0) < 0 {
        sysUnmap(base, size + 4096)
        return nil
    }
    return ((base as usize) + 4096) as *void
}

export fn sysUnmapGuarded(p: *void, size: usize) {
    sysUnmap(((p as usize) - 4096) as *void, size + 4096)
}
