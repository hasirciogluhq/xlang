// std/collections/result: `Result<T, E>`, a value that is either an `Ok` with the success type `T`
// or an `Err` with the error type `E`.
//
// It is an ordinary generic payload enum: a switch over both variants is exhaustive, and the live
// payload is dropped exactly once, so `Result<String, Error>` owns its string while it is an `Ok`
// and owns its error value while it is an `Err`. A variant is built as `Result.Ok(v)` or
// `Result.Err(e)` and needs a known target type where it is created, because the enum is generic
// (`local r: Result<i32, Error> = Result.Ok(1)`; without that type the build is `E0756`).
//
// The `?` operator is not part of the language yet (see `docs/known-limitations.md`); code that
// wants early exit writes the switch out today:
//
//     local r: Result<i32, Error> = step()
//     switch r {
//         case Result.Err(e) { return Result.Err(e) }
//         case Result.Ok(v) { /* continue with v */ }
//     }
//
// The helpers below read a `Result` without a `switch`: `resultOrElse` returns the value or a
// fallback, `resultIsOk` tests the variant, and `resultTake`/`resultTakeErr` move the success or
// the error value out through an out pointer and report which variant was live.

export enum Result<T, E> {
    Ok(T)
    Err(E)
}

/// The value of an `Ok`, or `fallback` for an `Err`.
export fn resultOrElse<T, E>(r: Result<T, E>, fallback: T) -> T {
    switch r {
        case Result.Ok(v) { return v }
        case Result.Err(e) { return fallback }
    }
}

/// Whether `r` is an `Ok`.
export fn resultIsOk<T, E>(r: Result<T, E>) -> bool {
    switch r {
        case Result.Ok(v) { return true }
        case Result.Err(e) { return false }
    }
}

/// The success value written through `out`, or `false` when `r` is an `Err`.
export fn resultTake<T, E>(r: *Result<T, E>, out: *T) -> bool {
    switch *r {
        case Result.Ok(v) {
            *out = v
            return true
        }
        case Result.Err(e) { return false }
    }
}

/// The error value written through `out`, or `false` when `r` is an `Ok`.
export fn resultTakeErr<T, E>(r: *Result<T, E>, out: *E) -> bool {
    switch *r {
        case Result.Ok(v) { return false }
        case Result.Err(e) {
            *out = e
            return true
        }
    }
}
