// std/cpu/features: which instruction-set extensions the processor offers and the OS enables.
//
// x86-64: CPUID (Intel SDM Vol. 2, CPUID; bit positions from the Intel CPUID reference, https://www.felixcloutier.com/x86/cpuid):
//   leaf 0: EAX max leaf; EBX, EDX, ECX spell the vendor string ("GenuineIntel", "AuthenticAMD", ...).
//   leaf 1 ECX: SSE3 bit 0, SSSE3 bit 9, FMA bit 12, SSE4.1 bit 19, SSE4.2 bit 20, POPCNT bit 23, AESNI bit 25,
//               OSXSAVE bit 27, AVX bit 28, F16C bit 29. leaf 1 EDX: SSE bit 25, SSE2 bit 26.
//   leaf 7 sub-leaf 0 EBX: BMI1 bit 3, AVX2 bit 5, BMI2 bit 8, AVX512F bit 16, AVX512DQ bit 17, SHA bit 29,
//               AVX512CD bit 28, AVX512BW bit 30, AVX512VL bit 31.
//   leaf 0x80000001 ECX: LZCNT bit 5 (AMD APM Vol. 3 lists the same bit as ABM; the Intel page lists LZCNT).
// A CPUID bit says the processor has the feature. AVX and AVX-512 also need the OS to save their register state: XCR0 read
// with XGETBV (Intel SDM Vol. 1, the XSAVE state components) must have bits 1 and 2 (AVX) and bits 5 to 7 (AVX-512) set. Without
// them the feature bits are reported as false here, even when CPUID shows them.
//
// arm64 Linux: the kernel reports features in AT_HWCAP (auxiliary vector entry 16, /proc/self/auxv) with the bit numbers of
// arch/arm64/include/uapi/asm/hwcap.h (HWCAP_ASIMD 1, AES 3, PMULL 4, SHA1 5, SHA2 6, CRC32 7, ATOMICS 8, SHA3 17, ASIMDDP 20,
// SHA512 21). The AT_HWCAP number is AT_HWCAP = 16 in include/uapi/linux/auxvec.h.
// arm64 macOS: sysctlbyname("hw.optional.*") with the Apple names (hw.optional.neon, hw.optional.arm.FEAT_AES, ...).
// Windows: not implemented yet (IsProcessorFeaturePresent is the planned source); every flag is false there.
//
// Not constant-time and not cached: each call runs CPUID again.

/// The features of the running processor. Flags the platform cannot report are false.
export struct CpuFeatures {
    vendor: [ui8; 13]       // x86-64: the CPUID vendor string, NUL terminated; empty elsewhere
    maxLeaf: ui32           // x86-64: the highest standard CPUID leaf
    sse2: bool
    sse3: bool
    ssse3: bool
    sse41: bool
    sse42: bool
    popcnt: bool
    aesni: bool
    avx: bool               // CPUID bit and the OS saves YMM state
    avx2: bool
    fma: bool
    f16c: bool
    bmi1: bool
    bmi2: bool
    lzcnt: bool
    sha: bool               // x86 SHA extensions
    avx512f: bool           // CPUID bit and the OS saves ZMM state
    avx512cd: bool
    avx512dq: bool
    avx512bw: bool
    avx512vl: bool
    neon: bool              // arm64: Advanced SIMD
    aes: bool
    pmull: bool
    sha1: bool
    sha2: bool
    sha3: bool
    sha512: bool
    crc32: bool
    atomics: bool           // arm64: LSE atomic instructions
    dotprod: bool
}

/// The bit `n` of `v` as a flag.
fn bitIs(v: ui32, n: ui32) -> bool {
    return ((v >> n) & 1) == 1
}

#if arch == "x86_64"

/// CPUID with leaf `leaf` and sub-leaf `sub`; writes EAX, EBX, ECX, EDX to out[0..4). RBX is saved in a scratch register because
/// LLVM reserves it for x86-64 code.
fn cpuidRaw(leaf: ui32, sub: ui32, out: *ui32) {
    local a: ui32 = 0
    local b: ui64 = 0
    local c: ui32 = 0
    local d: ui32 = 0
    local saved: ui64 = 0
    __builtin_asm("mov {6}, rbx\ncpuid\nmov {5}, rbx\nmov rbx, {6}", in("eax") leaf, in("ecx") sub, out("eax") a, out("ecx") c, out("edx") d, out(reg) b, out(reg) saved)
    out[0] = a
    out[1] = b as ui32
    out[2] = c
    out[3] = d
}

/// The low 32 bits of XCR0 (XGETBV with ECX = 0).
fn xcr0Low() -> ui32 {
    local lo: ui32 = 0
    local hi: ui32 = 0
    __builtin_asm("xgetbv", in("ecx") 0, out("eax") lo, out("edx") hi)
    return lo
}

fn detectPlatform(f: *CpuFeatures) {
    local r: [ui32; 4]
    cpuidRaw(0, 0, &r[0])
    f.maxLeaf = r[0]
    // the vendor string is EBX, EDX, ECX in that order
    local i: usize = 0
    while i < 4 {
        f.vendor[i] = ((r[1] >> ((i * 8) as ui32)) & 0xff) as ui8
        f.vendor[4 + i] = ((r[3] >> ((i * 8) as ui32)) & 0xff) as ui8
        f.vendor[8 + i] = ((r[2] >> ((i * 8) as ui32)) & 0xff) as ui8
        i = i + 1
    }
    f.vendor[12] = 0
    cpuidRaw(1, 0, &r[0])
    f.sse3 = bitIs(r[2], 0)
    f.ssse3 = bitIs(r[2], 9)
    f.fma = bitIs(r[2], 12)
    f.sse41 = bitIs(r[2], 19)
    f.sse42 = bitIs(r[2], 20)
    f.popcnt = bitIs(r[2], 23)
    f.aesni = bitIs(r[2], 25)
    f.f16c = bitIs(r[2], 29)
    f.sse2 = bitIs(r[3], 26)
    local osxsave: bool = bitIs(r[2], 27)
    local avxCpu: bool = bitIs(r[2], 28)
    local osAvx: bool = false
    local osAvx512: bool = false
    if osxsave {
        local xcr0: ui32 = xcr0Low()
        osAvx = (xcr0 & 6) == 6
        osAvx512 = osAvx && (xcr0 & 0xe0) == 0xe0
    }
    f.avx = avxCpu && osAvx
    if f.maxLeaf >= 7 {
        cpuidRaw(7, 0, &r[0])
        f.bmi1 = bitIs(r[1], 3)
        f.avx2 = bitIs(r[1], 5) && osAvx
        f.bmi2 = bitIs(r[1], 8)
        f.avx512f = bitIs(r[1], 16) && osAvx512
        f.avx512dq = bitIs(r[1], 17) && osAvx512
        f.sha = bitIs(r[1], 29)
        f.avx512cd = bitIs(r[1], 28) && osAvx512
        f.avx512bw = bitIs(r[1], 30) && osAvx512
        f.avx512vl = bitIs(r[1], 31) && osAvx512
    }
    cpuidRaw(0x80000000, 0, &r[0])
    if r[0] >= 0x80000001 {
        cpuidRaw(0x80000001, 0, &r[0])
        f.lzcnt = bitIs(r[2], 5)
    }
}

#elif os == "linux" && arch == "aarch64"
from "../sys" import sysOpenRead, sysRead, sysClose


/// The AT_HWCAP word from /proc/self/auxv (pairs of 64-bit type and value, little-endian, 16 bytes each).
fn hwcapWord() -> ui64 {
    local fd: i32 = sysOpenRead("/proc/self/auxv")
    if fd < 0 { return 0 }
    local buf: [ui8; 4096]
    local n: usize = 0
    while n < 4096 {
        local got: isize = sysRead(fd, &buf[n], 4096 - n)
        if got <= 0 { break }
        n = n + (got as usize)
    }
    sysClose(fd)
    local at: usize = 0
    while at + 16 <= n {
        local key: ui64 = 0
        local val: ui64 = 0
        local k: usize = 0
        while k < 8 {
            key = key | ((buf[at + k] as ui64) << ((k * 8) as ui64))
            val = val | ((buf[at + 8 + k] as ui64) << ((k * 8) as ui64))
            k = k + 1
        }
        if key == 16 { return val }
        if key == 0 { break }
        at = at + 16
    }
    return 0
}

fn detectPlatform(f: *CpuFeatures) {
    local w: ui64 = hwcapWord()
    f.neon = ((w >> 1) & 1) == 1
    f.aes = ((w >> 3) & 1) == 1
    f.pmull = ((w >> 4) & 1) == 1
    f.sha1 = ((w >> 5) & 1) == 1
    f.sha2 = ((w >> 6) & 1) == 1
    f.crc32 = ((w >> 7) & 1) == 1
    f.atomics = ((w >> 8) & 1) == 1
    f.sha3 = ((w >> 17) & 1) == 1
    f.dotprod = ((w >> 20) & 1) == 1
    f.sha512 = ((w >> 21) & 1) == 1
}

#elif os == "macos" && arch == "aarch64"

@library("System") declare fn sysctlbyname(name: *ui8, oldp: *void, oldlenp: *usize, newp: *void, newlen: usize) -> i32

/// 1 when the Apple sysctl `name` reports the feature, 0 otherwise (also when the name does not exist on this macOS).
fn sysctlFlag(name: *ui8) -> bool {
    local v: i32 = 0
    local len: usize = 4
    if sysctlbyname(name, &v as *void, &len, nil, 0) != 0 { return false }
    return v != 0
}

fn detectPlatform(f: *CpuFeatures) {
    f.neon = sysctlFlag("hw.optional.neon")
    f.aes = sysctlFlag("hw.optional.arm.FEAT_AES")
    f.pmull = sysctlFlag("hw.optional.arm.FEAT_PMULL")
    f.sha1 = sysctlFlag("hw.optional.arm.FEAT_SHA1")
    f.sha2 = sysctlFlag("hw.optional.arm.FEAT_SHA256")
    f.sha3 = sysctlFlag("hw.optional.arm.FEAT_SHA3")
    f.sha512 = sysctlFlag("hw.optional.arm.FEAT_SHA512")
    f.crc32 = sysctlFlag("hw.optional.arm.FEAT_CRC32")
    f.atomics = sysctlFlag("hw.optional.arm.FEAT_LSE")
    f.dotprod = sysctlFlag("hw.optional.arm.FEAT_DotProd")
}

#else

fn detectPlatform(f: *CpuFeatures) {
}

#endif

/// The features of the processor this program runs on (see the notes at the top of this file).
export fn cpuFeatures() -> CpuFeatures {
    local f: CpuFeatures
    detectPlatform(&f)
    return f
}
