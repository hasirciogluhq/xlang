// std/hw: hardware facts that the operating system publishes as text or as sysctl values. No device is opened.
//   Linux: /proc/cpuinfo ("model name", or "Hardware" on some arm64 kernels), /proc/meminfo ("MemTotal"), and the DMI
//          product name in /sys/class/dmi/id/product_name (the dmi driver's sysfs file; the kernel documents its fields in
//          Documentation/ABI/testing/sysfs-firmware-dmi).
//   macOS: sysctlbyname("machdep.cpu.brand_string"), "hw.memsize" (bytes, int64) and "hw.model" (the Mac model identifier).
//   Windows: the PROCESSOR_IDENTIFIER environment variable (GetEnvironmentVariableW) and GlobalMemoryStatusEx. There is no
//          documented, registry-free source for the machine model on Windows, so hwProductName returns 0 there.
// Every value is read at call time. The text is copied into the caller's buffer, NUL terminated, and the length is returned.

#if os == "linux"

from "../sys/linux" import sysOpenRead, sysRead, sysClose

/// Reads the whole file at `path` into `buf` (capacity `cap`); returns the byte count (0 when the file cannot be read).
fn readFile(path: *ui8, buf: *ui8, cap: usize) -> usize {
    local fd: i32 = sysOpenRead(path)
    if fd < 0 { return 0 }
    local n: usize = 0
    while n + 1 < cap {
        local got: isize = sysRead(fd, &buf[n], cap - 1 - n)
        if got <= 0 { break }
        n = n + (got as usize)
    }
    sysClose(fd)
    buf[n] = 0
    return n
}

/// The value of the first `key<TAB or space>...: value` line of `text[0..n)`, trimmed, copied into `out`; its length, or 0.
fn lineValue(text: *ui8, n: usize, key: *ui8, out: *ui8, cap: usize) -> usize {
    local klen: usize = 0
    while key[klen] != 0 { klen = klen + 1 }
    local at: usize = 0
    while at < n {
        local eol: usize = at
        while eol < n && text[eol] != 10 { eol = eol + 1 }
        local match: bool = eol - at >= klen
        local i: usize = 0
        while match && i < klen {
            if text[at + i] != key[i] { match = false }
            i = i + 1
        }
        if match {
            // a key that ends with ":" (MemTotal:) already has its colon; otherwise the value follows the first colon
            local colon: usize = at + klen
            if key[klen - 1] != 58 {
                while colon < eol && text[colon] != 58 { colon = colon + 1 }
            }
            if colon < eol {
                local s: usize = colon + 1
                if key[klen - 1] == 58 { s = at + klen }
                while s < eol && (text[s] == 32 || text[s] == 9) { s = s + 1 }
                local e: usize = eol
                while e > s && (text[e - 1] == 32 || text[e - 1] == 9 || text[e - 1] == 13) { e = e - 1 }
                local len: usize = 0
                while s + len < e && len + 1 < cap {
                    out[len] = text[s + len]
                    len = len + 1
                }
                out[len] = 0
                return len
            }
        }
        at = eol + 1
    }
    return 0
}

/// Copies `src[0..n)` into `out` without trailing newlines, NUL terminated; returns the length.
fn trimmedCopy(src: *ui8, n: usize, out: *ui8, cap: usize) -> usize {
    local e: usize = n
    while e > 0 && (src[e - 1] == 10 || src[e - 1] == 13 || src[e - 1] == 32) { e = e - 1 }
    local len: usize = 0
    while len < e && len + 1 < cap {
        out[len] = src[len]
        len = len + 1
    }
    out[len] = 0
    return len
}

/// The CPU model name into `out`; its length, or 0 when the kernel does not report one.
export fn hwCpuModel(out: *ui8, cap: usize) -> usize {
    local text: [ui8; 16384]
    local n: usize = readFile("/proc/cpuinfo", &text[0], 16384)
    local len: usize = lineValue(&text[0], n, "model name", out, cap)
    if len > 0 { return len }
    return lineValue(&text[0], n, "Hardware", out, cap)
}

/// The installed memory in bytes (MemTotal of /proc/meminfo, given in kibibytes), or -1.
export fn hwMemoryBytes() -> i64 {
    local text: [ui8; 4096]
    local n: usize = readFile("/proc/meminfo", &text[0], 4096)
    local digits: [ui8; 32]
    if lineValue(&text[0], n, "MemTotal:", &digits[0], 32) == 0 { return -1 }
    local kb: i64 = 0
    local i: usize = 0
    while digits[i] >= 48 && digits[i] <= 57 {
        kb = kb * 10 + ((digits[i] - 48) as i64)
        i = i + 1
    }
    return kb * 1024
}

/// The product name from DMI (for example "ThinkPad X1 Carbon"), or 0 when /sys/class/dmi is not readable.
export fn hwProductName(out: *ui8, cap: usize) -> usize {
    local buf: [ui8; 256]
    local n: usize = readFile("/sys/class/dmi/id/product_name", &buf[0], 256)
    if n == 0 { return 0 }
    return trimmedCopy(&buf[0], n, out, cap)
}

#elif os == "macos"

from "../sys/macos" import sysSysctl

/// A string sysctl into `out`; its length (without the NUL), or 0.
fn stringSysctl(name: *ui8, out: *ui8, cap: usize) -> usize {
    local len: usize = cap
    if !sysSysctl(name, out as *void, &len) || len == 0 { return 0 }
    local n: usize = len
    if n > 0 && out[n - 1] == 0 { n = n - 1 }
    return n
}

/// The CPU brand string (for example "Apple M3") into `out`; its length, or 0.
export fn hwCpuModel(out: *ui8, cap: usize) -> usize {
    return stringSysctl("machdep.cpu.brand_string", out, cap)
}

/// The installed memory in bytes (hw.memsize), or -1.
export fn hwMemoryBytes() -> i64 {
    local v: i64 = 0
    local len: usize = 8
    if !sysSysctl("hw.memsize", &v as *void, &len) { return -1 }
    return v
}

/// The Mac model identifier (for example "Mac15,3") into `out`; its length, or 0.
export fn hwProductName(out: *ui8, cap: usize) -> usize {
    return stringSysctl("hw.model", out, cap)
}

#elif os == "windows"

from "../sys/windows" import sysMemoryTotal, sysGetEnvW

/// The CPU description from the PROCESSOR_IDENTIFIER environment variable (for example
/// "Intel64 Family 6 Model 154 Stepping 3, GenuineIntel") into `out`; its length, or 0. GetSystemInfo reports only
/// dwProcessorType (a legacy architecture class, not a name), so the variable is the documented WS2008+ source:
/// https://learn.microsoft.com/en-us/windows/win32/procthread/processor-identification. It does not carry the marketing
/// name ("Core i7-12700"), which lives only in the registry value
/// HARDWARE\DESCRIPTION\System\CentralProcessor\0 : ProcessorNameString.
export fn hwCpuModel(out: *ui8, cap: usize) -> usize {
    local wname: [ui16; 21]             // "PROCESSOR_IDENTIFIER" is 20 units plus the NUL
    local key: *ui8 = "PROCESSOR_IDENTIFIER"
    local k: usize = 0
    while key[k] != 0 {
        wname[k] = key[k] as ui16
        k = k + 1
    }
    wname[k] = 0
    local wbuf: [ui16; 256]
    local need: ui32 = sysGetEnvW(&wname[0], &wbuf[0], 256)
    if need == 0 || need >= 256 { return 0 }
    // The value is ASCII in practice; each UTF-16 unit is narrowed to its low byte as in std/sys/env, and a unit above 0x7F
    // becomes '?' so the buffer stays valid UTF-8 without a second conversion helper.
    local len: usize = 0
    local i: usize = 0
    while i < (need as usize) && len + 1 < cap {
        local u: ui16 = wbuf[i]
        local b: ui8 = 63
        if u < 0x80 { b = u as ui8 }
        out[len] = b
        len = len + 1
        i = i + 1
    }
    out[len] = 0
    return len
}

/// The installed physical memory in bytes (GlobalMemoryStatusEx), or -1.
export fn hwMemoryBytes() -> i64 {
    return sysMemoryTotal()
}

/// There is no registry-free Windows source for the machine model (DMI/SMBIOS is not exposed by kernel32), so this
/// reports nothing; see docs/known-limitations.md. A caller that needs it reads the registry values
/// HARDWARE\DESCRIPTION\System\BIOS : SystemManufacturer / SystemProductName through RegGetValueW.
export fn hwProductName(out: *ui8, cap: usize) -> usize {
    out[0] = 0
    return 0
}

#else

export fn hwCpuModel(out: *ui8, cap: usize) -> usize {
    return 0
}

export fn hwMemoryBytes() -> i64 {
    return -1
}

export fn hwProductName(out: *ui8, cap: usize) -> usize {
    return 0
}

#endif

#if os == "linux"

/// The data cache line size in bytes (the coherency line size of cpu0's first cache, sysfs), or 64 when the file is absent.
export fn hwCacheLineSize() -> usize {
    local buf: [ui8; 32]
    local n: usize = readFile("/sys/devices/system/cpu/cpu0/cache/index0/coherency_line_size", &buf[0], 32)
    local v: usize = 0
    local i: usize = 0
    while i < n && buf[i] >= 48 && buf[i] <= 57 {
        v = v * 10 + ((buf[i] - 48) as usize)
        i = i + 1
    }
    if v == 0 { return 64 }
    return v
}

#elif os == "macos"


/// The data cache line size in bytes (hw.cachelinesize, an int), or 64.
export fn hwCacheLineSize() -> usize {
    local v: i32 = 0
    local len: usize = 4
    if !sysSysctl("hw.cachelinesize", &v as *void, &len) || v <= 0 { return 64 }
    return v as usize
}

#else

export fn hwCacheLineSize() -> usize {
    return 64
}

#endif
