// std/tls/names: the names of TLS protocol versions (RFC 8446 section 4.2.1 for 1.3; RFC 5246 appendix A.5 and RFC 6101
// for the legacy values) and of cipher suites (IANA "TLS Cipher Suites" registry, https://www.iana.org/assignments/tls-parameters/).
// Values are the two-byte codes on the wire. Unknown codes give "unknown" (the registry has more entries than this table).

/// The name of a protocol version: 0x0300 SSL 3.0 (RFC 6101), 0x0301 TLS 1.0, 0x0302 TLS 1.1 (RFC 4346), 0x0303 TLS 1.2
/// (RFC 5246), 0x0304 TLS 1.3 (RFC 8446).
export fn tlsVersionName(version: ui16) -> str {
    if version == 0x0300 { return "SSL 3.0" }
    if version == 0x0301 { return "TLS 1.0" }
    if version == 0x0302 { return "TLS 1.1" }
    if version == 0x0303 { return "TLS 1.2" }
    if version == 0x0304 { return "TLS 1.3" }
    return "unknown"
}

/// The IANA name of a cipher suite code. TLS 1.3 suites (RFC 8446 appendix B.4) and the ECDHE and RSA suites of the
/// AES-GCM and ChaCha20-Poly1305 families (RFC 5246 appendix A.5, RFC 5289, RFC 7905) are listed.
export fn tlsCipherSuiteName(suite: ui16) -> str {
    if suite == 0x1301 { return "TLS_AES_128_GCM_SHA256" }
    if suite == 0x1302 { return "TLS_AES_256_GCM_SHA384" }
    if suite == 0x1303 { return "TLS_CHACHA20_POLY1305_SHA256" }
    if suite == 0x1304 { return "TLS_AES_128_CCM_SHA256" }
    if suite == 0x1305 { return "TLS_AES_128_CCM_8_SHA256" }
    if suite == 0x009c { return "TLS_RSA_WITH_AES_128_GCM_SHA256" }
    if suite == 0x009d { return "TLS_RSA_WITH_AES_256_GCM_SHA384" }
    if suite == 0xc02b { return "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256" }
    if suite == 0xc02c { return "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384" }
    if suite == 0xc02f { return "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256" }
    if suite == 0xc030 { return "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384" }
    if suite == 0xcca8 { return "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256" }
    if suite == 0xcca9 { return "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256" }
    return "unknown"
}
