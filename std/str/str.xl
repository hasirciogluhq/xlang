// std/str: helpers for the built-in `str` view (`{ ptr, len }`). A `str` is read-only and never
// owns its bytes; `fromParts` builds one from a pointer and a length. Positions are byte offsets.
// Functions here take `str` and return booleans, integers or views only where the view is the honest type
// (`view`, the byte-level primitive). Functions that return text as a value return `String` (see string.xl).
from "../mem/memory" import strlen

/// Same two words as `str` (`@repr(c)` keeps `ptr` at offset 0 and `len` at offset 8).
@repr(c) struct StrParts {
    ptr: *ui8
    len: usize
}

/// A view of `n` bytes at `p`. The bytes are not copied; the caller keeps them alive.
export fn fromParts(p: *ui8, n: usize) -> str {
    local parts: StrParts = StrParts { ptr: p, len: n }
    local view: *str = &parts as *str
    return *view
}

/// A view of the NUL-terminated C string `p` (the NUL is not part of the view).
export fn fromC(p: *ui8) -> str {
    return fromParts(p, strlen(p))
}

/// A view of `n` bytes of `s` starting at `first`, without copying. Panics when the range is outside `s`.
/// The view is only valid while the bytes of `s` live; use `slice` (string.xl) for an owned copy.
export fn view(s: str, first: usize, n: usize) -> str {
    if first > s.len || n > s.len - first {
        panic("view: range is outside the string")
    }
    return fromParts(&s.ptr[first], n)
}

/// Byte-wise equality: same length and same bytes.
export fn eq(a: str, b: str) -> bool {
    if a.len != b.len { return false }
    local i: usize = 0
    while i < a.len {
        if a[i] != b[i] { return false }
        i = i + 1
    }
    return true
}

/// Byte offset of the first occurrence of `needle` in `s`, or -1 when there is none.
/// An empty `needle` is found at 0.
export fn find(s: str, needle: str) -> i64 {
    if needle.len > s.len { return -1 }
    local i: usize = 0
    while i + needle.len <= s.len {
        if eq(view(s, i, needle.len), needle) { return i as i64 }
        i = i + 1
    }
    return -1
}

export fn contains(s: str, needle: str) -> bool {
    return find(s, needle) >= 0
}

export fn startsWith(s: str, prefix: str) -> bool {
    if prefix.len > s.len { return false }
    return eq(view(s, 0, prefix.len), prefix)
}

export fn endsWith(s: str, suffix: str) -> bool {
    if suffix.len > s.len { return false }
    return eq(view(s, s.len - suffix.len, suffix.len), suffix)
}

/// Parses decimal digits only (no sign, no spaces). Returns false, and leaves `out` alone, when `s`
/// is empty, has another byte, or does not fit in a ui64.
export fn toU64(s: str, out: *ui64) -> bool {
    if s.len == 0 { return false }
    local v: ui64 = 0
    local i: usize = 0
    while i < s.len {
        local c: ui8 = s[i]
        if c < 48 || c > 57 { return false }
        local d: ui64 = (c - 48) as ui64
        if v > 1844674407370955161 || (v == 1844674407370955161 && d > 5) { return false }
        v = v * 10 + d
        i = i + 1
    }
    *out = v
    return true
}

/// Parses an optional leading '-' and decimal digits. Returns false, and leaves `out` alone, when
/// the value does not fit in an i64.
export fn toI64(s: str, out: *i64) -> bool {
    local negative: bool = s.len > 0 && s[0] == 45
    local digits: str = s
    if negative {
        digits = view(s, 1, s.len - 1)
    }
    local m: ui64 = 0
    if !toU64(digits, &m) { return false }
    if !negative {
        if m > 9223372036854775807 { return false }
        *out = m as i64
        return true
    }
    if m > 9223372036854775808 { return false }
    if m == 0 {
        *out = 0
    } else {
        *out = 0 - ((m - 1) as i64) - 1
    }
    return true
}
