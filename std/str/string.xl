// std/str/string: an owned, growable byte string on the registered allocator, and the functions that return
// text as a `String`. The bytes are not NUL-free: `ptr[len] == 0` whenever `cap > 0`, so `cstr()` is a C string.
// Embedded NUL bytes are kept. No small-string optimization: a non-empty String always allocates.
from "../mem/mem" import currentAllocator
from "../mem/memory" import memcpy
from "../collections/vec" import Vec
from "str" import fromParts, view, eq, find, contains, startsWith, endsWith
from "compare" import compare, equalIgnoreCase, globMatch, isSpace

export class String {
    ptr: *ui8     // nil when cap == 0
    len: usize    // bytes of content
    cap: usize    // bytes for content, not counting the NUL slot

    fn init(self) {
        self.ptr = nil
        self.len = 0
        self.cap = 0
    }

    fn init(self, s: str) {
        self.ptr = nil
        self.len = 0
        self.cap = 0
        self.append(s)
    }

    /// `n` copies of the byte `b`.
    fn init(self, n: usize, b: ui8) {
        self.ptr = nil
        self.len = 0
        self.cap = 0
        self.reserve(n)
        local i: usize = 0
        while i < n {
            self.ptr[i] = b
            i = i + 1
        }
        self.len = n
        if self.cap > 0 {
            self.ptr[n] = 0
        }
    }

    fn drop(self) {
        if self.cap > 0 {
            currentAllocator.free(self.ptr as *void)
        }
    }

    fn length(self) -> usize {
        return self.len
    }

    /// A view of the bytes; valid until the String changes or is dropped.
    fn asStr(self) -> str {
        return fromParts(self.ptr, self.len)
    }

    /// NUL-terminated bytes (an empty String gives a pointer to a static NUL).
    fn cstr(self) -> *ui8 {
        if self.cap == 0 {
            return ""
        }
        return self.ptr
    }

    /// The byte at `i`; panics when `i` is outside the content.
    fn at(self, i: usize) -> ui8 {
        if i >= self.len {
            panic("String index out of bounds")
        }
        return self.ptr[i]
    }

    /// Makes room for `n` bytes of content. Growth: max(n, 2 * cap, 15).
    fn reserve(self, n: usize) {
        if n <= self.cap {
            return
        }
        local want: usize = n
        if self.cap * 2 > want {
            want = self.cap * 2
        }
        if want < 15 {
            want = 15
        }
        local fresh: *ui8 = currentAllocator.alloc(want + 1, 1) as *ui8
        if fresh == nil {
            panic("String: out of memory")
        }
        if self.len > 0 {
            memcpy(fresh as *void, self.ptr as *void, self.len)
        }
        fresh[self.len] = 0
        if self.cap > 0 {
            currentAllocator.free(self.ptr as *void)
        }
        self.ptr = fresh
        self.cap = want
    }

    fn push(self, b: ui8) {
        self.reserve(self.len + 1)
        self.ptr[self.len] = b
        self.len = self.len + 1
        self.ptr[self.len] = 0
    }

    /// Appends the bytes of `s`. `s` must not be a view of this String's own buffer.
    fn append(self, s: str) {
        self.reserve(self.len + s.len)
        if s.len > 0 {
            memcpy(&self.ptr[self.len] as *void, s.ptr as *void, s.len)
        }
        self.len = self.len + s.len
        if self.cap > 0 {
            self.ptr[self.len] = 0
        }
    }

    fn append(self, o: *String) {
        self.append(o.asStr())
    }

    fn equals(self, s: str) -> bool {
        return eq(self.asStr(), s)
    }

    fn equals(self, o: *String) -> bool {
        return eq(self.asStr(), o.asStr())
    }

    fn clone(self) -> String {
        local copy: String = String(self.asStr())
        return copy
    }

    fn clear(self) {
        self.len = 0
        if self.cap > 0 {
            self.ptr[0] = 0
        }
    }

    /// A new String with `n` bytes starting at `first`; panics when the range is outside the content.
    fn slice(self, first: usize, n: usize) -> String {
        return slice(self.asStr(), first, n)
    }

    /// A new String with the bytes `[lo, hi)` replaced by `repl`; panics when the range is outside the content.
    fn splice(self, lo: usize, hi: usize, repl: *String) -> String {
        local out: String = slice(self.asStr(), 0, lo)
        out.append(repl)
        out.append(view(self.asStr(), hi, self.len - hi))
        return out
    }

    /// The byte offset of the first `needle` in the content, or -1 when there is none.
    fn find(self, needle: str) -> i64 {
        return find(self.asStr(), needle)
    }

    fn startsWith(self, prefix: str) -> bool {
        return startsWith(self.asStr(), prefix)
    }

    fn endsWith(self, suffix: str) -> bool {
        return endsWith(self.asStr(), suffix)
    }

    /// Three-way byte-wise comparison with `s` (-1, 0 or 1; see `compare`).
    fn compare(self, s: str) -> i32 {
        return compare(self.asStr(), s)
    }

    /// Equality with `s` after ASCII case folding (see `equalIgnoreCase`).
    fn equalsIgnoreCase(self, s: str) -> bool {
        return equalIgnoreCase(self.asStr(), s)
    }

    /// True when `needle` occurs in the string.
    fn contains(self, needle: str) -> bool {
        return contains(self.asStr(), needle)
    }

    /// A new String without the leading ASCII whitespace.
    fn trimStart(self) -> String {
        return trimStart(self.asStr())
    }

    /// A new String without the trailing ASCII whitespace.
    fn trimEnd(self) -> String {
        return trimEnd(self.asStr())
    }

    /// A new String with the first occurrence of `needle` replaced by `replacement` (see `replace`).
    fn replace(self, needle: str, replacement: str) -> String {
        return replace(self.asStr(), needle, replacement)
    }

    /// A new String with every non-overlapping occurrence of `needle` replaced by `replacement` (see `replaceAll`).
    fn replaceAll(self, needle: str, replacement: str) -> String {
        return replaceAll(self.asStr(), needle, replacement)
    }

    /// A new String holding `n` copies of this string (see `repeat`).
    fn repeat(self, n: usize) -> String {
        return repeat(self.asStr(), n)
    }

    /// True when this string, used as a glob pattern (`*` and `?`), matches all of `text`.
    fn globMatch(self, text: str) -> bool {
        return globMatch(self.asStr(), text)
    }

    /// A new String with the ASCII letters A to Z made lowercase; other bytes are unchanged.
    fn toLowerAscii(self) -> String {
        local out: String = String()
        local i: usize = 0
        while i < self.len {
            local c: ui8 = self.ptr[i]
            if c >= 65 && c <= 90 {
                c = c + 32
            }
            out.push(c)
            i = i + 1
        }
        return out
    }

    /// A new String with the ASCII letters a to z made uppercase; other bytes are unchanged.
    fn toUpperAscii(self) -> String {
        local out: String = String()
        local i: usize = 0
        while i < self.len {
            local c: ui8 = self.ptr[i]
            if c >= 97 && c <= 122 {
                c = c - 32
            }
            out.push(c)
            i = i + 1
        }
        return out
    }
}

/// A new String with `n` bytes of `s` starting at `first`. Panics when the range is outside `s`.
export fn slice(s: str, first: usize, n: usize) -> String {
    local out: String = String()
    out.append(view(s, first, n))
    return out
}

/// `s` without its leading and trailing ASCII whitespace.
export fn trim(s: str) -> String {
    local first: usize = 0
    local last: usize = s.len
    while first < last && isSpace(s[first]) {
        first = first + 1
    }
    while last > first && isSpace(s[last - 1]) {
        last = last - 1
    }
    return slice(s, first, last - first)
}

/// `s` without its leading ASCII whitespace.
export fn trimStart(s: str) -> String {
    local first: usize = 0
    while first < s.len && isSpace(s[first]) {
        first = first + 1
    }
    return slice(s, first, s.len - first)
}

/// `s` without its trailing ASCII whitespace.
export fn trimEnd(s: str) -> String {
    local last: usize = s.len
    while last > 0 && isSpace(s[last - 1]) {
        last = last - 1
    }
    return slice(s, 0, last)
}

/// The pieces of `s` between occurrences of `sep`, each a new String; empty pieces are kept, so "a,,b" gives
/// 3 pieces. Panics when `sep` is empty.
export fn split(s: str, sep: str) -> Vec<String> {
    if sep.len == 0 {
        panic("split: empty separator")
    }
    local parts: Vec<String> = Vec<String>()
    local start: usize = 0
    local i: usize = 0
    while i + sep.len <= s.len {
        if eq(view(s, i, sep.len), sep) {
            parts.push(slice(s, start, i - start))
            i = i + sep.len
            start = i
        } else {
            i = i + 1
        }
    }
    parts.push(slice(s, start, s.len - start))
    return parts
}

/// The pieces of `s` between runs of ASCII whitespace, each a new String. A run of whitespace of any length is one
/// separator, so no empty piece is produced by it, and leading and trailing whitespace produce none: `"  a b  "`
/// gives `[a, b]`. Whitespace is the ASCII set of `isSpace` (space, tab, newline, vertical tab, form feed, carriage
/// return); every other byte, including the bytes of a multi-byte UTF-8 character, is part of a piece. An input made
/// only of whitespace gives an empty Vec.
export fn splitAsciiWhitespace(s: str) -> Vec<String> {
    local parts: Vec<String> = Vec<String>()
    local i: usize = 0
    while i < s.len {
        if isSpace(s[i]) {
            i = i + 1
        } else {
            local start: usize = i
            while i < s.len && !isSpace(s[i]) { i = i + 1 }
            parts.push(slice(s, start, i - start))
        }
    }
    return parts
}

/// Copies at most `cap` bytes of `s` to `dst` and returns how many were written. When `s` is longer, the copy stops
/// before the code point that would be split, so the bytes written are always valid UTF-8 and never a half character;
/// `dst` is then a shorter string, not a broken one. Used where a buffer has a fixed size (an OS API field, a
/// fixed-width table) and the leftover is expected to be dropped rather than reported. No terminator is written: the
/// return value is the length, and the caller adds one when its protocol needs it.
export fn copyTruncated(s: str, dst: *ui8, cap: usize) -> usize {
    if s.len <= cap {
        if s.len > 0 { memcpy(dst as *void, s.ptr as *void, s.len) }
        return s.len
    }
    // The longest prefix that fits without splitting a code point: if the byte at the cut is a continuation byte
    // (10xxxxxx), back up over the run, at most three of them, so the cut lands on a sequence boundary.
    local cut: usize = cap
    local back: usize = 0
    if (s[cut] & 0xc0) == 0x80 {
        while cut > 0 && back < 3 && (s[cut] & 0xc0) == 0x80 {
            cut = cut - 1
            back = back + 1
        }
    }
    if cut > 0 {
        memcpy(dst as *void, s.ptr as *void, cut)
    }
    return cut
}

/// `s` with the first occurrence of `needle` replaced by `replacement`; `s` is copied unchanged when `needle`
/// does not occur. Panics when `needle` is empty.
export fn replace(s: str, needle: str, replacement: str) -> String {
    if needle.len == 0 {
        panic("replace: the pattern is empty")
    }
    local out: String = String()
    local at: i64 = find(s, needle)
    if at < 0 {
        out.append(s)
        return out
    }
    local k: usize = at as usize
    out.append(view(s, 0, k))
    out.append(replacement)
    out.append(view(s, k + needle.len, s.len - k - needle.len))
    return out
}

/// `s` with every non-overlapping occurrence of `needle` replaced by `replacement`, scanned left to right. The
/// replacement is not rescanned. Panics when `needle` is empty: an empty pattern would match at every position.
export fn replaceAll(s: str, needle: str, replacement: str) -> String {
    if needle.len == 0 {
        panic("replaceAll: the pattern is empty")
    }
    local out: String = String()
    local i: usize = 0
    while i < s.len {
        if i + needle.len <= s.len && eq(view(s, i, needle.len), needle) {
            out.append(replacement)
            i = i + needle.len
        } else {
            out.push(s[i])
            i = i + 1
        }
    }
    return out
}

/// `n` copies of `s` in one new String. Panics when the total length would overflow `usize`.
export fn repeat(s: str, n: usize) -> String {
    local out: String = String()
    if s.len != 0 && n > 18446744073709551615 / s.len {
        panic("repeat: the result would overflow")
    }
    local i: usize = 0
    while i < n {
        out.append(s)
        i = i + 1
    }
    return out
}
