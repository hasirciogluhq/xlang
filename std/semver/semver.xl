// std/semver: Semantic Versioning 2.0.0 (https://semver.org/spec/v2.0.0.html). A version is MAJOR.MINOR.PATCH with optional
// pre-release identifiers after '-' and build metadata after '+'. Numeric fields have no leading zeros (rule 2). Pre-release
// identifiers are dot-separated, each made of [0-9A-Za-z-] and non-empty (rule 9). Build metadata is ignored for precedence
// (rule 10). Precedence (rule 11): numbers compare numerically; a pre-release version is lower than the normal version; a
// numeric pre-release identifier is lower than an alphanumeric one; a shorter identifier list is lower when all shared
// identifiers are equal. Numeric identifiers compare by value, so values wider than 64 bits are rejected here.
// The pre-release text is a view into the parsed input; keep that input alive while the Semver is used.

from "../str/str" import fromParts

export struct Semver {
    major: ui64
    minor: ui64
    patch: ui64
    pre: str
    valid: bool
}

/// Parses one decimal number from `text` (no sign, no leading zero unless it is "0", fits in 64 bits); returns false on error.
fn parseNumber(text: str, out: *ui64) -> bool {
    if text.len == 0 { return false }
    if text.len > 1 && text[0] == 48 { return false }
    local v: ui64 = 0
    local i: usize = 0
    while i < text.len {
        local c: ui8 = text[i]
        if c < 48 || c > 57 { return false }
        local d: ui64 = (c - 48) as ui64
        if v > (0xffffffffffffffff - d) / 10 { return false }
        v = v * 10 + d
        i = i + 1
    }
    *out = v
    return true
}

/// True when `c` is a character of an identifier: [0-9A-Za-z-].
fn isIdentChar(c: ui8) -> bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45
}

/// Checks dot-separated identifiers (rule 9 for pre-release, rule 10 for build metadata). Numeric identifiers with a leading
/// zero are refused only when `noLeadingZero` is set: build metadata may contain them.
fn validIdentifiers(text: str, noLeadingZero: bool) -> bool {
    local start: usize = 0
    local i: usize = 0
    while i <= text.len {
        if i == text.len || text[i] == 46 {
            local idLen: usize = i - start
            if idLen == 0 { return false }
            local j: usize = start
            local allDigits: bool = true
            while j < i {
                if !isIdentChar(text[j]) { return false }
                if text[j] < 48 || text[j] > 57 { allDigits = false }
                j = j + 1
            }
            // a numeric identifier must not have a leading zero (rule 9)
            if noLeadingZero && allDigits && idLen > 1 && text[start] == 48 { return false }
            start = i + 1
        }
        i = i + 1
    }
    return true
}

/// Parses a version string. The result has `valid` set to false when the text is not a SemVer 2.0.0 version.
export fn semverParse(text: str) -> Semver {
    local s: Semver
    s.valid = false
    local end: usize = text.len
    local plus: i64 = -1
    local i: usize = 0
    while i < text.len {
        if text[i] == 43 {
            plus = i as i64
            break
        }
        i = i + 1
    }
    // build metadata: everything after '+', identifiers only, not compared
    if plus >= 0 {
        end = plus as usize
        local b: usize = end + 1
        if b >= text.len { return s }
        if !validIdentifiers(fromParts(&text.ptr[b], text.len - b), false) { return s }
    }
    local dash: i64 = -1
    i = 0
    while i < end {
        if text[i] == 45 {
            dash = i as i64
            break
        }
        i = i + 1
    }
    local core: str = fromParts(text.ptr, end)
    if dash >= 0 {
        core = fromParts(text.ptr, dash as usize)
        local p: usize = (dash as usize) + 1
        if p >= end { return s }
        s.pre = fromParts(&text.ptr[p], end - p)
        if !validIdentifiers(s.pre, true) { return s }
    }
    // MAJOR.MINOR.PATCH: exactly two dots
    local dots: usize = 0
    local first: usize = 0
    local second: usize = 0
    i = 0
    while i < core.len {
        if core[i] == 46 {
            if dots == 0 { first = i }
            if dots == 1 { second = i }
            dots = dots + 1
        }
        i = i + 1
    }
    if dots != 2 { return s }
    if !parseNumber(fromParts(core.ptr, first), &s.major) { return s }
    if !parseNumber(fromParts(&core.ptr[first + 1], second - first - 1), &s.minor) { return s }
    if !parseNumber(fromParts(&core.ptr[second + 1], core.len - second - 1), &s.patch) { return s }
    s.valid = true
    return s
}

/// Compares two identifiers under rule 11.4: numeric by value, numeric before alphanumeric, otherwise by ASCII order.
fn compareIdent(a: str, b: str) -> i32 {
    local an: bool = true
    local bn: bool = true
    local i: usize = 0
    while i < a.len {
        if a[i] < 48 || a[i] > 57 { an = false }
        i = i + 1
    }
    i = 0
    while i < b.len {
        if b[i] < 48 || b[i] > 57 { bn = false }
        i = i + 1
    }
    if an && bn {
        local x: ui64 = 0
        local y: ui64 = 0
        parseNumber(a, &x)
        parseNumber(b, &y)
        if x < y { return -1 }
        if x > y { return 1 }
        return 0
    }
    if an { return -1 }
    if bn { return 1 }
    local n: usize = a.len
    if b.len < n { n = b.len }
    i = 0
    while i < n {
        if a[i] < b[i] { return -1 }
        if a[i] > b[i] { return 1 }
        i = i + 1
    }
    if a.len < b.len { return -1 }
    if a.len > b.len { return 1 }
    return 0
}

/// Compares two pre-release lists identifier by identifier (rule 11.4). An empty list (normal version) is greater.
fn comparePre(a: str, b: str) -> i32 {
    if a.len == 0 && b.len == 0 { return 0 }
    if a.len == 0 { return 1 }
    if b.len == 0 { return -1 }
    local i: usize = 0
    local j: usize = 0
    while true {
        local ea: usize = i
        while ea < a.len && a[ea] != 46 { ea = ea + 1 }
        local eb: usize = j
        while eb < b.len && b[eb] != 46 { eb = eb + 1 }
        local c: i32 = compareIdent(fromParts(&a.ptr[i], ea - i), fromParts(&b.ptr[j], eb - j))
        if c != 0 { return c }
        if ea == a.len && eb == b.len { return 0 }
        if ea == a.len { return -1 }
        if eb == b.len { return 1 }
        i = ea + 1
        j = eb + 1
    }
    return 0
}

/// Compares two parsed versions by precedence: -1, 0 or 1. Build metadata is ignored.
export fn semverCompare(a: Semver, b: Semver) -> i32 {
    if a.major != b.major {
        if a.major < b.major { return -1 }
        return 1
    }
    if a.minor != b.minor {
        if a.minor < b.minor { return -1 }
        return 1
    }
    if a.patch != b.patch {
        if a.patch < b.patch { return -1 }
        return 1
    }
    return comparePre(a.pre, b.pre)
}
