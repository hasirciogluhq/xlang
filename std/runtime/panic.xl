// std/runtime/panic: the registered `panic`. The compiler's failure paths (division by zero, array
// bounds) call `panic`; user code can call it too. A panic first asks the unwinder (std/runtime/unwind)
// for an enclosing `try`: if there is one, the frames in between run their `defer` statements and
// drops and control continues in its `catch`. Without one the panic is fatal: the message goes to
// stderr and the process exits with status 134. A program that registers its own `panic` replaces this.
from "../sys" import sysWriteFile, sysExit
from "../mem/memory" import strlen
from "unwind" import unwindPanic

// The message goes through `sysWriteFile`: a panic writes to stderr only, so it must not pull in the
// socket path (ws2_32 on Windows) that `sysWrite` also contains.
register(panic) fn panic(msg: *ui8) {
    unwindPanic(msg)
    sysWriteFile(2, "panic: ", 7)
    sysWriteFile(2, msg, strlen(msg))
    sysWriteFile(2, "\n", 1)
    sysExit(134)
}
