// std/runtime/unwind: the run-time half of `try` / `catch` and of panic unwinding.
// The compiler gives every function that owns cleanups (`defer`, drops) a landing pad and every `try`
// a snapshot buffer; it knows nothing of this file but the `register(unwind)` role and the two
// builtins `__builtin_unwindPads` / `__builtin_unwindPadCount` (the table of (function, pad) addresses).
//
// A panic runs `unwindPanic`: it looks for the nearest enclosing `try` by walking the frame-pointer
// chain (`[fp]` = caller's fp, `[fp + 8]` = return address). If there is none the panic is fatal and
// nothing runs. If there is one, the walk visits every frame between: a frame with a landing pad gets
// control there (its cleanups run, then the pad calls the `unwind` hook, which continues the walk);
// the frame hosting the `try` gets its registers back and continues in its `catch` block.
// Foreign frames (code not compiled by xlang) cannot be unwound; every stack entry point zeroes the
// frame pointer, which ends the chain.
//
// Snapshot words written by the compiler: 0 = catch address, 1 = sp, 2 = fp, 3.. = callee-saved registers.
// Words 28 (next record) and 30 (message buffer) belong to this file.
from "../sync" import Mutex, mutexLock, mutexUnlock
from "../sys" import sysWrite, sysExit

define WORD_NEXT = 28
define WORD_MESSAGE = 30
define MESSAGE_MAX = 256
define MAX_FRAMES = 1048576

global tryLock: Mutex
global tryHead: usize        // newest active `try` snapshot, 0 = none

fn frameWord(fp: usize, i: usize) -> usize {
    local p: *usize = fp as *usize
    return p[i]
}

fn tryEnter(snap: *usize, msg: *ui8) {
    msg[0] = 0
    snap[WORD_MESSAGE] = msg as usize
    mutexLock(&tryLock)
    snap[WORD_NEXT] = tryHead
    tryHead = snap as usize
    mutexUnlock(&tryLock)
}

fn tryLeave(snap: *usize) {
    mutexLock(&tryLock)
    if tryHead == snap as usize {
        tryHead = snap[WORD_NEXT]
    } else {
        local cur: usize = tryHead
        while cur != 0 {
            local w: *usize = cur as *usize
            if w[WORD_NEXT] == snap as usize {
                w[WORD_NEXT] = snap[WORD_NEXT]
                break
            }
            cur = w[WORD_NEXT]
        }
    }
    mutexUnlock(&tryLock)
}

/// The active `try` hosted by the frame `fp`, or 0.
fn tryOf(fp: usize) -> usize {
    mutexLock(&tryLock)
    local cur: usize = tryHead
    while cur != 0 {
        local w: *usize = cur as *usize
        if w[2] == fp {
            break
        }
        cur = w[WORD_NEXT]
    }
    mutexUnlock(&tryLock)
    return cur
}

/// The nearest `try` above the frame `fp` (hosted by one of its callers), or 0.
fn nearestTry(fp: usize) -> usize {
    local cur: usize = fp
    local steps: usize = 0
    while steps < MAX_FRAMES {
        local up: usize = frameWord(cur, 0)
        if up <= cur {
            return 0
        }
        local t: usize = tryOf(up)
        if t != 0 {
            return t
        }
        cur = up
        steps = steps + 1
    }
    return 0
}

/// The landing pad of the function that contains the return address `ra`, or 0.
fn padFor(ra: usize) -> usize {
    local table: *usize = __builtin_unwindPads()
    local n: usize = __builtin_unwindPadCount()
    local pc: usize = ra - 1
    local best: usize = 0
    local pad: usize = 0
    local i: usize = 0
    while i < n {
        local fnAddr: usize = table[i * 2]
        if fnAddr <= pc && fnAddr > best {
            best = fnAddr
            pad = table[i * 2 + 1]
        }
        i = i + 1
    }
    return pad
}

/// Continues in the `catch` block of the `try` recorded in `snap`: restores sp, fp and the
/// callee-saved registers, then jumps to the catch address. Never returns.
fn landHandler(snap: usize) {
#if arch == "x86_64"
    __builtin_asm("mov rax, [rdi]\nmov rsp, [rdi + 8]\nmov rbp, [rdi + 16]\nmov rbx, [rdi + 24]\nmov r12, [rdi + 32]\nmov r13, [rdi + 40]\nmov r14, [rdi + 48]\nmov r15, [rdi + 56]\njmp rax",
                  in("rdi") snap, clobber("rax"))
#elif arch == "aarch64"
    __builtin_asm("ldr x9, [x0]\nldp x10, x11, [x0, #8]\nmov sp, x10\nmov x29, x11\nldp x19, x20, [x0, #24]\nldp x21, x22, [x0, #40]\nldp x23, x24, [x0, #56]\nldp x25, x26, [x0, #72]\nldp x27, x28, [x0, #88]\nldp d8, d9, [x0, #104]\nldp d10, d11, [x0, #120]\nldp d12, d13, [x0, #136]\nldp d14, d15, [x0, #152]\nbr x9",
                  in("x0") snap, clobber("x9"), clobber("x10"), clobber("x11"))
#endif
}

/// Continues in a landing pad with the stack and frame pointer of the frame it belongs to.
fn jumpPad(sp: usize, fp: usize, pad: usize) {
#if arch == "x86_64"
    __builtin_asm("mov rsp, rdi\nmov rbp, rsi\njmp rdx", in("rdi") sp, in("rsi") fp, in("rdx") pad)
#elif arch == "aarch64"
    __builtin_asm("mov sp, x0\nmov x29, x1\nbr x2", in("x0") sp, in("x1") fp, in("x2") pad)
#endif
}

/// Walks from the frame `fp` towards the `try` in `target`, giving control to the landing pads on
/// the way. Never returns when `target` is a live record.
fn unwindTo(fp: usize, target: usize) {
    local w: *usize = target as *usize
    local cur: usize = fp
    local steps: usize = 0
    while steps < MAX_FRAMES {
        local up: usize = frameWord(cur, 0)
        local ra: usize = frameWord(cur, 1)
        if up == w[2] {
            tryLeave(w)
            landHandler(target)
        }
        local pad: usize = padFor(ra)
        if pad != 0 {
            jumpPad(cur + 16, up, pad)
        }
        cur = up
        steps = steps + 1
    }
}

/// Called by `panic`: when a `try` encloses the caller, copies the message into its buffer and
/// unwinds to it (does not return). Returns when there is none.
export fn unwindPanic(msg: *ui8) {
    local fp: usize = 0        // this function's own frame (read inline: a helper would be its own frame)
#if arch == "x86_64"
    __builtin_asm("mov {0}, rbp", out(reg) fp)
#elif arch == "aarch64"
    __builtin_asm("mov {0}, x29", out(reg) fp)
#endif
    local target: usize = nearestTry(frameWord(fp, 0))
    if target == 0 {
        return
    }
    local dst: *ui8 = (target as *usize)[WORD_MESSAGE] as *ui8
    local i: usize = 0
    while i < MESSAGE_MAX - 1 && msg[i] != 0 {
        dst[i] = msg[i]
        i = i + 1
    }
    dst[i] = 0
    unwindTo(frameWord(fp, 0), target)
}

/// The `unwind` role. 0 = a `try` body was left normally, 1 = a `try` was entered, 2 = a landing
/// pad finished its cleanups and the unwinding goes on.
register(unwind) fn unwindHook(op: i32, snapshot: *usize, message: *ui8) {
    if op == 1 {
        tryEnter(snapshot, message)
        return
    }
    if op == 0 {
        tryLeave(snapshot)
        return
    }
    local fp: usize = 0
#if arch == "x86_64"
    __builtin_asm("mov {0}, rbp", out(reg) fp)
#elif arch == "aarch64"
    __builtin_asm("mov {0}, x29", out(reg) fp)
#endif
    local frame: usize = frameWord(fp, 0)        // the frame whose pad is running
    local target: usize = nearestTry(frame)
    if target == 0 {
        sysWrite(2, "panic: unwinding lost its handler\n", 34)
        sysExit(134)
    }
    unwindTo(frame, target)
}
