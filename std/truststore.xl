// std/truststore: the operating system's trusted root certificates and X.509 chain validation
// (RFC 5280 path building, simplified). The roots are read from the OS's own PEM bundle the first
// time they are needed and kept mapped for the life of the process:
//   Linux    /etc/ssl/certs/ca-certificates.crt, /etc/pki/tls/certs/ca-bundle.crt, /etc/ssl/ca-bundle.pem,
//            /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem, /etc/ssl/cert.pem (first that exists)
//   macOS    /etc/ssl/cert.pem (the system roots exported by the OS; the keychain itself is not read)
//   Windows  the system "ROOT" certificate store, enumerated through crypt32.dll (CertOpenSystemStoreW,
//            CertEnumCertificatesInStore): the store is a locked, serialized registry hive with no
//            syscall-level interface, so the OS library is the only stable way (see CLAUDE.md)
// `trustSetBundle(path)` overrides the search. Nothing is ever trusted implicitly: with no roots a
// chain fails with TRUST_NO_ROOTS.
from "x509" import Cert, x509Parse, x509IssuedBy, x509CheckSignedBy, x509MatchesHost, x509ValidAt
from "fs" import fsSize, fsReadAll
from "sys" import sysMap

export define TRUST_OK = 0
export define TRUST_NO_ROOTS = 1
export define TRUST_BAD_HOST = 2
export define TRUST_EXPIRED = 3
export define TRUST_UNKNOWN_ISSUER = 4
export define TRUST_BAD_SIGNATURE = 5
export define TRUST_NOT_CA = 6
export define TRUST_EMPTY_CHAIN = 7

define DER_CAP = 4096

global bundle: *ui8
global bundleCap: usize
global bundleLen: usize
global bundleTried: bool
global bundleOverride: *ui8
/// The bundle is a PEM text (false) or a list of `[u32 length, DER bytes]` records (true, Windows).
global bundleDer: bool

#if os == "windows"
@library("crypt32") declare fn CertOpenSystemStoreW(prov: *void, name: *ui16) -> *void
@library("crypt32") declare fn CertEnumCertificatesInStore(store: *void, prev: *void) -> *void
@library("crypt32") declare fn CertCloseStore(store: *void, flags: ui32) -> i32

define WIN_STORE_CAP = 4194304

/// Copies every certificate of the system ROOT store into one DER record list. false if none.
fn loadWindowsRoots() -> bool {
    // L"ROOT"
    local name: [ui16; 5]
    name[0] = 82
    name[1] = 79
    name[2] = 79
    name[3] = 84
    name[4] = 0
    local store: *void = CertOpenSystemStoreW(nil, &name[0])
    if store == nil { return false }
    local mem: *ui8 = sysMap(WIN_STORE_CAP) as *ui8
    if mem == nil {
        CertCloseStore(store, 0)
        return false
    }
    local used: usize = 0
    local ctx: *void = CertEnumCertificatesInStore(store, nil)
    while ctx != nil {
        // CERT_CONTEXT: dwCertEncodingType (u32), pbCertEncoded (*ui8) at 8, cbCertEncoded (u32) at 16.
        local words: *ui64 = ctx as *ui64
        local der: *ui8 = words[1] as *ui8
        local len: usize = ((ctx as *ui32)[4]) as usize
        if der != nil && len > 0 && used + 4 + len <= WIN_STORE_CAP {
            mem[used] = (len % 256) as ui8
            mem[used + 1] = ((len / 256) % 256) as ui8
            mem[used + 2] = ((len / 65536) % 256) as ui8
            mem[used + 3] = ((len / 16777216) % 256) as ui8
            local i: usize = 0
            while i < len {
                mem[used + 4 + i] = der[i]
                i = i + 1
            }
            used = used + 4 + len
        }
        ctx = CertEnumCertificatesInStore(store, ctx)     // frees the previous context
    }
    CertCloseStore(store, 0)
    if used == 0 { return false }
    bundle = mem
    bundleCap = WIN_STORE_CAP
    bundleLen = used
    bundleDer = true
    return true
}
#endif

/// Uses `path` (a PEM file with CERTIFICATE blocks) instead of the OS location. Call before any
/// verification; the NUL-terminated string must stay valid.
export fn trustSetBundle(path: *ui8) {
    bundleOverride = path
    bundleTried = false
    bundleDer = false
    bundle = nil
    bundleLen = 0
}

fn loadFile(path: *ui8) -> bool {
    local size: i64 = fsSize(path)
    if size <= 0 { return false }
    local cap: usize = (size as usize) + 4096
    local mem: *ui8 = sysMap(cap) as *ui8
    if mem == nil { return false }
    local n: isize = fsReadAll(path, mem, cap)
    if n <= 0 { return false }
    bundle = mem
    bundleCap = cap
    bundleLen = n as usize
    return true
}

fn load() {
    if bundleTried { return }
    bundleTried = true
    if bundleOverride != nil {
        loadFile(bundleOverride)
        return
    }
#if os == "linux"
    if loadFile("/etc/ssl/certs/ca-certificates.crt") { return }
    if loadFile("/etc/pki/tls/certs/ca-bundle.crt") { return }
    if loadFile("/etc/ssl/ca-bundle.pem") { return }
    if loadFile("/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem") { return }
    if loadFile("/etc/ssl/cert.pem") { return }
#elif os == "macos"
    if loadFile("/etc/ssl/cert.pem") { return }
    if loadFile("/private/etc/ssl/cert.pem") { return }
#elif os == "windows"
    if loadWindowsRoots() { return }
#endif
}

// ---- PEM ---------------------------------------------------------------------------------------

fn b64(c: ui8) -> i32 {
    if c >= 65 && c <= 90 { return (c - 65) as i32 }
    if c >= 97 && c <= 122 { return (c - 97 + 26) as i32 }
    if c >= 48 && c <= 57 { return (c - 48 + 52) as i32 }
    if c == 43 { return 62 }
    if c == 47 { return 63 }
    return -1
}

fn startsWith(p: *ui8, end: usize, at: usize, s: *ui8) -> bool {
    local i: usize = 0
    while s[i] != 0 {
        if at + i >= end || p[at + i] != s[i] { return false }
        i = i + 1
    }
    return true
}

/// Decodes the next `-----BEGIN CERTIFICATE-----` block at or after `*pos` into `der` (capacity
/// `cap`). Returns the DER length, 0 at the end of the bundle; a block that does not decode or fit
/// is skipped.
fn nextCert(pos: *usize, der: *ui8, cap: usize) -> usize {
    if bundleDer {
        // `[u32 length, DER]` records; an oversized record is skipped.
        while *pos + 4 <= bundleLen {
            local at: usize = *pos
            local n: usize = (bundle[at] as usize) + (bundle[at + 1] as usize) * 256 +
                             (bundle[at + 2] as usize) * 65536 + (bundle[at + 3] as usize) * 16777216
            *pos = at + 4 + n
            if n != 0 && n <= cap && at + 4 + n <= bundleLen {
                local i: usize = 0
                while i < n {
                    der[i] = bundle[at + 4 + i]
                    i = i + 1
                }
                return n
            }
        }
        *pos = bundleLen
        return 0
    }
    while true {
        local p: usize = *pos
        while p < bundleLen && !startsWith(bundle, bundleLen, p, "-----BEGIN CERTIFICATE-----") {
            p = p + 1
        }
        if p >= bundleLen {
            *pos = bundleLen
            return 0
        }
        p = p + 27
        local n: usize = 0
        local acc: ui32 = 0
        local bits: i32 = 0
        local ok: bool = true
        while p < bundleLen && bundle[p] != 45 {            // until '-' of the END line
            local v: i32 = b64(bundle[p])
            if v >= 0 {
                acc = (acc << 6) | (v as ui32)
                bits = bits + 6
                if bits >= 8 {
                    bits = bits - 8
                    if n >= cap {
                        ok = false
                    } else {
                        der[n] = ((acc >> (bits as ui32)) & 0xff) as ui8
                        n = n + 1
                    }
                }
            }
            p = p + 1
        }
        *pos = p
        if ok && n > 0 { return n }
    }
    return 0
}

/// Number of certificates in the loaded bundle (0 when none could be read).
export fn trustCount() -> usize {
    load()
    if bundle == nil { return 0 }
    local der: [ui8; 4096]
    local pos: usize = 0
    local count: usize = 0
    local n: usize = nextCert(&pos, &der[0], DER_CAP)
    while n != 0 {
        count = count + 1
        n = nextCert(&pos, &der[0], DER_CAP)
    }
    return count
}

/// Is there a trusted root, valid at `now`, that issued `c` (names match and its key verifies the
/// signature)?
fn anchoredAt(c: *Cert, now: i64) -> bool {
    local der: [ui8; 4096]
    local root: Cert
    local pos: usize = 0
    local n: usize = nextCert(&pos, &der[0], DER_CAP)
    while n != 0 {
        if x509Parse(&root, &der[0], n) {
            if x509IssuedBy(c, &root) && x509ValidAt(&root, now) && x509CheckSignedBy(c, &root) {
                return true
            }
        }
        n = nextCert(&pos, &der[0], DER_CAP)
    }
    return false
}

/// Validates `chain[0..count]` (leaf first, as the server sent it) for `host` at time `now`:
/// the leaf covers `host`, every certificate is within its validity period, each is signed by the
/// next (which must be a CA), and the chain reaches a trusted root. Returns a TRUST_* code.
export fn trustVerifyChain(chain: *Cert, count: usize, host: *ui8, now: i64) -> i32 {
    if count == 0 { return TRUST_EMPTY_CHAIN }
    load()
    if bundle == nil { return TRUST_NO_ROOTS }
    if !x509MatchesHost(&chain[0], host) { return TRUST_BAD_HOST }
    local i: usize = 0
    while i < count {
        if !x509ValidAt(&chain[i], now) { return TRUST_EXPIRED }
        if anchoredAt(&chain[i], now) { return TRUST_OK }
        if i + 1 >= count { return TRUST_UNKNOWN_ISSUER }
        local parent: *Cert = &chain[i + 1]
        if !x509IssuedBy(&chain[i], parent) { return TRUST_UNKNOWN_ISSUER }
        if !parent.hasBasic || !parent.isCa { return TRUST_NOT_CA }
        if parent.hasKeyUsage && !parent.keyCertSign { return TRUST_NOT_CA }
        if parent.pathLen >= 0 && (i as i32) > parent.pathLen { return TRUST_NOT_CA }
        if !x509CheckSignedBy(&chain[i], parent) { return TRUST_BAD_SIGNATURE }
        i = i + 1
    }
    return TRUST_UNKNOWN_ISSUER
}

export fn trustErrorText(code: i32) -> *ui8 {
    if code == TRUST_OK { return "ok" }
    if code == TRUST_NO_ROOTS { return "no trusted root certificates could be loaded from this OS" }
    if code == TRUST_BAD_HOST { return "certificate does not match the host name" }
    if code == TRUST_EXPIRED { return "certificate is expired or not yet valid" }
    if code == TRUST_UNKNOWN_ISSUER { return "certificate chain does not lead to a trusted root" }
    if code == TRUST_BAD_SIGNATURE { return "certificate signature is invalid" }
    if code == TRUST_NOT_CA { return "issuer certificate is not a CA" }
    if code == TRUST_EMPTY_CHAIN { return "server sent no certificate" }
    return "unknown error"
}
