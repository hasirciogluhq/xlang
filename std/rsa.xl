// std/rsa: RSA signature verification with a public key (n, e): PKCS#1 v1.5 (RFC 8017 8.2) and PSS
// (9.1.2, salt length = hash length as TLS 1.3 requires). Moduli up to 4096 bits. Verification is
// the main job; `rsaSignPss` signs for the TLS server (not constant-time).
from "bignum" import Mont, montInit, montTo, montFrom, montPow, bnZero, bnFromBytes, bnToBytes, bnCmp
from "digest" import digest, digestLen

define RSA_MAX_BYTES = 512

/// sig^e mod n into `out` (k bytes, k = modulus length without leading zeros). False when the key
/// or signature is malformed.
fn publicOp(n: *ui8, nlen: usize, e: *ui8, elen: usize, sig: *ui8, slen: usize, out: *ui8) -> usize {
    local off: usize = 0
    while off < nlen && n[off] == 0 { off = off + 1 }
    local mod: *ui8 = &n[off]
    local k: usize = nlen - off
    if k < 64 || k > RSA_MAX_BYTES || (mod[k - 1] & 1) == 0 { return 0 }
    if slen != k || elen == 0 || elen > 8 { return 0 }
    local limbs: usize = (k + 3) / 4
    local m: [ui32; 130]
    local s: [ui32; 130]
    local ex: [ui32; 130]
    if !bnFromBytes(&m[0], limbs, mod, k) { return 0 }
    if !bnFromBytes(&s[0], limbs, sig, slen) { return 0 }
    if bnCmp(&s[0], &m[0], limbs) >= 0 { return 0 }
    bnZero(&ex[0], 130)
    if !bnFromBytes(&ex[0], 2, e, elen) { return 0 }
    local c: Mont
    montInit(&c, &m[0], limbs)
    local sm: [ui32; 130]
    local rm: [ui32; 130]
    montTo(&c, &sm[0], &s[0])
    montPow(&c, &rm[0], &sm[0], &ex[0], 2)
    montFrom(&c, &rm[0], &rm[0])
    bnToBytes(&rm[0], limbs, out, k)
    return k
}

fn prefixFor(alg: i32, out: *ui8) -> usize {
    // DigestInfo DER prefixes for SHA-256/384/512.
    local p: [ui8; 19]
    p[0] = 0x30
    p[2] = 0x30
    p[3] = 0x0d
    p[4] = 0x06
    p[5] = 0x09
    p[6] = 0x60
    p[7] = 0x86
    p[8] = 0x48
    p[9] = 0x01
    p[10] = 0x65
    p[11] = 0x03
    p[12] = 0x04
    p[13] = 0x02
    p[15] = 0x05
    p[16] = 0x00
    p[17] = 0x04
    if alg == 1 {
        p[1] = 0x31
        p[14] = 0x01
        p[18] = 0x20
    } else if alg == 2 {
        p[1] = 0x41
        p[14] = 0x02
        p[18] = 0x30
    } else {
        p[1] = 0x51
        p[14] = 0x03
        p[18] = 0x40
    }
    local i: usize = 0
    while i < 19 {
        out[i] = p[i]
        i = i + 1
    }
    return 19
}

/// PKCS#1 v1.5: `hash[0..hlen]` is the digest of the signed data, computed with `alg` (DIGEST_*).
export fn rsaVerifyPkcs1(n: *ui8, nlen: usize, e: *ui8, elen: usize, sig: *ui8, slen: usize, alg: i32, hash: *ui8, hlen: usize) -> bool {
    if digestLen(alg) != hlen { return false }
    local em: [ui8; 512]
    local k: usize = publicOp(n, nlen, e, elen, sig, slen, &em[0])
    if k == 0 { return false }
    local pre: [ui8; 19]
    local pl: usize = prefixFor(alg, &pre[0])
    local tlen: usize = pl + hlen
    if k < tlen + 11 { return false }
    if em[0] != 0 || em[1] != 1 { return false }
    local i: usize = 2
    while i < k - tlen - 1 {
        if em[i] != 0xff { return false }
        i = i + 1
    }
    if em[k - tlen - 1] != 0 { return false }
    local j: usize = 0
    while j < pl {
        if em[k - tlen + j] != pre[j] { return false }
        j = j + 1
    }
    j = 0
    local diff: ui8 = 0
    while j < hlen {
        diff = diff | (em[k - hlen + j] ^ hash[j])
        j = j + 1
    }
    return diff == 0
}

/// MGF1 (RFC 8017 B.2.1): `out[0..len]` from `seed[0..slen]`.
fn mgf1(alg: i32, seed: *ui8, slen: usize, out: *ui8, len: usize) {
    local buf: [ui8; 80]
    local h: [ui8; 64]
    local i: usize = 0
    while i < slen {
        buf[i] = seed[i]
        i = i + 1
    }
    local hl: usize = digestLen(alg)
    local counter: ui32 = 0
    local done: usize = 0
    while done < len {
        buf[slen] = ((counter >> 24) & 0xff) as ui8
        buf[slen + 1] = ((counter >> 16) & 0xff) as ui8
        buf[slen + 2] = ((counter >> 8) & 0xff) as ui8
        buf[slen + 3] = (counter & 0xff) as ui8
        digest(alg, &buf[0], slen + 4, &h[0])
        local take: usize = len - done
        if take > hl { take = hl }
        local j: usize = 0
        while j < take {
            out[done + j] = h[j]
            j = j + 1
        }
        done = done + take
        counter = counter + 1
    }
}

/// RSASSA-PSS with MGF1 of the same hash and salt length = hash length; `hash` is the digest of the
/// signed data computed with `alg`.
export fn rsaVerifyPss(n: *ui8, nlen: usize, e: *ui8, elen: usize, sig: *ui8, slen: usize, alg: i32, hash: *ui8, hlen: usize) -> bool {
    if digestLen(alg) != hlen { return false }
    local em: [ui8; 512]
    local k: usize = publicOp(n, nlen, e, elen, sig, slen, &em[0])
    if k == 0 { return false }
    // modBits from the top byte of the modulus
    local off: usize = 0
    while n[off] == 0 { off = off + 1 }
    local top: ui8 = n[off]
    local topBits: usize = 8
    while topBits > 0 && ((top >> ((topBits - 1) as ui8)) & 1) == 0 { topBits = topBits - 1 }
    local modBits: usize = (k - 1) * 8 + topBits
    local emBits: usize = modBits - 1
    local emLen: usize = (emBits + 7) / 8
    local lead: usize = k - emLen
    local i: usize = 0
    while i < lead {
        if em[i] != 0 { return false }
        i = i + 1
    }
    local ep: *ui8 = &em[lead]
    if emLen < hlen * 2 + 2 || ep[emLen - 1] != 0xbc { return false }
    local dbLen: usize = emLen - hlen - 1
    local unused: usize = 8 * emLen - emBits
    if unused > 0 && (ep[0] >> ((8 - unused) as ui8)) != 0 { return false }
    local mask: [ui8; 512]
    mgf1(alg, &ep[dbLen], hlen, &mask[0], dbLen)
    local db: [ui8; 512]
    i = 0
    while i < dbLen {
        db[i] = ep[i] ^ mask[i]
        i = i + 1
    }
    if unused > 0 { db[0] = db[0] & (0xff >> (unused as ui8)) }
    local ps: usize = dbLen - hlen - 1
    i = 0
    while i < ps {
        if db[i] != 0 { return false }
        i = i + 1
    }
    if db[ps] != 1 { return false }
    // H' = Hash(8 zero bytes || mHash || salt)
    local mp: [ui8; 8 + 64 + 64]
    i = 0
    while i < 8 {
        mp[i] = 0
        i = i + 1
    }
    i = 0
    while i < hlen {
        mp[8 + i] = hash[i]
        mp[8 + hlen + i] = db[ps + 1 + i]
        i = i + 1
    }
    local hh: [ui8; 64]
    digest(alg, &mp[0], 8 + hlen * 2, &hh[0])
    local diff: ui8 = 0
    i = 0
    while i < hlen {
        diff = diff | (hh[i] ^ ep[dbLen + i])
        i = i + 1
    }
    return diff == 0
}

/// RSASSA-PSS signing (RFC 8017 9.1.1) with the private exponent `d`: MGF1 of the same hash, salt
/// length = hash length. `salt[0..hlen]` are random bytes from the caller and `hash` is the digest
/// of the signed data computed with `alg`. Writes the signature (k bytes, the modulus length) to
/// `out` and returns k; 0 when the key is malformed. Not constant-time (square-and-multiply on the
/// secret exponent): fine for a server nobody can time locally, see KNOWN-LIMITATIONS.md.
export fn rsaSignPss(n: *ui8, nlen: usize, d: *ui8, dlen: usize, alg: i32, hash: *ui8, hlen: usize, salt: *ui8, out: *ui8) -> usize {
    if digestLen(alg) != hlen || hlen > 64 { return 0 }
    local off: usize = 0
    while off < nlen && n[off] == 0 { off = off + 1 }
    local mod: *ui8 = &n[off]
    local k: usize = nlen - off
    if k < 64 || k > RSA_MAX_BYTES || (mod[k - 1] & 1) == 0 { return 0 }
    if dlen == 0 || dlen > k { return 0 }
    local top: ui8 = mod[0]
    local topBits: usize = 8
    while topBits > 0 && ((top >> ((topBits - 1) as ui8)) & 1) == 0 { topBits = topBits - 1 }
    local modBits: usize = (k - 1) * 8 + topBits
    local emBits: usize = modBits - 1
    local emLen: usize = (emBits + 7) / 8
    if emLen < hlen * 2 + 2 { return 0 }
    local dbLen: usize = emLen - hlen - 1

    // H = Hash(8 zero bytes || mHash || salt)
    local mp: [ui8; 8 + 64 + 64]
    local i: usize = 0
    while i < 8 {
        mp[i] = 0
        i = i + 1
    }
    i = 0
    while i < hlen {
        mp[8 + i] = hash[i]
        mp[8 + hlen + i] = salt[i]
        i = i + 1
    }
    local hh: [ui8; 64]
    digest(alg, &mp[0], 8 + hlen * 2, &hh[0])

    // DB = PS || 0x01 || salt, masked with MGF1(H)
    local db: [ui8; 512]
    local ps: usize = dbLen - hlen - 1
    i = 0
    while i < ps {
        db[i] = 0
        i = i + 1
    }
    db[ps] = 1
    i = 0
    while i < hlen {
        db[ps + 1 + i] = salt[i]
        i = i + 1
    }
    local mask: [ui8; 512]
    mgf1(alg, &hh[0], hlen, &mask[0], dbLen)
    i = 0
    while i < dbLen {
        db[i] = db[i] ^ mask[i]
        i = i + 1
    }
    local unused: usize = 8 * emLen - emBits
    if unused > 0 { db[0] = db[0] & (0xff >> (unused as ui8)) }

    // EM = maskedDB || H || 0xbc, right-aligned in k bytes
    local em: [ui8; 512]
    local lead: usize = k - emLen
    i = 0
    while i < lead {
        em[i] = 0
        i = i + 1
    }
    i = 0
    while i < dbLen {
        em[lead + i] = db[i]
        i = i + 1
    }
    i = 0
    while i < hlen {
        em[lead + dbLen + i] = hh[i]
        i = i + 1
    }
    em[k - 1] = 0xbc

    // s = EM^d mod n
    local limbs: usize = (k + 3) / 4
    local m: [ui32; 130]
    local x: [ui32; 130]
    local ex: [ui32; 130]
    if !bnFromBytes(&m[0], limbs, mod, k) { return 0 }
    if !bnFromBytes(&x[0], limbs, &em[0], k) { return 0 }
    if bnCmp(&x[0], &m[0], limbs) >= 0 { return 0 }
    bnZero(&ex[0], 130)
    if !bnFromBytes(&ex[0], limbs, d, dlen) { return 0 }
    local c: Mont
    montInit(&c, &m[0], limbs)
    local xm: [ui32; 130]
    local rm: [ui32; 130]
    montTo(&c, &xm[0], &x[0])
    montPow(&c, &rm[0], &xm[0], &ex[0], limbs)
    montFrom(&c, &rm[0], &rm[0])
    bnToBytes(&rm[0], limbs, out, k)
    return k
}
