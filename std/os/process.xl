// std/os/process: process identity, signals to a process, waiting for a child, and starting a child.
// Linux (raw syscalls, numbers from docs/std/syscalls): getpid (39 / 172), kill (62 / 129), wait4 (61 / 260), clone (56 / 220)
// with SIGCHLD and no sharing, execve (59 / 221) and exit (60 / 93). The child of processSpawn gets an empty environment.
// processSpawnOut also redirects the child's stdout and stderr into a file: Linux opens the file in the child and
// duplicates it onto fds 1 and 2 with dup3 (x86_64 292, arm64 24; https://man7.org/linux/man-pages/man2/dup.2.html),
// macOS uses posix_spawn_file_actions_addopen / _adddup2
// (https://developer.apple.com/library/archive/documentation/System/Conceptual/ManPages_iPhoneOS/man3/posix_spawn_file_actions_addclose.3.html).
// macOS (libSystem, the documented interface): getpid, kill, wait4 and posix_spawn.
// Signal handlers (rt_sigaction, sigaction) are not part of this module.

#if os == "linux"

from "../sys" import sysOpenWrite, sysClose

#if arch == "x86_64"
define PROC_GETPID = 39
define PROC_KILL = 62
define PROC_WAIT4 = 61
define PROC_CLONE = 56
define PROC_EXECVE = 59
define PROC_DUP3 = 292
define PROC_EXIT = 60
#elif arch == "aarch64"
define PROC_GETPID = 172
define PROC_KILL = 129
define PROC_WAIT4 = 260
define PROC_CLONE = 220
define PROC_EXECVE = 221
define PROC_DUP3 = 24
define PROC_EXIT = 93
#endif
define PROC_SIGCHLD = 17

export fn processId() -> i32 {
    return syscall(PROC_GETPID) as i32
}

export fn processKill(pid: i32, sig: i32) -> i32 {
    return syscall(PROC_KILL, pid, sig) as i32
}

/// Waits for `pid` (-1 for any child); writes the wait status to `*status`; returns the pid reaped, or -1.
export fn processWait(pid: i32, status: *i32) -> i32 {
    return syscall(PROC_WAIT4, pid, status, 0, 0) as i32
}

/// Starts `path` with the argument vector `argv` (NULL-terminated) in an empty environment. Returns the child's pid, or -1.
export fn processSpawn(path: *ui8, argv: **ui8) -> i32 {
    local envp: [usize; 1] = [0]
    local pid: i64 = syscall(PROC_CLONE, PROC_SIGCHLD, 0, 0, 0, 0)
    if pid < 0 { return -1 }
    if pid == 0 {
        // child: replace the image, and leave with status 127 when that fails
        syscall(PROC_EXECVE, path, argv, &envp[0])
        syscall(PROC_EXIT, 127)
    }
    return pid as i32
}

/// Like processSpawn, with the child's stdout and stderr both written to the file `outPath` (created or truncated).
/// Returns the child's pid, or -1; a child that cannot open the file leaves with status 127.
export fn processSpawnOut(path: *ui8, argv: **ui8, outPath: *ui8) -> i32 {
    local envp: [usize; 1] = [0]
    local pid: i64 = syscall(PROC_CLONE, PROC_SIGCHLD, 0, 0, 0, 0)
    if pid < 0 { return -1 }
    if pid == 0 {
        local fd: i32 = sysOpenWrite(outPath, false)
        if fd < 0 { syscall(PROC_EXIT, 127) }
        syscall(PROC_DUP3, fd, 1, 0)
        syscall(PROC_DUP3, fd, 2, 0)
        if fd > 2 { sysClose(fd) }
        syscall(PROC_EXECVE, path, argv, &envp[0])
        syscall(PROC_EXIT, 127)
    }
    return pid as i32
}

#elif os == "macos"

@library("System") declare fn getpid() -> i32
@library("System") declare fn kill(pid: i32, sig: i32) -> i32
@library("System") declare fn wait4(pid: i32, status: *i32, options: i32, rusage: *void) -> i32
@library("System") declare fn posix_spawn(pid: *i32, path: *ui8, fileActions: *void, attr: *void, argv: **ui8, envp: **ui8) -> i32
@library("System") declare fn posix_spawn_file_actions_init(actions: **void) -> i32
@library("System") declare fn posix_spawn_file_actions_destroy(actions: **void) -> i32
@library("System") declare fn posix_spawn_file_actions_addopen(actions: **void, fd: i32, path: *ui8, oflag: i32, mode: i32) -> i32
@library("System") declare fn posix_spawn_file_actions_adddup2(actions: **void, fd: i32, newfd: i32) -> i32

// <fcntl.h> on macOS: O_WRONLY 0x1, O_CREAT 0x200, O_TRUNC 0x400; file mode 0644.
define PROC_OUT_FLAGS = 1537
define PROC_OUT_MODE = 420

export fn processId() -> i32 {
    return getpid()
}

export fn processKill(pid: i32, sig: i32) -> i32 {
    return kill(pid, sig)
}

export fn processWait(pid: i32, status: *i32) -> i32 {
    return wait4(pid, status, 0, nil)
}

/// Starts `path` with `argv` (NULL-terminated) through posix_spawn in an empty environment. Returns the child's pid, or -1.
export fn processSpawn(path: *ui8, argv: **ui8) -> i32 {
    local envp: [usize; 1] = [0]
    local pid: i32 = 0
    if posix_spawn(&pid, path, nil, nil, argv, &envp[0] as **ui8) != 0 { return -1 }
    return pid
}

/// Like processSpawn, with the child's stdout and stderr both written to the file `outPath` (created or truncated).
/// Returns the child's pid, or -1.
export fn processSpawnOut(path: *ui8, argv: **ui8, outPath: *ui8) -> i32 {
    local envp: [usize; 1] = [0]
    local actions: *void = nil
    if posix_spawn_file_actions_init(&actions) != 0 { return -1 }
    local pid: i32 = -1
    if posix_spawn_file_actions_addopen(&actions, 1, outPath, PROC_OUT_FLAGS, PROC_OUT_MODE) == 0 &&
       posix_spawn_file_actions_adddup2(&actions, 1, 2) == 0 {
        local started: i32 = 0
        if posix_spawn(&started, path, &actions as *void, nil, argv, &envp[0] as **ui8) == 0 { pid = started }
    }
    posix_spawn_file_actions_destroy(&actions)
    return pid
}

#else

export fn processId() -> i32 {
    return -1
}

export fn processKill(pid: i32, sig: i32) -> i32 {
    return -1
}

export fn processWait(pid: i32, status: *i32) -> i32 {
    return -1
}

export fn processSpawn(path: *ui8, argv: **ui8) -> i32 {
    return -1
}

export fn processSpawnOut(path: *ui8, argv: **ui8, outPath: *ui8) -> i32 {
    return -1
}

#endif
