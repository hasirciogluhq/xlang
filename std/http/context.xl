// std/http/context: the request and response of one HTTP exchange, as a class (`Context`). A handler gets a `*Context` and calls
// its methods: Param, Query, PostForm, GetHeader, Status, String, JSON, HTML, Data, Redirect and the file helpers. Request fields
// are `str` views into the request buffer that the server keeps alive for the whole exchange; response headers are copied into
// the context. Middleware calls Next() to run the rest of the chain, and Abort() to stop it.
from "../mem/memory" import strlen
from "../tls/tls" import TlsConn, tlsWrite
from "../sys" import sysWrite, sysClockSeconds
from "../time/date" import DateTime, civilFromDays
from "../str/str" import fromParts, fromC, eq
from "../str/string" import String
from "../collections/vec" import Vec
from "util" import lower, formatUInt
from "multipart" import MultipartPart, multipartFind, multipartBoundary

/// A request handler or middleware: it takes the context of the exchange and answers through its methods.
export type Handler = fn(*Context)

/// A route parameter: the name from the pattern (`:id`, `*action`) and the matched value.
export class Param {
    name: str
    value: str
}

export class Context {
    fd: i32
    tls: *TlsConn              // the TLS session of an HTTPS connection, nil for plain HTTP
    method: str
    path: str                  // the path without the query string, percent-decoded
    rawQuery: str              // the query string as sent (without '?')
    body: str                  // the request body, as many bytes as Content-Length (or the chunks) gave
    headerBlock: str           // the request header lines (request line excluded)
    params: Vec<Param>         // filled by the router
    handlers: Vec<Handler>
    index: i32                 // the handler that Next() runs next
    aborted: bool
    responded: bool
    streaming: bool
    isHead: bool
    keepAlive: bool
    statusCode: i32            // the status written, for logging
    extra: String              // response headers added with SetHeader, each "Name: value\r\n"
    chunkedOpen: bool          // a chunked response is in progress (Stream)

    fn init(self, fd: i32, tls: *TlsConn) {
        self.fd = fd
        self.tls = tls
        self.method = ""
        self.path = ""
        self.rawQuery = ""
        self.body = ""
        self.headerBlock = ""
        self.params = Vec<Param>()
        self.handlers = Vec<Handler>()
        self.index = 0
        self.aborted = false
        self.responded = false
        self.streaming = false
        self.isHead = false
        self.keepAlive = false
        self.statusCode = 0
        self.extra = String()
        self.chunkedOpen = false
    }

    // ---- request ---------------------------------------------------------------------------------

    fn Method(self) -> str {
        return self.method
    }

    /// The path of the request (percent-decoded, no query).
    fn Path(self) -> str {
        return self.path
    }

    fn Body(self) -> str {
        return self.body
    }

    /// A route parameter ("" when the route has no parameter of that name).
    fn Param(self, name: str) -> str {
        local i: usize = 0
        while i < self.params.length() {
            local p: *Param = self.params.get(i)
            if eq(p.name, name) { return p.value }
            i = i + 1
        }
        return ""
    }

    /// The value of a query parameter, or "" when it is absent. Query values are percent-decoded and '+' is a space.
    fn Query(self, name: str) -> str {
        local v: String = findPair(self.rawQuery, name)
        return v.asStr()
    }

    /// The query parameter, or `fallback` when it is absent (an empty value is present and is returned as "").
    fn DefaultQuery(self, name: str, fallback: str) -> str {
        if !hasPair(self.rawQuery, name) { return fallback }
        return self.Query(name)
    }

    /// A field of an application/x-www-form-urlencoded request body (HTML forms), or "".
    fn PostForm(self, name: str) -> str {
        local v: String = findPair(self.body, name)
        return v.asStr()
    }

    /// A request header by name (case-insensitive), or "" when it is absent. The value is trimmed of its blanks.
    fn GetHeader(self, name: str) -> str {
        return headerValue(self.headerBlock, name)
    }

    /// Adds a response header. Content-Length, Connection and Date are written by the response writer and cannot be set here.
    fn SetHeader(self, name: str, value: str) {
        self.extra.append(name)
        self.extra.append(": ")
        self.extra.append(value)
        self.extra.append("\r\n")
    }

    // ---- response --------------------------------------------------------------------------------

    /// Sets the status for a response with no body (the body is then empty).
    fn Status(self, code: i32) {
        self.respond(code, "text/plain; charset=utf-8", "")
    }

    fn String(self, code: i32, text: str) {
        self.respond(code, "text/plain; charset=utf-8", text)
    }

    fn JSON(self, code: i32, text: str) {
        self.respond(code, "application/json; charset=utf-8", text)
    }

    fn HTML(self, code: i32, text: str) {
        self.respond(code, "text/html; charset=utf-8", text)
    }

    /// Sends `data` with `contentType` (for example image/png or an uploaded file's type).
    fn Data(self, code: i32, contentType: str, data: str) {
        self.respond(code, contentType, data)
    }

    /// Redirects the client with `code` (301, 302, 303, 307 or 308; RFC 9110 section 15.4) to `location`.
    fn Redirect(self, code: i32, location: str) {
        self.SetHeader("Location", location)
        self.respond(code, "text/plain; charset=utf-8", "")
    }

    /// Starts a chunked response (no Content-Length); send pieces with WriteChunk and finish with EndStream.
    fn StreamStart(self, code: i32, contentType: str) {
        if self.responded { return }
        self.writeHead(code, contentType)
        if self.isHead {
            self.writeRaw("Content-Length: 0\r\n")
            self.writeConnection()
        } else {
            self.writeRaw("Transfer-Encoding: chunked\r\n")
            self.writeConnection()
        }
        self.responded = true
        self.streaming = true
        self.statusCode = code
    }

    fn WriteChunk(self, data: str) {
        if !self.streaming || self.isHead || data.len == 0 { return }
        local hex: [ui8; 16]
        local n: usize = hexLength(data.len, &hex[0])
        self.writeBytes(&hex[0], n)
        self.writeRaw("\r\n")
        self.writeBytes(data.ptr, data.len)
        self.writeRaw("\r\n")
    }

    fn EndStream(self) {
        if !self.streaming { return }
        if !self.isHead { self.writeRaw("0\r\n\r\n") }
        self.streaming = false
    }

    // ---- control ---------------------------------------------------------------------------------

    /// Runs the next handler of the chain. Middleware calls it to wrap the rest of the chain.
    fn Next(self) {
        self.index = self.index + 1
        while self.index < (self.handlers.length() as i32) && !self.aborted {
            local h: fn(*Context) = *self.handlers.get(self.index as usize)
            h(self)
            self.index = self.index + 1
        }
    }

    /// Stops the chain: the handlers after the current one do not run.
    fn Abort(self) {
        self.aborted = true
    }

    fn AbortWithStatus(self, code: i32) {
        self.Status(code)
        self.Abort()
    }

    fn IsAborted(self) -> bool {
        return self.aborted
    }

    fn Responded(self) -> bool {
        return self.responded
    }

    // ---- forms and uploads ----------------------------------------------------------------------

    /// The text of a multipart form field (a part without a filename), or "" when absent.
    fn FormValue(self, name: str) -> str {
        local p: MultipartPart = multipartFind(self.body, multipartBoundary(self.GetHeader("Content-Type")), name)
        if !p.found || p.filename.len > 0 { return "" }
        return p.data
    }

    /// The content of an uploaded file (the multipart part named `name` that has a filename), or "" when absent.
    fn FormFile(self, name: str) -> str {
        local p: MultipartPart = multipartFind(self.body, multipartBoundary(self.GetHeader("Content-Type")), name)
        if !p.found || p.filename.len == 0 { return "" }
        return p.data
    }

    /// The file name the client sent for the upload `name`, or "".
    fn FormFileName(self, name: str) -> str {
        local p: MultipartPart = multipartFind(self.body, multipartBoundary(self.GetHeader("Content-Type")), name)
        return p.filename
    }

    /// The media type the client sent for the upload `name` (application/octet-stream when none was given), or "".
    fn FormFileType(self, name: str) -> str {
        local p: MultipartPart = multipartFind(self.body, multipartBoundary(self.GetHeader("Content-Type")), name)
        if !p.found || p.filename.len == 0 { return "" }
        if p.contentType.len == 0 { return "application/octet-stream" }
        return p.contentType
    }

    // ---- writer (internal) -----------------------------------------------------------------------

    fn respond(self, code: i32, contentType: str, body: str) {
        if self.responded { return }
        self.writeHead(code, contentType)
        local num: [ui8; 24]
        local len: usize = formatUInt(body.len, &num[0])
        self.writeRaw("Content-Length: ")
        self.writeBytes(&num[0], len)
        self.writeRaw("\r\n")
        self.writeConnection()
        if !self.isHead { self.writeBytes(body.ptr, body.len) }
        self.responded = true
        self.statusCode = code
    }

    fn writeHead(self, code: i32, contentType: str) {
        local num: [ui8; 24]
        local len: usize = formatUInt(code as usize, &num[0])
        self.writeRaw("HTTP/1.1 ")
        self.writeBytes(&num[0], len)
        self.writeRaw(" ")
        self.writeRaw(fromC(statusText(code)))
        self.writeRaw("\r\nContent-Type: ")
        self.writeBytes(contentType.ptr, contentType.len)
        self.writeRaw("\r\nDate: ")
        local dateBuf: [ui8; 40]
        local dl: usize = httpDate(&dateBuf[0])
        self.writeBytes(&dateBuf[0], dl)
        self.writeRaw("\r\n")
        if self.extra.length() > 0 {
            self.writeBytes(self.extra.cstr(), self.extra.length())
        }
    }

    fn writeConnection(self) {
        if self.keepAlive {
            self.writeRaw("Connection: keep-alive\r\n\r\n")
        } else {
            self.writeRaw("Connection: close\r\n\r\n")
        }
    }

    fn writeRaw(self, s: str) {
        self.writeBytes(s.ptr, s.len)
    }

    fn writeBytes(self, data: *ui8, n: usize) {
        if self.tls != nil {
            tlsWrite(self.tls, data, n)
            return
        }
        local done: usize = 0
        while done < n {
            local w: isize = sysWrite(self.fd, &data[done], n - done)
            if w <= 0 { return }
            done = done + (w as usize)
        }
    }
}

/// Hex digits of `v` followed by nothing (chunk size line, RFC 9112 section 7.1); returns the length written.
fn hexLength(v: usize, out: *ui8) -> usize {
    local digits: [ui8; 16]
    local n: usize = 0
    local x: usize = v
    while true {
        local d: usize = x % 16
        if d < 10 { digits[n] = (48 + d) as ui8 } else { digits[n] = (87 + d) as ui8 }
        n = n + 1
        x = x / 16
        if x == 0 { break }
    }
    local k: usize = 0
    while k < n {
        out[k] = digits[n - 1 - k]
        k = k + 1
    }
    return n
}

/// The value of the first pair named `name` in `text` ("a=1&b=2" form), decoded, or "" when absent.
fn findPair(text: str, name: str) -> String {
    local out: String = String()
    local i: usize = 0
    while i < text.len {
        local end: usize = i
        while end < text.len && text[end] != 38 { end = end + 1 }
        local eqAt: usize = i
        while eqAt < end && text[eqAt] != 61 { eqAt = eqAt + 1 }
        if eqAt - i == name.len && eqCI(fromParts(&text.ptr[i], name.len), name) {
            local v: str = ""
            if eqAt < end { v = fromParts(&text.ptr[eqAt + 1], end - eqAt - 1) }
            return decodeField(v)
        }
        i = end + 1
    }
    return out
}

/// True when the pair `name` appears in `text` (with or without a value).
fn hasPair(text: str, name: str) -> bool {
    local i: usize = 0
    while i <= text.len {
        local end: usize = i
        while end < text.len && text[end] != 38 { end = end + 1 }
        local eq_at: usize = i
        while eq_at < end && text[eq_at] != 61 { eq_at = eq_at + 1 }
        if eq_at - i == name.len && eq(fromParts(&text.ptr[i], name.len), name) { return true }
        i = end + 1
    }
    return false
}

/// Decodes one form or query value in one pass: '+' is a space and "%XX" is the byte XX (a '%' not followed by two hex digits
/// is kept). RFC 1866 section 8.2.1 and RFC 3986 section 2.1.
fn decodeField(v: str) -> String {
    local out: String = String()
    local i: usize = 0
    while i < v.len {
        if v[i] == 43 {
            out.append(" ")
            i = i + 1
        } else if v[i] == 37 && i + 2 < v.len && hexValue(v[i + 1]) >= 0 && hexValue(v[i + 2]) >= 0 {
            local b: ui8 = ((hexValue(v[i + 1]) * 16) + hexValue(v[i + 2])) as ui8
            out.append(fromParts(&b as *ui8, 1))
            i = i + 3
        } else {
            out.append(fromParts(&v.ptr[i], 1))
            i = i + 1
        }
    }
    return out
}

/// The value of a hex digit, or -1.
fn hexValue(c: ui8) -> i32 {
    if c >= 48 && c <= 57 { return (c - 48) as i32 }
    if c >= 65 && c <= 70 { return (c - 55) as i32 }
    if c >= 97 && c <= 102 { return (c - 87) as i32 }
    return -1
}

/// The value of header `name` in a header block ("Name: value\r\n..."), trimmed; "" when absent. Names compare case-insensitively.
fn headerValue(block: str, name: str) -> str {
    local i: usize = 0
    while i < block.len {
        local eol: usize = i
        while eol < block.len && block[eol] != 13 { eol = eol + 1 }
        local colon: usize = i
        while colon < eol && block[colon] != 58 { colon = colon + 1 }
        if colon - i == name.len && eqCI(fromParts(&block.ptr[i], name.len), name) {
            local s: usize = colon + 1
            while s < eol && (block[s] == 32 || block[s] == 9) { s = s + 1 }
            local e: usize = eol
            while e > s && (block[e - 1] == 32 || block[e - 1] == 9) { e = e - 1 }
            return fromParts(&block.ptr[s], e - s)
        }
        i = eol + 2
    }
    return ""
}

/// Case-insensitive comparison of two strings of the same length.
fn eqCI(a: str, b: str) -> bool {
    if a.len != b.len { return false }
    local i: usize = 0
    while i < a.len {
        if lower(a[i]) != lower(b[i]) { return false }
        i = i + 1
    }
    return true
}

export fn statusText(status: i32) -> *ui8 {
    if status == 200 { return "OK" }
    if status == 201 { return "Created" }
    if status == 202 { return "Accepted" }
    if status == 204 { return "No Content" }
    if status == 206 { return "Partial Content" }
    if status == 301 { return "Moved Permanently" }
    if status == 302 { return "Found" }
    if status == 303 { return "See Other" }
    if status == 304 { return "Not Modified" }
    if status == 307 { return "Temporary Redirect" }
    if status == 308 { return "Permanent Redirect" }
    if status == 400 { return "Bad Request" }
    if status == 401 { return "Unauthorized" }
    if status == 403 { return "Forbidden" }
    if status == 404 { return "Not Found" }
    if status == 405 { return "Method Not Allowed" }
    if status == 408 { return "Request Timeout" }
    if status == 409 { return "Conflict" }
    if status == 410 { return "Gone" }
    if status == 411 { return "Length Required" }
    if status == 413 { return "Payload Too Large" }
    if status == 414 { return "URI Too Long" }
    if status == 415 { return "Unsupported Media Type" }
    if status == 422 { return "Unprocessable Entity" }
    if status == 429 { return "Too Many Requests" }
    if status == 431 { return "Request Header Fields Too Large" }
    if status == 500 { return "Internal Server Error" }
    if status == 501 { return "Not Implemented" }
    if status == 502 { return "Bad Gateway" }
    if status == 503 { return "Service Unavailable" }
    if status == 504 { return "Gateway Timeout" }
    return "Unknown"
}

/// Status line, `Content-Type` and the headers added with `ctxSetHeader`.
/// The current time in the IMF-fixdate form of RFC 9110 section 5.6.7, "Sun, 06 Nov 1994 08:49:37 GMT", into `out` (at least
/// 29 bytes); returns the length. A clock that is not set reads as the epoch.
export fn httpDate(out: *ui8) -> usize {
    local t: i64 = sysClockSeconds()
    if t < 0 { t = 0 }
    local days: i64 = t / 86400
    local rem: i64 = t % 86400
    local d: DateTime = civilFromDays(days)
    local wd: i64 = (days + 4) % 7
    local wdays: str = "SunMonTueWedThuFriSat"
    local months: str = "JanFebMarAprMayJunJulAugSepOctNovDec"
    local o: usize = 0
    local i: usize = 0
    while i < 3 {
        out[o] = wdays[((wd * 3) as usize) + i]
        o = o + 1
        i = i + 1
    }
    out[o] = 44
    out[o + 1] = 32
    o = o + 2
    putPadded(out, o, d.day as i64, 2)
    o = o + 2
    out[o] = 32
    o = o + 1
    i = 0
    while i < 3 {
        out[o] = months[(((d.month - 1) * 3) as usize) + i]
        o = o + 1
        i = i + 1
    }
    out[o] = 32
    o = o + 1
    putPadded(out, o, d.year, 4)
    o = o + 4
    out[o] = 32
    o = o + 1
    putPadded(out, o, rem / 3600, 2)
    out[o + 2] = 58
    putPadded(out, o + 3, (rem % 3600) / 60, 2)
    out[o + 5] = 58
    putPadded(out, o + 6, rem % 60, 2)
    o = o + 8
    out[o] = 32
    out[o + 1] = 71
    out[o + 2] = 77
    out[o + 3] = 84
    return o + 4
}

/// Writes `v` in decimal, zero padded to `width` digits, at `out[at..]`.
fn putPadded(out: *ui8, at: usize, v: i64, width: usize) {
    local x: i64 = v
    local i: usize = width
    while i > 0 {
        i = i - 1
        out[at + i] = (48 + (x % 10)) as ui8
        x = x / 10
    }
}

