// std/http/util: string, number and header-block helpers shared by the HTTP server and client.
// Everything here works on NUL-terminated byte strings and caller-provided buffers.
from "../memory" import strlen

export fn cstrEq(a: *ui8, b: *ui8) -> bool {
    local i: usize = 0
    while a[i] != 0 && a[i] == b[i] { i = i + 1 }
    return a[i] == b[i]
}

export fn lower(c: ui8) -> ui8 {
    if c >= 65 && c <= 90 { return c + 32 }
    return c
}

/// Case-insensitive equality of two NUL-terminated strings.
export fn eqCI(a: *ui8, b: *ui8) -> bool {
    local i: usize = 0
    while a[i] != 0 && lower(a[i]) == lower(b[i]) { i = i + 1 }
    return lower(a[i]) == lower(b[i])
}

/// Does `s` start with `prefix` (case-insensitive)?
export fn startsCI(s: *ui8, prefix: *ui8) -> bool {
    local i: usize = 0
    while prefix[i] != 0 {
        if lower(s[i]) != lower(prefix[i]) { return false }
        i = i + 1
    }
    return true
}

export fn memMove(dst: *ui8, src: *ui8, n: usize) {
    local i: usize = 0
    while i < n {
        dst[i] = src[i]
        i = i + 1
    }
}

/// Writes the decimal digits of `v` at `buf` and returns how many.
export fn formatUInt(v: usize, buf: *ui8) -> usize {
    local tmp: [ui8; 24]
    local n: usize = 0
    local x: usize = v
    if x == 0 {
        buf[0] = 48
        return 1
    }
    while x > 0 {
        tmp[n] = ((x % 10) as ui8) + 48
        x = x / 10
        n = n + 1
    }
    local i: usize = 0
    while i < n {
        buf[i] = tmp[n - 1 - i]
        i = i + 1
    }
    return n
}

/// Writes the lowercase hexadecimal digits of `v` at `buf` and returns how many.
export fn formatHex(v: usize, buf: *ui8) -> usize {
    local tmp: [ui8; 24]
    local n: usize = 0
    local x: usize = v
    if x == 0 {
        buf[0] = 48
        return 1
    }
    while x > 0 {
        local d: ui8 = (x % 16) as ui8
        if d < 10 { tmp[n] = d + 48 } else { tmp[n] = d + 87 }
        x = x / 16
        n = n + 1
    }
    local i: usize = 0
    while i < n {
        buf[i] = tmp[n - 1 - i]
        i = i + 1
    }
    return n
}

/// Appends `s` at `at` in `buf` (capacity `cap`, truncating); returns the new length.
export fn append(buf: *ui8, at: usize, cap: usize, s: *ui8) -> usize {
    local n: usize = at
    local i: usize = 0
    while s[i] != 0 && n < cap {
        buf[n] = s[i]
        n = n + 1
        i = i + 1
    }
    return n
}

export fn hexDigit(c: ui8) -> i32 {
    if c >= 48 && c <= 57 { return (c - 48) as i32 }
    if c >= 97 && c <= 102 { return (c - 87) as i32 }
    if c >= 65 && c <= 70 { return (c - 55) as i32 }
    return -1
}

/// Index of the `\r\n\r\n` that ends the headers, or -1.
export fn headerEnd(s: *ui8, n: usize) -> isize {
    local i: usize = 0
    while i + 3 < n {
        if s[i] == 13 && s[i + 1] == 10 && s[i + 2] == 13 && s[i + 3] == 10 { return i as isize }
        i = i + 1
    }
    return -1
}

/// Turns every `\r` of the header block `s[0..he + 3)` into NUL, so each line reads
/// `Name: value\0\n` and the block ends at a line that starts with NUL.
export fn terminateLines(s: *ui8, he: usize) {
    local i: usize = 0
    while i < he + 3 {
        if s[i] == 13 { s[i] = 0 }
        i = i + 1
    }
}

/// Value of header `name` in a block prepared by `terminateLines` (the first line, the request or
/// status line, is skipped); nil when absent. Names compare case-insensitively.
export fn headerLookup(block: *ui8, name: *ui8) -> *ui8 {
    local nl: usize = strlen(name)
    local p: usize = 0
    while block[p] != 10 { p = p + 1 }
    p = p + 1
    while block[p] != 0 {
        local k: usize = 0
        while k < nl && lower(block[p + k]) == lower(name[k]) { k = k + 1 }
        if k == nl && block[p + nl] == 58 {
            local v: usize = p + nl + 1
            while block[v] == 32 || block[v] == 9 { v = v + 1 }
            return &block[v]
        }
        while block[p] != 10 { p = p + 1 }
        p = p + 1
    }
    return nil
}

/// Does the raw `Name: value\r\n` list `headers` contain `name`?
export fn hasHeader(headers: *ui8, name: *ui8) -> bool {
    if headers == nil { return false }
    local nl: usize = strlen(name)
    local p: usize = 0
    while headers[p] != 0 {
        if startsCI(&headers[p], name) && headers[p + nl] == 58 { return true }
        while headers[p] != 0 && headers[p] != 10 { p = p + 1 }
        if headers[p] == 10 { p = p + 1 }
    }
    return false
}

/// Decodes `%XX` and `+` in place; returns the new length. Invalid escapes are kept as written.
export fn urlDecode(s: *ui8) -> usize {
    local rd: usize = 0
    local wr: usize = 0
    while s[rd] != 0 {
        local c: ui8 = s[rd]
        if c == 43 {
            s[wr] = 32
            rd = rd + 1
        } else {
            if c == 37 && hexDigit(s[rd + 1]) >= 0 && s[rd + 1] != 0 && hexDigit(s[rd + 2]) >= 0 {
                s[wr] = ((hexDigit(s[rd + 1]) * 16 + hexDigit(s[rd + 2])) as ui8)
                rd = rd + 3
            } else {
                s[wr] = c
                rd = rd + 1
            }
        }
        wr = wr + 1
    }
    s[wr] = 0
    return wr
}
