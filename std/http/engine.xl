// std/http/engine: the router of the HTTP server, in the Gin style (github.com/gin-gonic/gin, the routing documentation). An
// Engine holds the routes; each HTTP method has a method that takes a path and a handler and returns the engine, so the calls chain:
//     router.GET("/hello", fn(c: *Context) { c.String(200, "Hello, World!") }).POST("/users", fn(c: *Context) { ... })
// A path is a pattern: ":name" matches one segment, "*name" matches the rest of the path including its leading slash. A static
// route wins over a pattern route at the same place. Two routes of one method whose patterns differ only in parameter names are
// rejected at registration (Gin panics too). A route's handler chain is the middleware in effect when it was registered, followed by
// the handler. A matched chain runs as a scheduler task (std/thread spawn); the connection waits for it before it answers.
from "../mem/memory" import strlen
from "../str/str" import fromParts, eq, fromC
from "../str/string" import String
from "../collections/vec" import Vec, vecClone
from "../tls/tls" import TlsCredentials
from "../thread/sched" import spawn, waitAll
from "context" import Context, Param, Handler
from "server" import routerServe, routerServeTls

/// One registered route.
export class Route {
    method: str
    pattern: String
    chain: Vec<Handler>
    isStatic: bool
}

/// The router. Routes are registered with the method calls; middleware with Use.
export class Engine {
    routes: Vec<Route>
    middleware: Vec<Handler>
    notFound: Vec<Handler>
    notAllowed: Vec<Handler>
    redirectTrailingSlash: bool
    redirectFixedPath: bool
    handleMethodNotAllowed: bool

    fn init(self) {
        self.routes = Vec<Route>()
        self.middleware = Vec<Handler>()
        self.notFound = Vec<Handler>()
        self.notAllowed = Vec<Handler>()
        self.redirectTrailingSlash = true
        self.redirectFixedPath = false
        self.handleMethodNotAllowed = false
    }

    /// Adds middleware for the routes registered after this call (Gin's engine.Use).
    fn Use(self, mw: fn(*Context)) -> *Engine {
        self.middleware.push(mw)
        return self
    }

    fn GET(self, path: str, handler: fn(*Context)) -> *Engine {
        return self.Handle("GET", path, handler)
    }

    fn POST(self, path: str, handler: fn(*Context)) -> *Engine {
        return self.Handle("POST", path, handler)
    }

    fn PUT(self, path: str, handler: fn(*Context)) -> *Engine {
        return self.Handle("PUT", path, handler)
    }

    fn PATCH(self, path: str, handler: fn(*Context)) -> *Engine {
        return self.Handle("PATCH", path, handler)
    }

    fn DELETE(self, path: str, handler: fn(*Context)) -> *Engine {
        return self.Handle("DELETE", path, handler)
    }

    fn HEAD(self, path: str, handler: fn(*Context)) -> *Engine {
        return self.Handle("HEAD", path, handler)
    }

    fn OPTIONS(self, path: str, handler: fn(*Context)) -> *Engine {
        return self.Handle("OPTIONS", path, handler)
    }

    /// Registers `handler` for the seven standard methods (Gin's Any).
    fn Any(self, path: str, handler: fn(*Context)) -> *Engine {
        self.Handle("GET", path, handler)
        self.Handle("POST", path, handler)
        self.Handle("PUT", path, handler)
        self.Handle("PATCH", path, handler)
        self.Handle("DELETE", path, handler)
        self.Handle("HEAD", path, handler)
        return self.Handle("OPTIONS", path, handler)
    }

    /// Registers `handler` for any method name (Gin's Handle).
    fn Handle(self, method: str, path: str, handler: fn(*Context)) -> *Engine {
        addRoute(self, method, path, handler, &self.middleware)
        return self
    }

    /// The handlers that answer a request no route matches (Gin's NoRoute). They replace the default 404 answer.
    fn NoRoute(self, handler: fn(*Context)) -> *Engine {
        self.notFound.push(handler)
        return self
    }

    /// The handlers for a request whose path exists with another method (only with handleMethodNotAllowed).
    fn NoMethod(self, handler: fn(*Context)) -> *Engine {
        self.notAllowed.push(handler)
        return self
    }

    /// A group of routes that share a prefix (Gin's RouterGroup). The group copies the middleware in effect now.
    fn Group(self, prefix: str) -> *RouterGroup {
        return newGroup(self, prefix, &self.middleware)
    }

    /// Serves on `port` on all interfaces, until the process ends. Returns -1 when the socket cannot be set up.
    fn Run(self, port: ui16) -> i32 {
        return routerServe(self as *void, engineServe, 0, port, noListen)
    }

    /// Serves HTTPS on `port` with the credentials of `cr`.
    fn RunTLS(self, port: ui16, cr: *TlsCredentials) -> i32 {
        return routerServeTls(self as *void, engineServe, 0, port, cr, noListen)
    }

    /// Routes one request: finds the route, fills its parameters, and runs its chain as a scheduler task. The call returns when the
    /// task has finished. Without a matching route the not-found chain (or "404 page not found") answers.
    fn Serve(self, c: *Context) {
        local found: i32 = findRoute(self, c)
        if found >= 0 {
            local r: *Route = self.routes.get(found as usize)
            c.handlers = vecClone(&r.chain)
            c.index = -1
            spawn(runChain, c as *void)
            waitAll()
            return
        }
        if self.handleMethodNotAllowed && allowedElsewhere(self, c) {
            c.handlers = vecClone(&self.notAllowed)
            c.index = -1
            spawn(runChain, c as *void)
            waitAll()
            return
        }
        if self.redirectTrailingSlash || self.redirectFixedPath {
            if redirectRoute(self, c) { return }
        }
        c.handlers = vecClone(&self.notFound)
        c.index = -1
        spawn(runChain, c as *void)
        waitAll()
        if !c.responded {
            c.String(404, "404 page not found")
        }
    }
}

/// The group of routes that share a prefix and middleware.
export class RouterGroup {
    engine: *Engine
    prefix: String
    middleware: Vec<Handler>

    /// Adds middleware for the routes registered after this call on this group.
    fn Use(self, mw: fn(*Context)) -> *RouterGroup {
        self.middleware.push(mw)
        return self
    }

    /// A sub-group: its prefix is this group's prefix followed by `prefix`.
    fn Group(self, prefix: str) -> *RouterGroup {
        local p: String = String()
        p.append(self.prefix.asStr())
        p.append(prefix)
        return newGroup(self.engine, p.asStr(), &self.middleware)
    }

    fn GET(self, path: str, handler: fn(*Context)) -> *RouterGroup {
        return self.Handle("GET", path, handler)
    }

    fn POST(self, path: str, handler: fn(*Context)) -> *RouterGroup {
        return self.Handle("POST", path, handler)
    }

    fn PUT(self, path: str, handler: fn(*Context)) -> *RouterGroup {
        return self.Handle("PUT", path, handler)
    }

    fn PATCH(self, path: str, handler: fn(*Context)) -> *RouterGroup {
        return self.Handle("PATCH", path, handler)
    }

    fn DELETE(self, path: str, handler: fn(*Context)) -> *RouterGroup {
        return self.Handle("DELETE", path, handler)
    }

    fn HEAD(self, path: str, handler: fn(*Context)) -> *RouterGroup {
        return self.Handle("HEAD", path, handler)
    }

    fn OPTIONS(self, path: str, handler: fn(*Context)) -> *RouterGroup {
        return self.Handle("OPTIONS", path, handler)
    }

    fn Any(self, path: str, handler: fn(*Context)) -> *RouterGroup {
        self.Handle("GET", path, handler)
        self.Handle("POST", path, handler)
        self.Handle("PUT", path, handler)
        self.Handle("PATCH", path, handler)
        self.Handle("DELETE", path, handler)
        self.Handle("HEAD", path, handler)
        return self.Handle("OPTIONS", path, handler)
    }

    fn Handle(self, method: str, path: str, handler: fn(*Context)) -> *RouterGroup {
        local full: String = String()
        full.append(self.prefix.asStr())
        full.append(path)
        addRoute(self.engine, method, full.asStr(), handler, &self.middleware)
        return self
    }
}

fn noListen() {
}

fn newGroup(e: *Engine, prefix: str, mw: *Vec<Handler>) -> *RouterGroup {
    local g: *RouterGroup = new RouterGroup()
    g.engine = e
    g.prefix = String()
    g.prefix.append(prefix)
    g.middleware = vecClone(mw)
    return g
}

/// The task body: runs the chain of the context (the argument of spawn).
fn runChain(arg: *void) {
    local c: *Context = arg as *Context
    c.Next()
}

/// Registers one route. A conflict with an existing route of the same method and shape stops the program (Gin's startup panic).
fn addRoute(e: *Engine, method: str, path: str, handler: fn(*Context), mw: *Vec<Handler>) {
    if path.len == 0 || path[0] != 47 { panic("route path must start with /") }
    local i: usize = 0
    while i < e.routes.length() {
        local other: *Route = e.routes.get(i)
        if eq(other.method, method) && sameShape(other.pattern.asStr(), path) {
            panic("ambiguous route: a route of this method has the same shape")
        }
        i = i + 1
    }
    local r: Route = Route()
    r.method = method
    r.pattern = String()
    r.pattern.append(path)
    r.chain = Vec<Handler>()
    local k: usize = 0
    while k < mw.length() {
        r.chain.push(*mw.get(k))
        k = k + 1
    }
    r.chain.push(handler)
    r.isStatic = !hasPattern(path)
    e.routes.push(r)
}

fn hasPattern(path: str) -> bool {
    local i: usize = 0
    while i < path.len {
        if path[i] == 58 || path[i] == 42 { return true }
        i = i + 1
    }
    return false
}

/// True when two patterns have the same shape: equal text except that parameter names (":x") and wildcard names ("*x") may differ.
fn sameShape(a: str, b: str) -> bool {
    local i: usize = 0
    local j: usize = 0
    while true {
        if i < a.len && j < b.len && a[i] == 58 && b[j] == 58 {
            while i < a.len && a[i] != 47 { i = i + 1 }
            while j < b.len && b[j] != 47 { j = j + 1 }
        } else if i < a.len && j < b.len && a[i] == 42 && b[j] == 42 {
            return true
        } else {
            if i >= a.len || j >= b.len { return i >= a.len && j >= b.len }
            if a[i] != b[j] { return false }
            i = i + 1
            j = j + 1
        }
    }
    return false
}

/// Matches `path` against the pattern `pat`; fills `params` (name and value views) on success.
fn matchPattern(pat: str, path: str, params: *Vec<Param>) -> bool {
    local pi: usize = 0
    local si: usize = 0
    while pi < pat.len {
        if pat[pi] == 58 {
            local ne: usize = pi + 1
            while ne < pat.len && pat[ne] != 47 { ne = ne + 1 }
            local ve: usize = si
            while ve < path.len && path[ve] != 47 { ve = ve + 1 }
            if ve == si { return false }
            local p: Param = Param()
            p.name = fromParts(&pat.ptr[pi + 1], ne - pi - 1)
            p.value = fromParts(&path.ptr[si], ve - si)
            params.push(p)
            pi = ne
            si = ve
        } else if pat[pi] == 42 {
            if pi == 0 || pat[pi - 1] != 47 || si == 0 || path[si - 1] != 47 { return false }
            local p: Param = Param()
            p.name = fromParts(&pat.ptr[pi + 1], pat.len - pi - 1)
            p.value = fromParts(&path.ptr[si - 1], path.len - si + 1)
            params.push(p)
            return true
        } else {
            if si >= path.len || pat[pi] != path[si] { return false }
            pi = pi + 1
            si = si + 1
        }
    }
    return si == path.len
}

/// The index of the route for the request, or -1. Static routes are tried before pattern routes. Fills c.params on a match.
fn findRoute(e: *Engine, c: *Context) -> i32 {
    local pass: i32 = 0
    while pass < 2 {
        local i: usize = 0
        while i < e.routes.length() {
            local r: *Route = e.routes.get(i)
            if r.isStatic == (pass == 0) && eq(r.method, c.method) {
                c.params.clear()
                if matchPattern(r.pattern.asStr(), c.path, &c.params) { return i as i32 }
            }
            i = i + 1
        }
        pass = pass + 1
    }
    c.params.clear()
    return -1
}

/// True when the path matches a route of another method (for 405).
fn allowedElsewhere(e: *Engine, c: *Context) -> bool {
    local i: usize = 0
    while i < e.routes.length() {
        local r: *Route = e.routes.get(i)
        c.params.clear()
        if !eq(r.method, c.method) && matchPattern(r.pattern.asStr(), c.path, &c.params) {
            c.params.clear()
            return true
        }
        i = i + 1
    }
    c.params.clear()
    return false
}

/// Redirects a path that differs from a route only by a trailing slash, or by letter case when fixed-path redirects are on. GET
/// gets 301, other methods 307 (Gin's behavior). Returns true when a redirect was sent.
fn redirectRoute(e: *Engine, c: *Context) -> bool {
    local target: String = String()
    if e.redirectTrailingSlash {
        local alt: String = String()
        if c.path.len > 1 && c.path[c.path.len - 1] == 47 {
            alt.append(fromParts(c.path.ptr, c.path.len - 1))
        } else {
            alt.append(c.path)
            alt.append("/")
        }
        if routeExists(e, c.method, alt.asStr()) {
            target.append(alt.asStr())
        }
    }
    if target.length() == 0 && e.redirectFixedPath {
        local fixed: String = String()
        local k: usize = 0
        while k < c.path.len {
            fixed.append(fromParts(&c.path.ptr[k], 1))
            k = k + 1
        }
        if routeExists(e, c.method, fixed.asStr()) {
            target.append(fixed.asStr())
        }
    }
    if target.length() == 0 { return false }
    local code: i32 = 307
    if eq(c.method, "GET") { code = 301 }
    c.Redirect(code, target.asStr())
    return true
}

fn routeExists(e: *Engine, method: str, path: str) -> bool {
    local i: usize = 0
    while i < e.routes.length() {
        local r: *Route = e.routes.get(i)
        local ps: Vec<Param> = Vec<Param>()
        if eq(r.method, method) && matchPattern(r.pattern.asStr(), path, &ps) {
            return true
        }
        i = i + 1
    }
    return false
}

/// The server's entry into the engine: the server passes the engine as a void pointer (the server does not import this module).
fn engineServe(e: *void, c: *Context) {
    local engine: *Engine = e as *Engine
    engine.Serve(c)
}
