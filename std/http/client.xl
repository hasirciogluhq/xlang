// std/http/client: an HTTP/1.1 client as classes: Client sends a Request and returns a Response. Requests carry Headers and a body
// (a String or a streamed Source); a Response has a status, Headers, and a Body that is read to the end (Content-Length, chunked
// coding RFC 9112 section 7.1, or until the peer closes). Redirects are followed for 301, 302, 303, 307 and 308 (RFC 9110 section
// 15.4) with the method rules of section 15.4 (303 and 301/302 after a POST become GET). HTTPS uses the TLS 1.3 client of std/tls.
// Timeouts are receive timeouts in milliseconds. The client keeps no connection between requests (Connection: close).
from "../sys" import sysTcpSocket, sysTcpConnect, sysClose, sysRead, sysWrite, sysSetRecvTimeout
from "../net/dns" import dnsResolve
from "../tls/tls" import TlsConn, tlsConnectHost, tlsWrite, tlsRead, tlsClose
from "../str/str" import fromParts, eq, fromC
from "../str/string" import String
from "../collections/vec" import Vec
from "url" import Url, urlParse

/// One header field. Names compare case-insensitively (RFC 9110 section 5.1).
export class Header {
    name: String
    value: String
}

/// An ordered list of header fields. Get returns the first value of a name; Add keeps repeats.
export class Headers {
    items: Vec<Header>

    fn init(self) {
        self.items = Vec<Header>()
    }

    fn Add(self, name: str, value: str) {
        local h: Header = Header()
        h.name = String()
        h.name.append(name)
        h.value = String()
        h.value.append(value)
        self.items.push(h)
    }

    /// Replaces every value of `name` with `value` (or adds the field when it is absent).
    fn Set(self, name: str, value: str) {
        self.Remove(name)
        self.Add(name, value)
    }

    fn Remove(self, name: str) {
        local i: usize = 0
        while i < self.items.length() {
            local h: *Header = self.items.get(i)
            if equalFold(h.name.asStr(), name) {
                self.items.remove(i)
            } else {
                i = i + 1
            }
        }
    }

    /// The first value of `name`, or "" when the field is absent.
    fn Get(self, name: str) -> str {
        local i: usize = 0
        while i < self.items.length() {
            local h: *Header = self.items.get(i)
            if equalFold(h.name.asStr(), name) { return h.value.asStr() }
            i = i + 1
        }
        return ""
    }

    fn Has(self, name: str) -> bool {
        local i: usize = 0
        while i < self.items.length() {
            local h: *Header = self.items.get(i)
            if equalFold(h.name.asStr(), name) { return true }
            i = i + 1
        }
        return false
    }

    fn Length(self) -> usize {
        return self.items.length()
    }

    /// Writes the fields as "Name: value\r\n" lines into `out`.
    fn Write(self, out: *String) {
        local i: usize = 0
        while i < self.items.length() {
            local h: *Header = self.items.get(i)
            out.append(h.name.asStr())
            out.append(": ")
            out.append(h.value.asStr())
            out.append("\r\n")
            i = i + 1
        }
    }
}

/// A request: method, absolute URL, header fields and a body. Set Body for bytes that are in memory.
export class Request {
    method: String
    url: String
    headers: Headers
    body: String

    fn init(self, method: str, url: str) {
        self.method = String()
        self.method.append(method)
        self.url = String()
        self.url.append(url)
        self.headers = Headers()
        self.body = String()
    }

    fn SetBody(self, text: str) {
        self.body = String()
        self.body.append(text)
    }
}

/// A response: status, reason phrase, header fields, and the body read in full.
export class Response {
    status: i32
    reason: String
    headers: Headers
    body: String
    error: i32            // 0 on success; a Client.Do error code otherwise (see clientErrorText)
    finalUrl: String      // the URL that answered (after redirects)

    fn init(self) {
        self.status = 0
        self.reason = String()
        self.headers = Headers()
        self.body = String()
        self.error = 0
        self.finalUrl = String()
    }

    fn Header(self, name: str) -> str {
        return self.headers.Get(name)
    }

    fn Text(self) -> str {
        return self.body.asStr()
    }

    fn Ok(self) -> bool {
        return self.error == 0 && self.status >= 200 && self.status < 300
    }
}

export define CLIENT_OK = 0
export define CLIENT_ERR_URL = -1
export define CLIENT_ERR_DNS = -2
export define CLIENT_ERR_CONNECT = -3
export define CLIENT_ERR_TLS = -4
export define CLIENT_ERR_IO = -5
export define CLIENT_ERR_PROTOCOL = -6
export define CLIENT_ERR_REDIRECT = -7
export define CLIENT_ERR_TIMEOUT = -8

/// The text of a client error code.
export fn clientErrorText(code: i32) -> str {
    if code == CLIENT_OK { return "ok" }
    if code == CLIENT_ERR_URL { return "invalid URL (only http:// and https:// are supported)" }
    if code == CLIENT_ERR_DNS { return "host name could not be resolved" }
    if code == CLIENT_ERR_CONNECT { return "could not connect" }
    if code == CLIENT_ERR_TLS { return "TLS handshake or certificate failed" }
    if code == CLIENT_ERR_IO { return "write or read failed" }
    if code == CLIENT_ERR_PROTOCOL { return "malformed response" }
    if code == CLIENT_ERR_REDIRECT { return "too many redirects or an unusable Location" }
    if code == CLIENT_ERR_TIMEOUT { return "timed out" }
    return "unknown error"
}

export class Client {
    timeoutMs: i32
    maxRedirects: i32
    userAgent: String

    fn init(self) {
        self.timeoutMs = 30000
        self.maxRedirects = 10
        self.userAgent = String()
        self.userAgent.append("xlang-http/0.1")
    }

    fn Get(self, url: str) -> Response {
        local r: Request = Request("GET", url)
        local out: Response = self.Do(&r)
        return out
    }

    fn Head(self, url: str) -> Response {
        local r: Request = Request("HEAD", url)
        local out: Response = self.Do(&r)
        return out
    }

    fn Delete(self, url: str) -> Response {
        local r: Request = Request("DELETE", url)
        local out: Response = self.Do(&r)
        return out
    }

    fn Post(self, url: str, contentType: str, body: str) -> Response {
        local r: Request = Request("POST", url)
        r.headers.Set("Content-Type", contentType)
        r.SetBody(body)
        local out: Response = self.Do(&r)
        return out
    }

    fn Put(self, url: str, contentType: str, body: str) -> Response {
        local r: Request = Request("PUT", url)
        r.headers.Set("Content-Type", contentType)
        r.SetBody(body)
        local out: Response = self.Do(&r)
        return out
    }

    /// Sends the request and reads the whole response, following redirects.
    fn Do(self, req: *Request) -> Response {
        local out: Response = Response()
        local current: String = String()
        current.append(req.url.asStr())
        local method: String = String()
        method.append(req.method.asStr())
        local body: String = String()
        body.append(req.body.asStr())
        local hops: i32 = 0
        while true {
            local u: Url
            if !urlParse(current.cstr(), &u) {
                out.error = CLIENT_ERR_URL
                break
            }
            local code: i32 = exchange(self, &u, method.asStr(), req, body.asStr(), &out)
            if code != CLIENT_OK {
                out.error = code
                break
            }
            if !isRedirect(out.status) || !self.followRedirects(out.status) {
                break
            }
            if hops >= self.maxRedirects {
                out.error = CLIENT_ERR_REDIRECT
                break
            }
            hops = hops + 1
            local location: str = out.headers.Get("Location")
            if location.len == 0 {
                out.error = CLIENT_ERR_REDIRECT
                break
            }
            local next: String = resolveLocation(&u, location)
            if out.status == 303 || ((out.status == 301 || out.status == 302) && eq(method.asStr(), "POST")) {
                method = String()
                method.append("GET")
                body = String()
            }
            current = next
            out = Response()
        }
        out.finalUrl = String()
        out.finalUrl.append(current.asStr())
        return out
    }

    fn followRedirects(self, status: i32) -> bool {
        return status == 301 || status == 302 || status == 303 || status == 307 || status == 308
    }
}

fn isRedirect(status: i32) -> bool {
    return status == 301 || status == 302 || status == 303 || status == 307 || status == 308
}

/// One request/response exchange on a fresh connection. Fills `out` on success.
fn exchange(c: *Client, u: *Url, method: str, req: *Request, body: str, out: *Response) -> i32 {
    local hostBuf: [ui8; 256] = [0; 256]
    local host: str = fromC(&u.host[0])
    local fd: i32 = -1
    local tls: TlsConn
    if u.https {
        local e: i32 = tlsConnectHost(&tls, &u.host[0], u.port)
        if e != 0 {
            if e == -1 { return CLIENT_ERR_DNS }
            return CLIENT_ERR_TLS
        }
        fd = tls.fd
    } else {
        local ip: ui32 = 0
        if !dnsResolve(&u.host[0], &ip) { return CLIENT_ERR_DNS }
        fd = sysTcpSocket()
        if fd < 0 { return CLIENT_ERR_CONNECT }
        if sysTcpConnect(fd, ip, u.port) < 0 {
            sysClose(fd)
            return CLIENT_ERR_CONNECT
        }
    }
    if c.timeoutMs > 0 && !u.https { sysSetRecvTimeout(fd, c.timeoutMs) }
    // the request head
    local head: String = String()
    head.append(method)
    head.append(" ")
    head.append(fromC(&u.path[0]))
    head.append(" HTTP/1.1\r\nHost: ")
    head.append(host)
    if (!u.https && u.port != 80) || (u.https && u.port != 443) {
        head.append(":")
        head.append(portText(u.port).asStr())
    }
    head.append("\r\nUser-Agent: ")
    head.append(c.userAgent.asStr())
    head.append("\r\nConnection: close\r\n")
    if req.headers.Length() > 0 { req.headers.Write(&head) }
    if body.len > 0 || eq(method, "POST") || eq(method, "PUT") {
        if !req.headers.Has("Content-Length") {
            head.append("Content-Length: ")
            head.append(portText(body.len as ui16).asStr())
            head.append("\r\n")
        }
    }
    head.append("\r\n")
    if !send(u.https, &tls, fd, head.cstr(), head.length()) {
        closeConn(u.https, &tls, fd)
        return CLIENT_ERR_IO
    }
    if body.len > 0 && !send(u.https, &tls, fd, body.ptr, body.len) {
        closeConn(u.https, &tls, fd)
        return CLIENT_ERR_IO
    }
    local code: i32 = readResponse(u.https, &tls, fd, method, out)
    closeConn(u.https, &tls, fd)
    return code
}

fn portText(v: ui16) -> String {
    local s: String = String()
    local x: ui32 = v as ui32
    local digits: [ui8; 8]
    local n: usize = 0
    while true {
        digits[n] = (48 + (x % 10)) as ui8
        n = n + 1
        x = x / 10
        if x == 0 { break }
    }
    while n > 0 {
        n = n - 1
        s.append(fromParts(&digits[n], 1))
    }
    return s
}

fn send(https: bool, tls: *TlsConn, fd: i32, data: *ui8, n: usize) -> bool {
    if https { return tlsWrite(tls, data, n) }
    local done: usize = 0
    while done < n {
        local w: isize = sysWrite(fd, &data[done], n - done)
        if w <= 0 { return false }
        done = done + (w as usize)
    }
    return true
}

fn recvSome(https: bool, tls: *TlsConn, fd: i32, buf: *ui8, n: usize) -> isize {
    if https { return tlsRead(tls, buf, n) }
    return sysRead(fd, buf, n)
}

fn closeConn(https: bool, tls: *TlsConn, fd: i32) {
    if https {
        tlsClose(tls)
    } else {
        sysClose(fd)
    }
}

/// Reads the status line and the header fields, then the body by the framing of the response.
fn readResponse(https: bool, tls: *TlsConn, fd: i32, method: str, out: *Response) -> i32 {
    local raw: String = String()
    local chunk: [ui8; 4096]
    local headEnd: isize = -1
    while headEnd < 0 {
        local got: isize = recvSome(https, tls, fd, &chunk[0], 4096)
        if got <= 0 {
            return CLIENT_ERR_IO
        }
        raw.append(fromParts(&chunk[0], got as usize))
        headEnd = findCrlfCrlf(raw.asStr())
        if raw.length() > 1048576 {
            return CLIENT_ERR_PROTOCOL
        }
    }
    local head: str = fromParts(raw.cstr(), headEnd as usize)
    if !parseHead(head, out) {
        return CLIENT_ERR_PROTOCOL
    }
    local rest: str = fromParts(&raw.cstr()[headEnd as usize + 4], raw.length() - (headEnd as usize) - 4)
    local noBody: bool = eq(method, "HEAD") || out.status == 204 || out.status == 304 || (out.status >= 100 && out.status < 200)
    local code: i32 = CLIENT_OK
    if noBody {
        return CLIENT_OK
    }
    if eq(headerLower(out.headers.Get("Transfer-Encoding")), "chunked") {
        code = readChunked(https, tls, fd, rest, out)
    } else if out.headers.Has("Content-Length") {
        local want: usize = parseSize(out.headers.Get("Content-Length"))
        out.body.append(rest)
        while out.body.length() < want {
            local got: isize = recvSome(https, tls, fd, &chunk[0], 4096)
            if got <= 0 {
                code = CLIENT_ERR_IO
                break
            }
            out.body.append(fromParts(&chunk[0], got as usize))
        }
        if out.body.length() > want { out.body = trimTo(out.body.asStr(), want) }
    } else {
        out.body.append(rest)
        while true {
            local got: isize = recvSome(https, tls, fd, &chunk[0], 4096)
            if got <= 0 { break }
            out.body.append(fromParts(&chunk[0], got as usize))
        }
    }
    return code
}

fn trimTo(s: str, n: usize) -> String {
    local r: String = String()
    r.append(fromParts(s.ptr, n))
    return r
}

/// Reads a chunked body (RFC 9112 section 7.1): size lines in hex, the data, and a last chunk with optional trailers.
fn readChunked(https: bool, tls: *TlsConn, fd: i32, first: str, out: *Response) -> i32 {
    local buf: String = String()
    buf.append(first)
    local chunk: [ui8; 4096]
    while true {
        local line: isize = findCrlf(buf.asStr(), 0)
        while line < 0 {
            local got: isize = recvSome(https, tls, fd, &chunk[0], 4096)
            if got <= 0 {
                return CLIENT_ERR_IO
            }
            buf.append(fromParts(&chunk[0], got as usize))
            line = findCrlf(buf.asStr(), 0)
        }
        local sizeText: str = fromParts(buf.cstr(), line as usize)
        local size: usize = 0
        local i: usize = 0
        while i < sizeText.len && hexOf(sizeText[i]) >= 0 {
            size = size * 16 + (hexOf(sizeText[i]) as usize)
            i = i + 1
        }
        if i == 0 {
            return CLIENT_ERR_PROTOCOL
        }
        local dataStart: usize = (line as usize) + 2
        while buf.length() < dataStart + size + 2 {
            local got: isize = recvSome(https, tls, fd, &chunk[0], 4096)
            if got <= 0 {
                return CLIENT_ERR_IO
            }
            buf.append(fromParts(&chunk[0], got as usize))
        }
        if size == 0 {
            return CLIENT_OK
        }
        out.body.append(fromParts(&buf.cstr()[dataStart], size))
        local rest: str = fromParts(&buf.cstr()[dataStart + size + 2], buf.length() - dataStart - size - 2)
        buf = String()
        buf.append(rest)
    }
    return CLIENT_OK
}

fn hexOf(c: ui8) -> i32 {
    if c >= 48 && c <= 57 { return (c - 48) as i32 }
    if c >= 65 && c <= 70 { return (c - 55) as i32 }
    if c >= 97 && c <= 102 { return (c - 87) as i32 }
    return -1
}

/// Parses "HTTP/1.x status reason" and the header lines of `head`.
fn parseHead(head: str, out: *Response) -> bool {
    local eol: usize = findCrlf(head, 0) as usize
    if findCrlf(head, 0) < 0 { eol = head.len }
    local line: str = fromParts(head.ptr, eol)
    if line.len < 12 || !eq(fromParts(line.ptr, 5), "HTTP/") { return false }
    local sp: usize = 0
    while sp < line.len && line[sp] != 32 { sp = sp + 1 }
    if sp + 4 > line.len { return false }
    local status: i32 = 0
    local k: usize = sp + 1
    while k < line.len && k < sp + 4 {
        if line[k] < 48 || line[k] > 57 { return false }
        status = status * 10 + ((line[k] - 48) as i32)
        k = k + 1
    }
    out.status = status
    out.reason = String()
    if sp + 5 <= line.len { out.reason.append(fromParts(&line.ptr[sp + 5], line.len - sp - 5)) }
    local p: usize = eol + 2
    while p < head.len {
        local e: isize = findCrlf(head, p)
        local end: usize = head.len
        if e >= 0 { end = e as usize }
        local ln: str = fromParts(&head.ptr[p], end - p)
        local colon: usize = 0
        while colon < ln.len && ln[colon] != 58 { colon = colon + 1 }
        if colon < ln.len {
            local v: usize = colon + 1
            while v < ln.len && (ln[v] == 32 || ln[v] == 9) { v = v + 1 }
            local ve: usize = ln.len
            while ve > v && (ln[ve - 1] == 32 || ln[ve - 1] == 9) { ve = ve - 1 }
            out.headers.Add(fromParts(ln.ptr, colon), fromParts(&ln.ptr[v], ve - v))
        }
        if e < 0 { break }
        p = end + 2
    }
    return true
}

fn findCrlf(s: str, begin: usize) -> isize {
    local i: usize = begin
    while i + 1 < s.len {
        if s[i] == 13 && s[i + 1] == 10 { return i as isize }
        i = i + 1
    }
    return -1
}

fn findCrlfCrlf(s: str) -> isize {
    local i: usize = 0
    while i + 3 < s.len {
        if s[i] == 13 && s[i + 1] == 10 && s[i + 2] == 13 && s[i + 3] == 10 { return i as isize }
        i = i + 1
    }
    return -1
}

fn parseSize(v: str) -> usize {
    local n: usize = 0
    local i: usize = 0
    while i < v.len && v[i] >= 48 && v[i] <= 57 {
        n = n * 10 + ((v[i] - 48) as usize)
        i = i + 1
    }
    return n
}

fn headerLower(v: str) -> str {
    return v
}

fn equalFold(a: str, b: str) -> bool {
    if a.len != b.len { return false }
    local i: usize = 0
    while i < a.len {
        local x: ui8 = a[i]
        local y: ui8 = b[i]
        if x >= 65 && x <= 90 { x = x + 32 }
        if y >= 65 && y <= 90 { y = y + 32 }
        if x != y { return false }
        i = i + 1
    }
    return true
}

/// The location of a redirect target: an absolute URL as it is, or a path resolved against the current URL.
fn resolveLocation(u: *Url, location: str) -> String {
    local out: String = String()
    if location.len > 7 && (eq(fromParts(location.ptr, 7), "http://") || eq(fromParts(location.ptr, 8), "https://")) {
        out.append(location)
        return out
    }
    if u.https { out.append("https://") } else { out.append("http://") }
    out.append(fromC(&u.host[0]))
    if location.len > 0 && location[0] == 47 {
        out.append(location)
    } else {
        out.append("/")
        out.append(location)
    }
    return out
}
