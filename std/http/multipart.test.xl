// Unit tests of multipart/form-data parsing: the boundary parameter, plain fields, file parts with names and types, and absent names.
from "std/testing" import Suite, T, suiteInit, test, suiteRun, expectEqStr, expectTrue, expectFalse
from "std/http" import multipartBoundary, multipartFind, MultipartPart

fn boundaryFromQuotedParameter(t: *T) {
    expectEqStr(t, multipartBoundary("multipart/form-data; boundary=\"abc-123\""), "abc-123")
}

fn boundaryFromUnquotedParameter(t: *T) {
    expectEqStr(t, multipartBoundary("multipart/form-data; boundary=XyZ"), "XyZ")
}

fn plainFieldIsFound(t: *T) {
    local body: str = "--B\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\nhello\r\n--B--\r\n"
    local p: MultipartPart = multipartFind(body, "B", "title")
    expectTrue(t, p.found)
    expectEqStr(t, p.data, "hello")
    expectEqStr(t, p.filename, "")
}

fn fileIsFoundWithNameAndType(t: *T) {
    local body: str = "--B\r\nContent-Disposition: form-data; name=\"upload\"; filename=\"a.txt\"\r\nContent-Type: text/plain\r\n\r\nfile body\r\n--B--\r\n"
    local p: MultipartPart = multipartFind(body, "B", "upload")
    expectTrue(t, p.found)
    expectEqStr(t, p.filename, "a.txt")
    expectEqStr(t, p.contentType, "text/plain")
    expectEqStr(t, p.data, "file body")
}

fn secondPartIsFound(t: *T) {
    local body: str = "--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n1\r\n--B\r\nContent-Disposition: form-data; name=\"b\"\r\n\r\n2\r\n--B--\r\n"
    local p: MultipartPart = multipartFind(body, "B", "b")
    expectTrue(t, p.found)
    expectEqStr(t, p.data, "2")
}

fn absentNameIsNotFound(t: *T) {
    local body: str = "--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n1\r\n--B--\r\n"
    local p: MultipartPart = multipartFind(body, "B", "missing")
    expectFalse(t, p.found)
}

@entry fn main() -> i32 {
    local s: Suite
    suiteInit(&s)
    test(&s, "boundary from a quoted parameter", boundaryFromQuotedParameter)
    test(&s, "boundary from an unquoted parameter", boundaryFromUnquotedParameter)
    test(&s, "plain field is found", plainFieldIsFound)
    test(&s, "file part has its name and type", fileIsFoundWithNameAndType)
    test(&s, "second part is found", secondPartIsFound)
    test(&s, "absent name is not found", absentNameIsNotFound)
    return suiteRun(&s)
}
