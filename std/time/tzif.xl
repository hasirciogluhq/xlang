// std/time/tzif: reading the compiled time zone database files, TZif version 2 and later (RFC 8536, https://www.rfc-editor.org/rfc/rfc8536,
// sections 3 and 4). A file has a version-1 data block with 32-bit transition times, then (version 2 and later) a second header and
// data block with 64-bit times, then a footer with a POSIX TZ string (RFC 8536 section 3.3, POSIX.1 section 8.3) for times after the
// last transition. Layout of one block (all integers big-endian): the six counts isutcnt, isstdcnt, leapcnt, timecnt, typecnt, charcnt
// (after the 20-byte header prefix "TZif", version, 15 unused bytes); then timecnt transition times, timecnt type indices, typecnt
// ttinfo records (UT offset as signed 32-bit, isdst byte, abbreviation index byte), charcnt abbreviation bytes, leapcnt leap records,
// isstdcnt and isutcnt indicator bytes.
// Lookup (section 3.2): a time before the first transition uses ttinfo 0; a time at or after a transition uses that transition's
// ttinfo. After the last transition, a footer TZ string without a daylight saving part gives a fixed offset; with a DST part, the
// rules are NOT evaluated here, so the last transition's type is used (a documented limit; see docs/std/time.md).
// The result views (abbreviations, footer) point into the file buffer, which the caller keeps alive.

from "../str/str" import fromParts

/// A parsed TZif file: byte offsets into `data` (length `n`), so the struct holds no pointers.
export struct TzFile {
    data: *ui8
    n: usize
    timeSize: usize           // 4 (version 1 block) or 8 (version 2+ block)
    timeCount: usize
    timesOff: usize
    idxOff: usize
    typeCount: usize
    typesOff: usize
    charCount: usize
    charsOff: usize
    footerOff: usize
    footerLen: usize
    ok: bool
}

/// The local time of an instant: UT offset in seconds (east positive), the DST flag, and the abbreviation.
export struct TzLocal {
    utoff: i64
    isdst: bool
    abbr: str
    ok: bool
}

/// Big-endian unsigned integer of `width` bytes at `p`.
fn beUnsigned(p: *ui8, width: usize) -> ui64 {
    local v: ui64 = 0
    local i: usize = 0
    while i < width {
        v = (v << 8) | (p[i] as ui64)
        i = i + 1
    }
    return v
}

/// The size in bytes of the data block that follows a header with these counts.
fn blockLen(timeSize: usize, timecnt: usize, typecnt: usize, charcnt: usize, leapcnt: usize, isstdcnt: usize, isutcnt: usize) -> usize {
    return timecnt * timeSize + timecnt + typecnt * 6 + charcnt + leapcnt * (timeSize + 4) + isstdcnt + isutcnt
}

/// Parses a TZif file held in `data[0..n)`. `ok` is false when the magic, the counts or the sizes are inconsistent.
export fn tzifParse(data: *ui8, n: usize) -> TzFile {
    local f: TzFile
    f.data = data
    f.n = n
    if n < 44 { return f }
    if data[0] != 84 || data[1] != 90 || data[2] != 105 || data[3] != 102 { return f }
    local version: ui8 = data[4]
    // version-1 block
    local isut: usize = beUnsigned(&data[20], 4) as usize
    local isstd: usize = beUnsigned(&data[24], 4) as usize
    local leap: usize = beUnsigned(&data[28], 4) as usize
    local timecnt: usize = beUnsigned(&data[32], 4) as usize
    local typecnt: usize = beUnsigned(&data[36], 4) as usize
    local charcnt: usize = beUnsigned(&data[40], 4) as usize
    local head: usize = 44
    local timeSize: usize = 4
    if version >= 50 {
        // skip the version-1 block: its size uses 4-byte times and 8-byte leap records
        local v1: usize = blockLen(4, timecnt, typecnt, charcnt, leap, isstd, isut)
        head = 44 + v1
        if n < head + 44 { return f }
        if data[head] != 84 || data[head + 1] != 90 || data[head + 2] != 105 || data[head + 3] != 102 { return f }
        isut = beUnsigned(&data[head + 20], 4) as usize
        isstd = beUnsigned(&data[head + 24], 4) as usize
        leap = beUnsigned(&data[head + 28], 4) as usize
        timecnt = beUnsigned(&data[head + 32], 4) as usize
        typecnt = beUnsigned(&data[head + 36], 4) as usize
        charcnt = beUnsigned(&data[head + 40], 4) as usize
        timeSize = 8
    }
    local body: usize = head + 44
    local total: usize = body + blockLen(timeSize, timecnt, typecnt, charcnt, leap, isstd, isut)
    if total > n || typecnt == 0 { return f }
    f.timeSize = timeSize
    f.timeCount = timecnt
    f.timesOff = body
    f.idxOff = body + timecnt * timeSize
    f.typeCount = typecnt
    f.typesOff = f.idxOff + timecnt
    f.charCount = charcnt
    f.charsOff = f.typesOff + typecnt * 6
    // the footer: newline, TZ string, newline; only the version-2 block has one
    local after: usize = total
    f.footerLen = 0
    if version >= 50 && after < n && data[after] == 10 {
        local e: usize = after + 1
        while e < n && data[e] != 10 { e = e + 1 }
        if e < n {
            f.footerOff = after + 1
            f.footerLen = e - (after + 1)
        }
    }
    f.ok = true
    return f
}

/// The transition time `i` (signed seconds since 1970-01-01 UTC).
fn transitionAt(f: *TzFile, i: usize) -> i64 {
    local p: *ui8 = &f.data[f.timesOff + i * f.timeSize]
    return beUnsigned(p, f.timeSize) as i64
}

/// A POSIX TZ string without a DST part: the standard abbreviation and the UT offset.
export struct PosixFixed {
    utoff: i64
    abbr: str
    ok: bool
}

/// The local time at the instant `t` (seconds since the Unix epoch), per the lookup rules of RFC 8536 section 3.2.
export fn tzLocalAt(f: *TzFile, t: i64) -> TzLocal {
    local r: TzLocal
    if !f.ok { return r }
    local ti: usize = 0
    if f.timeCount > 0 && t >= transitionAt(f, 0) {
        // binary search for the last transition at or before t
        local lo: usize = 0
        local hi: usize = f.timeCount - 1
        while lo < hi {
            local mid: usize = (lo + hi + 1) / 2
            if transitionAt(f, mid) <= t {
                lo = mid
            } else {
                hi = mid - 1
            }
        }
        ti = f.data[f.idxOff + lo] as usize
    }
    if ti >= f.typeCount { return r }
    // after the last transition, a footer with a fixed offset (no DST part) applies
    if f.timeCount > 0 && t >= transitionAt(f, f.timeCount - 1) {
        local fixed: PosixFixed = posixFixed(f.data, f.footerOff, f.footerLen)
        if fixed.ok {
            r.utoff = fixed.utoff
            r.isdst = false
            r.abbr = fixed.abbr
            r.ok = true
            return r
        }
    }
    local tt: *ui8 = &f.data[f.typesOff + ti * 6]
    r.utoff = ((beUnsigned(tt, 4) as ui32) as i32) as i64
    r.isdst = tt[4] != 0
    local ai: usize = tt[5] as usize
    local end: usize = ai
    while end < f.charCount && f.data[f.charsOff + end] != 0 { end = end + 1 }
    r.abbr = fromParts(&f.data[f.charsOff + ai], end - ai)
    r.ok = true
    return r
}

/// Reads the footer TZ string `data[off..off+len)` (POSIX.1 section 8.3). ok is true only when it names a standard time and no
/// daylight saving name follows the offset.
export fn posixFixed(data: *ui8, off: usize, len: usize) -> PosixFixed {
    local r: PosixFixed
    if len == 0 { return r }
    local p: usize = 0
    local name: str = fromParts(&data[off], 0)
    if data[off] == 60 {
        // <name> with characters that are not letters
        p = 1
        local s: usize = p
        while p < len && data[off + p] != 62 { p = p + 1 }
        if p >= len { return r }
        name = fromParts(&data[off + s], p - s)
        p = p + 1
    } else {
        local s: usize = 0
        while p < len && ((data[off + p] >= 65 && data[off + p] <= 90) || (data[off + p] >= 97 && data[off + p] <= 122)) { p = p + 1 }
        if p < 3 { return r }
        name = fromParts(&data[off], p)
    }
    // offset: [+-]hh[:mm[:ss]]; a positive value is west of Greenwich, so the UT offset is its negation
    local sign: i64 = -1
    if p < len && (data[off + p] == 43 || data[off + p] == 45) {
        if data[off + p] == 45 { sign = 1 }
        p = p + 1
    }
    local secs: i64 = 0
    local part: usize = 0
    while part < 3 {
        local v: i64 = 0
        local digits: usize = 0
        while p < len && data[off + p] >= 48 && data[off + p] <= 57 {
            v = v * 10 + ((data[off + p] - 48) as i64)
            digits = digits + 1
            p = p + 1
        }
        if digits == 0 || digits > 2 { return r }
        local mul: i64 = 1
        if part == 0 {
            mul = 3600
        } else if part == 1 {
            mul = 60
        }
        secs = secs + v * mul
        part = part + 1
        if part < 3 && p < len && data[off + p] == 58 {
            p = p + 1
        } else {
            break
        }
    }
    if p != len { return r }
    r.utoff = sign * secs
    r.abbr = name
    r.ok = true
    return r
}
