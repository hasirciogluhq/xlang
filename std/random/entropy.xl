// std/random/entropy: operating-system entropy. Every secret in std/random (CSPRNG key, PRNG seed, UUID bits)
// comes from here. The OS call lives in std/sys (`sysRandom`):
//   Linux:   getrandom(2), https://man7.org/linux/man-pages/man2/getrandom.2.html
//   macOS:   getentropy(2), https://developer.apple.com/library/archive/documentation/System/Conceptual/ManPages_iPhoneOS/man2/getentropy.2.html
//   Windows: BCryptGenRandom with the system-preferred RNG, https://learn.microsoft.com/windows/win32/api/bcrypt/nf-bcrypt-bcryptgenrandom
// No user-space fallback exists: when the OS refuses, the program panics instead of emitting weak bytes.
from "../sys" import sysRandom

/// Fills `out[0..n]` with OS entropy. Panics when the OS source fails; the bytes are never partial.
export fn randomBytes(out: *ui8, n: usize) {
    if !sysRandom(out, n) {
        panic("random: OS entropy source failed")
    }
}

/// One 64-bit value of OS entropy (little-endian byte order when read as bytes).
/// A uniformly random 32-bit value from OS entropy.
export fn randomU32() -> ui32 {
    local b: [ui8; 4]
    randomBytes(&b[0], 4)
    return ((b[0] as ui32) << 24) | ((b[1] as ui32) << 16) | ((b[2] as ui32) << 8) | (b[3] as ui32)
}

/// A uniformly random signed 64-bit value (every bit pattern is equally likely).
export fn randomI64() -> i64 {
    return randomU64() as i64
}

/// A uniformly random f64 in [0, 1): 53 random bits scaled by 2^-53, so every representable step is equally likely.
export fn randomF64() -> f64 {
    return (randomU64() >> 11) as f64 * (1.0 / 9007199254740992.0)
}

/// A uniformly random integer in [0, bound), without modulo bias: values below 2^64 mod bound are rejected
/// (classic rejection sampling; Lemire's multiply-shift needs a 128-bit product, which the language lacks).
/// Panics when `bound` is zero.
export fn randomBelowU64(bound: ui64) -> ui64 {
    if bound == 0 {
        panic("randomBelowU64: the bound must be positive")
    }
    local threshold: ui64 = (0 - bound) % bound
    while true {
        local x: ui64 = randomU64()
        if x >= threshold {
            return x % bound
        }
    }
    return 0
}

export fn randomU64() -> ui64 {
    local b: [ui8; 8]
    randomBytes(&b[0], 8)
    local v: ui64 = 0
    local i: usize = 0
    while i < 8 {
        v = v | ((b[i] as ui64) << ((i * 8) as ui64))
        i = i + 1
    }
    return v
}
