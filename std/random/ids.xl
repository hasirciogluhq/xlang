// std/random/ids: sortable and short identifiers. Every generator takes its time from the caller (the
// clock helpers in std/sys give seconds only), and its random bytes from OS entropy (`randomBytes`).
//
// Specifications and reference implementations:
//   ULID:     https://github.com/ulid/spec. 128 bits: 48-bit Unix milliseconds (big-endian), 80 random bits,
//             written as 26 Crockford base32 characters with 2 leading zero bits (130 bits in total).
//             Crockford alphabet: https://www.crockford.com/base32.html (no I, L, O, U).
//   cuid v1:  https://github.com/paralleldrive/cuid. "c", 8 base36 characters of milliseconds, 4 base36 characters
//             of a counter, 4 characters of a per-process fingerprint, 8 random base36 characters: 25 in total.
//   cuid v2:  https://github.com/paralleldrive/cuid2. A random lowercase letter, then base36 digits of a hash of
//             time, counter, fingerprint and random bytes. DEVIATION: the hash is SHA-256 until SHA-3 exists in
//             std/crypto (plan Q2, then SHA3-512 as the reference uses), so values differ from the reference.
//             The digits are the lowest 23 base36 digits of the 256-bit hash, not a substring of the text form.
//   nanoid:   https://github.com/ai/nanoid. Random characters from an alphabet by rejection sampling: each random
//             byte is masked to the smallest 2^k - 1 covering the alphabet, and values past the alphabet are skipped.
//   Snowflake: the Twitter layout (announced 2010, https://blog.x.com/engineering/en_us/a/2010/announcing-snowflake):
//             41 bits of milliseconds since a custom epoch, 10 bits of machine id, 12 bits of sequence, big-endian in
//             one 64-bit value with the sign bit clear.
//   KSUID:    https://github.com/segmentio/ksuid. 20 bytes: 4 bytes big-endian seconds since 2014-05-13T16:53:20Z
//             (1400000000), then 16 random bytes; written in base62 as 27 characters with '0' padding on the left,
//             alphabet 0-9, A-Z, a-z.
// Added after the first set, with specification and age (old = superseded, new = current recommendation):
//   MongoDB ObjectId: BSON specification, https://bsonspec.org/spec.html. Old (MongoDB 2009 design); still the database default.
//   XID:       https://github.com/rs/xid (README layout). Compact successor of ObjectId; not an RFC.
//   Sonyflake: https://github.com/sony/sonyflake. 10 ms resolution, long lifetime; not an RFC.
//   Instagram: https://instagram-engineering.com/sharding-ids-at-instagram-1cf5a71e5a5c (2012 design). Shard IDs.
//   TSID:      https://github.com/f4b6a3/tsid-creator. Newer 64-bit sortable ID; not an RFC.
//   Firebase push ID: Firebase realtime database documentation. Old (2012); sortable 20-character text.
// Superseded by the modern forms: cuid v1 by cuid v2; Snowflake-style 64-bit IDs by UUID v7 (RFC 9562) for
// interoperability, and by TSID or ULID for compact sortable keys. Snowflake and its variants are not standards.

from "entropy" import randomBytes
from "../crypto/hash/sha256" import sha256
from "../str/str" import fromParts
from "../encoding/hex" import hexEncode
from "../str/string" import String

// ---- shared helpers ------------------------------------------------------------------------------

define BASE36 = "0123456789abcdefghijklmnopqrstuvwxyz"
define BASE62 = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
define CROCKFORD = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
define CUID_COUNTER_MOD = 1679616            // 36^4: the counter wraps after four base36 characters

/// Writes the `bytes` low bytes of `value` big-endian at `out`.
fn putBE(out: *ui8, value: ui64, bytes: usize) {
    local i: usize = 0
    while i < bytes {
        out[i] = ((value >> (((bytes - 1 - i) * 8) as ui64)) & 0xff) as ui8
        i = i + 1
    }
}

/// Divides the big-endian number `work[0..n]` in place by `d` and returns the remainder.
/// Long division one byte at a time: remainder * 256 + byte stays below 2^32 for d <= 2^24.
fn divmodBytes(work: *ui8, n: usize, d: ui64) -> ui64 {
    local rem: ui64 = 0
    local i: usize = 0
    while i < n {
        local cur: ui64 = rem * 256 + (work[i] as ui64)
        work[i] = (cur / d) as ui8
        rem = cur % d
        i = i + 1
    }
    return rem
}

/// Writes exactly `width` digits of the big-endian number `work[0..n]` in `base`, taken from `alphabet`, left-padded
/// with the zero digit. A number with more digits keeps its lowest `width` digits. `work` is destroyed.
fn toDigits(work: *ui8, n: usize, base: ui64, alphabet: str, out: *ui8, width: usize) {
    local k: usize = 0
    while k < width {
        local rem: ui64 = divmodBytes(work, n, base)
        out[width - 1 - k] = alphabet[rem as usize]
        k = k + 1
    }
}

/// True when `work[0..n]` is zero.
fn isZeroBytes(work: *ui8, n: usize) -> bool {
    local i: usize = 0
    while i < n {
        if work[i] != 0 { return false }
        i = i + 1
    }
    return true
}

/// A uniform random index below `limit` (limit <= 256): bytes at or above the largest multiple of `limit` are
/// rejected, so every index is equally likely (no modulo bias). `buf` is a scratch buffer of 64 bytes refilled
/// by `randomBytes` as needed; `used` tracks the bytes taken from it.
fn randomBelow(limit: ui64, buf: *ui8, used: *usize) -> ui64 {
    local accept: ui64 = (256 / limit) * limit
    while true {
        if *used >= 64 {
            randomBytes(buf, 64)
            *used = 0
        }
        local b: ui64 = buf[*used] as ui64
        *used = *used + 1
        if b < accept {
            return b % limit
        }
    }
    return 0
}

// ---- ULID ----------------------------------------------------------------------------------------

/// Writes the 26-character ULID for `unixMillis` with 80 fresh random bits. Not monotonic within one
/// millisecond: use `UlidGen` when IDs made in the same millisecond must sort in order.
export fn ulid(unixMillis: ui64) -> String {
    local raw: [ui8; 16]
    putBE(&raw[0], unixMillis, 6)
    randomBytes(&raw[6], 10)
    return ulidEncode(&raw[0])
}

/// The 16 bytes at `raw` as 26 Crockford base32 characters. The first character carries the top 2 bits, which
/// are zero, so the value is 130 bits long.
fn ulidEncode(raw: *ui8) -> String {
    local text: [ui8; 26]
    local acc: ui64 = 0
    local accBits: ui64 = 2                  // the two leading zero bits
    local o: usize = 0
    local i: usize = 0
    while i < 16 {
        acc = (acc << 8) | (raw[i] as ui64)
        accBits = accBits + 8
        while accBits >= 5 {
            accBits = accBits - 5
            text[o] = CROCKFORD[((acc >> accBits) & 31) as usize]
            o = o + 1
        }
        i = i + 1
    }
    local out: String = String()
    out.append(fromParts(&text[0], 26))
    return out
}

/// Monotonic ULID source: within one millisecond the random part is incremented by one, so IDs made by one
/// generator sort in creation order even when the clock does not advance. A later millisecond starts a fresh
/// random part. Panics if the 80-bit random part would overflow inside one millisecond.
export class UlidGen {
    lastMs: ui64
    rand: [ui8; 10]

    fn init(self) {
        self.lastMs = 0
        randomBytes(&self.rand[0], 10)
    }

    fn next(self, unixMillis: ui64) -> String {
        if unixMillis != self.lastMs {
            randomBytes(&self.rand[0], 10)
            self.lastMs = unixMillis
        } else {
            local i: i32 = 9
            while i >= 0 {
                self.rand[i as usize] = self.rand[i as usize] + 1
                if self.rand[i as usize] != 0 { break }
                i = i - 1
            }
            if i < 0 {
                panic("ulid: random part overflowed inside one millisecond")
            }
        }
        local raw: [ui8; 16]
        putBE(&raw[0], unixMillis, 6)
        local k: usize = 0
        while k < 10 {
            raw[6 + k] = self.rand[k]
            k = k + 1
        }
        return ulidEncode(&raw[0])
    }
}

// ---- cuid v1 and v2 ------------------------------------------------------------------------------

/// The per-process cuid state: counter and fingerprint, set on first use.
global cuidCounter: ui64
global cuidFingerprint: [ui8; 4]
global cuidReady: bool
global cuidSeed: [ui8; 64]
global cuidUsed: usize = 64

fn cuidInit() {
    if cuidReady { return }
    cuidReady = true
    randomBytes(&cuidFingerprint[0], 4)
    cuidCounter = 0
}

/// Writes `width` base36 characters of `value` (left-padded with '0') at `out`.
fn base36Pad(value: ui64, width: usize, out: *ui8) {
    local k: usize = 0
    local v: ui64 = value
    while k < width {
        out[width - 1 - k] = BASE36[(v % 36) as usize]
        v = v / 36
        k = k + 1
    }
}

/// A cuid v1 for `unixMillis`: 25 characters, starting with 'c'. Counter and fingerprint are per process; the
/// fingerprint is 4 random base36 characters instead of the reference's host hash (no hostname without OS calls).
export fn cuidV1(unixMillis: ui64) -> String {
    cuidInit()
    local text: [ui8; 25]
    text[0] = 99                           // 'c'
    base36Pad(unixMillis, 8, &text[1])
    base36Pad(cuidCounter, 4, &text[9])
    cuidCounter = (cuidCounter + 1) % (CUID_COUNTER_MOD as ui64)
    local k: usize = 0
    while k < 4 {
        text[13 + k] = BASE36[(cuidFingerprint[k] % 36) as usize]
        k = k + 1
    }
    k = 0
    while k < 8 {
        text[17 + k] = BASE36[randomBelow(36, &cuidSeed[0], &cuidUsed) as usize]
        k = k + 1
    }
    local out: String = String()
    out.append(fromParts(&text[0], 25))
    return out
}

/// A cuid v2 of 24 characters (the reference default): a random lowercase letter, then 23 base36 digits of the
/// SHA-256 of (milliseconds, counter, fingerprint, 16 random bytes). See the file header for the deviation.
export fn cuidV2(unixMillis: ui64) -> String {
    cuidInit()
    local input: [ui8; 8 + 8 + 4 + 16]
    putBE(&input[0], unixMillis, 8)
    putBE(&input[8], cuidCounter, 8)
    cuidCounter = cuidCounter + 1
    local k: usize = 0
    while k < 4 {
        input[16 + k] = cuidFingerprint[k]
        k = k + 1
    }
    randomBytes(&input[20], 16)
    local digest: [ui8; 32]
    sha256(&input[0], 36, &digest[0])
    local text: [ui8; 24]
    text[0] = (97 + randomBelow(26, &cuidSeed[0], &cuidUsed)) as ui8
    toDigits(&digest[0], 32, 36, BASE36, &text[1], 23)
    local out: String = String()
    out.append(fromParts(&text[0], 24))
    return out
}

// ---- nanoid --------------------------------------------------------------------------------------

/// A random identifier of `size` characters drawn from `alphabet` (1 to 256 distinct bytes), by rejection
/// sampling: each random byte is masked to the smallest 2^k - 1 that covers the alphabet, and values past the
/// alphabet are skipped, so every character is equally likely. The reference default alphabet is
/// "_-0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ" with size 21.
export fn nanoid(size: usize, alphabet: str) -> String {
    if alphabet.len == 0 || alphabet.len > 256 {
        panic("nanoid: the alphabet must hold 1 to 256 bytes")
    }
    local mask: ui64 = 1
    while mask < (alphabet.len as ui64) {
        mask = mask * 2
    }
    mask = mask - 1
    local out: String = String()
    local buf: [ui8; 64]
    local used: usize = 64
    local made: usize = 0
    while made < size {
        if used >= 64 {
            randomBytes(&buf[0], 64)
            used = 0
        }
        local idx: ui64 = (buf[used] as ui64) & mask
        used = used + 1
        if idx < (alphabet.len as ui64) {
            out.push(alphabet[idx as usize])
            made = made + 1
        }
    }
    return out
}

// ---- Snowflake -----------------------------------------------------------------------------------

/// The Twitter epoch: 2010-11-04T01:42:54.657Z in milliseconds.
define SNOWFLAKE_TWITTER_EPOCH = 1288834974657

/// Snowflake ID source for one machine. IDs made by one source are strictly increasing. Panics when the
/// clock goes back, or when more than 4096 IDs are asked for in one millisecond (the caller must wait).
export class Snowflake {
    epochMs: ui64
    machine: ui64
    lastMs: ui64
    seq: ui64

    /// `machine` is 0 to 1023; `epochMs` is the custom epoch in Unix milliseconds.
    fn init(self, machine: ui64, epochMs: ui64) {
        if machine > 1023 {
            panic("snowflake: the machine id must be 0 to 1023")
        }
        self.epochMs = epochMs
        self.machine = machine
        self.lastMs = 0
        self.seq = 0
    }

    /// The next ID for the time `unixMillis` (must not be before the epoch and not before the previous call).
    fn next(self, unixMillis: ui64) -> ui64 {
        if unixMillis < self.epochMs {
            panic("snowflake: the time is before the epoch")
        }
        if unixMillis < self.lastMs {
            panic("snowflake: the clock went backwards")
        }
        if unixMillis == self.lastMs {
            self.seq = self.seq + 1
            if self.seq > 4095 {
                panic("snowflake: more than 4096 IDs in one millisecond")
            }
        } else {
            self.seq = 0
            self.lastMs = unixMillis
        }
        return ((unixMillis - self.epochMs) << 22) | (self.machine << 12) | self.seq
    }
}

// ---- KSUID ---------------------------------------------------------------------------------------

/// The KSUID epoch: 2014-05-13T16:53:20Z in Unix seconds.
define KSUID_EPOCH = 1400000000

/// A KSUID for `unixSeconds` (at or after the epoch): 27 base62 characters, left-padded with '0'.
export fn ksuid(unixSeconds: ui64) -> String {
    local raw: [ui8; 20]
    putBE(&raw[0], unixSeconds - KSUID_EPOCH, 4)
    randomBytes(&raw[4], 16)
    local text: [ui8; 27]
    toDigits(&raw[0], 20, 62, BASE62, &text[0], 27)
    local out: String = String()
    out.append(fromParts(&text[0], 27))
    return out
}

// ---- MongoDB ObjectId ----------------------------------------------------------------------------
// 12 bytes: 4-byte big-endian Unix seconds, 5 random bytes fixed per process, 3-byte big-endian counter that starts
// at a random value (MongoDB BSON specification, ObjectId: https://bsonspec.org/spec.html; MongoDB manual).
// Text: 24 lowercase hexadecimal characters. Older than cuid and ULID; it is still the database default.
export class ObjectIdGen {
    process: [ui8; 5]
    counter: ui64

    fn init(self) {
        randomBytes(&self.process[0], 5)
        local start: [ui8; 3]
        randomBytes(&start[0], 3)
        self.counter = ((start[0] as ui64) << 16) | ((start[1] as ui64) << 8) | (start[2] as ui64)
    }

    fn next(self, unixSeconds: ui64) -> String {
        local raw: [ui8; 12]
        putBE(&raw[0], unixSeconds, 4)
        local k: usize = 0
        while k < 5 {
            raw[4 + k] = self.process[k]
            k = k + 1
        }
        putBE(&raw[9], self.counter, 3)
        self.counter = (self.counter + 1) & 0xffffff
        local text: [ui8; 24]
        hexEncode(&raw[0], 12, &text[0])
        local out: String = String()
        out.append(fromParts(&text[0], 24))
        return out
    }
}

// ---- XID -----------------------------------------------------------------------------------------
// 12 bytes: 4-byte big-endian Unix seconds, 3-byte machine id, 2-byte process id, 3-byte counter (rs/xid,
// https://github.com/rs/xid; the layout follows its README). Text: 20 characters of base32hex (RFC 4648 section 7)
// in lowercase without padding. The machine and process bytes are random per process here, because no hostname
// or pid is read without OS calls; the reference uses a hash of the hostname and the real pid.
export class XidGen {
    machine: [ui8; 3]
    pid: [ui8; 2]
    counter: ui64

    fn init(self) {
        randomBytes(&self.machine[0], 3)
        randomBytes(&self.pid[0], 2)
        local start: [ui8; 3]
        randomBytes(&start[0], 3)
        self.counter = ((start[0] as ui64) << 16) | ((start[1] as ui64) << 8) | (start[2] as ui64)
    }

    fn next(self, unixSeconds: ui64) -> String {
        local raw: [ui8; 12]
        putBE(&raw[0], unixSeconds, 4)
        local k: usize = 0
        while k < 3 {
            raw[4 + k] = self.machine[k]
            k = k + 1
        }
        raw[7] = self.pid[0]
        raw[8] = self.pid[1]
        putBE(&raw[9], self.counter, 3)
        self.counter = (self.counter + 1) & 0xffffff
        local text: [ui8; 20]
        base32Bits(&raw[0], 12, 0, "0123456789abcdefghijklmnopqrstuv", &text[0])
        local out: String = String()
        out.append(fromParts(&text[0], 20))
        return out
    }
}

/// Writes the base-32 characters of the `n` bytes at `raw`, after `pad` leading zero bits, using `alphabet`.
/// A final partial group is padded with zero bits on the right. Output length: ceil((pad + 8n) / 5).
fn base32Bits(raw: *ui8, n: usize, pad: ui64, alphabet: str, out: *ui8) {
    local acc: ui64 = 0
    local accBits: ui64 = pad
    local o: usize = 0
    local i: usize = 0
    while i < n {
        acc = ((acc << 8) | (raw[i] as ui64)) & 0xffffffff
        accBits = accBits + 8
        while accBits >= 5 {
            accBits = accBits - 5
            out[o] = alphabet[((acc >> accBits) & 31) as usize]
            o = o + 1
        }
        i = i + 1
    }
    if accBits > 0 {
        out[o] = alphabet[((acc << (5 - accBits)) & 31) as usize]
    }
}

// ---- Sonyflake -----------------------------------------------------------------------------------
// 63-bit ID: 39 bits of 10 ms units since a start time, 8-bit sequence, 16-bit machine id (sony/sonyflake, README:
// https://github.com/sony/sonyflake). Sequence is per 10 ms unit. Unlike Snowflake it trades resolution for
// a longer lifetime (about 174 years).
export class Sonyflake {
    startMs: ui64
    machine: ui64
    lastTen: ui64
    seq: ui64

    /// `startMs` is the start time in Unix milliseconds; `machine` is 0 to 65535.
    fn init(self, startMs: ui64, machine: ui64) {
        if machine > 65535 {
            panic("sonyflake: the machine id must be 0 to 65535")
        }
        self.startMs = startMs
        self.machine = machine
        self.lastTen = 0
        self.seq = 0
    }

    /// The next ID for the time `unixMillis`. Panics before the start time, on a backwards clock, or when more than
    /// 256 IDs are asked for inside one 10 ms unit.
    fn next(self, unixMillis: ui64) -> ui64 {
        if unixMillis < self.startMs {
            panic("sonyflake: the time is before the start time")
        }
        local ten: ui64 = (unixMillis - self.startMs) / 10
        if ten < self.lastTen {
            panic("sonyflake: the clock went backwards")
        }
        if ten == self.lastTen {
            self.seq = self.seq + 1
            if self.seq > 255 {
                panic("sonyflake: more than 256 IDs in one 10 ms unit")
            }
        } else {
            self.seq = 0
            self.lastTen = ten
        }
        return (ten << 24) | (self.seq << 16) | self.machine
    }
}

// ---- Instagram ----------------------------------------------------------------------------------
// 64-bit ID: 41 bits of milliseconds since an epoch, 13-bit shard id, 10-bit sequence (Instagram engineering
// blog, "Sharding & IDs", 2012: https://instagram-engineering.com/sharding-ids-at-instagram-1cf5a71e5a5c).
// The epoch is caller-provided. Each shard keeps its own sequence per millisecond.
export class InstagramIdGen {
    epochMs: ui64
    shard: ui64
    lastMs: ui64
    seq: ui64

    fn init(self, epochMs: ui64, shard: ui64) {
        if shard > 8191 {
            panic("instagram: the shard id must be 0 to 8191")
        }
        self.epochMs = epochMs
        self.shard = shard
        self.lastMs = 0
        self.seq = 0
    }

    fn next(self, unixMillis: ui64) -> ui64 {
        if unixMillis < self.epochMs {
            panic("instagram: the time is before the epoch")
        }
        if unixMillis < self.lastMs {
            panic("instagram: the clock went backwards")
        }
        if unixMillis == self.lastMs {
            self.seq = self.seq + 1
            if self.seq > 1023 {
                panic("instagram: more than 1024 IDs in one millisecond")
            }
        } else {
            self.seq = 0
            self.lastMs = unixMillis
        }
        return ((unixMillis - self.epochMs) << 23) | (self.shard << 10) | self.seq
    }
}

// ---- TSID ----------------------------------------------------------------------------------------
// 64-bit ID: 42 bits of milliseconds since 2020-01-01T00:00:00Z, 22 random bits (tsid-creator, format described at
// https://github.com/f4b6a3/tsid-creator). Sortable by creation time, and no coordination is needed.
define TSID_EPOCH_MS = 1577836800000

export fn tsid(unixMillis: ui64) -> ui64 {
    local r: [ui8; 3]
    randomBytes(&r[0], 3)
    local rnd: ui64 = (((r[0] as ui64) << 16) | ((r[1] as ui64) << 8) | (r[2] as ui64)) & 0x3fffff
    return (((unixMillis - TSID_EPOCH_MS) & 0x3ffffffffff) << 22) | rnd
}

// ---- Firebase push ID -----------------------------------------------------------------------------
// 20 characters: 8 characters of 48-bit milliseconds (most significant first), then 12 random characters
// (Firebase realtime database push IDs; the alphabet is ASCII-ordered: "-", 0-9, A-Z, "_", a-z). Within one
// millisecond the random part is incremented, so IDs from one generator sort in creation order.
define PUSHID_ALPHABET = "-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz"

export class PushIdGen {
    lastMs: ui64
    digits: [ui8; 12]

    fn init(self) {
        self.lastMs = 0
        local r: [ui8; 12]
        randomBytes(&r[0], 12)
        local k: usize = 0
        while k < 12 {
            self.digits[k] = r[k] & 63
            k = k + 1
        }
    }

    fn next(self, unixMillis: ui64) -> String {
        if unixMillis != self.lastMs {
            self.lastMs = unixMillis
            local r: [ui8; 12]
            randomBytes(&r[0], 12)
            local k: usize = 0
            while k < 12 {
                self.digits[k] = r[k] & 63
                k = k + 1
            }
        } else {
            local i: i32 = 11
            while i >= 0 {
                self.digits[i as usize] = self.digits[i as usize] + 1
                if self.digits[i as usize] < 64 { break }
                self.digits[i as usize] = 0
                i = i - 1
            }
            if i < 0 {
                panic("pushid: random part overflowed inside one millisecond")
            }
        }
        local text: [ui8; 20]
        local t: ui64 = unixMillis
        local k: usize = 0
        while k < 8 {
            text[7 - k] = PUSHID_ALPHABET[(t & 63) as usize]
            t = t >> 6
            k = k + 1
        }
        k = 0
        while k < 12 {
            text[8 + k] = PUSHID_ALPHABET[self.digits[k] as usize]
            k = k + 1
        }
        local out: String = String()
        out.append(fromParts(&text[0], 20))
        return out
    }
}
