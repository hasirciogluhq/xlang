export fn println<A, B, C>(fmt: str, a: A, b: B, c: C) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtEmit3(&sink, fmt, a, b, c)
    sink.write("\n")
}

export fn println<A, B, C, D>(fmt: str, a: A, b: B, c: C, d: D) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtEmit4(&sink, fmt, a, b, c, d)
    sink.write("\n")
}

export fn println<A, B, C, D, E>(fmt: str, a: A, b: B, c: C, d: D, e: E) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtEmit5(&sink, fmt, a, b, c, d, e)
    sink.write("\n")
}

export fn println<A, B, C, D, E, F>(fmt: str, a: A, b: B, c: C, d: D, e: E, f: F) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtEmit6(&sink, fmt, a, b, c, d, e, f)
    sink.write("\n")
}

/// Writes only "\n"; the same as `print("\n")`.
export fn printEndl() {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    sink.write("\n")
}

