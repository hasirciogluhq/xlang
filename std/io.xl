// std/io: output on top of the raw write syscall; none of it is built into the compiler.
// `print` writes without a newline: a program writes "\n" itself. `format` and `fmtAppend` build
// the text in a String; `print` builds it and writes it to stdout.
from "sys" import sysWrite
from "str" import strFromC, strFromParts
from "string" import String

// ---- text of values (not exported) ----------------------------------------------------------

fn writeBytes(fd: i32, s: str) {
    if s.len > 0 {
        sysWrite(fd, s.ptr, s.len)
    }
}

fn appendUInt(s: *String, v: ui64) {
    local buf: [ui8; 24]
    local i: usize = 24
    local n: ui64 = v
    if n == 0 {
        s.push(48)
        return
    }
    while n > 0 {
        i = i - 1
        buf[i] = ((n % 10) as ui8) + 48
        n = n / 10
    }
    s.append(strFromParts(&buf[i], 24 - i))
}

fn appendInt(s: *String, v: i64) {
    if v < 0 {
        s.push(45)
        appendUInt(s, (0 - v) as ui64)
        return
    }
    appendUInt(s, v as ui64)
}

/// Six decimals, rounded half up.
fn appendFloat(s: *String, v: f64) {
    local x: f64 = v
    if x < 0.0 {
        s.push(45)
        x = 0.0 - x
    }
    local whole: ui64 = x as ui64
    local scaled: ui64 = ((x - (whole as f64)) * 1000000.0 + 0.5) as ui64
    if scaled >= 1000000 {
        whole = whole + 1
        scaled = scaled - 1000000
    }
    appendUInt(s, whole)
    s.push(46)
    local digits: [ui8; 6]
    local k: usize = 6
    while k > 0 {
        k = k - 1
        digits[k] = ((scaled % 10) as ui8) + 48
        scaled = scaled / 10
    }
    s.append(strFromParts(&digits[0], 6))
}

/// The text for one `{}`: the same types as the plain `print` overloads.
fn fmtWrite(out: *String, s: str) {
    out.append(s)
}

fn fmtWrite(out: *String, p: *ui8) {
    out.append(strFromC(p))
}

fn fmtWrite(out: *String, v: i64) {
    appendInt(out, v)
}

fn fmtWrite(out: *String, v: ui64) {
    appendUInt(out, v)
}

fn fmtWrite(out: *String, v: f64) {
    appendFloat(out, v)
}

fn fmtWrite(out: *String, b: bool) {
    if b {
        out.append("true")
    } else {
        out.append("false")
    }
}

fn fmtWrite(out: *String, s: *String) {
    out.append(s.asStr())
}

/// Number of `{}` placeholders (`{{` and `}}` are escapes and do not count).
fn placeholders(text: str) -> usize {
    local n: usize = 0
    local i: usize = 0
    while i + 1 < text.len {
        if (text[i] == 123 && text[i + 1] == 123) || (text[i] == 125 && text[i + 1] == 125) {
            i = i + 2
        } else if text[i] == 123 && text[i + 1] == 125 {
            n = n + 1
            i = i + 2
        } else {
            i = i + 1
        }
    }
    return n
}

/// A format being appended: `at` is the next byte of `text` not yet written.
class Format {
    out: *String
    text: str
    at: usize

    fn init(self, out: *String, text: str) {
        self.out = out
        self.text = text
        self.at = 0
    }

    /// Checks that the format has exactly `arity` placeholders; panics otherwise.
    fn check(self, arity: usize) {
        local n: usize = placeholders(self.text)
        if n != arity {
            local msg: String = String("format: ")
            appendUInt(&msg, n as ui64)
            msg.append(" placeholders, got ")
            appendUInt(&msg, arity as ui64)
            msg.append(" arguments")
            panic(msg.cstr())
        }
    }

    /// Appends the text up to the next placeholder (or the end); `{{` and `}}` append one brace.
    fn literal(self) {
        while self.at < self.text.len {
            local c: ui8 = self.text[self.at]
            local next: ui8 = 0
            if self.at + 1 < self.text.len {
                next = self.text[self.at + 1]
            }
            if c == 123 && next == 125 {
                return
            }
            if (c == 123 || c == 125) && next == c {
                self.out.push(c)
                self.at = self.at + 2
            } else {
                self.out.push(c)
                self.at = self.at + 1
            }
        }
    }

    fn finish(self) {
        self.literal()
    }
}

/// Appends the literal text, then the argument for the placeholder that follows it.
fn formatArg<A>(f: *Format, v: A) {
    f.literal()
    f.at = f.at + 2
    fmtWrite(f.out, v)
}

// ---- formatting -----------------------------------------------------------------------------

/// Appends `fmt` to `out`; each `{}` takes the next argument and `{{` and `}}` are braces.
export fn fmtAppend<A>(out: *String, fmt: str, a: A) {
    local f: Format = Format(out, fmt)
    f.check(1)
    formatArg(&f, a)
    f.finish()
}

export fn fmtAppend<A, B>(out: *String, fmt: str, a: A, b: B) {
    local f: Format = Format(out, fmt)
    f.check(2)
    formatArg(&f, a)
    formatArg(&f, b)
    f.finish()
}

export fn fmtAppend<A, B, C>(out: *String, fmt: str, a: A, b: B, c: C) {
    local f: Format = Format(out, fmt)
    f.check(3)
    formatArg(&f, a)
    formatArg(&f, b)
    formatArg(&f, c)
    f.finish()
}

export fn fmtAppend<A, B, C, D>(out: *String, fmt: str, a: A, b: B, c: C, d: D) {
    local f: Format = Format(out, fmt)
    f.check(4)
    formatArg(&f, a)
    formatArg(&f, b)
    formatArg(&f, c)
    formatArg(&f, d)
    f.finish()
}

export fn fmtAppend<A, B, C, D, E>(out: *String, fmt: str, a: A, b: B, c: C, d: D, e: E) {
    local f: Format = Format(out, fmt)
    f.check(5)
    formatArg(&f, a)
    formatArg(&f, b)
    formatArg(&f, c)
    formatArg(&f, d)
    formatArg(&f, e)
    f.finish()
}

export fn fmtAppend<A, B, C, D, E, F>(out: *String, fmt: str, a: A, b: B, c: C, d: D, e: E, f: F) {
    local w: Format = Format(out, fmt)
    w.check(6)
    formatArg(&w, a)
    formatArg(&w, b)
    formatArg(&w, c)
    formatArg(&w, d)
    formatArg(&w, e)
    formatArg(&w, f)
    w.finish()
}

/// A new String holding `fmt` with its placeholders replaced, as `fmtAppend` does.
export fn format<A>(fmt: str, a: A) -> String {
    local out: String = String()
    fmtAppend(&out, fmt, a)
    return out
}

export fn format<A, B>(fmt: str, a: A, b: B) -> String {
    local out: String = String()
    fmtAppend(&out, fmt, a, b)
    return out
}

export fn format<A, B, C>(fmt: str, a: A, b: B, c: C) -> String {
    local out: String = String()
    fmtAppend(&out, fmt, a, b, c)
    return out
}

export fn format<A, B, C, D>(fmt: str, a: A, b: B, c: C, d: D) -> String {
    local out: String = String()
    fmtAppend(&out, fmt, a, b, c, d)
    return out
}

export fn format<A, B, C, D, E>(fmt: str, a: A, b: B, c: C, d: D, e: E) -> String {
    local out: String = String()
    fmtAppend(&out, fmt, a, b, c, d, e)
    return out
}

export fn format<A, B, C, D, E, F>(fmt: str, a: A, b: B, c: C, d: D, e: E, f: F) -> String {
    local out: String = String()
    fmtAppend(&out, fmt, a, b, c, d, e, f)
    return out
}

// ---- output ---------------------------------------------------------------------------------

export fn print(s: str) {
    writeBytes(1, s)
}

export fn print(p: *ui8) {
    writeBytes(1, strFromC(p))
}

export fn print(v: i64) {
    local out: String = String()
    fmtWrite(&out, v)
    writeBytes(1, out.asStr())
}

export fn print(v: ui64) {
    local out: String = String()
    fmtWrite(&out, v)
    writeBytes(1, out.asStr())
}

export fn print(v: f64) {
    local out: String = String()
    fmtWrite(&out, v)
    writeBytes(1, out.asStr())
}

export fn print(b: bool) {
    local out: String = String()
    fmtWrite(&out, b)
    writeBytes(1, out.asStr())
}

export fn print(s: *String) {
    writeBytes(1, s.asStr())
}

/// `print("x = {}, y = {}", x, y)`: `{}` takes the next argument, `{{` and `}}` are braces.
export fn print<A>(fmt: str, a: A) {
    local out: String = format(fmt, a)
    writeBytes(1, out.asStr())
}

export fn print<A, B>(fmt: str, a: A, b: B) {
    local out: String = format(fmt, a, b)
    writeBytes(1, out.asStr())
}

export fn print<A, B, C>(fmt: str, a: A, b: B, c: C) {
    local out: String = format(fmt, a, b, c)
    writeBytes(1, out.asStr())
}

export fn print<A, B, C, D>(fmt: str, a: A, b: B, c: C, d: D) {
    local out: String = format(fmt, a, b, c, d)
    writeBytes(1, out.asStr())
}

export fn print<A, B, C, D, E>(fmt: str, a: A, b: B, c: C, d: D, e: E) {
    local out: String = format(fmt, a, b, c, d, e)
    writeBytes(1, out.asStr())
}

export fn print<A, B, C, D, E, F>(fmt: str, a: A, b: B, c: C, d: D, e: E, f: F) {
    local out: String = format(fmt, a, b, c, d, e, f)
    writeBytes(1, out.asStr())
}

export fn eprint(s: str) {
    writeBytes(2, s)
}
