// std/io: the print family. Every function writes straight to its fd through an FmtSink and makes
// no allocator calls. `print` writes without a newline, `println` adds one "\n" after the text, and
// `printEndl()` writes only "\n". The text rules (`{}`, `{{`, `}}`) live in std/fmt.
from "fmt" import FmtSink, FmtFd, fmtWrite, fmtEmit1, fmtEmit2, fmtEmit3, fmtEmit4, fmtEmit5, fmtEmit6
from "string" import String

// ---- stdout ---------------------------------------------------------------------------------

export fn print(s: str) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtWrite(&sink, s)
}

export fn print(p: *ui8) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtWrite(&sink, p)
}

export fn print(v: i64) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtWrite(&sink, v)
}

export fn print(v: ui64) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtWrite(&sink, v)
}

export fn print(v: f64) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtWrite(&sink, v)
}

export fn print(b: bool) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtWrite(&sink, b)
}

export fn print(s: *String) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtWrite(&sink, s)
}

/// `print("x = {}, y = {}", x, y)`: `{}` takes the next argument, `{{` and `}}` are braces.
export fn print<A>(fmt: str, a: A) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtEmit1(&sink, fmt, a)
}

export fn print<A, B>(fmt: str, a: A, b: B) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtEmit2(&sink, fmt, a, b)
}

export fn print<A, B, C>(fmt: str, a: A, b: B, c: C) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtEmit3(&sink, fmt, a, b, c)
}

export fn print<A, B, C, D>(fmt: str, a: A, b: B, c: C, d: D) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtEmit4(&sink, fmt, a, b, c, d)
}

export fn print<A, B, C, D, E>(fmt: str, a: A, b: B, c: C, d: D, e: E) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtEmit5(&sink, fmt, a, b, c, d, e)
}

export fn print<A, B, C, D, E, F>(fmt: str, a: A, b: B, c: C, d: D, e: E, f: F) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtEmit6(&sink, fmt, a, b, c, d, e, f)
}

export fn println(s: str) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtWrite(&sink, s)
    sink.write("\n")
}

export fn println(p: *ui8) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtWrite(&sink, p)
    sink.write("\n")
}

export fn println(v: i64) {
    local sink: FmtSink = FmtSink(FmtFd, 1, nil, 0, nil)
    fmtWrite(&sink, v)
    sink.write("\n")
}

