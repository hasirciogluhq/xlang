    fmtWrite(&sink, s)
}

export fn fprint(fd: i32, p: *ui8) {
    local sink: FmtSink = FmtSink(FmtFd, fd, nil, 0, nil)
    fmtWrite(&sink, p)
}

export fn fprint(fd: i32, v: i64) {
