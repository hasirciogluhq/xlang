// std/io: output on top of the raw write syscall; none of it is built into the compiler.
// `print` writes without a newline: a program writes "\n" itself.
from "sys" import sysWrite
from "str" import strFromC, strFromParts
from "string" import String

// ---- writing (not exported) -----------------------------------------------------------------

fn writeBytes(fd: i32, s: str) {
    if s.len > 0 {
        sysWrite(fd, s.ptr, s.len)
    }
}

fn writeUInt(fd: i32, v: ui64) {
    local buf: [ui8; 24]
    local i: usize = 24
    local n: ui64 = v
    if n == 0 {
        writeBytes(fd, "0")
        return
    }
    while n > 0 {
        i = i - 1
        buf[i] = ((n % 10) as ui8) + 48
        n = n / 10
    }
    writeBytes(fd, strFromParts(&buf[i], 24 - i))
}

fn writeInt(fd: i32, v: i64) {
    if v < 0 {
        writeBytes(fd, "-")
        writeUInt(fd, (0 - v) as ui64)
        return
    }
    writeUInt(fd, v as ui64)
}

/// Six decimals, rounded half up.
fn writeFloat(fd: i32, v: f64) {
    local x: f64 = v
    if x < 0.0 {
        writeBytes(fd, "-")
        x = 0.0 - x
    }
    local whole: ui64 = x as ui64
    local scaled: ui64 = ((x - (whole as f64)) * 1000000.0 + 0.5) as ui64
    if scaled >= 1000000 {
        whole = whole + 1
        scaled = scaled - 1000000
    }
    writeUInt(fd, whole)
    writeBytes(fd, ".")
    local digits: [ui8; 6]
    local k: usize = 6
    while k > 0 {
        k = k - 1
        digits[k] = ((scaled % 10) as ui8) + 48
        scaled = scaled / 10
    }
    writeBytes(fd, strFromParts(&digits[0], 6))
}

/// The value written for one `{}`: the same types as the plain `print` overloads.
fn fmtWrite(fd: i32, s: str) {
    writeBytes(fd, s)
}

fn fmtWrite(fd: i32, p: *ui8) {
    writeBytes(fd, strFromC(p))
}

fn fmtWrite(fd: i32, v: i64) {
    writeInt(fd, v)
}

fn fmtWrite(fd: i32, v: ui64) {
    writeUInt(fd, v)
}

fn fmtWrite(fd: i32, v: f64) {
    writeFloat(fd, v)
}

fn fmtWrite(fd: i32, b: bool) {
    if b {
        writeBytes(fd, "true")
    } else {
        writeBytes(fd, "false")
    }
}

fn fmtWrite(fd: i32, s: *String) {
    writeBytes(fd, s.asStr())
}

/// Number of `{}` placeholders (`{{` and `}}` are escapes and do not count).
fn placeholders(text: str) -> usize {
    local n: usize = 0
    local i: usize = 0
    while i + 1 < text.len {
        if (text[i] == 123 && text[i + 1] == 123) || (text[i] == 125 && text[i + 1] == 125) {
            i = i + 2
        } else if text[i] == 123 && text[i + 1] == 125 {
            n = n + 1
            i = i + 2
        } else {
            i = i + 1
        }
    }
    return n
}

/// A format being written: `at` is the next byte of `text` not yet written.
class Format {
    fd: i32
    text: str
    at: usize

    fn init(self, fd: i32, text: str) {
        self.fd = fd
        self.text = text
        self.at = 0
    }

    /// Checks that the format has exactly `arity` placeholders; panics otherwise.
    fn check(self, arity: usize) {
        local n: usize = placeholders(self.text)
        if n != arity {
            local msg: String = String("print: format has ")
            appendUInt(&msg, n)
            msg.append(" placeholders, got ")
            appendUInt(&msg, arity)
            msg.append(" arguments")
            panic(msg.cstr())
        }
    }

    /// Writes the text up to the next placeholder (or the end); `{{` and `}}` print one brace.
    fn literal(self) {
        while self.at < self.text.len {
            local c: ui8 = self.text[self.at]
            local next: ui8 = 0
            if self.at + 1 < self.text.len {
                next = self.text[self.at + 1]
            }
            if c == 123 && next == 125 {
                return
            }
            if (c == 123 || c == 125) && next == c {
                writeBytes(self.fd, strFromParts(&self.text.ptr[self.at], 1))
                self.at = self.at + 2
            } else {
                writeBytes(self.fd, strFromParts(&self.text.ptr[self.at], 1))
                self.at = self.at + 1
            }
        }
    }

    fn finish(self) {
        self.literal()
    }
}

fn appendUInt(s: *String, v: usize) {
    local buf: [ui8; 24]
    local i: usize = 24
    local n: usize = v
    if n == 0 {
        s.push(48)
        return
    }
    while n > 0 {
        i = i - 1
        buf[i] = ((n % 10) as ui8) + 48
        n = n / 10
    }
    s.append(strFromParts(&buf[i], 24 - i))
}

/// Writes the literal text, then the argument for the placeholder that follows it.
fn formatArg<A>(f: *Format, v: A) {
    f.literal()
    f.at = f.at + 2
    fmtWrite(f.fd, v)
}

// ---- output ---------------------------------------------------------------------------------

export fn print(s: str) {
    writeBytes(1, s)
}

export fn print(p: *ui8) {
    writeBytes(1, strFromC(p))
}

export fn print(v: i64) {
    writeInt(1, v)
}

export fn print(v: ui64) {
    writeUInt(1, v)
}

export fn print(v: f64) {
    writeFloat(1, v)
}

export fn print(b: bool) {
    fmtWrite(1, b)
}

export fn print(s: *String) {
    writeBytes(1, s.asStr())
}

/// `print("x = {}, y = {}", x, y)`: `{}` takes the next argument, `{{` and `}}` are braces.
export fn print<A>(fmt: str, a: A) {
    local f: Format = Format(1, fmt)
    f.check(1)
    formatArg(&f, a)
    f.finish()
}

export fn print<A, B>(fmt: str, a: A, b: B) {
    local f: Format = Format(1, fmt)
    f.check(2)
    formatArg(&f, a)
    formatArg(&f, b)
    f.finish()
}

export fn print<A, B, C>(fmt: str, a: A, b: B, c: C) {
    local f: Format = Format(1, fmt)
    f.check(3)
    formatArg(&f, a)
    formatArg(&f, b)
    formatArg(&f, c)
    f.finish()
}

export fn print<A, B, C, D>(fmt: str, a: A, b: B, c: C, d: D) {
    local f: Format = Format(1, fmt)
    f.check(4)
    formatArg(&f, a)
    formatArg(&f, b)
    formatArg(&f, c)
    formatArg(&f, d)
    f.finish()
}

export fn print<A, B, C, D, E>(fmt: str, a: A, b: B, c: C, d: D, e: E) {
    local f: Format = Format(1, fmt)
    f.check(5)
    formatArg(&f, a)
    formatArg(&f, b)
    formatArg(&f, c)
    formatArg(&f, d)
    formatArg(&f, e)
    f.finish()
}

export fn print<A, B, C, D, E, F>(fmt: str, a: A, b: B, c: C, d: D, e: E, f: F) {
    local w: Format = Format(1, fmt)
    w.check(6)
    formatArg(&w, a)
    formatArg(&w, b)
    formatArg(&w, c)
    formatArg(&w, d)
    formatArg(&w, e)
    formatArg(&w, f)
    w.finish()
}

export fn eprint(s: str) {
    writeBytes(2, s)
}
