// std/net/proto/dhcp: DHCP for IPv4 (RFC 2131, https://www.rfc-editor.org/rfc/rfc2131) and its options (RFC 2132). A message is the
// 236-byte BOOTP header (section 2: op, htype, hlen, hops, xid, secs, flags, ciaddr, yiaddr, siaddr, giaddr, chaddr 16, sname 64,
// file 128), the magic cookie 99.130.83.99 (section 3), and options as code, length, value (RFC 2132 section 2); option 255 ends the
// list and option 0 is padding. The client sends DHCPDISCOVER (option 53 = 1) with a broadcast flag (0x8000) and reads the server's
// DHCPOFFER (2) or DHCPACK (5). Not implemented: DHCPREQUEST, lease renewal, the state machine and sending over UDP port 67/68 (a raw
// broadcast needs privileges; see docs/std/protocols.md).

define DHCP_COOKIE = 1669525603

/// Writes a DHCPDISCOVER for the 6-byte hardware address `mac` and transaction ID `xid` into `out` (capacity 300); returns its length.
export fn dhcpDiscover(mac: *ui8, xid: ui32, out: *ui8) -> usize {
    local i: usize = 0
    while i < 300 {
        out[i] = 0
        i = i + 1
    }
    out[0] = 1
    out[1] = 1
    out[2] = 6
    out[3] = 0
    out[4] = ((xid >> 24) & 0xff) as ui8
    out[5] = ((xid >> 16) & 0xff) as ui8
    out[6] = ((xid >> 8) & 0xff) as ui8
    out[7] = (xid & 0xff) as ui8
    out[10] = 0x80
    i = 0
    while i < 6 {
        out[28 + i] = mac[i]
        i = i + 1
    }
    out[236] = 99
    out[237] = 130
    out[238] = 83
    out[239] = 99
    local o: usize = 240
    out[o] = 53
    out[o + 1] = 1
    out[o + 2] = 1
    o = o + 3
    out[o] = 55
    out[o + 1] = 6
    out[o + 2] = 1
    out[o + 3] = 3
    out[o + 4] = 6
    out[o + 5] = 15
    out[o + 6] = 51
    out[o + 7] = 54
    o = o + 8
    out[o] = 255
    return o + 1
}

/// The fields of a DHCPOFFER or DHCPACK the client needs.
export struct DhcpReply {
    kind: ui8
    xid: ui32
    yourAddr: ui32
    serverId: ui32
    subnetMask: ui32
    router: ui32
    leaseSeconds: ui32
    ok: bool
}

fn be32(p: *ui8) -> ui32 {
    return ((p[0] as ui32) << 24) | ((p[1] as ui32) << 16) | ((p[2] as ui32) << 8) | (p[3] as ui32)
}

/// Reads an offer or acknowledgement (BOOTREPLY, op 2) from `buf[0..n)`.
export fn dhcpParseReply(buf: *ui8, n: usize) -> DhcpReply {
    local r: DhcpReply
    if n < 241 || buf[0] != 2 { return r }
    if buf[236] != 99 || buf[237] != 130 || buf[238] != 83 || buf[239] != 99 { return r }
    r.xid = be32(&buf[4])
    r.yourAddr = be32(&buf[16])
    local o: usize = 240
    while o < n {
        local code: ui8 = buf[o]
        if code == 255 { break }
        if code == 0 {
            o = o + 1
        } else {
            if o + 1 >= n { return r }
            local len: usize = buf[o + 1] as usize
            if o + 2 + len > n { return r }
            local v: usize = o + 2
            if code == 53 && len >= 1 {
                r.kind = buf[v]
            } else if code == 54 && len >= 4 {
                r.serverId = be32(&buf[v])
            } else if code == 1 && len >= 4 {
                r.subnetMask = be32(&buf[v])
            } else if code == 3 && len >= 4 {
                r.router = be32(&buf[v])
            } else if code == 51 && len >= 4 {
                r.leaseSeconds = be32(&buf[v])
            }
            o = v + len
        }
    }
    r.ok = r.kind == 2 || r.kind == 5
    return r
}
