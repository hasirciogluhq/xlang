// std/net/proto/transport: IPv6 header (RFC 8200, https://www.rfc-editor.org/rfc/rfc8200, section 3), UDP (RFC 768,
// https://www.rfc-editor.org/rfc/rfc768), TCP header without options (RFC 9293, https://www.rfc-editor.org/rfc/rfc9293, section 3.1),
// ICMPv6 echo (RFC 4443, https://www.rfc-editor.org/rfc/rfc4443, sections 2.3 and 4.1), and the ARP request of RFC 826
// (https://www.rfc-editor.org/rfc/rfc826). The UDP and TCP checksums cover a pseudo-header: for IPv4 the source and destination
// addresses, a zero byte, the protocol and the segment length (RFC 768 and RFC 9293 section 3.1); for IPv6 the addresses, the
// 32-bit length, three zero bytes and the next header value (RFC 8200 section 8.1). The Internet checksum is the one of
// std/net/proto/ip (RFC 1071). A UDP checksum of zero is sent as 0xffff (RFC 768). The functions write bytes; they open no socket.

from "ip" import inetChecksum
from "../../mem/mem" import currentAllocator

/// The Internet checksum of a pseudo-header followed by a segment. `pseudo` holds the pseudo-header bytes (`pn` of them), and
/// `seg` the segment (`sn` bytes, its checksum field already zero).
fn checksumWith(pseudo: *ui8, pn: usize, seg: *ui8, sn: usize) -> ui16 {
    local buf: *ui8 = currentAllocator.alloc(pn + sn, 1) as *ui8
    if buf == nil { panic("transport: out of memory") }
    local i: usize = 0
    while i < pn {
        buf[i] = pseudo[i]
        i = i + 1
    }
    i = 0
    while i < sn {
        buf[pn + i] = seg[i]
        i = i + 1
    }
    local c: ui16 = inetChecksum(buf, pn + sn)
    currentAllocator.free(buf as *void)
    return c
}

fn putBe16(out: *ui8, at: usize, v: ui16) {
    out[at] = (v >> 8) as ui8
    out[at + 1] = (v & 0xff) as ui8
}

/// The IPv4 pseudo-header of RFC 768 and RFC 9293 (12 bytes).
fn pseudo4(src: *ui8, dst: *ui8, proto: ui8, len: usize, out: *ui8) {
    local i: usize = 0
    while i < 4 {
        out[i] = src[i]
        out[4 + i] = dst[i]
        i = i + 1
    }
    out[8] = 0
    out[9] = proto
    putBe16(out, 10, len as ui16)
}

/// A 40-byte IPv6 header (RFC 8200 section 3) with the given next header, payload length and hop limit. Returns 40.
export fn ipv6Header(src: *ui8, dst: *ui8, nextHeader: ui8, payloadLen: ui16, hopLimit: ui8, out: *ui8) -> usize {
    // version 6, traffic class 0, flow label 0
    out[0] = 0x60
    out[1] = 0
    out[2] = 0
    out[3] = 0
    putBe16(out, 4, payloadLen)
    out[6] = nextHeader
    out[7] = hopLimit
    local i: usize = 0
    while i < 16 {
        out[8 + i] = src[i]
        out[24 + i] = dst[i]
        i = i + 1
    }
    return 40
}

/// A UDP datagram (RFC 768) over IPv4 addresses `src4` and `dst4`: the 8-byte header then `n` payload bytes. Returns the length.
export fn udpBuild4(src4: *ui8, dst4: *ui8, sport: ui16, dport: ui16, payload: *ui8, n: usize, out: *ui8) -> usize {
    local len: usize = 8 + n
    putBe16(out, 0, sport)
    putBe16(out, 2, dport)
    putBe16(out, 4, len as ui16)
    putBe16(out, 6, 0)
    local i: usize = 0
    while i < n {
        out[8 + i] = payload[i]
        i = i + 1
    }
    local ph: [ui8; 12]
    pseudo4(src4, dst4, 17, len, &ph[0])
    local c: ui16 = checksumWith(&ph[0], 12, out, len)
    if c == 0 { c = 0xffff }
    putBe16(out, 6, c)
    return len
}

/// A TCP segment header without options (RFC 9293 section 3.1, 20 bytes) over IPv4, with the flags of section 3.1 (FIN 0x01,
/// SYN 0x02, RST 0x04, PSH 0x08, ACK 0x10) and then `n` payload bytes. Returns the length.
export fn tcpBuild4(src4: *ui8, dst4: *ui8, sport: ui16, dport: ui16, seq: ui32, ack: ui32, flags: ui8, window: ui16, payload: *ui8, n: usize, out: *ui8) -> usize {
    local len: usize = 20 + n
    putBe16(out, 0, sport)
    putBe16(out, 2, dport)
    out[4] = (seq >> 24) as ui8
    out[5] = ((seq >> 16) & 0xff) as ui8
    out[6] = ((seq >> 8) & 0xff) as ui8
    out[7] = (seq & 0xff) as ui8
    out[8] = (ack >> 24) as ui8
    out[9] = ((ack >> 16) & 0xff) as ui8
    out[10] = ((ack >> 8) & 0xff) as ui8
    out[11] = (ack & 0xff) as ui8
    // data offset 5 (no options) in the high nibble of byte 12
    out[12] = 0x50
    out[13] = flags
    putBe16(out, 14, window)
    putBe16(out, 16, 0)
    putBe16(out, 18, 0)
    local i: usize = 0
    while i < n {
        out[20 + i] = payload[i]
        i = i + 1
    }
    local ph: [ui8; 12]
    pseudo4(src4, dst4, 6, len, &ph[0])
    putBe16(out, 16, checksumWith(&ph[0], 12, out, len))
    return len
}

/// An ICMPv6 echo request (type 128) or reply (type 129) with identifier, sequence and `n` data bytes (RFC 4443 section 4.1). The
/// checksum covers the IPv6 pseudo-header (RFC 8200 section 8.1) with next header 58. Returns the length, 8 + n.
export fn icmpv6Echo(src: *ui8, dst: *ui8, reply: bool, id: ui16, seq: ui16, payload: *ui8, n: usize, out: *ui8) -> usize {
    local len: usize = 8 + n
    if reply { out[0] = 129 } else { out[0] = 128 }
    out[1] = 0
    putBe16(out, 2, 0)
    putBe16(out, 4, id)
    putBe16(out, 6, seq)
    local i: usize = 0
    while i < n {
        out[8 + i] = payload[i]
        i = i + 1
    }
    // pseudo-header: source (16), destination (16), length (32), zeros (3), next header (1)
    local ph: [ui8; 40]
    i = 0
    while i < 16 {
        ph[i] = src[i]
        ph[16 + i] = dst[i]
        i = i + 1
    }
    ph[32] = 0
    ph[33] = 0
    ph[34] = ((len >> 8) & 0xff) as ui8
    ph[35] = (len & 0xff) as ui8
    ph[36] = 0
    ph[37] = 0
    ph[38] = 0
    ph[39] = 58
    putBe16(out, 2, checksumWith(&ph[0], 40, out, len))
    return len
}

/// An ARP request for `targetIp` from `senderMac` and `senderIp` (RFC 826, section 3, Ethernet and IPv4): 28 bytes, with the
/// target hardware address zero. Returns 28.
export fn arpRequest(senderMac: *ui8, senderIp: *ui8, targetIp: *ui8, out: *ui8) -> usize {
    putBe16(out, 0, 1)
    putBe16(out, 2, 0x0800)
    out[4] = 6
    out[5] = 4
    putBe16(out, 6, 1)
    local i: usize = 0
    while i < 6 {
        out[8 + i] = senderMac[i]
        out[18 + i] = 0
        i = i + 1
    }
    i = 0
    while i < 4 {
        out[14 + i] = senderIp[i]
        out[24 + i] = targetIp[i]
        i = i + 1
    }
    return 28
}
