// std/net/proto/ip: IPv4 and ICMP wire format helpers. The Internet checksum is the one's complement sum of 16-bit big-endian
// words, complemented (RFC 1071, https://www.rfc-editor.org/rfc/rfc1071, section 4.1): add the words with end-around carry,
// pad an odd last byte with zero, and take the complement of the result. A message that already contains its correct checksum
// sums to 0xffff, so `inetChecksum` over it returns 0.
// The IPv4 header (RFC 791, https://www.rfc-editor.org/rfc/rfc791, section 3.1) is 20 bytes without options: version 4 and
// IHL 5 in byte 0, total length, identification, flags and fragment offset (0 here), TTL, protocol, header checksum, source
// and destination addresses. The ICMP echo message (RFC 792, https://www.rfc-editor.org/rfc/rfc792) is type 8 (request) or 0
// (reply), code 0, a checksum over the whole ICMP message, identifier and sequence number, then the data.

/// The Internet checksum (RFC 1071) of `data[0..n)`, as the 16-bit value to store in the header.
export fn inetChecksum(data: *ui8, n: usize) -> ui16 {
    local sum: ui64 = 0
    local i: usize = 0
    while i + 1 < n {
        sum = sum + (((data[i] as ui64) << 8) | (data[i + 1] as ui64))
        i = i + 2
    }
    if i < n {
        sum = sum + ((data[i] as ui64) << 8)
    }
    while sum >> 16 != 0 {
        sum = (sum & 0xffff) + (sum >> 16)
    }
    return (~sum & 0xffff) as ui16
}

/// Writes a 20-byte IPv4 header (no options) into `out` with the header checksum set; returns 20. `src` and `dst` point to
/// four bytes each (network order). The fragment fields are zero: the don't-fragment flag is set (RFC 791 section 3.2 allows
/// the sender to choose).
export fn ipv4Header(src: *ui8, dst: *ui8, protocol: ui8, payloadLen: ui16, id: ui16, ttl: ui8, out: *ui8) -> usize {
    local total: ui16 = (20 + (payloadLen as usize)) as ui16
    out[0] = 0x45
    out[1] = 0
    out[2] = (total >> 8) as ui8
    out[3] = (total & 0xff) as ui8
    out[4] = (id >> 8) as ui8
    out[5] = (id & 0xff) as ui8
    out[6] = 0x40
    out[7] = 0
    out[8] = ttl
    out[9] = protocol
    out[10] = 0
    out[11] = 0
    local i: usize = 0
    while i < 4 {
        out[12 + i] = src[i]
        out[16 + i] = dst[i]
        i = i + 1
    }
    local sum: ui16 = inetChecksum(out, 20)
    out[10] = (sum >> 8) as ui8
    out[11] = (sum & 0xff) as ui8
    return 20
}

/// Writes an ICMP echo request (type 8) or reply (type 0) with identifier, sequence and `n` data bytes into `out`, with the
/// checksum set. Returns the message length, 8 + n.
export fn icmpEcho(reply: bool, id: ui16, seq: ui16, data: *ui8, n: usize, out: *ui8) -> usize {
    if reply {
        out[0] = 0
    } else {
        out[0] = 8
    }
    out[1] = 0
    out[2] = 0
    out[3] = 0
    out[4] = (id >> 8) as ui8
    out[5] = (id & 0xff) as ui8
    out[6] = (seq >> 8) as ui8
    out[7] = (seq & 0xff) as ui8
    local i: usize = 0
    while i < n {
        out[8 + i] = data[i]
        i = i + 1
    }
    local sum: ui16 = inetChecksum(out, 8 + n)
    out[2] = (sum >> 8) as ui8
    out[3] = (sum & 0xff) as ui8
    return 8 + n
}
