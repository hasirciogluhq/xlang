// std/net/proto/syslog: the RFC 5424 syslog header (https://www.rfc-editor.org/rfc/rfc5424, section 6). A message is
//   <PRI>VERSION SP TIMESTAMP SP HOSTNAME SP APP-NAME SP PROCID SP MSGID SP STRUCTURED-DATA [SP MSG]
// PRI = facility * 8 + severity (section 6.2.1). The fields after the version are printable ASCII without spaces; a missing
// value is the NILVALUE "-". This module writes the header with the version 1; the structured data is written as "-" (none).
// Facilities 0 to 23 and severities 0 to 7 are the values of section 6.2.1.

/// PRI for a facility (0 to 23) and a severity (0 to 7); -1 when either is out of range.
export fn syslogPri(facility: i32, severity: i32) -> i32 {
    if facility < 0 || facility > 23 || severity < 0 || severity > 7 { return -1 }
    return facility * 8 + severity
}

/// Writes `value` into `out`, or "-" when it is empty (the NILVALUE of section 6). Returns the length.
fn putField(out: *ui8, at: usize, value: str) -> usize {
    if value.len == 0 {
        out[at] = 45
        return 1
    }
    local i: usize = 0
    while i < value.len {
        out[at + i] = value[i]
        i = i + 1
    }
    return value.len
}

/// Writes the header `<PRI>1 TIMESTAMP HOSTNAME APP-NAME PROCID MSGID - MSG` into `out` (capacity `cap`) and returns its length,
/// or -1 when the PRI is invalid or the header does not fit. Empty fields are written as "-". The timestamp must already be an
/// RFC 3339 string (for example from std/time formatRfc3339), or empty.
export fn syslogMessage(facility: i32, severity: i32, timestamp: str, host: str, app: str, procId: str, msgId: str, msg: str, out: *ui8, cap: usize) -> isize {
    local pri: i32 = syslogPri(facility, severity)
    if pri < 0 { return -1 }
    local total: usize = 64 + timestamp.len + host.len + app.len + procId.len + msgId.len + msg.len
    if total > cap { return -1 }
    local o: usize = 0
    out[o] = 60
    o = o + 1
    // PRI digits, at most three
    local digits: [ui8; 3]
    local nd: usize = 0
    local v: i32 = pri
    while true {
        digits[nd] = (48 + v % 10) as ui8
        nd = nd + 1
        v = v / 10
        if v == 0 { break }
    }
    while nd > 0 {
        nd = nd - 1
        out[o] = digits[nd]
        o = o + 1
    }
    out[o] = 62
    out[o + 1] = 49
    out[o + 2] = 32
    o = o + 3
    o = o + putField(out, o, timestamp)
    out[o] = 32
    o = o + 1
    o = o + putField(out, o, host)
    out[o] = 32
    o = o + 1
    o = o + putField(out, o, app)
    out[o] = 32
    o = o + 1
    o = o + putField(out, o, procId)
    out[o] = 32
    o = o + 1
    o = o + putField(out, o, msgId)
    out[o] = 32
    out[o + 1] = 45
    o = o + 2
    if msg.len > 0 {
        out[o] = 32
        o = o + 1
        local i: usize = 0
        while i < msg.len {
            out[o + i] = msg[i]
            i = i + 1
        }
        o = o + msg.len
    }
    return o as isize
}
