// std/net/proto/dhcp6: the DHCPv6 client (RFC 8415, https://www.rfc-editor.org/rfc/rfc8415) for stateful address assignment (IA_NA).
// A message is the type (1 byte), the transaction id (3 bytes) and options, each code (2), length (2), value (section 8, section 21).
// Like dhcpclient.xl it does no I/O: the caller passes `now` in milliseconds, feeds datagrams to `recv`, calls `tick` on timer expiry
// and sends what `take` returns to ff02::1:2, UDP port 547 (the client listens on 546, section 7.2). Messages are sent with the
// client DUID-LL (section 11.4: type 3, hardware type 1, the MAC) and one IA_NA (section 21.4).
//
//   Init --start--> Soliciting --ADVERTISE--> Requesting --REPLY--> Bound --T1--> Renewing --T2--> Rebinding --valid end--> Init
//
// Retransmission (section 15) starts at IRT, doubles per attempt up to MRT, with +-10% jitter (here from `jitter`): SOLICIT 1 s/3600 s,
// REQUEST 1 s/30 s, RENEW and REBIND 10 s/600 s. T1 and T2 are the IA_NA values; 0 means the client chooses 0.5 and 0.8 of the
// shortest preferred lifetime (section 14.2).
from "../../str/string" import String
from "../../collections/vec" import Vec
from "wire" import putBe, putZeros, getBe, retryDelay, jitter

/// The message type (RFC 8415 section 7.3).
export enum Dhcp6Kind: ui8 {
    None = 0
    Solicit = 1
    Advertise = 2
    Request = 3
    Confirm = 4
    Renew = 5
    Rebind = 6
    Reply = 7
    Release = 8
    Decline = 9
}

export enum Dhcp6State: ui8 {
    Init
    Soliciting
    Requesting
    Bound
    Renewing
    Rebinding
}

/// What a server message carries that the client needs: type, transaction id, the server DUID, the first IA_NA address with its
/// lifetimes and timers (seconds), and the status code (0 = Success, section 7.5).
export class Dhcp6Reply {
    kind: Dhcp6Kind
    xid: ui32
    serverId: String
    address: String                     // 16 bytes, empty when the message has none
    t1: ui32
    t2: ui32
    preferred: ui32
    valid: ui32
    status: ui16
    ok: bool

    fn init(self) {
        self.kind = Dhcp6Kind.None
        self.serverId = String()
        self.address = String()
    }
}

fn opt(out: *String, code: ui64, body: *String) {
    putBe(out, code, 2)
    putBe(out, body.length() as ui64, 2)
    out.append(body)
}

/// Reads the options in `buf[lo..hi]` into `r`; an IA_NA (option 3) is read again for its IAADDR (option 5) and status.
fn readOptions(buf: *String, lo: usize, hi: usize, r: *Dhcp6Reply) {
    local o: usize = lo
    for ; o + 4 <= hi; o += 4 + (getBe(buf, o + 2, 2) as usize) {
        local code: ui64 = getBe(buf, o, 2)
        local n: usize = getBe(buf, o + 2, 2) as usize
        if o + 4 + n > hi { return }
        local v: usize = o + 4
        if code == 2 { r.serverId = buf.slice(v, n) }
        else if code == 3 && n >= 12 {
            r.t1 = getBe(buf, v + 4, 4) as ui32
            r.t2 = getBe(buf, v + 8, 4) as ui32
            readOptions(buf, v + 12, v + n, r)
        } else if code == 5 && n >= 24 {
            r.address = buf.slice(v, 16)
            r.preferred = getBe(buf, v + 16, 4) as ui32
            r.valid = getBe(buf, v + 20, 4) as ui32
        } else if code == 13 && n >= 2 { r.status = getBe(buf, v, 2) as ui16 }
    }
}

/// Parses a server message; `ok` is false for a message that is too short or whose type is not ADVERTISE or REPLY.
export fn dhcp6Parse(buf: *String) -> Dhcp6Reply {
    local r: Dhcp6Reply = Dhcp6Reply()
    if buf.length() < 4 { return r }
    r.kind = buf.at(0) as Dhcp6Kind
    r.xid = getBe(buf, 1, 3) as ui32
    readOptions(buf, 4, buf.length(), &r)
    r.ok = r.kind == Dhcp6Kind.Advertise || r.kind == Dhcp6Kind.Reply
    return r
}

export class Dhcp6Client {
    state: Dhcp6State
    mac: ui64
    iaid: ui32
    xid: ui32
    seed: ui32
    begun: ui64
    due: ui64
    attempt: ui32
    server: String                      // the chosen server DUID
    address: String                     // the leased address (16 bytes)
    t1At: ui64
    t2At: ui64
    endAt: ui64
    packet: String                      // always sent to ff02::1:2, UDP port 547

    fn init(self, mac: ui64, seed: ui32) {
        self.state = Dhcp6State.Init
        self.mac = mac
        self.iaid = seed
        self.xid = seed
        self.seed = seed
        self.server = String()
        self.address = String()
        self.packet = String()
    }

    fn take(self) -> String {
        local p: String = self.packet.clone()
        self.packet = String()
        return p
    }

    fn bound(self) -> bool { return self.state >= Dhcp6State.Bound }

    /// Builds and schedules one message of `kind` (section 18.2); `irt` and `mrt` are the retransmission bounds in ms.
    fn send(self, now: ui64, kind: Dhcp6Kind, irt: ui64, mrt: ui64) {
        local m: String = String()
        m.push(kind as ui8)
        putBe(&m, self.xid as ui64, 3)
        local duid: String = String()
        putBe(&duid, 0x00030001, 4)                     // DUID-LL, hardware type 1 (Ethernet)
        putBe(&duid, self.mac, 6)
        opt(&m, 1, &duid)
        if self.server.length() > 0 && kind != Dhcp6Kind.Solicit { opt(&m, 2, &self.server) }
        local ia: String = String()
        putBe(&ia, self.iaid as ui64, 4)
        putZeros(&ia, 8)                                // T1, T2: the client leaves them to the server
        if self.address.length() > 0 && kind != Dhcp6Kind.Solicit {
            putBe(&ia, 5, 2)
            putBe(&ia, 24, 2)
            ia.append(&self.address)
            putZeros(&ia, 8)
        }
        opt(&m, 3, &ia)
        local oro: String = String()
        putBe(&oro, 23, 2)                              // ask for the DNS servers (RFC 3646)
        opt(&m, 6, &oro)
        local elapsed: String = String()
        putBe(&elapsed, ((now - self.begun) / 10) as ui64, 2)
        opt(&m, 8, &elapsed)
        self.packet = m
        local wait: i64 = retryDelay(irt, mrt, self.attempt) as i64 + jitter(&self.seed, (irt / 10) as i64)
        self.due = now + wait as ui64
        self.attempt++
    }

    /// Begins acquisition: a new transaction, then SOLICIT (section 18.2.1).
    fn start(self, now: ui64) {
        self.xid = (self.xid * 1664525 + 1013904223) & 0xffffff
        self.state = Dhcp6State.Soliciting
        self.begun = now
        self.attempt = 0
        self.server = String()
        self.address = String()
        self.send(now, Dhcp6Kind.Solicit, 1000, 3600000)
    }

    /// Gives the address back with a RELEASE (section 18.2.7) and returns to Init.
    fn release(self, now: ui64) {
        if !self.bound() { return }
        self.xid = (self.xid + 1) & 0xffffff
        self.send(now, Dhcp6Kind.Release, 1000, 1000)
        self.state = Dhcp6State.Init
    }

    /// One received datagram of this transaction.
    fn recv(self, now: ui64, buf: *String) {
        local r: Dhcp6Reply = dhcp6Parse(buf)
        if !r.ok || r.xid != self.xid { return }
        if r.kind == Dhcp6Kind.Advertise && self.state == Dhcp6State.Soliciting && r.address.length() == 16 {
            self.server = r.serverId.clone()
            self.address = r.address.clone()
            self.state = Dhcp6State.Requesting
            self.attempt = 0
            self.send(now, Dhcp6Kind.Request, 1000, 30000)
        } else if r.kind == Dhcp6Kind.Reply && self.state >= Dhcp6State.Requesting && self.state != Dhcp6State.Bound {
            if r.status != 0 || r.address.length() != 16 {              // NoAddrsAvail, NoBinding, ...: start over
                self.start(now)
                return
            }
            local pref: ui64 = r.preferred as ui64 * 1000
            self.address = r.address.clone()
            self.t1At = now + (r.t1 != 0 ? r.t1 as ui64 * 1000 : pref / 2)
            self.t2At = now + (r.t2 != 0 ? r.t2 as ui64 * 1000 : pref * 4 / 5)
            self.endAt = now + r.valid as ui64 * 1000
            self.state = Dhcp6State.Bound
            self.due = self.t1At
        }
    }

    /// A timer check: retransmits, or moves Bound to Renewing, Renewing to Rebinding (section 18.2.4, 18.2.5) and Rebinding to Init.
    fn tick(self, now: ui64) {
        if now < self.due { return }
        switch self.state {
            case Dhcp6State.Init { self.start(now) }
            case Dhcp6State.Soliciting { self.send(now, Dhcp6Kind.Solicit, 1000, 3600000) }
            case Dhcp6State.Requesting { self.send(now, Dhcp6Kind.Request, 1000, 30000) }
            case Dhcp6State.Bound {
                self.state = Dhcp6State.Renewing
                self.attempt = 0
                self.send(now, Dhcp6Kind.Renew, 10000, 600000)
            }
            case Dhcp6State.Renewing {
                if now >= self.t2At {
                    self.state = Dhcp6State.Rebinding
                    self.attempt = 0
                    self.server = String()
                    self.send(now, Dhcp6Kind.Rebind, 10000, 600000)
                } else { self.send(now, Dhcp6Kind.Renew, 10000, 600000) }
            }
            case Dhcp6State.Rebinding {
                if now >= self.endAt { self.start(now) } else { self.send(now, Dhcp6Kind.Rebind, 10000, 600000) }
            }
        }
    }
}
