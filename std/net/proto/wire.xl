// std/net/proto/wire: big-endian ("network order", RFC 1700 / RFC 9293 section 3.1) reads and writes on a `String` used as a byte
// buffer, and the retransmission helpers of the address-configuration protocols. A packet is a `String`; a parser borrows the
// received bytes as a `*String`. Reads check the offset (a panic under `--safety=checked`), so a parser tests the length first.
from "../../str/string" import String

/// Appends the low `width` bytes of `v`, most significant first.
export fn putBe(out: *String, v: ui64, width: usize) {
    for i in 0..width { out.push(((v >> (((width - 1 - i) * 8) as ui64)) & 0xff) as ui8) }
}

/// Appends `n` zero bytes.
export fn putZeros(out: *String, n: usize) {
    for _ in 0..n { out.push(0) }
}

/// The `width` bytes at `at`, most significant first, as a number.
export fn getBe(s: *String, at: usize, width: usize) -> ui64 {
    local v: ui64 = 0
    for i in 0..width { v = (v << 8) | (s.at(at + i) as ui64) }
    return v
}

/// The retransmission time of attempt `attempt` (0 for the first send), in milliseconds: `irt` doubled per attempt, capped at
/// `mrt` (RFC 2131 section 4.1: 4 s doubling to 64 s; RFC 8415 section 15: IRT doubling to MRT).
export fn retryDelay(irt: ui64, mrt: ui64, attempt: ui32) -> ui64 {
    local rt: ui64 = irt << ((attempt < 20 ? attempt : 20) as ui64)
    return rt > mrt ? mrt : rt
}

/// A pseudo-random offset in [-span, span] from the xorshift32 state `seed` (Marsaglia 2003), advanced by the call. The
/// callers seed it from `sysRandom`; the protocols only need the spread, not unpredictability.
export fn jitter(seed: *ui32, span: i64) -> i64 {
    local x: ui32 = *seed == 0 ? 2463534242 : *seed
    x = x ^ (x << 13)
    x = x ^ (x >> 17)
    x = x ^ (x << 5)
    *seed = x
    return ((x % 2001) as i64 - 1000) * span / 1000
}
