// std/net/proto/mqtt: MQTT version 5.0 packets (OASIS MQTT Version 5.0, https://docs.oasis-open.org/mqtt/mqtt/v5.0/mqtt-v5.0.html).
// A packet is a fixed header (packet type in the high nibble of byte 0, flags in the low nibble; section 2.1.1) and a remaining
// length (a variable byte integer of 1 to 4 bytes, section 1.5.5), then the variable header and the payload. Strings are a
// 2-byte big-endian length and UTF-8 bytes (section 1.5.4). Every packet written here carries an empty property list (a single
// 0x00 length byte, section 2.2.2). Only the packets a client needs are built: CONNECT (3.1), PUBLISH (3.3), SUBSCRIBE (3.8),
// PINGREQ (3.12) and DISCONNECT (3.14); the reader parses CONNACK (3.2) and the packet type of any packet.
// Not implemented: will messages, authentication (AUTH), user properties, topic aliases, the QoS 1 and QoS 2 acknowledgements.

define MQTT_MAX_BODY = 2048

/// Writes the variable byte integer `v` (section 1.5.5) into `out`; returns its length (1 to 4). `v` must be below 268435456.
fn varInt(v: usize, out: *ui8) -> usize {
    local x: usize = v
    local n: usize = 0
    while true {
        local b: ui8 = (x % 128) as ui8
        x = x / 128
        if x > 0 { b = b | 128 }
        out[n] = b
        n = n + 1
        if x == 0 { break }
    }
    return n
}

/// The fixed header plus `body[0..n)` into `out`; returns the total length, or 0 when the body is too large.
fn packet(first: ui8, body: *ui8, n: usize, out: *ui8, cap: usize) -> usize {
    if n > MQTT_MAX_BODY { return 0 }
    local hdr: [ui8; 4]
    local hl: usize = varInt(n, &hdr[0])
    if 1 + hl + n > cap { return 0 }
    out[0] = first
    local i: usize = 0
    while i < hl {
        out[1 + i] = hdr[i]
        i = i + 1
    }
    i = 0
    while i < n {
        out[1 + hl + i] = body[i]
        i = i + 1
    }
    return 1 + hl + n
}

/// Writes a UTF-8 string with its 2-byte length at `body[at..]`; returns the position after it.
fn putString(body: *ui8, at: usize, s: *ui8, n: usize) -> usize {
    body[at] = ((n >> 8) & 0xff) as ui8
    body[at + 1] = (n & 0xff) as ui8
    local i: usize = 0
    while i < n {
        body[at + 2 + i] = s[i]
        i = i + 1
    }
    return at + 2 + n
}

/// A CONNECT packet (section 3.1) for protocol version 5 with a clean start, the keep-alive interval in seconds and the client
/// identifier. Returns the length written, or 0.
export fn mqttConnect(clientId: *ui8, idLen: usize, keepAlive: ui16, out: *ui8, cap: usize) -> usize {
    local body: [ui8; MQTT_MAX_BODY]
    local p: usize = 0
    // protocol name "MQTT" and level 5
    p = putString(&body[0], p, "MQTT", 4)
    body[p] = 5
    // connect flags: clean start (bit 1); no will, user name or password
    body[p + 1] = 2
    body[p + 2] = ((keepAlive >> 8) & 0xff) as ui8
    body[p + 3] = (keepAlive & 0xff) as ui8
    // empty properties
    body[p + 4] = 0
    p = p + 5
    p = putString(&body[0], p, clientId, idLen)
    return packet(0x10, &body[0], p, out, cap)
}

/// A PUBLISH packet (section 3.3) with QoS 0, 1 or 2, the retain flag, and the packet identifier used by QoS 1 and 2 (ignored
/// for QoS 0). Returns the length written, or 0.
export fn mqttPublish(topic: *ui8, topicLen: usize, payload: *ui8, n: usize, qos: ui8, retain: bool, packetId: ui16, out: *ui8, cap: usize) -> usize {
    local body: [ui8; MQTT_MAX_BODY]
    local p: usize = putString(&body[0], 0, topic, topicLen)
    if qos > 0 {
        body[p] = ((packetId >> 8) & 0xff) as ui8
        body[p + 1] = (packetId & 0xff) as ui8
        p = p + 2
    }
    body[p] = 0
    p = p + 1
    local i: usize = 0
    while i < n {
        if p + i >= MQTT_MAX_BODY { return 0 }
        body[p + i] = payload[i]
        i = i + 1
    }
    p = p + n
    local first: ui8 = 0x30 | ((qos & 3) << 1)
    if retain { first = first | 1 }
    return packet(first, &body[0], p, out, cap)
}

/// A SUBSCRIBE packet (section 3.8) with one topic filter and its maximum QoS. Returns the length written, or 0.
export fn mqttSubscribe(packetId: ui16, filter: *ui8, filterLen: usize, qos: ui8, out: *ui8, cap: usize) -> usize {
    local body: [ui8; MQTT_MAX_BODY]
    body[0] = ((packetId >> 8) & 0xff) as ui8
    body[1] = (packetId & 0xff) as ui8
    body[2] = 0
    local p: usize = putString(&body[0], 3, filter, filterLen)
    body[p] = qos & 3
    p = p + 1
    return packet(0x82, &body[0], p, out, cap)
}

/// PINGREQ (section 3.12): two bytes.
export fn mqttPingReq(out: *ui8) -> usize {
    out[0] = 0xc0
    out[1] = 0
    return 2
}

/// DISCONNECT with reason code 0, normal disconnection (section 3.14): two bytes.
export fn mqttDisconnect(out: *ui8) -> usize {
    out[0] = 0xe0
    out[1] = 0
    return 2
}

/// The result of reading a packet header: the packet type (1 to 15), the remaining length, and the header size. `ok` is false
/// when the bytes do not start a complete header.
export struct MqttHeader {
    kind: ui8
    flags: ui8
    remaining: usize
    headerLen: usize
    ok: bool
}

/// Reads the fixed header at the start of `buf[0..n)`.
export fn mqttReadHeader(buf: *ui8, n: usize) -> MqttHeader {
    local h: MqttHeader
    if n < 2 { return h }
    h.kind = buf[0] >> 4
    h.flags = buf[0] & 15
    local mult: usize = 1
    local value: usize = 0
    local i: usize = 1
    while true {
        if i > 4 || i >= n { return h }
        local b: ui8 = buf[i]
        value = value + ((b & 127) as usize) * mult
        i = i + 1
        if (b & 128) == 0 { break }
        mult = mult * 128
    }
    h.remaining = value
    h.headerLen = i
    h.ok = i + value <= n
    return h
}

/// The CONNACK packet (section 3.2): the session-present flag and the reason code (0 means success).
export struct MqttConnack {
    sessionPresent: bool
    reason: ui8
    ok: bool
}

export fn mqttParseConnack(buf: *ui8, n: usize) -> MqttConnack {
    local r: MqttConnack
    local h: MqttHeader = mqttReadHeader(buf, n)
    if !h.ok || h.kind != 2 || h.remaining < 2 { return r }
    r.sessionPresent = (buf[h.headerLen] & 1) == 1
    r.reason = buf[h.headerLen + 1]
    r.ok = true
    return r
}
