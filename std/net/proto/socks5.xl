// std/net/proto/socks5: the SOCKS version 5 messages of RFC 1928 (https://www.rfc-editor.org/rfc/rfc1928). Every message is
// binary and the port is big-endian. The client sends a greeting (VER 5, NMETHODS, METHODS) and receives the chosen method;
// then a request (VER 5, CMD, RSV 0, ATYP, DST.ADDR, DST.PORT) and a reply (VER 5, REP, RSV 0, ATYP, BND.ADDR, BND.PORT).
// ATYP 1 is an IPv4 address (4 bytes), 3 a domain name (one length byte, then the name, not NUL-terminated), 4 an IPv6 address
// (16 bytes). CMD 1 is CONNECT. METHOD 0 is "no authentication required" and 0xff means no acceptable method.
// This module builds the messages and reads the reply header; the username/password subnegotiation (RFC 1929) is not done.

define SOCKS_VERSION = 5
define SOCKS_CMD_CONNECT = 1
define SOCKS_ATYP_IPV4 = 1
define SOCKS_ATYP_DOMAIN = 3
define SOCKS_ATYP_IPV6 = 4

/// The greeting offering "no authentication" only: [5, 1, 0]. Returns 3.
export fn socks5Greeting(out: *ui8) -> usize {
    out[0] = SOCKS_VERSION
    out[1] = 1
    out[2] = 0
    return 3
}

/// The CONNECT request for a domain name, `host[0..hlen)`, which must be 1 to 255 bytes. Returns the length, or 0 when the name
/// does not fit the one-byte length. The output buffer needs 7 + hlen bytes.
export fn socks5ConnectDomain(host: *ui8, hlen: usize, port: ui16, out: *ui8) -> usize {
    if hlen == 0 || hlen > 255 { return 0 }
    out[0] = SOCKS_VERSION
    out[1] = SOCKS_CMD_CONNECT
    out[2] = 0
    out[3] = SOCKS_ATYP_DOMAIN
    out[4] = hlen as ui8
    local i: usize = 0
    while i < hlen {
        out[5 + i] = host[i]
        i = i + 1
    }
    out[5 + hlen] = (port >> 8) as ui8
    out[6 + hlen] = (port & 0xff) as ui8
    return 7 + hlen
}

/// The CONNECT request for an IPv4 address (4 bytes at `addr`). Returns 10.
export fn socks5ConnectIPv4(addr: *ui8, port: ui16, out: *ui8) -> usize {
    out[0] = SOCKS_VERSION
    out[1] = SOCKS_CMD_CONNECT
    out[2] = 0
    out[3] = SOCKS_ATYP_IPV4
    local i: usize = 0
    while i < 4 {
        out[4 + i] = addr[i]
        i = i + 1
    }
    out[8] = (port >> 8) as ui8
    out[9] = (port & 0xff) as ui8
    return 10
}

/// The reply header: the status REP (0 means succeeded) and the length of the whole reply, or 0 when the bytes are not a
/// complete reply. The bound address follows the ATYP rules above.
export struct SocksReply {
    rep: ui8
    length: usize
    ok: bool
}

export fn socks5ParseReply(buf: *ui8, n: usize) -> SocksReply {
    local r: SocksReply
    if n < 4 || buf[0] != SOCKS_VERSION { return r }
    r.rep = buf[1]
    local addrLen: usize = 0
    if buf[3] == SOCKS_ATYP_IPV4 {
        addrLen = 4
    } else if buf[3] == SOCKS_ATYP_IPV6 {
        addrLen = 16
    } else if buf[3] == SOCKS_ATYP_DOMAIN {
        if n < 5 { return r }
        addrLen = 1 + (buf[4] as usize)
    } else {
        return r
    }
    local total: usize = 4 + addrLen + 2
    if n < total { return r }
    r.length = total
    r.ok = true
    return r
}
