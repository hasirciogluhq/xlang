// Redirects. GET /old goes to https://example.com/ with 301; POST /submit answers 307 so the client repeats the POST at /result.
from "std" import Engine, Context

@entry fn main() -> i32 {
    local router: Engine = Engine()
    router.GET("/old", fn(c: *Context) {
        c.Redirect(301, "https://example.com/")
    })
    router.POST("/submit", fn(c: *Context) {
        c.Redirect(307, "/result")
    })
    router.GET("/result", fn(c: *Context) {
        c.String(200, "result page")
    })
    return router.Run(8080)
}
