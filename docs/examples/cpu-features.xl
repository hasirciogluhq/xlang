// Prints the processor's features. On x86-64 the vendor string and the SIMD and AVX flags; on arm64 the crypto and NEON flags.
from "std" import print, cpuFeatures, CpuFeatures

fn flag(name: *ui8, v: bool) {
    print(name)
    print("=")
    print(v)
    print(" ")
}

@entry fn main() -> i32 {
    local f: CpuFeatures = cpuFeatures()
    print("vendor: ")
    print(&f.vendor[0])
    print("\n")
    flag("sse2", f.sse2)
    flag("avx2", f.avx2)
    flag("neon", f.neon)
    flag("aes", f.aes)
    flag("sha2", f.sha2)
    print("\n")
    return 0
}
