// Route groups with nested prefixes and middleware. The group's middleware runs before its own handlers only.
//   GET /api/v1/users/      -> 401 without the X-Token header, else the list
//   GET /api/v1/users/:id   -> 401 without the header, else the user
//   GET /public             -> no middleware
from "std" import Engine, Context, RouterGroup

fn authRequired(c: *Context) {
    if c.GetHeader("X-Token").len == 0 {
        c.AbortWithStatus(401)
        return
    }
    c.Next()
}

@entry fn main() -> i32 {
    local router: Engine = Engine()
    local v1: *RouterGroup = router.Group("/api").Group("/v1")
    local users: *RouterGroup = v1.Group("/users")
    users.Use(authRequired)
    users.GET("/", fn(c: *Context) {
        c.String(200, "list users")
    })
    users.GET("/:id", fn(c: *Context) {
        c.String(200, "get user")
    })
    router.GET("/public", fn(c: *Context) {
        c.String(200, "public")
    })
    return router.Run(8080)
}
