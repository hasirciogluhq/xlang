// A JSON response. curl http://127.0.0.1:8080/message answers {"message":"hey","status":200} as application/json.
from "std" import Engine, Context

@entry fn main() -> i32 {
    local router: Engine = Engine()
    router.GET("/message", fn(c: *Context) {
        c.JSON(200, "{\"message\":\"hey\",\"status\":200}")
    })
    return router.Run(8080)
}
