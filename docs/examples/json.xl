// A JSON response. `curl http://127.0.0.1:8080/message` answers {"message":"hey","status":200} with the JSON content type.
from "std" import print, Router, Context, routerInit, routerGet, routerServe, ctxJSON

fn message(c: *Context) {
    ctxJSON(c, 200, "{\"message\":\"hey\",\"status\":200}")
}

fn listening() {
    print("listening on http://127.0.0.1:8080\n")
}

@entry fn main() -> i32 {
    local r: Router
    routerInit(&r)
    routerGet(&r, "/message", message)
    return routerServe(&r, 2130706433, 8080, listening)
}
