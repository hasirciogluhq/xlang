// Path parameters: ":name" matches one segment, "*action" the rest of the path. curl http://127.0.0.1:8080/user/john answers
// "Hello john"; curl http://127.0.0.1:8080/user/john/send answers "john is /send".
from "std" import Engine, Context, String

@entry fn main() -> i32 {
    local router: Engine = Engine()
    router.GET("/user/:name", fn(c: *Context) {
        local body: String = String()
        body.append("Hello ")
        body.append(c.Param("name"))
        c.String(200, body.asStr())
    }).GET("/user/:name/*action", fn(c: *Context) {
        local body: String = String()
        body.append(c.Param("name"))
        body.append(" is ")
        body.append(c.Param("action"))
        c.String(200, body.asStr())
    })
    return router.Run(8080)
}
