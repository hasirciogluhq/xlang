// Path parameters: `:name` matches one segment, `*action` matches the rest of the path (including its leading slash).
// `curl http://127.0.0.1:8080/user/john` answers "Hello john"; `curl http://127.0.0.1:8080/user/john/send` answers
// "john is /send".
from "std" import print, String, Router, Context, routerInit, routerGet, routerServe, ctxString, ctxParam, fromC

fn user(c: *Context) {
    local body: String = String()
    body.append("Hello ")
    body.append(fromC(ctxParam(c, "name")))
    ctxString(c, 200, body.cstr())
}

fn userAction(c: *Context) {
    local body: String = String()
    body.append(fromC(ctxParam(c, "name")))
    body.append(" is ")
    body.append(fromC(ctxParam(c, "action")))
    ctxString(c, 200, body.cstr())
}

fn listening() {
    print("listening on http://127.0.0.1:8080\n")
}

@entry fn main() -> i32 {
    local r: Router
    routerInit(&r)
    routerGet(&r, "/user/:name", user)
    routerGet(&r, "/user/:name/*action", userAction)
    return routerServe(&r, 2130706433, 8080, listening)
}
