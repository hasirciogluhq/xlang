// Query string parameters. curl "http://127.0.0.1:8080/welcome?firstname=Jane&lastname=Doe" answers "Hello Jane Doe"; a missing
// parameter takes its default ("Guest" and "Doe" here).
from "std" import Engine, Context, String

@entry fn main() -> i32 {
    local router: Engine = Engine()
    router.GET("/welcome", fn(c: *Context) {
        local body: String = String()
        body.append("Hello ")
        body.append(c.DefaultQuery("firstname", "Guest"))
        body.append(" ")
        body.append(c.DefaultQuery("lastname", "Doe"))
        c.String(200, body.asStr())
    })
    return router.Run(8080)
}
