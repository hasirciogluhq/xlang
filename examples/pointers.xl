// Pointers (*T), address-of (&), deref (*) and casts (`as`).
from "std" import print, println, printInt, printUInt

fn bump(p: *i32) {
    *p = *p + 1
}

fn main() -> i32 {
    local x: i32 = 10
    local p: *i32 = &x
    *p = 20
    bump(p)
    print("x=")
    printInt(x as i64)
    println("")
    print("x-pointer: ")
    printUInt(p as usize)
    println("")

    local wide: i64 = x as i64
    print("wide=")
    printInt(wide)
    println("")

    local raw: usize = p as usize
    local back: *i32 = raw as *i32
    print("via bits=")
    printInt(*back as i64)
    println("")

    local q: *i32 = nil
    q = &x
    print("q=")
    printInt(*q as i64)
    println("")
    return 0
}
