// Pointers (*T), address-of (&), deref (*) and casts (`as`).
from "std" import print, println

fn bump(p: *i32) {
    *p = *p + 1
}

@entry fn main() -> i32 {
    local x: i32 = 10
    local p: *i32 = &x
    *p = 20
    bump(p)
    print("x=")
    println(x as i64)
    print("x-pointer: ")
    println(p as usize as ui64)

    local wide: i64 = x as i64
    print("wide=")
    println(wide)

    local raw: usize = p as usize
    local back: *i32 = raw as *i32
    print("via bits=")
    println(*back as i64)

    local q: *i32 = nil
    q = &x
    print("q=")
    println(*q as i64)
    return 0
}
