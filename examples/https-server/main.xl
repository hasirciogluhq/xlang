// https-server: a TLS 1.3 server (RFC 8446) with a router, serving on 127.0.0.1.
//   https-server <cert.pem> <key.pem> [port]
// Routes: GET /              text
//         GET /hello/:name   text, the name from the path
//         GET /time          JSON with the Unix time (seconds)
// The certificate and key are PEM files (RSA or ECDSA P-256/P-384). Try it with
//   curl --cacert <ca.pem> https://127.0.0.1:8443/time
from "std" import print, String, sprintf, Router, Context, routerInit, routerGet, routerServeTls, ctxString, ctxJSON, ctxParam, fromC, toU64, TlsCredentials, tlsLoadCredentials, TLS_OK, tlsErrorText
from "std/sys" import sysClockSeconds

global cred: TlsCredentials
global router: Router

define DEFAULT_PORT = 8443

fn index(c: *Context) {
    ctxString(c, 200, "xlang https server\n")
}

fn hello(c: *Context) {
    local body: String = String()
    body.append("hello ")
    body.append(fromC(ctxParam(c, "name")))
    body.append("\n")
    ctxString(c, 200, body.cstr())
}

fn time(c: *Context) {
    local body: String = sprintf("{\"unix\":{}}", sysClockSeconds())
    ctxJSON(c, 200, body.cstr())
}

fn listening() {
    print("https listening on https://127.0.0.1\n")
}

@entry fn main(argc: i32, argv: **ui8) -> i32 {
    if argc < 3 {
        print("usage: https-server <cert.pem> <key.pem> [port]\n")
        return 2
    }
    local port: ui16 = DEFAULT_PORT
    if argc >= 4 {
        local v: ui64 = 0
        if !toU64(fromC(argv[3]), &v) || v == 0 || v > 65535 {
            print("the port must be 1 to 65535\n")
            return 2
        }
        port = v as ui16
    }
    local rc: i32 = tlsLoadCredentials(&cred, argv[1], argv[2])
    if rc != TLS_OK {
        print("cannot load the certificate or key: ")
        print(tlsErrorText(rc))
        print("\n")
        return 1
    }
    routerInit(&router)
    routerGet(&router, "/", index)
    routerGet(&router, "/hello/:name", hello)
    routerGet(&router, "/time", time)
    return routerServeTls(&router, 2130706433, port, &cred, listening)
}
