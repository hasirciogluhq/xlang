// https-server: a TLS 1.3 server (RFC 8446) with a router, serving on all interfaces.
//   https-server <cert.pem> <key.pem> [port]
// Routes: GET /              text
//         GET /hello/:name   text, the name from the path
//         GET /time          JSON with the Unix time (seconds)
// The certificate and key are PEM files (RSA or ECDSA P-256/P-384). Try it with: curl --cacert ca.crt https://127.0.0.1:8443/time
from "std" import print, Engine, Context, String, sprintf, TlsCredentials, tlsLoadCredentials, TLS_OK, tlsErrorText, fromC, toU64
from "std/sys" import sysClockSeconds

define DEFAULT_PORT = 8443

@entry fn main(argc: i32, argv: **ui8) -> i32 {
    if argc < 3 {
        print("usage: https-server <cert.pem> <key.pem> [port]\n")
        return 2
    }
    local port: ui16 = DEFAULT_PORT
    if argc >= 4 {
        local v: ui64 = 0
        if !toU64(fromC(argv[3]), &v) || v == 0 || v > 65535 {
            print("the port must be 1 to 65535\n")
            return 2
        }
        port = v as ui16
    }
    local cred: TlsCredentials
    local rc: i32 = tlsLoadCredentials(&cred, argv[1], argv[2])
    if rc != TLS_OK {
        print("cannot load the certificate or key: ")
        print(tlsErrorText(rc))
        print("\n")
        return 1
    }
    local router: Engine = Engine()
    router.GET("/", fn(c: *Context) {
        c.String(200, "xlang https server\n")
    }).GET("/hello/:name", fn(c: *Context) {
        local body: String = String()
        body.append("hello ")
        body.append(c.Param("name"))
        body.append("\n")
        c.String(200, body.asStr())
    }).GET("/time", fn(c: *Context) {
        local body: String = sprintf("{\"unix\":{}}", sysClockSeconds())
        c.JSON(200, body.asStr())
    })
    return router.RunTLS(port, &cred)
}
