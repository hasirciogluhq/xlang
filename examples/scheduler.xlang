// Parallel job scheduler — go fn(...) + wait_all()
// wait_all / cpu / go come from the linked frontend runtime (scheduler package).

fn job_worker(job_id: int32, name: string) {
    print("job %d done: %s", job_id, name)
    return 0
}

fn main() {
    print("cpu: %d", cpu())
    go job_worker(1, "alpha")
    go job_worker(2, "beta")
    go job_worker(3, "gamma")
    go job_worker(4, "delta")
    wait_all()
    return 0
}
