// Parallel jobs on the std M:N scheduler: spawn(...) + waitAll().
from "std" import print, println, spawn, waitAll, cpu

fn jobWorker(arg: *void) {
    local id: usize = arg as usize
    print("job ")
    print(id as i64)
    println(" done")
}

@entry fn main() -> i32 {
    print("cpu: ")
    println(cpu() as i64)
    local id: usize = 1
    while id <= 4 {
        spawn(jobWorker, id as *void)
        id = id + 1
    }
    waitAll()
    return 0
}
