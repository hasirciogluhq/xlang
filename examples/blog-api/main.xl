// blog-api: a JSON REST service with routes, route groups, JWT authentication and an in-memory store.
//   blog-api <secret> [port]         serve on 127.0.0.1 (default port 8080)
//   blog-api <secret> token <sub>    print an HS256 token for subject <sub> (for the Authorization header)
//
// Routes:
//   GET    /posts            public: list the posts as a JSON array
//   GET    /posts/:id        public: one post, or 404
//   POST   /api/posts        needs "Authorization: Bearer <token>": body {"title":"..","body":".."}, answers 201 with the id
//   PUT    /api/posts/:id    needs the token: body {"title":"..","body":".."}
//   DELETE /api/posts/:id    needs the token: 204
//
// The store holds 64 posts of at most 120 bytes of title and 480 bytes of body. Strings are rejected when they contain a quote,
// a backslash or a control character, so the JSON answers stay valid without an escaper.
from "std" import print, String, sprintf, fromC, fromParts, eq, strlen, Engine, Context, RouterGroup, jwtSignHs256, jwtVerifyHs256, jsonString, toU64
from "std/sys" import sysClockSeconds

define MAX_POSTS = 64
define TITLE_MAX = 120
define BODY_MAX = 480
define DEFAULT_PORT = 8080

/// One stored post. `used` is false for a free slot.
struct Post {
    used: bool
    id: i64
    title: [ui8; 120]
    titleLen: usize
    text: [ui8; 480]
    textLen: usize
}

global posts: [Post; 64]
global nextId: i64 = 1
global secret: *ui8 = nil
global secretLen: usize = 0

/// The slot of the post with `id`, or -1.
fn slotOf(id: i64) -> i32 {
    local i: i32 = 0
    while i < MAX_POSTS {
        if posts[i].used && posts[i].id == id { return i }
        i = i + 1
    }
    return -1
}

fn freeSlot() -> i32 {
    local i: i32 = 0
    while i < MAX_POSTS {
        if !posts[i].used { return i }
        i = i + 1
    }
    return -1
}

/// True when `s` can be written into a JSON string without escapes.
fn plain(s: *ui8, n: usize) -> bool {
    local i: usize = 0
    while i < n {
        if s[i] == 34 || s[i] == 92 || s[i] < 32 { return false }
        i = i + 1
    }
    return true
}

/// Copies `s[0..n)` into `dst` (capacity `cap`); returns the length stored.
fn store(dst: *ui8, cap: usize, s: *ui8, n: usize) -> usize {
    local i: usize = 0
    while i < n && i < cap {
        dst[i] = s[i]
        i = i + 1
    }
    return i
}

/// The title and body of a request body, or false when a field is missing, too long or not plain text.
fn readPost(c: *Context, title: *ui8, body: *ui8) -> bool {
    local text: String = String()
    text.append(c.Body())
    local t: [ui8; 128]
    local b: [ui8; 512]
    if !jsonString(text.cstr(), "title", &t[0], 128) { return false }
    if !jsonString(text.cstr(), "body", &b[0], 512) { return false }
    local tl: usize = strlen(&t[0])
    local bl: usize = strlen(&b[0])
    if tl == 0 || tl > TITLE_MAX || bl > BODY_MAX { return false }
    if !plain(&t[0], tl) || !plain(&b[0], bl) { return false }
    store(title, TITLE_MAX, &t[0], tl)
    store(body, BODY_MAX, &b[0], bl)
    return true
}

/// The JSON object of a stored post.
fn postJson(slot: i32) -> String {
    return sprintf("{\"id\":{},\"title\":\"{}\",\"body\":\"{}\"}", posts[slot].id, fromParts(&posts[slot].title[0], posts[slot].titleLen), fromParts(&posts[slot].text[0], posts[slot].textLen))
}

fn listPosts(c: *Context) {
    local out: String = String()
    out.append("[")
    local i: i32 = 0
    local first: bool = true
    while i < MAX_POSTS {
        if posts[i].used {
            if !first { out.append(",") }
            out.append(postJson(i).asStr())
            first = false
        }
        i = i + 1
    }
    out.append("]")
    c.JSON(200, out.asStr())
}

fn showPost(c: *Context) {
    local id: i64 = 0
    if !toId(c.Param("id"), &id) {
        c.String(404, "not found")
        return
    }
    local slot: i32 = slotOf(id)
    if slot < 0 {
        c.String(404, "not found")
        return
    }
    c.JSON(200, postJson(slot).asStr())
}

fn createPost(c: *Context) {
    local t: [ui8; 120]
    local b: [ui8; 480]
    if !readPost(c, &t[0], &b[0]) {
        c.String(400, "a title and a body of plain text are required")
        return
    }
    local slot: i32 = freeSlot()
    if slot < 0 {
        c.String(507, "the store is full")
        return
    }
    posts[slot].used = true
    posts[slot].id = nextId
    nextId = nextId + 1
    posts[slot].titleLen = store(&posts[slot].title[0], TITLE_MAX, &t[0], strlen(&t[0]))
    posts[slot].textLen = store(&posts[slot].text[0], BODY_MAX, &b[0], strlen(&b[0]))
    local body: String = sprintf("{\"id\":{}}", posts[slot].id)
    c.JSON(201, body.asStr())
}

fn updatePost(c: *Context) {
    local id: i64 = 0
    if !toId(c.Param("id"), &id) {
        c.String(404, "not found")
        return
    }
    local slot: i32 = slotOf(id)
    if slot < 0 {
        c.String(404, "not found")
        return
    }
    local t: [ui8; 120]
    local b: [ui8; 480]
    if !readPost(c, &t[0], &b[0]) {
        c.String(400, "a title and a body of plain text are required")
        return
    }
    posts[slot].titleLen = store(&posts[slot].title[0], TITLE_MAX, &t[0], strlen(&t[0]))
    posts[slot].textLen = store(&posts[slot].text[0], BODY_MAX, &b[0], strlen(&b[0]))
    c.JSON(200, postJson(slot).asStr())
}

fn deletePost(c: *Context) {
    local id: i64 = 0
    if !toId(c.Param("id"), &id) {
        c.String(404, "not found")
        return
    }
    local slot: i32 = slotOf(id)
    if slot < 0 {
        c.String(404, "not found")
        return
    }
    posts[slot].used = false
    c.Status(204)
}

/// Parses a decimal id from the path; false when it is empty or not a number.
fn toId(s: str, out: *i64) -> bool {
    if s.len == 0 { return false }
    local v: i64 = 0
    local i: usize = 0
    while i < s.len {
        if s[i] < 48 || s[i] > 57 { return false }
        v = v * 10 + ((s[i] - 48) as i64)
        i = i + 1
    }
    *out = v
    return true
}

/// The group middleware: the bearer token in Authorization must verify with the server secret (HS256).
fn requireToken(c: *Context) {
    local auth: str = c.GetHeader("Authorization")
    if auth.len < 8 {
        c.AbortWithStatus(401)
        return
    }
    if !jwtVerifyHs256(fromParts(&auth.ptr[7], auth.len - 7), secret, secretLen) {
        c.AbortWithStatus(401)
        return
    }
    c.Next()
}

fn listening() {
    print("blog-api listening on http://127.0.0.1\n")
}

@entry fn main(argc: i32, argv: **ui8) -> i32 {
    if argc < 2 {
        print("usage: blog-api <secret> [port] | blog-api <secret> token <subject>\n")
        return 2
    }
    secret = argv[1]
    secretLen = strlen(argv[1])
    if argc == 4 && eq(fromC(argv[2]), "token") {
        local payload: String = sprintf("{\"sub\":\"{}\",\"iat\":{}}", fromC(argv[3]), sysClockSeconds())
        local token: String = jwtSignHs256("{\"alg\":\"HS256\",\"typ\":\"JWT\"}", payload.asStr(), secret, secretLen)
        print(token.asStr())
        print("\n")
        return 0
    }
    local port: ui16 = DEFAULT_PORT
    if argc >= 3 {
        local v: ui64 = 0
        if !toU64(fromC(argv[2]), &v) || v == 0 || v > 65535 {
            print("the port must be 1 to 65535\n")
            return 2
        }
        port = v as ui16
    }
    local router: Engine = Engine()
    router.GET("/posts", listPosts)
    router.GET("/posts/:id", showPost)
    local api: *RouterGroup = router.Group("/api")
    api.Use(requireToken)
    api.POST("/posts", createPost)
    api.PUT("/posts/:id", updatePost)
    api.DELETE("/posts/:id", deletePost)
    return router.Run(port)
}
