// Strings are NUL-terminated `*ui8`; there is no concatenation operator and no format string.
from "std" import print, println, strlen

@entry fn main() -> i32 {
    local s: *ui8 = "hello world"
    println(s)
    print("length: ")
    println(strlen(s) as i64)
    print("first byte: ")
    println(s[0] as i64)
    print("User: ")
    println("ahmet")
    print("score: ")
    println(100 as i64)
    return 0
}
