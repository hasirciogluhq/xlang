{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2}) ${3:-> i32 }{",
      "\t$0",
      "}"
    ],
    "description": "Function"
  },
  "Exported function": {
    "prefix": "exportfn",
    "body": [
      "export fn ${1:name}(${2}) ${3:-> i32 }{",
      "\t$0",
      "}"
    ],
    "description": "Function visible to other modules"
  },
  "C-exported function": {
    "prefix": "exportc",
    "body": [
      "export(c) fn ${1:name}(${2}) ${3:-> i32 }{",
      "\t$0",
      "}"
    ],
    "description": "Function with an unmangled C symbol"
  },
  "Main": {
    "prefix": "main",
    "body": [
      "fn main() -> i32 {",
      "\t$0",
      "\treturn 0",
      "}"
    ],
    "description": "Program entry point"
  },
  "Local": {
    "prefix": "local",
    "body": [
      "local ${1:name}: ${2:i32} = ${3:0}"
    ],
    "description": "Local variable"
  },
  "Global": {
    "prefix": "global",
    "body": [
      "global ${1:name}: ${2:i32} = ${3:0}"
    ],
    "description": "Global variable (constant initializer)"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:i32}",
      "}"
    ],
    "description": "Struct"
  },
  "C-layout struct": {
    "prefix": "structc",
    "body": [
      "@repr(c)",
      "struct ${1:Name} {",
      "\t${2:field}: ${3:i32}",
      "}"
    ],
    "description": "Struct with C layout"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "\t${2:field}: ${3:i32}",
      "",
      "\tfn ${4:method}(self) -> ${5:i32} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Class"
  },
  "Derived class": {
    "prefix": "classd",
    "body": [
      "class ${1:Name} : ${2:Base} {",
      "\toverride fn ${3:method}(self) -> ${4:i32} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Class with a base class"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "\tfn ${2:method}(self) -> ${3:i32}",
      "}"
    ],
    "description": "Interface"
  },
  "Impl": {
    "prefix": "impl",
    "body": [
      "impl ${1:Interface} for ${2:Type} {",
      "\tfn ${3:method}(self) -> ${4:i32} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Interface implementation"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name}: ${2:i32} {",
      "\t${3:A},",
      "\t${4:B}",
      "}"
    ],
    "description": "Enum"
  },
  "Type alias": {
    "prefix": "typealias",
    "body": [
      "export type ${1:Name} = ${2:i32}"
    ],
    "description": "Transparent type alias"
  },
  "Define constant": {
    "prefix": "define",
    "body": [
      "define ${1:NAME} = ${2:0}"
    ],
    "description": "Compile-time constant"
  },
  "Define macro": {
    "prefix": "definem",
    "body": [
      "define ${1:name}(${2:x}: expr) {",
      "\t$0",
      "}"
    ],
    "description": "Hygienic macro"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "If"
  },
  "If else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "If / else"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "Do while": {
    "prefix": "do",
    "body": [
      "do {",
      "\t$0",
      "} while ${1:condition}"
    ],
    "description": "Do-while loop"
  },
  "For": {
    "prefix": "for",
    "body": [
      "for local ${1:i}: ${2:i32} = 0; ${1:i} < ${3:n}; ${1:i}++ {",
      "\t$0",
      "}"
    ],
    "description": "C-style for loop"
  },
  "For range": {
    "prefix": "forin",
    "body": [
      "for ${1:i} in ${2:0}..${3:n} {",
      "\t$0",
      "}"
    ],
    "description": "Range loop (upper bound exclusive)"
  },
  "Labeled loop": {
    "prefix": "label",
    "body": [
      "${1:outer}: while ${2:condition} {",
      "\t$0",
      "}"
    ],
    "description": "Labeled loop (break / continue take the label)"
  },
  "Switch": {
    "prefix": "switch",
    "body": [
      "switch ${1:value} {",
      "\tcase ${2:0} {",
      "\t\t$3",
      "\t}",
      "\tdefault {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Switch (no fallthrough)"
  },
  "Defer": {
    "prefix": "defer",
    "body": [
      "defer ${1:cleanup()}"
    ],
    "description": "Run a statement when the enclosing block is left"
  },
  "Unsafe": {
    "prefix": "unsafe",
    "body": [
      "unsafe {",
      "\t$0",
      "}"
    ],
    "description": "Allow implicit signedness-changing conversions"
  },
  "Ternary": {
    "prefix": "tern",
    "body": [
      "${1:cond} ? ${2:a} : ${3:b}"
    ],
    "description": "Conditional expression"
  },
  "New": {
    "prefix": "new",
    "body": [
      "new ${1:Type} { ${2:field}: ${3:value} }"
    ],
    "description": "Allocate through the registered allocator"
  },
  "New with allocator": {
    "prefix": "newa",
    "body": [
      "new(${1:allocator}) ${2:Type} { ${3:field}: ${4:value} }"
    ],
    "description": "Allocate through an explicit allocator"
  },
  "Import from": {
    "prefix": "from",
    "body": [
      "from \"${1:std}\" import ${2:name}"
    ],
    "description": "Import names from a module"
  },
  "Import all": {
    "prefix": "importall",
    "body": [
      "import * from \"${1:module}\""
    ],
    "description": "Import every export of a module"
  },
  "Import namespace": {
    "prefix": "importas",
    "body": [
      "import * as ${1:alias} from \"${2:module}\""
    ],
    "description": "Import a module under a namespace"
  },
  "Re-export": {
    "prefix": "exportfrom",
    "body": [
      "export * from \"${1:module}\""
    ],
    "description": "Re-export a module"
  },
  "Declare function": {
    "prefix": "declare",
    "body": [
      "declare fn ${1:name}(${2}) ${3:-> i32}"
    ],
    "description": "Function defined in another object or library"
  },
  "Library import": {
    "prefix": "library",
    "body": [
      "@library(\"${1:ntdll}\")",
      "declare fn ${2:name}(${3}) ${4:-> i32}"
    ],
    "description": "Function imported from a native OS library"
  },
  "Register panic": {
    "prefix": "registerpanic",
    "body": [
      "register(panic) fn ${1:panic}(msg: *ui8) {",
      "\t$0",
      "}"
    ],
    "description": "Bind the panic role"
  },
  "Register allocator": {
    "prefix": "registeralloc",
    "body": [
      "register(allocator) global ${1:currentAllocator}: ${2:Allocator}"
    ],
    "description": "Bind the allocator role"
  },
  "Conditional compilation": {
    "prefix": "#if",
    "body": [
      "#if ${1:os == \"linux\"}",
      "$0",
      "#endif"
    ],
    "description": "Conditional compilation block"
  },
  "Static assert": {
    "prefix": "staticassert",
    "body": [
      "staticAssert(${1:sizeOf(T) == 8}, \"${2:message}\")"
    ],
    "description": "Compile-time assertion"
  },
  "Syscall": {
    "prefix": "syscall",
    "body": [
      "syscall(${1:nr}, ${2:args})"
    ],
    "description": "Raw system call (returns i64, -errno on error)"
  },
  "Atomic load": {
    "prefix": "atomicload",
    "body": [
      "__builtin_atomicLoad(${1:ptr}, MemoryOrder.${2:seqCst})"
    ],
    "description": "Atomic load"
  },
  "Atomic store": {
    "prefix": "atomicstore",
    "body": [
      "__builtin_atomicStore(${1:ptr}, ${2:value}, MemoryOrder.${3:seqCst})"
    ],
    "description": "Atomic store"
  },
  "Inline asm": {
    "prefix": "asm",
    "body": [
      "__builtin_asm(\"${1:nop}\", options(\"nomem\"))"
    ],
    "description": "Inline assembly (template is target specific)"
  },
  "Test file": {
    "prefix": "testfile",
    "body": [
      "from \"std/testing\" import Suite, T, suiteInit, test, suiteRun, expectEq, expectTrue",
      "",
      "fn ${1:works}(t: *T) {",
      "\texpectEq(t, ${2:1 + 1}, ${3:2})",
      "}",
      "",
      "fn main() -> i32 {",
      "\tlocal s: Suite",
      "\tsuiteInit(&s)",
      "\ttest(&s, \"${4:works}\", ${1:works})",
      "\treturn suiteRun(&s)",
      "}"
    ],
    "description": "A *.test.xl file using std/testing"
  },
  "Test case": {
    "prefix": "testcase",
    "body": [
      "fn ${1:name}(t: *T) {",
      "\t$0",
      "}"
    ],
    "description": "std/testing test body"
  },
  "Gin engine": {
    "prefix": "ginengine",
    "body": [
      "@entry fn main() -> i32 {",
      "\tlocal router: Engine = Engine()",
      "\trouter.GET(\"/${1:path}\", fn(c: *Context) {",
      "\t\tc.String(200, \"${2:ok}\")",
      "\t})",
      "\treturn router.Run(${3:8080})",
      "}"
    ],
    "description": "Gin-style engine with a chained route and Run"
  },
  "Route group with middleware": {
    "prefix": "gingroup",
    "body": [
      "local api: *RouterGroup = router.Group(\"/${1:api}\")",
      "api.Use(fn(c: *Context) {",
      "\tc.Next()",
      "})",
      "api.GET(\"/${2:ping}\", fn(c: *Context) {",
      "\tc.JSON(200, \"{}\")",
      "})"
    ],
    "description": "Route group with its own middleware (Gin Group and Use)"
  },
  "Handler with path parameter": {
    "prefix": "ginparam",
    "body": [
      "router.GET(\"/${1:user}/:${2:id}\", fn(c: *Context) {",
      "\tc.String(200, c.Param(\"${2:id}\"))",
      "})"
    ],
    "description": "Route with a :name parameter"
  },
  "HTTP client request": {
    "prefix": "httpclient",
    "body": [
      "local client: Client = Client()",
      "local resp: Response = client.Get(\"${1:https://example.com/}\")",
      "if resp.error != 0 || resp.status != 200 {",
      "\t$0",
      "}"
    ],
    "description": "HTTP client GET with status check"
  },
  "Multipart upload handler": {
    "prefix": "ginupload",
    "body": [
      "router.POST(\"/${1:upload}\", fn(c: *Context) {",
      "\tlocal name: str = c.FormFileName(\"${2:file}\")",
      "\tlocal data: str = c.FormFile(\"${2:file}\")",
      "\tc.String(200, name)",
      "})"
    ],
    "description": "Handler that reads a multipart file upload"
  },
  "S3 client": {
    "prefix": "s3client",
    "body": [
      "local s3: S3Client = S3Client(s3ProfileAws(\"${1:us-east-1}\"), \"${2:accessKey}\", \"${3:secretKey}\")",
      "local r: S3Result = s3.PutObject(\"${4:bucket}\", \"${5:key}\", \"text/plain\", \"${6:body}\")",
      "if !r.ok {",
      "\t$0",
      "}"
    ],
    "description": "S3 client: put an object through a provider profile"
  }
}
