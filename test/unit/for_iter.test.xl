// Unit: the iterating `for` and slices — `for x in s { }`, `for x, i in s { }`, `[]T`, `[]mut T` and
// `buffer[lo..hi]`. The element is a `*T` into the storage (nothing is copied), the index is a `usize`
// and comes second, and the bound is read once.
from "std/testing" import Suite, T, suiteInit, test, suiteRun, expectEq, expectEqUInt, expectTrue
from "std/str/str" import eq

class Proc {
    pid: i32
    name: str

    fn init(self, pid: i32, name: str) {
        self.pid = pid
        self.name = name
    }
}

// `for x in arr` over a [T; N]: the element is `*T`, so a write reaches the array.
fn loopArray(t: *T) {
    local procs: [Proc; 3]
    procs[0] = Proc(10, "init")
    procs[1] = Proc(20, "worker")
    procs[2] = Proc(30, "reaper")
    local sum: i64 = 0
    for p in procs {
        sum = sum + (p.pid as i64)
        p.pid = p.pid + 1                 // writes into the array, not a copy
    }
    expectEq(t, sum, 60)
    expectEq(t, procs[0].pid as i64, 11)
    expectEq(t, procs[2].pid as i64, 31)
}

// `for x, i in arr`: the index is a `usize`, starts at 0 and steps by one.
fn loopArrayIndexed(t: *T) {
    local procs: [Proc; 4]
    procs[0] = Proc(1, "a")
    procs[1] = Proc(2, "b")
    procs[2] = Proc(3, "c")
    procs[3] = Proc(4, "d")
    local weight: i64 = 0
    local seen: usize = 0
    for p, i in procs {
        // The index counts from zero, one per element, in order.
        expectEqUInt(t, i, seen)
        seen = seen + 1
        weight = weight + ((i as i64) * (p.pid as i64))
    }
    expectEqUInt(t, seen, 4)
    // 0*1 + 1*2 + 2*3 + 3*4 = 20
    expectEq(t, weight, 20)
}

// A slice view `arr[lo..hi]` is not a copy: writing through it reaches the array.
fn sliceView(t: *T) {
    local buf: [i32; 6] = [1, 2, 3, 4, 5, 6]
    local mid: []i32 = buf[1..5]
    expectEqUInt(t, mid.len, 4)
    expectEq(t, mid[0] as i64, 2)
    expectEq(t, mid[3] as i64, 5)
    local sum: i64 = 0
    for v in mid {
        sum = sum + (*v as i64)
    }
    expectEq(t, sum, 14)               // 2 + 3 + 4 + 5
    // `[]i32` from a mutable array is writable: the write lands in `buf`.
    local mut_mid: []mut i32 = buf[1..5]
    local w: *i32 = mut_mid.ptr
    w[0] = 200
    expectEq(t, buf[1] as i64, 200)
}

// `buffer[..]` and `buffer[lo..]` produce a whole slice and a tail view.
fn sliceOpen(t: *T) {
    local buf: [i32; 4] = [10, 20, 30, 40]
    local all: []i32 = buf[..]
    expectEqUInt(t, all.len, 4)
    local tail: []i32 = buf[2..]
    expectEqUInt(t, tail.len, 2)
    expectEq(t, tail[0] as i64, 30)
    local head: []i32 = buf[..2]
    expectEqUInt(t, head.len, 2)
    expectEq(t, head[1] as i64, 20)
}

// An empty slice runs the body zero times.
fn emptySlice(t: *T) {
    local buf: [i32; 3] = [1, 2, 3]
    local none: []i32 = buf[1..1]
    expectEqUInt(t, none.len, 0)
    local count: i64 = 0
    for v in none {
        count = count + 1
        v = v
    }
    expectEq(t, count, 0)
}

// `str` walks bytes.
fn loopStr(t: *T) {
    local s: str = "abcd"
    local sum: i64 = 0
    for b in s {
        sum = sum + (*b as i64)
    }
    expectEq(t, sum, (97 + 98 + 99 + 100))
}

// Break and continue in the body.
fn breakContinue(t: *T) {
    local procs: [Proc; 5]
    procs[0] = Proc(1, "a")
    procs[1] = Proc(2, "b")
    procs[2] = Proc(3, "c")
    procs[3] = Proc(4, "d")
    procs[4] = Proc(5, "e")
    local sum: i64 = 0
    for p in procs {
        if p.pid == 3 { continue }
        if p.pid == 5 { break }
        sum = sum + (p.pid as i64)
    }
    expectEq(t, sum, 7)                // 1 + 2 + (skip 3) + 4, then break on 5
}

// A label on the iterating loop leaves both levels.
fn labeledLoop(t: *T) {
    local rows: [i32; 3] = [1, 2, 3]
    local cols: [i32; 3] = [10, 20, 30]
    local found: i32 = -1
    outer: for a in rows {
        for b in cols {
            if *a * *b == 60 {
                found = *a * 100 + *b
                break outer
            }
        }
    }
    expectEq(t, found as i64, 2030)    // 2 * 30
}

// `[]mut T` as a parameter: a write through it reaches the caller's array.
fn fill(v: []mut i32, base: i32) {
    for x in v {
        *x = base
        base = base + 1
    }
}

fn mutParam(t: *T) {
    local buf: [i32; 4] = [0, 0, 0, 0]
    fill(buf[..], 10)
    expectEq(t, buf[0] as i64, 10)
    expectEq(t, buf[1] as i64, 11)
    expectEq(t, buf[3] as i64, 13)
}

// A read-only `[]T` parameter can read but its element is not a place (a write is E0716).
fn sumView(v: []i32) -> i64 {
    local sum: i64 = 0
    for x in v {
        sum = sum + (*x as i64)
    }
    return sum
}

fn readonlyParam(t: *T) {
    local buf: [i32; 3] = [4, 5, 6]
    expectEq(t, sumView(buf[..]), 15)
}

@entry fn main() -> i32 {
    local s: Suite
    suiteInit(&s)
    test(&s, "for over an array, element is a pointer", loopArray)
    test(&s, "for with an index", loopArrayIndexed)
    test(&s, "slice view is not a copy", sliceView)
    test(&s, "open and half-open slices", sliceOpen)
    test(&s, "empty slice runs zero times", emptySlice)
    test(&s, "for over str walks bytes", loopStr)
    test(&s, "break and continue", breakContinue)
    test(&s, "labeled outer loop", labeledLoop)
    test(&s, "[]mut T parameter writes the caller", mutParam)
    test(&s, "[]T parameter reads only", readonlyParam)
    return suiteRun(&s)
}
