// Unit: slices — `[]T`, `[]mut T` and `buffer[lo..hi]`. A slice is a non-owning fat pointer
// (`{ ptr, len }`), the same two words as `str`; the element is typed, indexing is bounds-checked and
// a slice of a mutable owner is writable.
from "std/testing" import Suite, T, suiteInit, test, suiteRun, expectEq, expectEqUInt, expectTrue

// The layout: two words, `ptr` at offset 0 and `len` at offset 8, the same as `str`.
fn layout(t: *T) {
    expectEq(t, sizeOf([]i32), sizeOf(str))
    expectEqUInt(t, offsetOf([]i32, ptr), 0)
    expectEqUInt(t, offsetOf([]i32, len), 8)
    // `[]T` and `[]mut T` are the same size: the `mut` is a permission, not a different layout.
    expectEq(t, sizeOf([]mut i32), sizeOf([]i32))
}

// A slice from an array covers the range and reads through it.
fn readElement(t: *T) {
    local buf: [i32; 5] = [10, 20, 30, 40, 50]
    local s: []i32 = buf[..]
    expectEqUInt(t, s.len, 5)
    expectEq(t, s[0] as i64, 10)
    expectEq(t, s[4] as i64, 50)
    local tail: []i32 = buf[3..]
    expectEqUInt(t, tail.len, 2)
    expectEq(t, tail[0] as i64, 40)
}

// An empty slice has length zero; its data pointer is the base plus the start offset, which need
// not be nil (only a hand-built `{ nil, 0 }` is). The loop over it runs zero times.
fn emptyLength(t: *T) {
    local buf: [i32; 3] = [1, 2, 3]
    local s: []i32 = buf[1..1]
    expectEqUInt(t, s.len, 0)
    local count: i64 = 0
    for v in s {
        count = count + 1
        v = v
    }
    expectEq(t, count, 0)
}

// A `[]mut T` element is a place: a write lands in the owner's storage.
fn mutableWrite(t: *T) {
    local buf: [i32; 4] = [1, 2, 3, 4]
    local s: []mut i32 = buf[..]
    s[0] = 100
    s[3] = 400
    expectEq(t, buf[0] as i64, 100)
    expectEq(t, buf[3] as i64, 400)
}

// The element of a view is not a copy: a write through the data pointer changes the array.
fn ptrIsShared(t: *T) {
    local buf: [i32; 3] = [7, 8, 9]
    local s: []i32 = buf[..]
    local p: *i32 = s.ptr
    p[1] = 88
    expectEq(t, buf[1] as i64, 88)
    expectEq(t, s[1] as i64, 88)
}

// Element access is bounds-checked under --safety=checked.
fn boundsChecked(t: *T) {
    local buf: [i32; 3] = [1, 2, 3]
    local s: []i32 = buf[..]
    local panicked: i32 = 0
    try {
        local x: i32 = s[3]
        x = x
    } catch e {
        panicked = 1
    }
    expectEq(t, panicked, 1)
}

// A slice of a slice stays inside the original bytes.
fn nestedSlice(t: *T) {
    local buf: [i32; 6] = [1, 2, 3, 4, 5, 6]
    local whole: []i32 = buf[..]
    local mid: []i32 = whole[1..5]
    local inner: []i32 = mid[1..3]
    expectEqUInt(t, mid.len, 4)
    expectEqUInt(t, inner.len, 2)
    expectEq(t, inner[0] as i64, 3)
    expectEq(t, inner[1] as i64, 4)
}

@entry fn main() -> i32 {
    local s: Suite
    suiteInit(&s)
    test(&s, "slice layout is { ptr, len }", layout)
    test(&s, "reads through a view", readElement)
    test(&s, "empty slice has length zero", emptyLength)
    test(&s, "[]mut T writes the owner", mutableWrite)
    test(&s, "element pointer is shared", ptrIsShared)
    test(&s, "element access is bounds-checked", boundsChecked)
    test(&s, "slice of a slice", nestedSlice)
    return suiteRun(&s)
}
