// std/net/proto/dhcp6: the DHCPv6 client (RFC 8415) driven by hand-built server messages and a fake clock.
from "std" import print
from "std/str/string" import String
from "std/net/proto/wire" import putBe, putZeros
from "std/net/proto/dhcp6" import Dhcp6Client, Dhcp6State, Dhcp6Reply, dhcp6Parse

global failures: i32 = 0

fn check(ok: bool, what: str) {
    if !ok {
        failures++
        print("FAIL ")
        print(what)
        print("\n")
    }
}

/// A server message of `kind` for `xid` with SERVERID, and an IA_NA holding 2001:db8::5 (preferred 100 s, valid 200 s) unless
/// `status` is not 0, in which case it carries that status code instead.
fn serverMsg(kind: ui8, xid: ui32, status: ui16) -> String {
    local m: String = String()
    m.push(kind)
    putBe(&m, xid as ui64, 3)
    putBe(&m, 2, 2)                                     // SERVERID: DUID-LL, hw 1, 6 bytes
    putBe(&m, 10, 2)
    putBe(&m, 0x00030001, 4)
    putBe(&m, 0x0200000000AA, 6)
    if status != 0 {
        putBe(&m, 13, 2)
        putBe(&m, 2, 2)
        putBe(&m, status as ui64, 2)
        return m
    }
    putBe(&m, 3, 2)                                     // IA_NA: iaid, T1 0, T2 0, IAADDR
    putBe(&m, 12 + 4 + 24, 2)
    putZeros(&m, 12)
    putBe(&m, 5, 2)
    putBe(&m, 24, 2)
    putBe(&m, 0x20010db8, 4)
    putZeros(&m, 8)
    putBe(&m, 5, 4)
    putBe(&m, 100, 4)
    putBe(&m, 200, 4)
    return m
}

@entry fn main() -> i32 {
    local c: Dhcp6Client = Dhcp6Client(0x020000000001, 9)
    c.start(0)
    local sol: String = c.take()
    check(sol.at(0) == 1 && c.state == Dhcp6State.Soliciting, "SOLICIT first")
    check(sol.at(4) == 0 && sol.at(5) == 1 && sol.at(7) == 10, "client DUID-LL option comes first (type 1, 10 bytes)")

    c.tick(100)
    check(c.take().length() == 0, "no early retransmit")
    c.tick(3000)
    local again: String = c.take()
    check(again.at(0) == 1 && again.length() == sol.length(), "SOLICIT repeats with backoff")

    local adv: String = serverMsg(2, c.xid, 0)
    local parsed: Dhcp6Reply = dhcp6Parse(&adv)
    check(parsed.ok && parsed.address.length() == 16 && parsed.valid == 200 && parsed.preferred == 100, "ADVERTISE parses")
    c.recv(3100, &adv)
    local req: String = c.take()
    check(c.state == Dhcp6State.Requesting && req.at(0) == 3, "advertise leads to REQUEST")

    local fail: String = serverMsg(7, c.xid, 2)         // status NoAddrsAvail
    c.recv(3200, &fail)
    check(c.state == Dhcp6State.Soliciting, "a failure status restarts")
    c.take()

    local adv2: String = serverMsg(2, c.xid, 0)
    c.recv(3300, &adv2)
    c.take()
    local rep: String = serverMsg(7, c.xid, 0)
    c.recv(3400, &rep)
    check(c.state == Dhcp6State.Bound && c.address.length() == 16, "reply binds the address")
    check(c.t1At == 3400 + 50000 && c.t2At == 3400 + 80000 && c.endAt == 3400 + 200000, "T1/T2 default to 0.5/0.8 of preferred")

    c.tick(c.t1At)
    check(c.state == Dhcp6State.Renewing && c.take().at(0) == 5, "T1 sends RENEW")
    c.tick(c.t2At + 20000)
    local rebind: String = c.take()
    check(c.state == Dhcp6State.Rebinding && rebind.at(0) == 6, "T2 sends REBIND")

    c.tick(c.endAt + 1)
    check(c.state == Dhcp6State.Soliciting, "the valid lifetime ends: start over")

    if failures == 0 { print("dhcp6 ok\n") }
    return failures
}
