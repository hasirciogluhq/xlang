// A write through a read-only slice `[]T`: E0716. The writable view is `[]mut T`.
// `buf[..]` on a mutable local gives `[]mut T`; forcing it into `[]T` drops the write permission.
fn poke(v: []i32) {
    v[0] = 1
}

@entry fn main() -> i32 {
    local buf: [i32; 3] = [1, 2, 3]
    poke(buf[..])
    return 0
}
