// printalloc: an `@init` installs a counting allocator. The print family, fprint, fprintln and
// snprintf must make no allocator calls; sprintf and toString must make at least one.
from "std" import print, println, printEndl, fprint, fprintln, sprintf, format, snprintf, toString, Allocator, Heap, String

class Counting {
}

global delegate: Heap
global counting: Counting
global allocs: i32 = 0
global failures: i32 = 0

impl Allocator for Counting {
    fn alloc(self, size: usize, align: usize) -> *void {
        allocs = allocs + 1
        return delegate.alloc(size, align)
    }

    fn free(self, p: *void) {
        delegate.free(p)
    }
}

@init fn useCounting() {
    __builtin_setRegistered("allocator", counting)
}

fn check(name: *ui8, ok: bool) {
    if !ok {
        failures = failures + 1
        print("FAIL ")
        print(name)
        print("\n")
    }
}

fn main() -> i32 {
    local owned: String = String("owned")
    local buf: [ui8; 8]

    local before: i32 = allocs
    print("plain ")
    print(42)
    print(-1)
    print(2.5)
    print(true)
    print(&owned)
    print("{} {}\n", "fmt", 3)
    println("line")
    println(&owned)
    println("{}", 9)
    printEndl()
    fprint(1, "fd ")
    fprintln(1, "fd {}", 1)
    local n: usize = snprintf(&buf[0], 8 as usize, "abc {}", 12)
    check("print family and snprintf make no allocator calls", allocs == before)
    check("snprintf length", n == 6)

    local beforeSprintf: i32 = allocs
    local s: String = sprintf("{}", 1)
    check("sprintf makes an allocator call", allocs > beforeSprintf)
    check("sprintf text", s.len == 1)

    local beforeToString: i32 = allocs
    local t: String = toString(5)
    check("toString makes an allocator call", allocs > beforeToString)
    check("toString text", t.len == 1)

    if failures == 0 {
        print("printalloc ok\n")
    }
    return failures
}
