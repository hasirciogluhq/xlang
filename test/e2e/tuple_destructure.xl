// End-to-end: tuple destructuring — `local (a, b) = expr`.
// The form is sugar over `local $t = expr` plus one `local` per name, so the right-hand side runs
// once, the names are visible like any other local, and the element types come from the tuple.
// Exits with the number of failed checks and prints "tuple destructuring ok" when all pass.

from "std" import print, println

fn divMod(a: i64, b: i64) -> (i64, i64) {
    return (a / b, a % b)
}

fn minMax(a: i32, b: i32) -> (i32, i32) {
    if a < b {
        return (a, b)
    }
    return (b, a)
}

fn triple() -> (i32, f64, bool) {
    return (7, 2.5, true)
}

// A counter so a test can check that the right-hand side runs exactly once.
global calls: i32 = 0

fn counted(a: i32) -> (i32, i32) {
    calls++
    return (a, a * 10)
}

@entry fn main() -> i32 {
    local failures: i32 = 0

    // Two names from a two-element tuple.
    local (q, r) = divMod(17, 5)
    if q != 3 {
        println("divMod q: expected 3, got {}", q)
        failures++
    }
    if r != 2 {
        println("divMod r: expected 2, got {}", r)
        failures++
    }

    // The element order follows the tuple's, not the names' order: `minMax` returns (min, max),
    // so the first name takes the smaller value even though it is written before the larger one.
    local (low, high) = minMax(9, 4)
    if high != 9 {
        println("minMax high: expected 9, got {}", high)
        failures++
    }
    if low != 4 {
        println("minMax low: expected 4, got {}", low)
        failures++
    }

    // Three names, mixed element types (i32, f64, bool), taken apart in one statement.
    local (n, half, flag) = triple()
    if n != 7 {
        println("triple n: expected 7, got {}", n)
        failures++
    }
    if half != 2.5 {
        println("triple half: expected 2.5, got {}", half)
        failures++
    }
    if !flag {
        print("triple flag: expected true\n")
        failures++
    }

    // The right-hand side evaluates once: a call returning a tuple runs a single time.
    calls = 0
    local (a, b) = counted(4)
    if calls != 1 {
        println("call count: expected 1, got {}", calls)
        failures++
    }
    if a != 4 || b != 40 {
        println("counted: expected (4, 40), got ({}, {})", a, b)
        failures++
    }

    // A name bound by destructuring is an ordinary local: it can be reassigned and read later.
    q = q + 100
    if q != 103 {
        println("reassign q: expected 103, got {}", q)
        failures++
    }

    // Destructuring from a tuple that was already built.
    local pair: (i32, i32) = (11, 22)
    local (left, right) = pair
    if left != 11 || right != 22 {
        println("literal pair: expected (11, 22), got ({}, {})", left, right)
        failures++
    }

    // A destructured name can be passed on, and a destructured tuple can be nested in a call.
    local (m, n2) = minMax(left, right)
    if m != 11 || n2 != 22 {
        println("minMax of the pair: expected (11, 22), got ({}, {})", m, n2)
        failures++
    }

    // The right-hand side sees the outer bindings: the temporary is computed before any name is
    // bound, so `divMod(base, 2)` reads the outer `base` and not a half-bound one.
    local base: i32 = 9
    local (half_of_base, base_rem) = divMod(base, 2)
    if half_of_base != 4 {
        println("rhs read the outer value: expected 4, got {}", half_of_base)
        failures++
    }
    if base_rem != 1 {
        println("rhs remainder: expected 1, got {}", base_rem)
        failures++
    }

    if failures == 0 {
        print("tuple destructuring ok\n")
    }
    return failures
}
