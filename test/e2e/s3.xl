// S3 client end-to-end against an S3-compatible server on 127.0.0.1:18333 with the access key testkey / testsecret. The e2e runner
// starts SeaweedFS there when XLANG_E2E_S3=1 (see run.sh). Covers bucket creation, PutObject, GetObject, HeadObject, ListObjectsV2,
// a presigned GET fetched with the HTTP client, a two-part multipart upload (5 MiB first part), DeleteObject, and the NoSuchKey answer
// afterwards. Prints "s3 ok" and exits 0 on success; the exit status is the number of failed checks.
from "std" import print, String, Client, Response, S3Client, S3Result, S3List, s3ProfileGeneric

fn check(name: *ui8, ok: bool) -> i32 {
    if !ok {
        print("FAIL ")
        print(name)
        print("\n")
        return 1
    }
    return 0
}

fn fill(s: *String, piece: str, times: usize) {
    local i: usize = 0
    while i < times {
        s.append(piece)
        i = i + 1
    }
}

@entry fn main() -> i32 {
    local s3: S3Client = S3Client(s3ProfileGeneric("127.0.0.1:18333", "us-east-1", false), "testkey", "testsecret")
    local failures: i32 = 0
    local bucket: str = "xlang-e2e"

    // Rerunnable: a bucket left by an earlier run answers 409 (BucketAlreadyOwnedByYou), which is fine here.
    local made: S3Result = s3.CreateBucket(bucket)
    failures += check("create bucket", made.ok || made.status == 409)
    // Leftovers of an earlier run: the listing below must see exactly the one object this run puts.
    s3.DeleteObject(bucket, "big.bin")

    local put: S3Result = s3.PutObject(bucket, "hello.txt", "text/plain", "hello s3")
    failures += check("put", put.ok)

    local got: S3Result = s3.GetObject(bucket, "hello.txt")
    failures += check("get", got.ok && got.body.asStr().len == 8)

    local head: S3Result = s3.HeadObject(bucket, "hello.txt")
    failures += check("head", head.ok)

    local list: S3List = s3.ListObjectsV2(bucket, "", "", 100)
    failures += check("list has the object", list.result.ok && list.objects.length() == 1)

    local url: String = s3.PresignGet(bucket, "hello.txt", 300)
    local client: Client = Client()
    local viaUrl: Response = client.Get(url.asStr())
    failures += check("presigned get", viaUrl.error == 0 && viaUrl.status == 200 && viaUrl.body.asStr().len == 8)

    // Multipart: 5 MiB first part (the minimum for every part but the last), then a 4-byte last part.
    local block: String = String()
    fill(&block, "a", 1024)
    local first: String = String()
    fill(&first, block.asStr(), 5120)
    local start: S3Result = s3.CreateMultipartUpload(bucket, "big.bin", "application/octet-stream")
    failures += check("create multipart", start.ok)
    local uploadId: String = start.UploadId()
    failures += check("upload id", uploadId.asStr().len > 0)
    local p1: S3Result = s3.UploadPart(bucket, "big.bin", uploadId.asStr(), 1, first.asStr())
    local p2: S3Result = s3.UploadPart(bucket, "big.bin", uploadId.asStr(), 2, "tail")
    failures += check("upload parts", p1.ok && p2.ok)
    local parts: String = String()
    parts.append("<Part><PartNumber>1</PartNumber><ETag>")
    parts.append(p1.etag.asStr())
    parts.append("</ETag></Part><Part><PartNumber>2</PartNumber><ETag>")
    parts.append(p2.etag.asStr())
    parts.append("</ETag></Part>")
    local done: S3Result = s3.CompleteMultipartUpload(bucket, "big.bin", uploadId.asStr(), parts.asStr())
    failures += check("complete multipart", done.ok)
    local assembled: S3Result = s3.GetObject(bucket, "big.bin")
    failures += check("multipart size", assembled.ok && assembled.body.asStr().len == 5242880 + 4)

    local del: S3Result = s3.DeleteObject(bucket, "hello.txt")
    failures += check("delete", del.ok)
    local gone: S3Result = s3.GetObject(bucket, "hello.txt")
    failures += check("NoSuchKey after delete", !gone.ok && gone.status == 404)

    if failures == 0 {
        print("s3 ok\n")
    }
    return failures
}
