// utf16: the UTF-16 <-> UTF-8 boundary of std/encoding/utf16, and the byte-level string helpers it replaced inline
// loops with (findByte / findLastByte, findLast, splitAsciiWhitespace, copyTruncated).
//
// The conversion cases are the ones an OS API actually produces: an ASCII name, a name that needs two UTF-8 bytes,
// one that needs three, an astral plane character that is a surrogate pair in UTF-16 (four UTF-8 bytes), a lone high
// surrogate at the end of the input, a lone low surrogate, and a buffer too small for the next code point.
from "std" import println
from "std/encoding/utf16" import toUtf8, toUtf8Exact, utf8LenOf, valid, fromUtf8, fromWideC
from "std/str" import findByte, findLastByte, findLast, view, fromParts
from "std/str" import splitAsciiWhitespace, copyTruncated
from "std/collections/vec" import Vec
from "std/str/string" import String

global failures: i32 = 0

fn fail(what: *ui8) {
    failures = failures + 1
    println("FAIL {}", &what[0])
}

/// True when the first `n` bytes of `out` eq the NUL-terminated `want`, and `n` is exactly its length.
fn same(out: *ui8, n: usize, want: *ui8) -> bool {
    local i: usize = 0
    while want[i] != 0 {
        if i >= n || out[i] != want[i] { return false }
        i = i + 1
    }
    return i == n
}

/// UTF-8 -> a UTF-16 array at compile time is not available, so each case writes its units by hand.
@entry fn main() -> i32 {
    local out: [ui8; 32]

    // "ascii" -> UTF-16 "ascii"; one byte each.
    local ascii: [ui16; 5] = [97, 115, 99, 105, 105]
    local n: usize = toUtf8(&ascii[0], 5, &out[0], 32, true)
    if !same(&out[0], n, "ascii") || n != 5 { fail("ascii") }

    // U+00E9 "é" is 0xE9 in UTF-16 and C3 A9 in UTF-8 (two bytes).
    local eacute: [ui16; 1] = [0xe9]
    n = toUtf8(&eacute[0], 1, &out[0], 32, true)
    local wantEacute: [ui8; 3] = [0xc3, 0xa9, 0]
    if !same(&out[0], n, &wantEacute[0]) || n != 2 { fail("e-acute") }

    // U+20AC "€" is E2 82 AC (three bytes).
    local euro: [ui16; 1] = [0x20ac]
    n = toUtf8(&euro[0], 1, &out[0], 32, true)
    local wantEuro: [ui8; 4] = [0xe2, 0x82, 0xac, 0]
    if !same(&out[0], n, &wantEuro[0]) || n != 3 { fail("euro") }

    // U+1F600 is D83D DE00 in UTF-16 and F0 9F 98 80 in UTF-8: one code point from two units.
    local grin: [ui16; 2] = [0xd83d, 0xde00]
    n = toUtf8(&grin[0], 2, &out[0], 32, true)
    local wantGrin: [ui8; 5] = [0xf0, 0x9f, 0x98, 0x80, 0]
    if !same(&out[0], n, &wantGrin[0]) || n != 4 { fail("surrogate pair") }
    if !valid(&grin[0], 2) { fail("pair is valid") }

    // A lone high surrogate at the end of the input: lossy gives U+FFFD (EF BF BD), strict refuses.
    local lone: [ui16; 1] = [0xd83d]
    n = toUtf8(&lone[0], 1, &out[0], 32, true)
    local wantFffd: [ui8; 4] = [0xef, 0xbf, 0xbd, 0]
    if !same(&out[0], n, &wantFffd[0]) || n != 3 { fail("lone high is U+FFFD") }
    if toUtf8Exact(&lone[0], 1, &out[0], 32, true) != -1 { fail("strict lone high") }
    if valid(&lone[0], 1) { fail("lone high is not valid") }

    // A lone low surrogate in the middle of otherwise good text: "a" + DC00 + "b" -> "a\uFFFDb".
    local mixed: [ui16; 3] = [97, 0xdc00, 98]
    n = toUtf8(&mixed[0], 3, &out[0], 32, true)
    local wantMixed: [ui8; 6] = [97, 0xef, 0xbf, 0xbd, 98, 0]
    if !same(&out[0], n, &wantMixed[0]) || n != 5 { fail("lone low in the middle") }
    if toUtf8Exact(&mixed[0], 3, &out[0], 32, true) != -1 { fail("strict lone low") }

    // A high surrogate followed by a non-low unit is two lone units, not a pair.
    local broken: [ui16; 2] = [0xd83d, 97]
    n = toUtf8(&broken[0], 2, &out[0], 32, true)
    local wantBroken: [ui8; 5] = [0xef, 0xbf, 0xbd, 97, 0]
    if !same(&out[0], n, &wantBroken[0]) { fail("high then ascii") }

    // Capacity: room for the terminator only. "aa" with cap 2 holds one byte and the NUL.
    local two: [ui16; 2] = [97, 97]
    n = toUtf8(&two[0], 2, &out[0], 2, true)
    if n != 1 || out[0] != 97 || out[1] != 0 { fail("terminator inside the cap") }
    // Cap 3 fits both bytes plus the NUL.
    n = toUtf8(&two[0], 2, &out[0], 3, true)
    if n != 2 || out[2] != 0 { fail("fits with terminator") }
    // Without `terminate` the full cap is usable.
    n = toUtf8(&two[0], 2, &out[0], 2, false)
    if n != 2 { fail("no terminator uses the whole cap") }

    // A cut never splits a character: cap 2 for "€" (3 bytes) writes nothing of it but keeps the "a" before it.
    local eurPair: [ui16; 2] = [97, 0x20ac]
    n = toUtf8(&eurPair[0], 2, &out[0], 2, false)
    if n != 1 || out[0] != 97 { fail("cut before a whole code point") }
    // Cap 3 cannot take 'a' (1) plus '€' (3), so it stops after 'a'.
    n = toUtf8(&eurPair[0], 2, &out[0], 3, false)
    if n != 1 { fail("cut leaves the prefix whole") }
    // Cap 4 takes everything.
    n = toUtf8(&eurPair[0], 2, &out[0], 4, false)
    if n != 4 { fail("full prefix fits") }

    // utf8LenOf agrees with toUtf8 and does not write.
    if utf8LenOf(&eurPair[0], 2, 64, false) != 4 { fail("utf8LenOf full") }
    if utf8LenOf(&eurPair[0], 2, 3, false) != 1 { fail("utf8LenOf cut") }
    if utf8LenOf(&grin[0], 2, 64, true) != 4 { fail("utf8LenOf pair") }

    // An embedded NUL unit is data, not a terminator: the length comes from `n`.
    local withNul: [ui16; 3] = [97, 0, 98]
    n = toUtf8(&withNul[0], 3, &out[0], 32, true)
    if n != 3 || out[1] != 0 || out[2] != 98 { fail("embedded NUL is a unit") }
    // fromWideC is the other rule: it stops at the NUL.
    local cstr: [ui16; 5] = [97, 0, 98, 99, 0]
    if fromWideC(&cstr[0]) != 1 { fail("fromWideC stops at NUL") }

    // Round trip: UTF-8 -> UTF-16 -> UTF-8 for a string with a two-byte, a three-byte and an astral character.
    local mixedUtf8: [ui8; 10] = [97, 0xc3, 0xa9, 0xe2, 0x82, 0xac, 0xf0, 0x9f, 0x98, 0x80]
    local wide: [ui16; 16]
    local units: usize = fromUtf8(&mixedUtf8[0], 10, &wide[0], 16, true)
    if units != 5 { fail("fromUtf8 unit count") }
    if !valid(&wide[0], units) { fail("fromUtf8 produces valid UTF-16") }
    n = toUtf8(&wide[0], units, &out[0], 32, true)
    local i: usize = 0
    while i < 10 && out[i] == mixedUtf8[i] { i = i + 1 }
    if i != 10 || n != 10 { fail("round trip") }

    // Byte-level find: one-byte forms and the last-occurrence forms of std/str.
    local line: str = view("1 (bash) S 2 3 4", 0, 16)
    if findByte(line, 41) != 7 { fail("findByte ')'") }
    if findLastByte(line, 41) != 7 { fail("findLastByte ')'") }
    if findByte(line, 122) != -1 { fail("findByte absent") }
    if findLastByte(line, 122) != -1 { fail("findLastByte absent") }
    if findLast(line, ")") != 7 { fail("findLast ')'") }
    if findLast(line, "S") != 9 { fail("findLast letter") }
    if findLast(line, "zz") != -1 { fail("findLast absent") }

    // splitAsciiWhitespace: a run of whitespace is one separator, leading and trailing runs vanish.
    local words: Vec<String> = splitAsciiWhitespace(view("  alpha \t beta\n gamma  ", 0, 23))
    if words.len != 3 { fail("split count") }
    if words.len == 3 {
        if !eqWord(&words, 0, "alpha") { fail("split 0") }
        if !eqWord(&words, 1, "beta") { fail("split 1") }
        if !eqWord(&words, 2, "gamma") { fail("split 2") }
    }
    local none: Vec<String> = splitAsciiWhitespace(view(" \t\n ", 0, 4))
    if none.len != 0 { fail("split whitespace only") }

    // copyTruncated: a cut backs up to the previous character boundary, never into the middle of one.
    // The bytes are é (C3 A9), € (E2 82 AC) and 😀 (F0 9F 98 80): 2 + 3 + 4 = 9.
    local buf: [ui8; 16]
    local raw: [ui8; 9] = [0xc3, 0xa9, 0xe2, 0x82, 0xac, 0xf0, 0x9f, 0x98, 0x80]
    local src: str = fromParts(&raw[0], 9)
    if copyTruncated(src, &buf[0], 16) != 9 { fail("copyTruncated fits") }
    if copyTruncated(src, &buf[0], 9) != 9 { fail("copyTruncated exact") }
    // Cap 8 is one byte short of the whole string, so 😀 is dropped whole and é€ remain (5 bytes).
    if copyTruncated(src, &buf[0], 8) != 5 { fail("copyTruncated drops the straddling char") }
    // Cap 4 falls inside € (é ends at 2, € needs 2..5), so only é survives.
    if copyTruncated(src, &buf[0], 4) != 2 { fail("copyTruncated backs up to é") }
    // Cap 5 holds é€ exactly.
    if copyTruncated(src, &buf[0], 5) != 5 { fail("copyTruncated holds é€") }
    // Cap 6 is one byte into 😀, which is dropped whole: still é€.
    if copyTruncated(src, &buf[0], 6) != 5 { fail("copyTruncated caps at é€") }
    // Cap 2 and 1 hold é alone (é is exactly 2).
    if copyTruncated(src, &buf[0], 2) != 2 { fail("copyTruncated exact é") }
    if copyTruncated(src, &buf[0], 1) != 0 { fail("copyTruncated cuts inside é") }
    // An ASCII string is cut on the cap with no backing up.
    local plain: str = view("abcdef", 0, 6)
    if copyTruncated(plain, &buf[0], 4) != 4 { fail("copyTruncated ascii") }

    if failures == 0 {
        println("utf16 ok")
        return 0
    }
    return 1
}

fn eqWord(v: *Vec<String>, i: usize, want: *ui8) -> bool {
    local w: *String = v.get(i)
    local k: usize = 0
    while want[k] != 0 {
        if k >= w.len || w.ptr[k] != want[k] { return false }
        k = k + 1
    }
    return k == w.len
}
