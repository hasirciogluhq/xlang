// std/net/proto/dhcpclient: the DHCPv4 state machine (RFC 2131 section 4.4) driven by hand-built server messages and a fake clock.
from "std" import print
from "std/str/string" import String
from "std/net/proto/wire" import putBe, putZeros
from "std/net/proto/dhcp" import DhcpKind, DhcpReply, dhcpParseReply
from "std/net/proto/dhcpclient" import DhcpClient, DhcpState

global failures: i32 = 0

fn check(ok: bool, what: str) {
    if !ok {
        failures++
        print("FAIL ")
        print(what)
        print("\n")
    }
}

fn opt(m: *String, code: ui8, v: ui64) {
    m.push(code)
    m.push(4)
    putBe(m, v, 4)
}

/// A server message of `kind` for transaction `xid`: yiaddr 10.0.0.5, server 10.0.0.1, lease 100 s.
fn serverMsg(kind: ui8, xid: ui32) -> String {
    local m: String = String()
    m.push(2)
    m.push(1)
    m.push(6)
    m.push(0)
    putBe(&m, xid as ui64, 4)
    putZeros(&m, 8)
    putBe(&m, 0x0A000005, 4)
    putZeros(&m, 4 + 4 + 16 + 64 + 128)
    putBe(&m, 0x63825363, 4)
    m.push(53)
    m.push(1)
    m.push(kind)
    opt(&m, 54, 0x0A000001)
    opt(&m, 51, 100)
    opt(&m, 1, 0xFFFFFF00)
    m.push(255)
    return m
}

@entry fn main() -> i32 {
    local c: DhcpClient = DhcpClient(0x020000000001, 7)
    c.start(1000)
    local p: String = c.take()
    local d: DhcpReply = dhcpParseReply(&p)
    check(p.length() == 300 && p.at(0) == 1, "discover is a 300-byte BOOTREQUEST")
    check(c.dest == 0xFFFFFFFF && c.state == DhcpState.Selecting, "discover is broadcast")

    c.tick(1000)                                        // not due yet: nothing is sent
    check(c.take().length() == 0, "no early retransmit")
    c.tick(6000)                                        // 4 s +- 1 s has passed: DISCOVER again
    check(c.take().length() == 300, "discover is retransmitted")

    local offer: String = serverMsg(2, c.xid)
    c.recv(7000, &offer)
    local req: String = c.take()
    check(c.state == DhcpState.Requesting && req.length() == 300, "offer leads to a request")
    check(req.at(240) == 53 && req.at(242) == 3, "it is a REQUEST")

    local other: String = serverMsg(5, c.xid + 1)       // another transaction is ignored
    c.recv(7100, &other)
    check(c.state == DhcpState.Requesting, "foreign xid ignored")

    local ack: String = serverMsg(5, c.xid)
    c.recv(7200, &ack)
    check(c.state == DhcpState.Bound && c.address() == 0x0A000005, "ack binds the address")
    check(c.t1At == 7200 + 50000 && c.t2At == 7200 + 87500 && c.endAt == 7200 + 100000, "T1/T2 default to 0.5/0.875")

    c.tick(7200 + 50000)                                // T1: unicast RENEW to the server
    local renew: String = c.take()
    check(c.state == DhcpState.Renewing && c.dest == 0x0A000001 && renew.length() == 300, "T1 renews by unicast")
    check(renew.at(12) == 10 && renew.at(15) == 5, "ciaddr is the leased address")

    c.tick(7200 + 87500 + 70000)                        // T2 passed with no answer: broadcast REBIND
    check(c.state == DhcpState.Rebinding && c.dest == 0xFFFFFFFF, "T2 rebinds by broadcast")
    c.take()
    local ack2: String = serverMsg(5, c.xid)
    c.recv(200000, &ack2)
    check(c.state == DhcpState.Bound && c.endAt == 200000 + 100000, "ack renews the lease")

    local nak: String = serverMsg(6, c.xid)
    c.tick(c.t1At)
    c.take()
    c.recv(c.t1At + 10, &nak)
    check(c.state == DhcpState.Init && c.address() == 0, "nak drops the lease")

    c.start(400000)
    c.take()
    local offer2: String = serverMsg(2, c.xid)
    c.recv(400001, &offer2)
    local ack3: String = serverMsg(5, c.xid)
    c.recv(400002, &ack3)
    c.release(400003)
    local rel: String = c.take()
    check(rel.at(242) == 7 && c.dest == 0x0A000001 && c.state == DhcpState.Init, "release goes to the server")

    if failures == 0 { print("dhcpclient ok\n") }
    return failures
}
