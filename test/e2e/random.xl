// std/random tests: RFC 8439 ChaCha20 block vector, SplitMix64 and Xoshiro256** reference values, bounds and
// distribution sanity for the generators, and RFC 9562 UUID layout. No Python: every expected value is from
// a specification or computed by hand from the algorithm in its documentation.
from "std/random" import randomBytes, randomU64, Csprng, Xoshiro256, splitMix64, mulHigh, shuffle, uuidV4, uuidV7, uuidString
from "std/crypto/cipher/chacha20poly1305" import chacha20Block
from "std" import print

global failures: i32 = 0

fn check(ok: bool, what: *ui8) {
    if !ok {
        failures = failures + 1
        print("FAIL ")
        print(what)
        print("\n")
    }
}

/// 64-bit constant from two 32-bit halves.
fn word(hi: ui32, lo: ui32) -> ui64 {
    return ((hi as ui64) << 32) | (lo as ui64)
}

fn chachaRfc8439() {
    // RFC 8439 section 2.3.2: key 00..1f, nonce 00:00:00:09:00:00:00:4a:00:00:00:00, block counter 1.
    local key: [ui8; 32]
    local i: usize = 0
    while i < 32 {
        key[i] = i as ui8
        i = i + 1
    }
    local nonce: [ui8; 12] = [0, 0, 0, 9, 0, 0, 0, 0x4a, 0, 0, 0, 0]
    local out: [ui8; 64]
    chacha20Block(&key[0], 1, &nonce[0], &out[0])
    local want: [ui8; 16] = [0x10, 0xf1, 0xe7, 0xe4, 0xd1, 0x3b, 0x59, 0x15, 0x50, 0x0f, 0xdd, 0x1f, 0xa3, 0x20, 0x71, 0xc4]
    i = 0
    while i < 16 {
        check(out[i] == want[i], "chacha20Block RFC 8439 2.3.2")
        i = i + 1
    }
}

fn splitMixVector() {
    // Vigna's splitmix64.c with state 0: the first two outputs.
    local st: ui64 = 0
    check(splitMix64(&st) == word(0xe220a839, 0x7b1dcdaf), "splitMix64 #1")
    check(splitMix64(&st) == word(0x6e789e6a, 0xa1b965f4), "splitMix64 #2")
}

fn xoshiroVector() {
    // State {1, 2, 3, 4}: result = rotl(s[1] * 5, 7) * 9. First output 11520; the second is 0 because s[1] becomes 0.
    local r: Xoshiro256 = Xoshiro256(7)
    r.s[0] = 1
    r.s[1] = 2
    r.s[2] = 3
    r.s[3] = 4
    check(r.next() == 11520, "xoshiro256** #1")
    check(r.next() == 0, "xoshiro256** #2")
}

fn mulHighVector() {
    check(mulHigh(word(0x80000000, 0), 4) == 2, "mulHigh 2^63 * 4")
    check(mulHigh(word(0xffffffff, 0xffffffff), word(0xffffffff, 0xffffffff)) == word(0xffffffff, 0xfffffffe), "mulHigh max*max")
    check(mulHigh(3, 5) == 0, "mulHigh small")
}

fn seededIsRepeatable() {
    local a: Xoshiro256 = Xoshiro256(42)
    local b: Xoshiro256 = Xoshiro256(42)
    local c: Xoshiro256 = Xoshiro256(43)
    local same: bool = true
    local differs: bool = false
    local i: usize = 0
    while i < 16 {
        local x: ui64 = a.next()
        local y: ui64 = b.next()
        local z: ui64 = c.next()
        if x != y { same = false }
        if x != z { differs = true }
        i = i + 1
    }
    check(same, "same seed, same sequence")
    check(differs, "different seed, different sequence")
}

fn boundsAndDistribution() {
    local r: Xoshiro256 = Xoshiro256(2024)
    // below(10): every value appears, and each bucket is near 1000 of 10000 draws.
    local hist: [usize; 10]
    local i: usize = 0
    while i < 10 {
        hist[i] = 0
        i = i + 1
    }
    i = 0
    while i < 10000 {
        local v: ui64 = r.below(10)
        check(v < 10, "below(10) in range")
        hist[v as usize] = hist[v as usize] + 1
        i = i + 1
    }
    i = 0
    while i < 10 {
        check(hist[i] > 800 && hist[i] < 1200, "below(10) bucket near uniform")
        i = i + 1
    }
    // between(-5, 5) includes both ends; the full i64 range does not panic.
    local lo: bool = false
    local hi: bool = false
    i = 0
    while i < 2000 {
        local x: i64 = r.between(-5, 5)
        check(x >= -5 && x <= 5, "between(-5, 5) in range")
        if x == -5 { lo = true }
        if x == 5 { hi = true }
        i = i + 1
    }
    check(lo && hi, "between reaches both ends")
    // The full i64 range: the count wraps to 0 and must take the whole-range path, not panic.
    local full: i64 = r.between(-9223372036854775807 - 1, 9223372036854775807)
    check(full >= -9223372036854775807 - 1, "between full i64 range")
    // float64 in [0, 1) and the mean is near one half.
    local sum: f64 = 0.0
    i = 0
    while i < 10000 {
        local f: f64 = r.float64()
        check(f >= 0.0 && f < 1.0, "float64 in [0,1)")
        sum = sum + f
        i = i + 1
    }
    check(sum > 4500.0 && sum < 5500.0, "float64 mean near 0.5")
}

fn shuffleKeepsElements() {
    local r: Xoshiro256 = Xoshiro256(9)
    local v: [i32; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
    shuffle<i32>(&r, &v[0], 8)
    local sum: i32 = 0
    local i: usize = 0
    while i < 8 {
        sum = sum + v[i]
        i = i + 1
    }
    check(sum == 36, "shuffle keeps the multiset")
}

fn csprngBytes() {
    local c: Csprng = Csprng()
    local a: [ui8; 16384]
    local b: [ui8; 16384]
    c.fill(&a[0], 16384)
    c.fill(&b[0], 16384)
    local hist: [usize; 256]
    local i: usize = 0
    while i < 256 {
        hist[i] = 0
        i = i + 1
    }
    local equal: usize = 0
    i = 0
    while i < 16384 {
        hist[a[i] as usize] = hist[a[i] as usize] + 1
        if a[i] == b[i] { equal = equal + 1 }
        i = i + 1
    }
    // 16384 bytes over 256 values: expected 64 each; 20..120 is far outside normal variation.
    i = 0
    while i < 256 {
        check(hist[i] > 20 && hist[i] < 120, "csprng byte histogram near uniform")
        i = i + 1
    }
    // Two independent 16 KiB draws agree on about 64 bytes; 1000 would mean the stream repeats.
    check(equal < 1000, "csprng consecutive fills differ")
    check(c.nextU64() != c.nextU64(), "csprng u64 values differ")
    local seed: [ui8; 16]
    randomBytes(&seed[0], 16)
    check(randomU64() != randomU64(), "os entropy u64 values differ")
}

fn uuidLayout() {
    // RFC 9562: bytes 00..0f give the canonical text form.
    local raw: [ui8; 16]
    local i: usize = 0
    while i < 16 {
        raw[i] = i as ui8
        i = i + 1
    }
    local text: [ui8; 36]
    uuidString(&raw[0], &text[0])
    local want: *ui8 = "00010203-0405-0607-0809-0a0b0c0d0e0f"
    i = 0
    while i < 36 {
        check(text[i] == want[i], "uuidString canonical form")
        i = i + 1
    }
    // v4: version nibble 4, variant bits 10.
    local u4: [ui8; 16]
    uuidV4(&u4[0])
    check(u4[6] >> 4 == 4, "uuidV4 version 4")
    check(u4[8] >> 6 == 2, "uuidV4 variant 10")
    // v7: the timestamp occupies bytes 0..5 big-endian, version nibble 7, variant 10.
    local u7: [ui8; 16]
    uuidV7(&u7[0], word(0x0123, 0x456789ab))
    check(u7[0] == 0x01 && u7[1] == 0x23 && u7[2] == 0x45 && u7[3] == 0x67 && u7[4] == 0x89 && u7[5] == 0xab, "uuidV7 timestamp bytes")
    check(u7[6] >> 4 == 7, "uuidV7 version 7")
    check(u7[8] >> 6 == 2, "uuidV7 variant 10")
    uuidString(&u7[0], &text[0])
    check(text[8] == 45 && text[13] == 45 && text[18] == 45 && text[23] == 45, "uuidString hyphens")
    check(text[14] == 55, "uuidString version digit 7")
}

@entry fn main() -> i32 {
    chachaRfc8439()
    splitMixVector()
    xoshiroVector()
    mulHighVector()
    seededIsRepeatable()
    boundsAndDistribution()
    shuffleKeepsElements()
    csprngBytes()
    uuidLayout()
    if failures == 0 {
        print("random ok\n")
        return 0
    }
    return 1
}
