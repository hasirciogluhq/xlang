// Bit operators: & | ^ ~ << >> (Go-style precedence: `& << >>` bind like `*`, `| ^` like `+`).
from "std" import println, print, printInt, printUInt

global failures: i32 = 0
global mask: ui32 = 0xff00 | 0x00f0
global shifted: ui64 = 1 << 40

fn check(name: *ui8, got: ui64, want: ui64) {
    if got != want {
        failures = failures + 1
        print("FAIL ")
        print(name)
        print(": got ")
        printUInt(got)
        print(", want ")
        printUInt(want)
        println("")
    }
}

fn rotr32(x: ui32, n: ui32) -> ui32 {
    return (x >> n) | (x << (32 - n))
}

fn main() -> i32 {
    local a: ui32 = 0xf0f0f0f0
    local b: ui32 = 0x0ff00ff0
    check("and", (a & b) as ui64, 0x00f000f0)
    check("or", (a | b) as ui64, 0xfff0fff0)
    check("xor", (a ^ b) as ui64, 0xff00ff00)
    check("not", (~a) as ui64, 0x0f0f0f0f)
    check("not8", (~(5 as ui8)) as ui64, 250)
    check("shl", (1 as ui32 << 31) as ui64, 0x80000000)
    check("shl-wrap", (0xffffffff as ui32 << 4) as ui64, 0xfffffff0)
    check("shr", (a >> 28) as ui64, 0xf)
    check("rotr", rotr32(0x80000001, 4) as ui64, 0x18000000)

    // counts >= width give 0 (no poison), whatever the count type
    local big: usize = 32
    check("shl-over", (a << big) as ui64, 0)
    check("shr-over", (a >> 40) as ui64, 0)

    // signed >> is arithmetic
    local n: i64 = -17
    check("sar", (n >> 2) as ui64, (-5) as ui64)
    local m: i32 = -1
    check("sar-over", (m >> 99) as ui64, (-1 as i64) as ui64)
    check("sar-small", (-8 as i8 >> 1) as i64 as ui64, (-4 as i64) as ui64)

    // precedence: `&` like `*`, `|` like `+`
    check("prec1", (1 | 2 & 3) as ui64, 3)
    check("prec2", (2 + 1 << 2) as ui64, 6)    // 2 + (1 << 2)
    check("prec3", (6 & 3 + 1) as ui64, 3)     // (6 & 3) + 1
    check("prec4", (1 ^ 3 | 4) as ui64, 6)

    // mixed use
    local byte: ui8 = 0xab
    check("hi-nibble", ((byte >> 4) & 0xf) as ui64, 0xa)
    check("lo-nibble", (byte & 0xf) as ui64, 0xb)
    local word: ui32 = (byte as ui32) << 24 | (0x12 as ui32) << 16
    check("pack", word as ui64, 0xab120000)

    // constants
    check("global-or", mask as ui64, 0xfff0)
    check("global-shl", shifted, 1099511627776)

    if failures == 0 {
        println("bitops ok")
        return 0
    }
    return 1
}
