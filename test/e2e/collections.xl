// Collections: the owned, growable String (std/string), the growable Vec<T> (std/vec) and the file
// round trip through String.
from "std" import print, String, Vec, vecClone, fsWrite, fsReadAllString, fsRemove

global failures: i32 = 0

fn check(name: *ui8, ok: bool) {
    if !ok {
        failures = failures + 1
        print("FAIL ")
        print(name)
        print("\n")
    }
}

fn main() -> i32 {
    local s: String = String("Jones")
    check("length from a literal", s.length() == 5)
    s.append(" and ")
    local tail: String = String("x")
    s.append(&tail)
    check("append str and String", s.equals("Jones and x"))
    check("equals String", s.equals(&tail) == false)

    local copy: String = s.clone()
    s.clear()
    check("clone is independent", copy.equals("Jones and x") && s.length() == 0)

    local nul: String = String("a\0b")
    check("embedded NUL survives", nul.length() == 3 && nul.at(1) == 0)

    local grow: String = String()
    local i: i32 = 0
    while i < 1000 {
        grow.push(65)
        i = i + 1
    }
    check("push grows", grow.length() == 1000 && grow.at(999) == 65)

    local word: String = String("abc")
    check("cstr ends with NUL", word.cstr()[3] == 0)
    local empty: String = String()
    check("empty cstr", empty.cstr()[0] == 0)

    local path: *ui8 = "xlang_e2e_collections.tmp"
    check("write", fsWrite(path, "round trip\n\0 bytes"))
    local read: String = fsReadAllString(path)
    check("read back", read.length() == 18 && read.at(17) == 115 && read.at(11) == 0)
    fsRemove(path)

    local nums: Vec<i32> = Vec<i32>()
    check("vec starts empty", nums.isEmpty() && nums.length() == 0 && nums.capacity() == 0)
    nums.push(10)
    check("first push allocates 4", nums.capacity() == 4 && *nums.get(0) == 10)
    nums.push(20)
    nums.push(30)
    nums.insert(1, 15)
    check("insert shifts", *nums.get(1) == 15 && *nums.get(2) == 20 && nums.length() == 4)
    nums.push(40)
    check("growth doubles", nums.capacity() == 8 && *nums.last() == 40 && *nums.first() == 10)
    check("remove returns and shifts", nums.remove(0) == 10 && *nums.get(0) == 15)
    check("swapRemove moves last", nums.swapRemove(0) == 15 && *nums.get(0) == 40 && nums.length() == 3)
    nums.set(2, 99)
    check("set replaces", *nums.last() == 99)
    check("pop returns last", nums.pop() == 99 && nums.length() == 2)
    nums.reserve(20)
    check("reserve grows once", nums.capacity() == 20 && nums.length() == 2)
    nums.truncate(1)
    check("truncate keeps prefix", nums.length() == 1 && *nums.get(0) == 40)
    local copyNums: Vec<i32> = vecClone(&nums)
    nums.clear()
    check("vecClone is independent", copyNums.length() == 1 && *copyNums.get(0) == 40 && nums.isEmpty())

    local strs: Vec<String> = Vec<String>()
    strs.push(String("one"))
    strs.push(String("two"))
    local taken: String = strs.pop()
    check("Vec of String moves out", taken.equals("two") && strs.length() == 1)
    strs.push(String("three"))
    check("Vec of String keeps elements", strs.get(0).equals("one") && strs.get(1).equals("three"))

    if failures == 0 {
        print("collections ok\n")
    }
    return failures
}
