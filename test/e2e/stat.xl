// std/io/stat: `fsStat` on a file this test writes, on a directory and on a missing path; the clock must agree with the mtime.
from "std" import print, sysClockSeconds
from "std/sys" import sysOpenWrite, sysWrite, sysClose, sysUnlink
from "std/io/stat" import fsStat, FILE_MODE_TYPE, FILE_MODE_DIR

global failures: i32 = 0

fn check(ok: bool, what: str) {
    if !ok {
        failures++
        print("FAIL ")
        print(what)
        print("\n")
    }
}

@entry fn main() -> i32 {
    local fd: i32 = sysOpenWrite("stat_test.tmp", false)
    check(fd >= 0 && sysWrite(fd, "hello", 5) == 5, "write the file")
    sysClose(fd)
    local f = fsStat("stat_test.tmp")
    check(f.ok && f.size == 5, "a file has its size")
    check((f.mode & FILE_MODE_TYPE) != FILE_MODE_DIR, "a file is not a directory")
    check(f.mtimeSec > sysClockSeconds() - 120 && f.mtimeSec <= sysClockSeconds() + 5, "mtime is recent")
    sysUnlink("stat_test.tmp")

    local d = fsStat(".")
    check(d.ok && (d.mode & FILE_MODE_TYPE) == FILE_MODE_DIR, "a directory is a directory")
    check(!fsStat("no_such_file.tmp").ok, "a missing path fails")

    if failures == 0 { print("stat ok\n") }
    return failures
}
