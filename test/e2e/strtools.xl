// Strings: the str helpers, String additions and format / fmtAppend.
from "std" import print, format, fmtAppend, String, Vec, strFind, strContains, strStartsWith, strEndsWith, strTrim, strSplit, strToI64, strToU64, strEq

global failures: i32 = 0

fn check(name: *ui8, ok: bool) {
    if !ok {
        failures = failures + 1
        print("FAIL ")
        print(name)
        print("\n")
    }
}

fn main() -> i32 {
    check("find", strFind("hello world", "o w") == 4)
    check("find absent", strFind("hello", "xyz") == -1)
    check("find empty needle", strFind("abc", "") == 0)
    check("contains", strContains("abcdef", "cde") && !strContains("abc", "d"))
    check("starts with", strStartsWith("prefix-x", "prefix") && !strStartsWith("pre", "prefix"))
    check("ends with", strEndsWith("file.xl", ".xl") && !strEndsWith("xl", "file.xl"))

    local trimmed: str = strTrim("  \t hi there \n")
    check("trim", strEq(trimmed, "hi there"))
    check("trim all blanks", strTrim(" \r\n ").len == 0)

    local parts: Vec<str> = strSplit("a,,bc,", ",")
    check("split count keeps empty pieces", parts.length() == 4)
    local p0: str = *parts.get(0)
    local p1: str = *parts.get(1)
    local p2: str = *parts.get(2)
    local p3: str = *parts.get(3)
    check("split pieces", strEq(p0, "a") && p1.len == 0 && strEq(p2, "bc") && p3.len == 0)

    local n: i64 = 0
    check("i64 positive", strToI64("12345", &n) && n == 12345)
    check("i64 negative", strToI64("-42", &n) && n == -42)
    check("i64 minimum", strToI64("-9223372036854775808", &n) && n == (0 - 9223372036854775807) - 1)
    check("i64 overflow", !strToI64("9223372036854775808", &n))
    check("i64 lone sign", !strToI64("-", &n))
    check("i64 junk", !strToI64("12a", &n))

    local u: ui64 = 0
    check("u64 maximum", strToU64("18446744073709551615", &u) && u + 1 == 0)
    check("u64 overflow", !strToU64("18446744073709551616", &u))
    check("u64 empty", !strToU64("", &u))

    local src: String = String("MiXeD 1")
    local low: String = src.toLowerAscii()
    local up: String = src.toUpperAscii()
    check("lower", low.equals("mixed 1"))
    check("upper", up.equals("MIXED 1") && src.equals("MiXeD 1"))
    check("String find, starts, ends", src.find("X") == 2 && src.startsWith("Mi") && src.endsWith(" 1"))
    check("String slice", strEq(src.slice(0, 2), "Mi"))
    local filled: String = String(3, 65)
    check("String filled with a byte", filled.equals("AAA") && filled.cstr()[3] == 0)

    local msg: String = format("{} + {} = {}", 1, 2, 3)
    check("format three", msg.equals("1 + 2 = 3"))
    local acc: String = String("x=")
    fmtAppend(&acc, "{} {{}} {}", -7, true)
    check("fmtAppend with braces and bool", acc.equals("x=-7 {} true"))
    check("format float", format("{}", 2.5).equals("2.500000"))

    if failures == 0 {
        print("strtools ok\n")
    }
    return failures
}
