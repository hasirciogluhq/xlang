// End-to-end: the `for` family — range (exclusive and inclusive), three-clause, labeled jumps.
// Exits with the number of failed checks and prints "for ok" when all pass.

from "std" import print, println

// A bound from a call, to check that both bounds are evaluated once and that a literal bound
// takes the type of the call's result without a written `as`.
fn limit() -> i64 {
    return 4
}

fn countdown(n: i64) -> i64 {
    local sum: i64 = 0
    for i in 0..=n { sum += i }
    return sum
}

@entry fn main() -> i32 {
    local failures: i32 = 0

    // 1. exclusive range: 0,1,2,3,4
    local sum: i64 = 0
    local count: i64 = 0
    for i in 0..5 {
        sum += i
        count += 1
    }
    if sum != 10 {
        println("exclusive sum: expected 10, got {}", sum)
        failures++
    }
    if count != 5 {
        println("exclusive count: expected 5, got {}", count)
        failures++
    }

    // 2. inclusive range: 0..=5 runs six times
    local sumInc: i64 = 0
    local countInc: i64 = 0
    for i in 0..=5 {
        sumInc += i
        countInc += 1
    }
    if sumInc != 15 {
        println("inclusive sum: expected 15, got {}", sumInc)
        failures++
    }
    if countInc != 6 {
        println("inclusive count: expected 6, got {}", countInc)
        failures++
    }

    // 3. inclusive and exclusive at a single point: 3..=3 runs once, 3..3 runs zero times
    local one: i64 = 0
    for i in 3..=3 { one += 1 }
    if one != 1 {
        println("single inclusive: expected 1, got {}", one)
        failures++
    }
    local none: i64 = 0
    for i in 3..3 { none += 1 }
    if none != 0 {
        println("single exclusive: expected 0, got {}", none)
        failures++
    }

    // 4. a reversed range is empty
    local reversed: i64 = 0
    for i in 5..2 { reversed += 1 }
    if reversed != 0 {
        println("reversed range: expected 0 iterations, got {}", reversed)
        failures++
    }

    // 5. variable bounds on both sides
    local lo: i64 = 2
    local hi: i64 = 6
    local varSum: i64 = 0
    for i in lo..hi { varSum += i }
    if varSum != 14 {
        println("variable bounds: expected 14, got {}", varSum)
        failures++
    }
    local varSumInc: i64 = 0
    for i in lo..=hi { varSumInc += i }
    if varSumInc != 20 {
        println("variable inclusive: expected 20, got {}", varSumInc)
        failures++
    }

    // 6. a call as the upper bound, with a literal lower bound: no `as` is needed
    local fromCall: i64 = 0
    for i in 0..limit() { fromCall += 1 }
    if fromCall != 4 {
        println("call bound exclusive: expected 4, got {}", fromCall)
        failures++
    }
    local fromCallInc: i64 = 0
    for i in 0..=limit() { fromCallInc += 1 }
    if fromCallInc != 5 {
        println("call bound inclusive: expected 5, got {}", fromCallInc)
        failures++
    }

    // 7. the bound is evaluated once, before the first iteration
    if countdown(5) != 15 {
        println("countdown(5): expected 15, got {}", countdown(5))
        failures++
    }

    // 8. three-clause forms, each part optional
    local a: i64 = 0
    for local i: i64 = 0; i < 4; i++ { a += i }
    if a != 6 {
        println("three-clause: expected 6, got {}", a)
        failures++
    }
    local b: i64 = 0
    for ; b < 3; b++ { }
    if b != 3 {
        println("no init: expected 3, got {}", b)
        failures++
    }
    local c: i64 = 0
    for local i: i64 = 0; i < 3; {
        c += 1
        i++
    }
    if c != 3 {
        println("no step: expected 3, got {}", c)
        failures++
    }
    local d: i64 = 0
    for local i: i64 = 0; ; i++ {
        if i == 3 { break }
        d += 1
    }
    if d != 3 {
        println("no cond: expected 3, got {}", d)
        failures++
    }

    // 9. labeled jumps out of nested ranges
    local outerSum: i64 = 0
    outer: for i in 0..3 {
        for j in 0..10 {
            if j == 2 { continue outer }
            outerSum += 1
        }
    }
    if outerSum != 6 {
        println("continue outer: expected 6, got {}", outerSum)
        failures++
    }
    local afterBreak: i64 = 0
    outer2: for i in 0..5 {
        for j in 0..5 {
            if i == 2 { break outer2 }
            afterBreak += 1
        }
    }
    if afterBreak != 10 {
        println("break outer: expected 10, got {}", afterBreak)
        failures++
    }

    // 10. nested ranges keep their own bounds
    local nested: i64 = 0
    for i in 0..=2 {
        for j in 0..=1 {
            nested += 1
        }
    }
    if nested != 6 {
        println("nested ranges: expected 6, got {}", nested)
        failures++
    }

    if failures == 0 {
        print("for ok\n")
    }
    return failures
}
