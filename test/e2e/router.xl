// End-to-end: the Gin-style router driven without a socket: every request is a Context with fd -1 (the answer is dropped, the
// status is recorded). Covers the Gin routing rules: static and parameter routes, catch-all, groups with their own middleware,
// middleware order, trailing-slash redirects, 404 and the route-conflict rule. Prints "router ok" when every check passes; the exit
// status is the number of failed checks.
from "std" import print, eq, Engine, Context, RouterGroup

global failures: i32 = 0
global hit: i32 = 0
global trace: i32 = 0
global paramOk: bool = false

fn check(name: *ui8, ok: bool) {
    if !ok {
        failures += 1
        print("FAIL ")
        print(name)
        print("\n")
    }
}

fn request(e: *Engine, method: str, path: str) -> Context {
    local c: Context = Context(-1, nil)
    c.method = method
    c.path = path
    e.Serve(&c)
    return c
}

@entry fn main() -> i32 {
    local e: Engine = Engine()
    e.GET("/", fn(c: *Context) { hit = 1 })
    e.GET("/users/:id", fn(c: *Context) {
        hit = 2
        paramOk = eq(c.Param("id"), "42")
    })
    e.GET("/users/me", fn(c: *Context) { hit = 3 })
    e.GET("/files/*path", fn(c: *Context) {
        hit = 4
        paramOk = eq(c.Param("path"), "/a/b.txt")
    })
    e.POST("/users", fn(c: *Context) { hit = 6 })
    e.Use(fn(c: *Context) {
        trace = trace + 1
        c.Next()
    })
    local api: *RouterGroup = e.Group("/api")
    api.GET("/ping", fn(c: *Context) { hit = 5 })

    hit = 0
    request(&e, "GET", "/")
    check("root", hit == 1)
    hit = 0
    request(&e, "GET", "/users/42")
    check("param", hit == 2 && paramOk)
    hit = 0
    request(&e, "GET", "/users/me")
    check("static wins", hit == 3)
    hit = 0
    request(&e, "GET", "/files/a/b.txt")
    check("catch-all", hit == 4 && paramOk)
    hit = 0
    request(&e, "POST", "/users")
    check("post", hit == 6)
    hit = 0
    trace = 0
    local ping: Context = request(&e, "GET", "/api/ping")
    check("group and global middleware", hit == 5 && trace == 1)
    local missing: Context = request(&e, "GET", "/nope")
    check("404", missing.statusCode == 404)
    local slash: Context = request(&e, "GET", "/users/42/")
    check("trailing slash redirects", slash.statusCode == 301)

    if failures == 0 {
        print("router ok\n")
    }
    return failures
}
