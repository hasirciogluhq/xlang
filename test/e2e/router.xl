// End-to-end: the Gin-style router (params, catch-all, groups, middleware, 404/405) driven without a
// socket. Handlers record what they saw. Exits with the number of failed checks and prints
// "router ok" when all pass.
from "std" import print, println, cstrEq, Router, Group, Context, routerInit, routerGet, routerPost, routerUse, routerGroup, groupGet, groupUse, routerDispatch, routerNoRoute, ctxInit, ctxParam, ctxNext, ctxAbort

global failures: i32 = 0
global hit: i32 = 0
global trace: i32 = 0
global lastParam: *ui8 = nil

fn check(name: *ui8, ok: bool) {
    if !ok {
        failures += 1
        print("FAIL ")
        println(name)
    }
}

fn root(c: *Context) { hit = 1 }
fn user(c: *Context) {
    hit = 2
    lastParam = ctxParam(c, "id")
}
fn me(c: *Context) { hit = 3 }
fn files(c: *Context) {
    hit = 4
    lastParam = ctxParam(c, "path")
}
fn apiPing(c: *Context) { hit = 5 }
fn create(c: *Context) { hit = 6 }
fn notFound(c: *Context) { hit = 99 }
fn guard(c: *Context) {
    trace += 1
    ctxNext(c)
    trace += 10
}

fn run(r: *Router, method: *ui8, path: *ui8) {
    local c: Context
    local buf: [ui8; 1]
    ctxInit(&c, -1, nil)
    c.method = method
    c.path = path
    c.isHead = true       // no body written; fd -1 is never used for success paths
    hit = 0
    lastParam = nil
    routerDispatch(r, &c)
}

fn main() -> i32 {
    local r: Router
    routerInit(&r)
    routerGet(&r, "/", root)
    routerGet(&r, "/users/:id", user)
    routerGet(&r, "/users/me", me)
    routerGet(&r, "/files/*path", files)
    routerPost(&r, "/users", create)
    local api: Group
    routerGroup(&r, "/api", &api)
    groupUse(&api, guard)
    groupGet(&api, "/ping", apiPing)
    routerNoRoute(&r, notFound)

    run(&r, "GET", "/")
    check("root", hit == 1)
    run(&r, "GET", "/users/42")
    check("param", hit == 2 && lastParam != nil && cstrEq(lastParam, "42"))
    run(&r, "GET", "/users/me")
    check("static wins", hit == 3)
    run(&r, "GET", "/files/a/b.txt")
    check("catch-all", hit == 4 && lastParam != nil && cstrEq(lastParam, "/a/b.txt"))
    run(&r, "POST", "/users")
    check("post", hit == 6)
    run(&r, "GET", "/api/ping")
    check("group", hit == 5 && trace == 11)
    run(&r, "GET", "/nope")
    check("no route", hit == 99)
    run(&r, "HEAD", "/")
    check("head falls back to get", hit == 1)

    if failures == 0 { println("router ok") }
    return failures
}
