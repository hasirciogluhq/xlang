// Slices and the iterating `for`: `[]T`, `[]mut T`, `buffer[lo..hi]` and `for x in s` / `for x, i in s`
// over arrays, slices and `str`. A slice is a non-owning fat pointer; the loop element is a `*T` into
// the storage, so a write reaches the owner and nothing is copied.
from "std" import print
from "std/str/str" import eq

global failures: i32 = 0

fn check(name: *ui8, ok: bool) {
    if !ok {
        failures = failures + 1
        print("FAIL ")
        print(name)
        print("\n")
    }
}

class Proc {
    pid: i32
    name: str

    fn init(self, pid: i32, name: str) {
        self.pid = pid
        self.name = name
    }
}

// Walk a fixed array and fix every process's name in place: the element is a pointer.
fn loopArray() {
    local procs: [Proc; 3]
    procs[0] = Proc(10, "init")
    procs[1] = Proc(20, "worker")
    procs[2] = Proc(30, "reaper")
    local sum: i64 = 0
    for p in procs {
        sum = sum + (p.pid as i64)
        p.pid = p.pid * 10
    }
    check("array sum", sum == 60)
    check("array written in place", procs[0].pid == 100 && procs[2].pid == 300)

    local weighted: i64 = 0
    for p, i in procs {
        weighted = weighted + ((i as i64) * (p.pid as i64))
    }
    // 0*100 + 1*200 + 2*300 = 800
    check("indexed loop", weighted == 800)
}

// A slice view over part of an array, read and written through.
fn loopSlice() {
    local buf: [i32; 6] = [1, 2, 3, 4, 5, 6]
    local mid: []mut i32 = buf[1..5]
    check("slice length", mid.len == 4)
    local sum: i64 = 0
    for v in mid {
        sum = sum + (*v as i64)
    }
    check("slice sum", sum == 14)              // 2 + 3 + 4 + 5
    // Write every element through the view; the array sees it.
    for v in mid {
        *v = *v * 2
    }
    check("slice wrote through", buf[1] == 4 && buf[4] == 10 && buf[5] == 6)
    // Open and half-open forms.
    local tail: []i32 = buf[4..]
    check("tail", tail.len == 2 && tail[0] == 10)
    local head: []i32 = buf[..2]
    check("head", head.len == 2 && head[1] == 4)
}

// `str` walks bytes.
fn loopStr() {
    local s: str = "abc"
    local sum: i64 = 0
    local count: usize = 0
    for b in s {
        sum = sum + (*b as i64)
        count = count + 1
    }
    check("str bytes", sum == (97 + 98 + 99) && count == 3)
    check("str unchanged", eq(s, "abc"))
}

// An empty slice runs zero times.
fn emptyLoop() {
    local buf: [i32; 3] = [1, 2, 3]
    local none: []i32 = buf[1..1]
    local count: i64 = 0
    for v in none {
        count = count + 1
        v = v
    }
    check("empty slice", count == 0 && none.len == 0)
}

// break / continue / labeled break inside the iterating loop.
fn breakContinue() {
    local rows: [i32; 3] = [1, 2, 3]
    local total: i64 = 0
    for a in rows {
        if *a == 2 { continue }
        total = total + (*a as i64)
    }
    check("continue skips one", total == 4)     // 1 + 3

    local cols: [i32; 3] = [10, 20, 30]
    local found: i32 = -1
    outer: for a in rows {
        for b in cols {
            if *a * *b == 60 {
                found = *a * 100 + *b
                break outer
            }
        }
    }
    check("labeled break", found == 230)
}

@entry fn main() -> i32 {
    loopArray()
    loopSlice()
    loopStr()
    emptyLoop()
    breakContinue()
    if failures != 0 {
        print("for_iter failed\n")
        return 1
    }
    print("for_iter ok\n")
    return 0
}
