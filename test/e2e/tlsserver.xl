// TLS 1.3 server e2e (the peer is `tlsclient.xl`, or openssl/curl): serves connections on
// 127.0.0.1:tlsPort until a client asks for `/quit`. Failed handshakes (the client's negative tests)
// are expected and just logged. Build with `-D tlsPort=14433` and optionally `-D tlsEc=1` for the
// ECDSA P-256 certificate instead of RSA-2048.
from "std" import println, tlsLoadCredentialsPem, tlsListen, tlsAccept, tlsRead, tlsWrite, tlsClose
from "std" import tlsErrorText, TlsConn, TlsCredentials, TLS_OK, strlen
from "std/sys" import sysClose
from "tls/fixture" import rsaCert, rsaKey, ecCert, ecKey

global cred: TlsCredentials
global req: [ui8; 4096]
global chunk: [ui8; 4096]

fn startsWith(s: *ui8, p: *ui8) -> bool {
    local i: usize = 0
    while p[i] != 0 {
        if s[i] != p[i] { return false }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
#ifdef tlsEc
    local r: i32 = tlsLoadCredentialsPem(&cred, ecCert, strlen(ecCert), ecKey, strlen(ecKey))
#else
    local r: i32 = tlsLoadCredentialsPem(&cred, rsaCert, strlen(rsaCert), rsaKey, strlen(rsaKey))
#endif
    if r != TLS_OK {
        println("server: credentials")
        println(tlsErrorText(r))
        return 1
    }
    local fd: i32 = tlsListen(2130706433, tlsPort as ui16)
    if fd < 0 {
        println("server: listen")
        return 2
    }
    println("server: listening")
    local running: bool = true
    while running {
        local c: TlsConn
        local e: i32 = tlsAccept(fd, &cred, &c)
        if e == TLS_OK {
            local n: isize = tlsRead(&c, &req[0], 4095)
            if n > 0 {
                req[n as usize] = 0
                if startsWith(&req[0], "GET /quit") {
                    tlsWrite(&c, "bye", 3)
                    running = false
                } else if startsWith(&req[0], "GET /big") {
                    // 200000 bytes: enough records to cross the 2^14 boundary many times
                    local i: usize = 0
                    while i < 4096 {
                        chunk[i] = (65 + (i % 26)) as ui8
                        i = i + 1
                    }
                    local sent: usize = 0
                    while sent < 200000 {
                        local take: usize = 200000 - sent
                        if take > 4096 { take = 4096 }
                        tlsWrite(&c, &chunk[0], take)
                        sent = sent + take
                    }
                } else {
                    tlsWrite(&c, "hello tls13", 11)
                }
            }
            tlsClose(&c)
        } else {
            println("server: handshake rejected")
            println(tlsErrorText(e))
        }
    }
    sysClose(fd)
    println("server: done")
    return 0
}
