// ECDSA P-256 verification, RFC 6979 A.2.5 vector (message "sample", SHA-256).
from "std/ecdsa" import ecdsaVerify
from "std/sha256" import sha256
from "std" import println, print

fn hexVal(c: ui8) -> ui8 {
    if c >= 97 { return c - 87 }
    return c - 48
}

fn unhex(hex: *ui8, out: *ui8, n: usize) {
    local i: usize = 0
    while i < n {
        out[i] = hexVal(hex[i * 2]) * 16 + hexVal(hex[i * 2 + 1])
        i = i + 1
    }
}

fn main() -> i32 {
    local qx: [ui8; 32]
    local qy: [ui8; 32]
    local r: [ui8; 32]
    local s: [ui8; 32]
    unhex("60fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb6", &qx[0], 32)
    unhex("7903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299", &qy[0], 32)
    unhex("efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716", &r[0], 32)
    unhex("f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8", &s[0], 32)
    local h: [ui8; 32]
    sha256("sample", 6, &h[0])
    local failures: i32 = 0
    if !ecdsaVerify(1, &qx[0], &qy[0], &h[0], 32, &r[0], &s[0]) {
        println("FAIL valid signature rejected")
        failures = failures + 1
    }
    h[0] = h[0] ^ 1
    if ecdsaVerify(1, &qx[0], &qy[0], &h[0], 32, &r[0], &s[0]) {
        println("FAIL wrong hash accepted")
        failures = failures + 1
    }
    h[0] = h[0] ^ 1
    s[31] = s[31] ^ 1
    if ecdsaVerify(1, &qx[0], &qy[0], &h[0], 32, &r[0], &s[0]) {
        println("FAIL tampered s accepted")
        failures = failures + 1
    }
    if failures == 0 {
        println("ecdsa ok")
        return 0
    }
    return 1
}
