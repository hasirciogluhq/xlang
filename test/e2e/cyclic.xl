// cyclic: mutual imports are legal. This module is the entry and imports cyclicdep, which imports it
// back. Both have `@init`: cyclicdep runs first, the importing (entry) module runs after it.
from "std" import print
from "cyclicdep" import depPlusCycle, depSeqValue

global cycSeq: i32 = 0
global cycSawDep: i32 = 0
global failures: i32 = 0

fn check(name: *ui8, ok: bool) {
    if !ok {
        failures = failures + 1
        print("FAIL ")
        print(name)
        print("\n")
    }
}

export fn cycValue() -> i32 {
    return 5
}

export fn cycSeqValue() -> i32 {
    return cycSeq
}

@init fn cycBoot() {
    cycSawDep = depSeqValue()
    cycSeq = 2
}

fn main() -> i32 {
    check("cyclicdep @init ran before the entry module's @init", cycSawDep == 1)
    check("entry module @init ran", cycSeqValue() == 2)
    check("cross-cycle call reaches cyclicdep and back", depPlusCycle() == 15)
    check("cross-cycle call into the entry module", cycValue() == 5)
    check("cyclicdep state visible in main", depSeqValue() == 1)
    if failures == 0 {
        print("cyclic ok\n")
    }
    return failures
}
