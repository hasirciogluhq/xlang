// Uses the default stdlib: print, the registered heap allocator, `new`, `free`, assert!.
from "std" import print, free, assert, strlen, sqrt

struct Point { x: i32, y: i32 }

fn main() -> i32 {
    print("hello from std\n")
    local p: *Point = new Point { x: 3, y: 4 }
    assert!(p != nil)
    assert!(p.x * p.y == 12)
    print((p.x + p.y) as i64)
    print("\n")
    free(p as *void)

    local total: i32 = 0
    local i: i32 = 0
    while i < 1000 {
        local q: *Point = new Point { x: i, y: 1 }
        total = total + q.x
        free(q as *void)
        i = i + 1
    }
    print(total as i64)
    print("\n")
    assert!(strlen("four") == 4)
    assert!(sqrt(16.0) > 3.999 && sqrt(16.0) < 4.001)
    return 0
}
