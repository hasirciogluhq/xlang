// Entry model: every @init runs before @entry (imports first, source order), every @fini runs after
// @entry in reverse order, and the exit status is the value @entry returns.
from "std" import print

@init fn bootA() { print("initA ") }
@init fn bootB() { print("initB ") }
@fini fn downA() { print("finiA\n") }
@fini fn downB() { print("finiB ") }

@entry fn main() -> i32 {
    print("entry ")
    return 3
}
