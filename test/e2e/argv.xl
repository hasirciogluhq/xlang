// argv: `@entry fn main(argc: i32, argv: **ui8)` receives the argument count and the argument vector. The
// runner starts the program without arguments, so argc is 1, argv[0] is the program path and
// argv[1] is the NULL terminator.
from "std" import print

@entry fn main(argc: i32, argv: **ui8) -> i32 {
    if argc != 1 {
        print("FAIL argc\n")
        return 1
    }
    if argv[0] == nil {
        print("FAIL argv0\n")
        return 1
    }
    if argv[1] != nil {
        print("FAIL terminator\n")
        return 1
    }
    print("argv ok\n")
    return 0
}
