// End-to-end: the control-flow syntax (break, labels, for, do-while, switch, defer, ?:, op=, ++/--).
// Exits with the number of failed checks and prints "controlflow ok" when all pass.
from "std" import print, println, printInt

enum Color { Red, Green, Blue }

global failures: i32 = 0
global counter: i64 = 0
global deferred: i64 = 0

fn check(name: *ui8, got: i64, want: i64) {
    if got != want {
        failures += 1
        print("FAIL ")
        print(name)
        print(": ")
        printInt(got)
        println("")
    }
}

fn bump() -> i64 {
    counter += 1
    return counter - 1
}

fn classify(v: i32) -> i32 {
    switch v {
        case 1, 2 { return 10 }
        case 3 { return 30 }
        default { return -1 }
    }
}

fn colorCode(c: Color) -> i32 {
    switch c {
        case Color.Red { return 1 }
        case Color.Green { return 2 }
        default { return 3 }
    }
}

fn deferOrder() -> i64 {
    local n: i64 = 0
    {
        defer { n = n * 10 + 1 }
        defer { n = n * 10 + 2 }
        n = 5
    }
    return n
}

fn deferReturn() -> i64 {
    defer deferred += 7
    return 42
}

fn deferInLoop() -> i64 {
    local acc: i64 = 0
    for i in 0..4 {
        defer acc += 100
        if i == 1 { continue }
        if i == 3 { break }
        acc += 1
    }
    return acc
}

fn main() -> i32 {
    local i: i64 = 0
    while true {
        if i == 5 { break }
        i += 1
    }
    check("break", i, 5)

    local sum: i64 = 0
    outer: for local a: i64 = 0; a < 5; a++ {
        for local b: i64 = 0; b < 5; b++ {
            if b == 3 { continue outer }
            if a == 3 { break outer }
            sum += 1
        }
    }
    check("labels", sum, 9)

    local odd: i64 = 0
    for local k: i64 = 0; k < 10; k++ {
        if k % 2 == 0 { continue }
        odd += k
    }
    check("for-continue", odd, 25)

    local total: i64 = 0
    for j in 0..5 { total += j }
    check("range", total, 10)

    local c: i64 = 6
    c *= 7
    c -= 2
    c /= 4
    c %= 7
    c <<= 3
    c >>= 1
    c |= 1
    c &= 0x1f
    c ^= 2
    check("compound", c, 15)

    local arr: [i64; 3] = [0, 0, 0]
    counter = 0
    arr[bump()] += 5
    check("once", counter, 1)
    check("once-arr", arr[0], 5)

    local p: i64 = 1
    p++
    p++
    p--
    check("incdec", p, 2)

    local runs: i64 = 0
    do {
        runs += 1
    } while false
    check("do-while", runs, 1)
    local w: i64 = 0
    do {
        w += 1
        if w < 3 { continue }
    } while w < 3
    check("do-continue", w, 3)

    check("switch1", classify(2) as i64, 10)
    check("switch2", classify(3) as i64, 30)
    check("switch3", classify(9) as i64, -1)
    check("enum", colorCode(Color.Green) as i64, 2)

    local t: i64 = i > 2 ? 100 : 200
    check("ternary", t, 100)
    local nested: i64 = i > 9 ? 1 : i > 4 ? 2 : 3
    check("ternary-nested", nested, 2)

    check("defer-order", deferOrder(), 521)
    check("defer-return", deferReturn(), 42)
    check("defer-ran", deferred, 7)
    // i=0: +1, +100; i=1: continue, +100; i=2: +1, +100; i=3: break, +100
    check("defer-loop", deferInLoop(), 402)

    if failures == 0 {
        println("controlflow ok")
    }
    return failures
}
