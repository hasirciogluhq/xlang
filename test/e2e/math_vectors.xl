// std/math geometry: the Vec2/Vec3/Vec4/Rect value classes and the heap-backed `Mat`, checked against values
// computed by hand and against `m * inverse(m) == I` up to 1e-9.
from "std" import print, assert
from "std/math" import Vec2, Vec3, Vec4, Rect, Mat, matDet, matInverse, matIdentity, matAdd, matSub, matTranspose, lerp, smoothstep, mapRange, clamp, degToRad, radToDeg, MATH_PI

define EPS = 0.000000001

@entry fn main() -> i32 {
    vec2Cases()
    vec3Cases()
    vec4Cases()
    rectCases()
    matrixCases()
    scalarCases()
    print("math_vectors ok\n")
    return 0
}

fn vec2Cases() {
    local a: Vec2 = Vec2(1.0, 2.0)
    local b: Vec2 = Vec2(3.0, 4.0)

    local sum: Vec2 = a.add(&b)
    assert!(eq2(&sum, 4.0, 6.0))
    local diff: Vec2 = a.sub(&b)
    assert!(eq2(&diff, -2.0, -2.0))
    local scaled: Vec2 = a.scale(3.0)
    assert!(eq2(&scaled, 3.0, 6.0))
    local neg: Vec2 = a.negate()
    assert!(eq2(&neg, -1.0, -2.0))
    local had: Vec2 = Vec2(2.0, 3.0)
    local prod: Vec2 = Vec2(4.0, 5.0)
    local hadamard: Vec2 = had.mul(&prod)
    assert!(eq2(&hadamard, 8.0, 15.0))

    assert!(a.dot(&b) == 11.0)
    assert!(a.cross(&b) == -2.0)          // 1*4 - 2*3
    assert!(b.cross(&a) == 2.0)
    assert!(a.lengthSquared() == 5.0)
    local three_four: Vec2 = Vec2(3.0, 4.0)
    assert!(three_four.length() == 5.0)
    assert!(a.distance(&b) == sqrtInt(8.0))
    assert!(a.distanceSquared(&b) == 8.0)

    // The zero vector normalizes to the zero vector, not to NaN.
    local zero: Vec2 = Vec2(0.0, 0.0)
    local zeroUnit: Vec2 = zero.normalized()
    assert!(zeroUnit.equals(&zero))
    local unit: Vec2 = a.normalized()
    assert!(near(unit.length(), 1.0))

    local half: Vec2 = a.lerp(&b, 0.5)
    assert!(eq2(&half, 2.0, 3.0))
    local lo: Vec2 = a.min(&b)
    assert!(eq2(&lo, 1.0, 2.0))
    local hi: Vec2 = a.max(&b)
    assert!(eq2(&hi, 3.0, 4.0))

    local raw: Vec2 = Vec2(-5.0, 9.0)
    local clamped: Vec2 = raw.clamped(0.0, 4.0)
    assert!(eq2(&clamped, 0.0, 4.0))

    // A 2x2 matrix maps (1, 2) by the rotation-free scale [2 0; 0 3].
    local m: Mat = Mat(2, 2)
    m.set(0, 0, 2.0)
    m.set(1, 1, 3.0)
    local mapped: Vec2 = a.transform(&m)
    assert!(eq2(&mapped, 2.0, 6.0))

    // A 3x3 affine matrix [1 0 5; 0 1 7; 0 0 1] translates by (5, 7).
    local aff: Mat = matIdentity(3, 3)
    aff.set(0, 2, 5.0)
    aff.set(1, 2, 7.0)
    local moved: Vec2 = a.transformAffine(&aff)
    assert!(eq2(&moved, 6.0, 9.0))
}

fn vec3Cases() {
    local a: Vec3 = Vec3(1.0, 2.0, 3.0)
    local b: Vec3 = Vec3(4.0, 5.0, 6.0)

    assert!(a.dot(&b) == 32.0)
    local c: Vec3 = a.cross(&b)
    assert!(c.x == -3.0 && c.y == 6.0 && c.z == -3.0)
    local cLen: f64 = c.length()
    assert!(near(cLen, 7.348469228349534))

    local sum: Vec3 = a.add(&b)
    assert!(eq3(&sum, 5.0, 7.0, 9.0))
    local diff: Vec3 = b.sub(&a)
    assert!(eq3(&diff, 3.0, 3.0, 3.0))
    local scaled: Vec3 = a.scale(2.0)
    assert!(eq3(&scaled, 2.0, 4.0, 6.0))
    local neg: Vec3 = a.negate()
    assert!(eq3(&neg, -1.0, -2.0, -3.0))

    // The unit vector of the cross product keeps the direction and has length 1.
    local n: Vec3 = c.normalized()
    assert!(near(n.length(), 1.0))
    local want: Vec3 = Vec3(-0.408248290463863, 0.816496580927726, -0.408248290463863)
    assert!(n.nearDefault(&want))
    local zero: Vec3 = Vec3(0.0, 0.0, 0.0)
    local zeroUnit: Vec3 = zero.normalized()
    assert!(zeroUnit.equals(&zero))

    local mid: Vec3 = a.lerp(&b, 0.5)
    assert!(eq3(&mid, 2.5, 3.5, 4.5))
    local lo: Vec3 = a.min(&b)
    assert!(lo.equals(&a))
    local hi: Vec3 = a.max(&b)
    assert!(hi.equals(&b))
    local d: f64 = a.distance(&b)
    assert!(near(d, 5.196152422706632))     // sqrt(27)
    assert!(a.distanceSquared(&b) == 27.0)

    local m: Mat = matIdentity(3, 3)
    local mapped: Vec3 = a.transform(&m)
    assert!(mapped.equals(&a))
}

fn vec4Cases() {
    local a: Vec4 = Vec4(1.0, 2.0, 3.0, 1.0)
    local b: Vec4 = Vec4(4.0, 5.0, 6.0, 1.0)

    assert!(a.dot(&b) == 33.0)
    local sum: Vec4 = a.add(&b)
    assert!(eq4(&sum, 5.0, 7.0, 9.0, 2.0))
    local diff: Vec4 = b.sub(&a)
    assert!(eq4(&diff, 3.0, 3.0, 3.0, 0.0))
    local scaled: Vec4 = a.scale(2.0)
    assert!(eq4(&scaled, 2.0, 4.0, 6.0, 2.0))
    local neg: Vec4 = a.negate()
    assert!(eq4(&neg, -1.0, -2.0, -3.0, -1.0))
    local mid: Vec4 = a.lerp(&b, 0.5)
    assert!(eq4(&mid, 2.5, 3.5, 4.5, 1.0))

    assert!(near(a.length(), sqrtInt(15.0)))
    local unit: Vec4 = a.normalized()
    assert!(near(unit.length(), 1.0))
    local zero: Vec4 = Vec4(0.0, 0.0, 0.0, 0.0)
    local zeroUnit: Vec4 = zero.normalized()
    assert!(zeroUnit.equals(&zero))

    local xyz: Vec3 = a.xyz()
    assert!(eq3(&xyz, 1.0, 2.0, 3.0))
}

fn rectCases() {
    local r: Rect = Rect(1.0, 2.0, 4.0, 3.0)     // x 1..5, y 2..5
    assert!(r.area() == 12.0)
    assert!(r.perimeter() == 14.0)
    assert!(!r.isEmpty())
    assert!(r.right() == 5.0 && r.bottom() == 5.0)
    assert!(r.left() == 1.0 && r.top() == 2.0)

    local c: Vec2 = r.center()
    assert!(eq2(&c, 3.0, 3.5))
    local o: Vec2 = r.origin()
    assert!(eq2(&o, 1.0, 2.0))

    local inside: Vec2 = Vec2(3.0, 3.0)
    local outside: Vec2 = Vec2(6.0, 3.0)
    local edge: Vec2 = Vec2(5.0, 5.0)
    assert!(r.contains(&inside))
    assert!(!r.contains(&outside))
    assert!(r.contains(&edge))
    assert!(r.distanceTo(&outside) == 1.0)
    assert!(r.distanceTo(&inside) == 0.0)

    local inner: Rect = Rect(2.0, 3.0, 1.0, 1.0)
    assert!(r.containsRect(&inner))
    assert!(!inner.containsRect(&r))

    local other: Rect = Rect(4.0, 4.0, 4.0, 4.0)
    assert!(r.intersects(&other))
    local shared: Rect = r.intersect(&other)
    assert!(eqRect(&shared, 4.0, 4.0, 1.0, 1.0))

    local far: Rect = Rect(100.0, 100.0, 1.0, 1.0)
    assert!(!r.intersects(&far))
    local none: Rect = r.intersect(&far)
    assert!(none.isEmpty())

    local both: Rect = r.union(&other)
    assert!(eqRect(&both, 1.0, 2.0, 7.0, 6.0))
    local empty: Rect = Rect(0.0, 0.0, 0.0, 0.0)
    local withEmpty: Rect = r.union(&empty)
    assert!(withEmpty.equals(&r))

    local moved: Rect = r.translate(2.0, -1.0)
    assert!(eqRect(&moved, 3.0, 1.0, 4.0, 3.0))
    local grown: Rect = r.inflate(1.0)
    assert!(eqRect(&grown, 0.0, 1.0, 6.0, 5.0))
    local shrunk: Rect = r.deflate(1.0)
    assert!(eqRect(&shrunk, 2.0, 3.0, 2.0, 1.0))
    local tooSmall: Rect = r.deflate(10.0)
    assert!(tooSmall.isEmpty())

    local seed: Rect = Rect(0.0, 0.0, 0.0, 0.0)
    local fromCorners: Rect = seed.fromCorners(5.0, 5.0, 1.0, 1.0)
    assert!(eqRect(&fromCorners, 1.0, 1.0, 4.0, 4.0))

    local negative: Rect = Rect(0.0, 0.0, -3.0, 4.0)
    assert!(negative.isEmpty())
    assert!(negative.area() == 0.0)
}

fn matrixCases() {
    // 3x3 with known values: det = -306, inverse entry by entry.
    local m: Mat = Mat(3, 3)
    local vals_m: [f64; 9] = [6.0, 1.0, 1.0, 4.0, -2.0, 5.0, 2.0, 8.0, 7.0]
    fill(&m, &vals_m[0])
    assert!(near(matDet(&m), -306.0))
    assert!(near(m.det(), -306.0))
    local inv: Mat = Mat(0, 0)
    assert!(matInverse(&m, &inv))
    assert!(near(inv.at(0, 0), 3.0 / 17.0))
    assert!(near(inv.at(0, 1), -1.0 / 306.0))
    assert!(near(inv.at(1, 0), 1.0 / 17.0))
    assert!(near(inv.at(2, 0), -2.0 / 17.0))

    // m * m^-1 == I for a 4x4, through the method form of the product.
    local four: Mat = Mat(4, 4)
    local vals_four: [f64; 16] = [4.0, 1.0, 2.0, 0.0, 1.0, 3.0, 0.0, 1.0, 0.0, 1.0, 5.0, 2.0, 2.0, 0.0, 1.0, 4.0]
    fill(&four, &vals_four[0])
    local fourInv: Mat = Mat(0, 0)
    assert!(matInverse(&four, &fourInv))
    local prod: Mat = four.mul(&fourInv)
    assert!(isIdentity(&prod, 4))

    // 1x1, 0x0 and a singular 3x3.
    local one: Mat = Mat(1, 1)
    one.set(0, 0, 4.0)
    assert!(near(matDet(&one), 4.0))
    local oneInv: Mat = Mat(0, 0)
    assert!(matInverse(&one, &oneInv))
    assert!(near(oneInv.at(0, 0), 0.25))

    local empty: Mat = Mat(0, 0)
    assert!(empty.isEmpty())
    assert!(near(matDet(&empty), 1.0))
    local emptyInv: Mat = Mat(0, 0)
    assert!(matInverse(&empty, &emptyInv))
    assert!(emptyInv.isEmpty())

    local sing: Mat = Mat(3, 3)
    local vals_sing: [f64; 9] = [1.0, 2.0, 3.0, 2.0, 4.0, 6.0, 1.0, 1.0, 1.0]
    fill(&sing, &vals_sing[0])
    assert!(near(matDet(&sing), 0.0))
    local singInv: Mat = Mat(0, 0)
    assert!(!matInverse(&sing, &singInv))

    // Elementwise add/sub, the transpose and the resize that reuses storage.
    local x: Mat = Mat(2, 2)
    local vals_x: [f64; 4] = [1.0, 2.0, 3.0, 4.0]
    fill(&x, &vals_x[0])
    local y: Mat = matIdentity(2, 2)
    local sum: Mat = Mat(0, 0)
    matAdd(&x, &y, &sum)
    assert!(near(sum.at(0, 0), 2.0) && near(sum.at(1, 1), 5.0) && near(sum.at(0, 1), 2.0))
    local diff: Mat = Mat(0, 0)
    matSub(&x, &y, &diff)
    assert!(near(diff.at(0, 0), 0.0) && near(diff.at(1, 1), 3.0))
    local tr: Mat = Mat(0, 0)
    matTranspose(&x, &tr)
    assert!(near(tr.at(0, 1), 3.0) && near(tr.at(1, 0), 2.0))
    local sq: Mat = m.transposed()
    assert!(sq.rows == 3 && sq.cols == 3 && near(sq.at(0, 1), 4.0))

    local r: Mat = Mat(2, 3)
    r.set(1, 2, 9.0)
    assert!(near(r.at(1, 2), 9.0))
    r.resize(3, 3)
    assert!(near(r.at(1, 2), 0.0) && r.count() == 9)
}

fn scalarCases() {
    assert!(lerp(2.0, 4.0, 0.25) == 2.5)
    assert!(lerp(2.0, 4.0, 0.0) == 2.0)
    assert!(smoothstep(0.0, 1.0, 0.5) == 0.5)
    assert!(smoothstep(0.0, 1.0, -1.0) == 0.0)
    assert!(smoothstep(0.0, 1.0, 2.0) == 1.0)
    assert!(smoothstep(0.0, 10.0, 2.5) == 0.15625)     // t = 0.25 -> 3t^2 - 2t^3
    assert!(mapRange(5.0, 0.0, 10.0, 0.0, 100.0) == 50.0)
    assert!(clamp(9.0, 0.0, 4.0) == 4.0)
    assert!(clamp(-1.0, 0.0, 4.0) == 0.0)
    assert!(clamp(2.0, 0.0, 4.0) == 2.0)
    assert!(near(degToRad(180.0), MATH_PI))
    assert!(near(radToDeg(MATH_PI), 180.0))
}

// Exact componentwise comparisons written as free functions: `&Vec2(1.0, 2.0)` is not allowed (the language has
// no address of a temporary), so the expected value arrives as plain components.

fn eq2(v: *Vec2, x: f64, y: f64) -> bool {
    local o: Vec2 = Vec2(x, y)
    return v.equals(&o)
}

fn eq3(v: *Vec3, x: f64, y: f64, z: f64) -> bool {
    local o: Vec3 = Vec3(x, y, z)
    return v.equals(&o)
}

fn eq4(v: *Vec4, x: f64, y: f64, z: f64, w: f64) -> bool {
    local o: Vec4 = Vec4(x, y, z, w)
    return v.equals(&o)
}

fn eqRect(r: *Rect, x: f64, y: f64, w: f64, h: f64) -> bool {
    local o: Rect = Rect(x, y, w, h)
    return r.equals(&o)
}

// Fills `m` in row-major order from `v`; the caller sizes `m` first and passes exactly rows * cols entries.
// The array is passed as a pointer because a fixed array parameter has one concrete length.
fn fill(m: *Mat, v: *f64) {
    local i: usize = 0
    local n: usize = m.count()
    while i < n {
        local p: *f64 = (v as usize + i * sizeOf(f64)) as *f64
        m.set(i / m.cols, i % m.cols, *p)
        i = i + 1
    }
}

fn isIdentity(m: *Mat, n: usize) -> bool {
    local i: usize = 0
    while i < n {
        local j: usize = 0
        while j < n {
            local want: f64 = 0.0
            if i == j { want = 1.0 }
            if !near(m.at(i, j), want) { return false }
            j = j + 1
        }
        i = i + 1
    }
    return true
}

// The square root of a small integer constant, checked exactly against the values the test compares with. The
// standard library has `sqrt`; this is only to keep a known value visible next to the number it explains.
fn sqrtInt(v: f64) -> f64 {
    local g: f64 = v
    local i: i32 = 0
    while i < 40 {
        g = 0.5 * (g + v / g)
        i = i + 1
    }
    return g
}

fn near(a: f64, b: f64) -> bool {
    local d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < EPS
}
