// try / catch: a panic is caught, `defer` statements and drops of the abandoned frames run, and the
// program continues.
from "std" import print

global log: [i32; 16]
global logLen: i32 = 0

fn note(v: i32) {
    log[logLen as usize] = v
    logLen = logLen + 1
}

fn leaf(boom: bool) -> i32 {
    defer note(1)
    if boom {
        panic("leaf failed")
    }
    return 7
}

fn middle(boom: bool) -> i32 {
    defer note(2)
    local v: i32 = leaf(boom)
    note(100)
    return v
}

fn divide(a: i32, b: i32) -> i32 {
    return a / b
}

fn nested() -> i32 {
    local r: i32 = 0
    try {
        try {
            middle(true)
        } catch inner {
            note(3)
            panic("again")
        }
    } catch outer {
        note(4)
        r = 1
    }
    return r
}

fn early(boom: bool) -> i32 {
    try {
        if !boom {
            return 5
        }
        panic("x")
    } catch e {
        return 6
    }
    return 0
}

@entry fn main() -> i32 {
    // 1. no panic: the body runs, the handler does not
    local a: i32 = 0
    try {
        a = middle(false)
    } catch e {
        a = -1
    }
    if a != 7 { return 1 }

    // 2. explicit panic through two frames: both defers run, in order, and the message arrives
    logLen = 0
    local ok: bool = false
    try {
        middle(true)
    } catch e {
        ok = e[0] != 0 && e[4] != 0
    }
    if !ok { return 2 }
    if logLen != 2 || log[0] != 1 || log[1] != 2 { return 3 }

    // 3. a compiler-generated panic (division by zero)
    local zero: i32 = 0
    local caught: bool = false
    try {
        divide(1, zero)
    } catch e {
        caught = true
    }
    if !caught { return 4 }

    // 4. nested try, panic inside a handler goes to the outer one
    logLen = 0
    if nested() != 1 { return 5 }
    if logLen != 4 || log[2] != 3 || log[3] != 4 { return 6 }

    // 5. return inside try, with and without a panic
    if early(false) != 5 || early(true) != 6 { return 7 }

    // 6. in a loop: the program keeps going after every catch
    local n: i32 = 0
    for i in 0..5 {
        try {
            if i % 2 == 0 { panic("even") }
            n = n + 1
        } catch e {
            n = n + 10
        }
    }
    if n != 32 { return 8 }

    print("try ok\n")
    return 0
}
