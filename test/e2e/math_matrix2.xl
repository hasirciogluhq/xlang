// std/math fixed-size 2x2 matrix: known determinants, the inverse (m * m^-1 == I), the transpose of the transpose,
// an orthonormal rotation (R R^T == I), the rotation of a known vector and the singular cases.
//   Conventions: row-major entries, radians, right-handed (a positive angle turns +x toward +y).
from "std" import print, assert
from "std/math" import Mat2, Vec2, mat2Identity, mat2Rotation, mat2Scale, mat2FromColumns, mat2Lerp, MATH_PI

define EPS = 0.000000001

@entry fn main() -> i32 {
    construction()
    arithmeticCases()
    determinantAndInverse()
    rotationCases()
    productCases()
    singularCases()
    vectorCases()
    print("math_matrix2 ok\n")
    return 0
}

fn construction() {
    local a: Mat2 = Mat2(1.0, 2.0, 3.0, 4.0)
    assert!(a.at(0, 0) == 1.0)
    assert!(a.at(0, 1) == 2.0)
    assert!(a.at(1, 0) == 3.0)
    assert!(a.at(1, 1) == 4.0)
    // The row-major backing array: m[1] is entry (0, 1).
    assert!(a.m[1] == 2.0 && a.m[2] == 3.0)
    assert!(a.trace() == 5.0)

    local ident: Mat2 = mat2Identity()
    assert!(ident.isIdentity())
    assert!(!a.isIdentity())
    assert!(ident.trace() == 2.0)

    local scaled: Mat2 = mat2Scale(2.0, 3.0)
    assert!(scaled.at(0, 0) == 2.0 && scaled.at(1, 1) == 3.0 && scaled.at(0, 1) == 0.0)

    local lerped: Mat2 = mat2Lerp(&a, &ident, 0.5)
    assert!(near(lerped.at(0, 0), 1.0))
    assert!(near(lerped.at(0, 1), 1.0))
    assert!(near(lerped.at(1, 1), 2.5))
    local start: Mat2 = mat2Lerp(&a, &ident, 0.0)
    assert!(start.equals(&a))
}

fn arithmeticCases() {
    local a: Mat2 = Mat2(1.0, 2.0, 3.0, 4.0)
    local b: Mat2 = Mat2(5.0, 6.0, 7.0, 8.0)
    local sum: Mat2 = a.add(&b)
    local wantSum: Mat2 = Mat2(6.0, 8.0, 10.0, 12.0)
    assert!(sum.equals(&wantSum))
    local diff: Mat2 = b.sub(&a)
    local wantDiff: Mat2 = Mat2(4.0, 4.0, 4.0, 4.0)
    assert!(diff.equals(&wantDiff))
    local scaled: Mat2 = a.scale(2.0)
    local wantScaled: Mat2 = Mat2(2.0, 4.0, 6.0, 8.0)
    assert!(scaled.equals(&wantScaled))
}

fn determinantAndInverse() {
    // det [1 2; 3 4] = 1*4 - 2*3 = -2.
    local a: Mat2 = Mat2(1.0, 2.0, 3.0, 4.0)
    assert!(near(a.det(), -2.0))

    local inv: Mat2 = Mat2()
    assert!(a.inverse(&inv))
    // 1/det [d -b; -c a] = -1/2 [4 -2; -3 1] = [-2 1; 1.5 -0.5].
    assert!(near(inv.at(0, 0), -2.0))
    assert!(near(inv.at(0, 1), 1.0))
    assert!(near(inv.at(1, 0), 1.5))
    assert!(near(inv.at(1, 1), -0.5))

    // inverse(a) * a == I, through the out-parameter form.
    local product: Mat2 = Mat2()
    inv.mulTo(&a, &product)
    local ident: Mat2 = mat2Identity()
    assert!(product.nearDefault(&ident))

    // A scale inverts to the reciprocal scale.
    local s: Mat2 = mat2Scale(2.0, 4.0)
    local sInv: Mat2 = Mat2()
    assert!(s.inverse(&sInv))
    assert!(near(sInv.at(0, 0), 0.5) && near(sInv.at(1, 1), 0.25))

    // transpose(transpose(a)) == a, and the transpose swaps the off-diagonal entries.
    local t: Mat2 = a.transposed()
    assert!(t.at(0, 1) == 3.0 && t.at(1, 0) == 2.0)
    local tt: Mat2 = t.transposed()
    assert!(tt.equals(&a))

    // det of the transpose is the det of the original.
    assert!(near(t.det(), a.det()))
}

fn rotationCases() {
    // The rotation by pi/2 turns (1, 0) into (0, 1).
    local r: Mat2 = mat2Rotation(MATH_PI / 2.0)
    assert!(near(r.at(0, 0), 0.0))
    assert!(near(r.at(0, 1), -1.0))
    assert!(near(r.at(1, 0), 1.0))
    assert!(near(r.at(1, 1), 0.0))

    // A rotation is orthogonal: R R^T == I (and det 1).
    local rt: Mat2 = r.transposed()
    local rr: Mat2 = r.mul(&rt)
    local ident: Mat2 = mat2Identity()
    assert!(rr.nearDefault(&ident))
    assert!(near(r.det(), 1.0))

    // The full turn is the identity.
    local full: Mat2 = mat2Rotation(MATH_PI * 2.0)
    assert!(full.nearDefault(&ident))

    // The half turn negates both axes.
    local half: Mat2 = mat2Rotation(MATH_PI)
    assert!(near(half.at(0, 0), -1.0) && near(half.at(1, 1), -1.0))
}

fn productCases() {
    local a: Mat2 = Mat2(1.0, 2.0, 3.0, 4.0)
    local b: Mat2 = Mat2(5.0, 6.0, 7.0, 8.0)
    // [1 2; 3 4] [5 6; 7 8] = [19 22; 43 50].
    local p: Mat2 = a.mul(&b)
    assert!(near(p.at(0, 0), 19.0))
    assert!(near(p.at(0, 1), 22.0))
    assert!(near(p.at(1, 0), 43.0))
    assert!(near(p.at(1, 1), 50.0))

    // The product into the left operand: a.mulTo(&b, &a) is b's left product, not b's old value.
    local aliased: Mat2 = Mat2(1.0, 2.0, 3.0, 4.0)
    aliased.mulTo(&b, &aliased)
    assert!(near(aliased.at(0, 0), 19.0) && near(aliased.at(1, 1), 50.0))

    // det(AB) = det(A) det(B): -2 * -2 = 4.
    assert!(near(p.det(), 4.0))

    // The identity is neutral.
    local ident: Mat2 = mat2Identity()
    local ap: Mat2 = a.mul(&ident)
    assert!(ap.equals(&a))
}

fn singularCases() {
    // A rank-one matrix: the second row is twice the first, so det = 0 and no inverse exists.
    local sing: Mat2 = Mat2(1.0, 2.0, 2.0, 4.0)
    assert!(near(sing.det(), 0.0))
    local inv: Mat2 = Mat2(9.0, 9.0, 9.0, 9.0)
    assert!(!sing.inverse(&inv))
    // A refused inverse leaves the destination untouched.
    assert!(inv.at(0, 0) == 9.0)

    // The zero matrix is singular.
    local zero: Mat2 = Mat2()
    assert!(near(zero.det(), 0.0))
    local zeroInv: Mat2 = Mat2()
    assert!(!zero.inverse(&zeroInv))

    // The identity is not singular and inverts to itself.
    local ident: Mat2 = mat2Identity()
    local idInv: Mat2 = Mat2()
    assert!(ident.inverse(&idInv))
    assert!(idInv.nearDefault(&ident))
}

fn vectorCases() {
    // The columns of the matrix are the images of the basis vectors.
    local ex: Vec2 = Vec2(1.0, 0.0)
    local ey: Vec2 = Vec2(0.0, 1.0)
    local c: Mat2 = mat2FromColumns(&ex, &ey)
    local ident: Mat2 = mat2Identity()
    assert!(c.nearDefault(&ident))

    // mat2Scale(2, 3) maps (1, 2) to (2, 6).
    local s: Mat2 = mat2Scale(2.0, 3.0)
    local v: Vec2 = Vec2(1.0, 2.0)
    local out: Vec2 = Vec2(0.0, 0.0)
    s.mulVec(&v, &out)
    assert!(equal2(&out, 2.0, 6.0))

    // The rotation by pi/2 maps (1, 0) to (0, 1).
    local r: Mat2 = mat2Rotation(MATH_PI / 2.0)
    r.mulVec(&ex, &out)
    assert!(near(out.x, 0.0) && near(out.y, 1.0))
}

fn equal2(v: *Vec2, x: f64, y: f64) -> bool {
    return near(v.x, x) && near(v.y, y)
}

fn near(a: f64, b: f64) -> bool {
    local d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < EPS
}

