// X25519 known-answer tests (RFC 7748 section 5.2 and 6.1).
from "std/x25519" import x25519, x25519Base
from "std" import print

fn hexVal(c: ui8) -> ui8 {
    if c >= 97 { return c - 87 }
    return c - 48
}

fn unhex(hex: *ui8, out: *ui8, n: usize) {
    local i: usize = 0
    while i < n {
        out[i] = hexVal(hex[i * 2]) * 16 + hexVal(hex[i * 2 + 1])
        i = i + 1
    }
}

fn same(a: *ui8, b: *ui8) -> bool {
    local i: usize = 0
    while i < 32 {
        if a[i] != b[i] { return false }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    local k: [ui8; 32]
    local u: [ui8; 32]
    local want: [ui8; 32]
    local out: [ui8; 32]
    local failures: i32 = 0
    unhex("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4", &k[0], 32)
    unhex("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c", &u[0], 32)
    unhex("c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552", &want[0], 32)
    x25519(&out[0], &k[0], &u[0])
    if !same(&out[0], &want[0]) {
        print("FAIL vector 1\n")
        failures = failures + 1
    }
    unhex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a", &k[0], 32)
    unhex("8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a", &want[0], 32)
    x25519Base(&out[0], &k[0])
    if !same(&out[0], &want[0]) {
        print("FAIL alice public key\n")
        failures = failures + 1
    }
    // shared secret: alice private * bob public
    local bob: [ui8; 32]
    unhex("de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f", &bob[0], 32)
    unhex("4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742", &want[0], 32)
    local shared: [ui8; 32]
    x25519(&shared[0], &k[0], &bob[0])      // `bob` holds Bob's public key
    if !same(&shared[0], &want[0]) {
        print("FAIL shared secret\n")
        failures = failures + 1
    }
    if failures == 0 {
        print("x25519 ok\n")
        return 0
    }
    return 1
}
