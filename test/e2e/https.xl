// HTTPS client smoke test: DNS + TLS 1.3 + OS root store against a public server, plus the certificate rejection path (an IP address
// is not a name on the certificate). Needs network access; exits 0 on success. Uses the std HTTP client.
from "std" import print, Client, Response, CLIENT_ERR_TLS

@entry fn main() -> i32 {
    local c: Client = Client()
    local ok: Response = c.Get("https://example.com/")
    if ok.error != 0 || ok.status != 200 {
        print("FAIL: https GET\n")
        return 1
    }
    local bad: Response = c.Get("https://1.1.1.1/")
    if bad.error != CLIENT_ERR_TLS {
        print("FAIL: certificate for another name was accepted\n")
        return 2
    }
    print("https ok\n")
    return 0
}
