// Strings: the built-in `str` view, the three types a literal can take, and the std/str helpers.
from "std" import print, strEq, strSlice, strFromC, strlen

global failures: i32 = 0
global g: str = "xlang"

const GREETING = "hi"
const LIMIT: i32 = 7
const TABLE: [ui8; 4] = "abc"

fn check(name: *ui8, ok: bool) {
    if !ok {
        failures = failures + 1
        print("FAIL ")
        print(name)
        print("\n")
    }
}

fn main() -> i32 {
    check("len", "Jones".len == 5)
    local s = "Jo\0nes"
    check("embedded NUL counts", s.len == 6)
    check("embedded NUL byte", s[2] == 0)
    local b: [ui8; 8] = "Jones"
    b[0] = 66
    check("array copy is writable", b[0] == 66)
    check("array copy is zero-padded", b[5] == 0)
    check("strEq equal", strEq("abc", "abc"))
    check("strEq different", !strEq("abc", "abd"))
    check("strSlice", strEq(strSlice("hello", 1, 3), "ell"))
    check("global str", g.len == 5)
    local p: *ui8 = "plain"
    check("raw pointer literal", strlen(p) == 5)
    check("strFromC", strFromC(p).len == 5)
    check("str bytes", s.ptr[0] == 74)
    check("module const str", GREETING.len == 2)
    check("module const array", TABLE[1] == 98 && TABLE[3] == 0)
    local lp: *i32 = &LIMIT
    check("address of const", *lp == 7 && LIMIT == 7)
    const SUFFIX = "!"
    const ITEMS: [i32; 3] = [1, 2, 3]
    check("local const str", SUFFIX.len == 1)
    check("local const array", ITEMS[0] + ITEMS[2] == 4)
    if failures == 0 {
        print("strings ok\n")
    }
    return failures
}
