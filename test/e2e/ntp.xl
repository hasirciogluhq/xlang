// std/net/proto/ntp: packet build/parse, the sub-second timestamp conversions and the offset/delay of RFC 5905 section 8.
from "std" import print, sysClockNanos
from "std/str/string" import String
from "std/net/proto/ntp" import ntpClientRequest, ntpParse, ntpFromUnixNanos, ntpToUnixNanos, ntpOffsetDelay, NtpOffsetDelay, NtpPacket

global failures: i32 = 0

fn check(ok: bool, what: str) {
    if !ok {
        failures++
        print("FAIL ")
        print(what)
        print("\n")
    }
}

@entry fn main() -> i32 {
    local ts: ui64 = ntpFromUnixNanos(1700000000500000000)             // 2023-11-14T22:13:20.5Z
    check((ts >> 32) == 1700000000 + 2208988800, "seconds carry the 1900 offset")
    check((ts & 0xffffffff) == 0x80000000, "half a second is 0x80000000")
    check(ntpToUnixNanos(ts) == 1700000000500000000, "nanoseconds round-trip")
    check(ntpToUnixNanos(ntpFromUnixNanos(123456789)) == 123456789, "sub-second nanoseconds round-trip")

    local req: String = ntpClientRequest(ts)
    local p: NtpPacket = ntpParse(&req)
    check(req.length() == 48 && req.at(0) == 0x23, "request is 48 bytes, LI 0 VN 4 Mode 3")
    check(p.ok && p.version == 4 && p.mode == 3 && p.transmit == ts, "request parses back")
    local shortPkt: String = String(10, 0)
    check(!ntpParse(&shortPkt).ok, "short packet is rejected")

    // Section 8 example shape: server 1 s ahead, 100 ms each way.
    local one: i64 = 4294967296
    local t1: ui64 = (10 * one) as ui64
    local t2: ui64 = (11 * one + one / 10) as ui64
    local t3: ui64 = t2 + (one / 10) as ui64
    local t4: ui64 = t1 + (3 * one / 10) as ui64
    local od: NtpOffsetDelay = ntpOffsetDelay(t1, t2, t3, t4)
    check(od.offset > one - one / 100 && od.offset < one + one / 100, "offset is about 1 s")
    check(od.delay > one / 5 - one / 100 && od.delay < one / 5 + one / 100, "delay is about 200 ms")

    local now: i64 = sysClockNanos()
    check(now > 1700000000000000000, "the clock is past 2023")
    check(sysClockNanos() >= now, "the clock does not go back")

    if failures == 0 { print("ntp ok\n") }
    return failures
}
