import expect from test
import * as fs from filesystem

fn scratch_path(): string {
    return "test/xlang/_file_test_scratch.txt"
}

fn TestWriteAndReadAll() {
    local path = scratch_path()
    expect(fs.Write(path, "hello file")).toEqual(0)
    expect(fs.ReadAll(path)).toEqual("hello file")
    return 0
}

fn TestAppend() {
    local path = scratch_path()
    fs.Write(path, "a")
    expect(fs.Append(path, "b")).toEqual(0)
    expect(fs.ReadAll(path)).toEqual("ab")
    return 0
}

fn TestExistsAndSize() {
    local path = scratch_path()
    fs.Write(path, "12345")
    expect(fs.Exists(path)).toEqual(1)
    expect(fs.Size(path)).toEqual(5)
    expect(fs.Exists("test/xlang/_missing_file_.txt")).toEqual(0)
    return 0
}

fn TestOpenReadStream() {
    local path = scratch_path()
    fs.Write(path, "stream-read")
    local f = fs.OpenRead(path)
    expect(fs.IsOpen(f)).toEqual(1)
    expect(fs.ReadAll(f)).toEqual("stream-read")
    expect(fs.Close(f)).toEqual(0)
    return 0
}

fn TestOpenWriteStream() {
    local path = scratch_path()
    local f = fs.OpenWrite(path)
    expect(fs.IsOpen(f)).toEqual(1)
    expect(fs.WriteStream(f, "stream-write")).toEqual(0)
    expect(fs.Close(f)).toEqual(0)
    expect(fs.ReadAll(path)).toEqual("stream-write")
    return 0
}

fn TestOpenAppendStream() {
    local path = scratch_path()
    fs.Write(path, "x")
    local f = fs.OpenAppend(path)
    expect(fs.WriteStream(f, "y")).toEqual(0)
    expect(fs.Close(f)).toEqual(0)
    expect(fs.ReadAll(path)).toEqual("xy")
    return 0
}

fn TestMissingReadAll() {
    expect(str_len(fs.ReadAll("test/xlang/_missing_read_all_.txt"))).toEqual(0)
    return 0
}
